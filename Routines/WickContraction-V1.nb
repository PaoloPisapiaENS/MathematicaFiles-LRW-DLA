Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "FieldsNamesGenerator", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"FieldsNamesGenerator", "::", "usage"}], "=", 
    "\"\<FieldsNamesGenerator[\\!\\*\nStyleBox[\\\"fields_List\\\", \
\\\"TI\\\"]] takes a list of field variable names and returns a list of the \
modified names needed by WickContraction[]. The modified names are \
StyleBox[\\\"starFields\\\", \\\"TI\\\"], StyleBox[\\\"deltaFields\\\", \
\\\"TI\\\"] and StyleBox[\\\"deltaStarFields\\\", \\\"TI\\\"] .\>\""}], ";"}],
   "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"FieldsNamesGenerator", "[", "fields_List", "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"locFields", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"starFields", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"deltaFields", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"deltaStarFields", "=", 
        RowBox[{"{", "}"}]}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "l", "}"}], ",", "\n", "\n", 
        RowBox[{
         RowBox[{"locFields", "=", "fields"}], ";", "\n", "\n", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"l", "=", "1"}], ",", 
           RowBox[{"l", "<=", 
            RowBox[{"Length", "[", "locFields", "]"}]}], ",", 
           RowBox[{"l", "++"}], ",", "\n", 
           RowBox[{
            RowBox[{"AppendTo", "[", 
             RowBox[{"starFields", ",", " ", 
              RowBox[{"ToExpression", "[", 
               RowBox[{
                RowBox[{"ToString", "[", 
                 RowBox[{"locFields", "[", 
                  RowBox[{"[", "l", "]"}], "]"}], "]"}], " ", "<>", " ", 
                "\"\<s\>\""}], "]"}]}], "]"}], ";", "\n", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"deltaFields", ",", " ", 
              RowBox[{"ToExpression", "[", 
               RowBox[{"\"\<\[Delta]\>\"", "<>", 
                RowBox[{"ToString", "[", 
                 RowBox[{"locFields", "[", 
                  RowBox[{"[", "l", "]"}], "]"}], "]"}]}], " ", "]"}]}], 
             "]"}], ";", "\n", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"deltaStarFields", ",", 
              RowBox[{"ToExpression", "[", 
               RowBox[{"\"\<\[Delta]\>\"", "<>", " ", 
                RowBox[{"ToString", "[", 
                 RowBox[{"starFields", "[", 
                  RowBox[{"[", "l", "]"}], "]"}], "]"}]}], " ", "]"}]}], 
             "]"}], ";"}]}], "\n", "]"}], ";", 
         RowBox[{"(*", 
          RowBox[{
          "End", " ", "of", " ", "loop", " ", "to", " ", "define", " ", "the",
            " ", "fields"}], "*)"}], "\n", "\n", 
         RowBox[{"Return", "[", 
          RowBox[{"{", 
           RowBox[{
           "locFields", ",", "starFields", ",", "deltaFields", ",", 
            "deltaStarFields"}], "}"}], "]"}]}]}], "\n", "]"}], ";"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 InitializationCell->True,
