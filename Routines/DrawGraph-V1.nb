Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"DrawGraph", "[", 
     RowBox[{"exp_List", ",", 
      RowBox[{"options", ":", 
       RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"DrawGraph", "[", 
        RowBox[{"#", ",", "options"}], "]"}], "&"}], "@", 
      RowBox[{"(", 
       RowBox[{"Total", "@", "exp"}], ")"}]}], ")"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"DrawGraph", "[", 
   RowBox[{"exp_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "terms", ",", "i", ",", "pureProp", ",", " ", "weight", ",", " ", "dots",
       ",", "plot"}], "}"}], ",", "\n", "\n", "\n", 
    RowBox[{
     RowBox[{"terms", "=", "exp"}], ";", "\n", "\n", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"terms", "==", "0"}], ",", 
       RowBox[{
        RowBox[{"Message", "[", 
         RowBox[{"DrawGraph", "::", "zero"}], "]"}], ";", " ", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\n", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"terms", "==", "0"}], ",", "\n", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"Style", "[", 
            RowBox[{"\"\<!!ZERO!!\>\"", ",", "Red"}], "]"}], "]"}], ";", " ", 
          "\n", 
          RowBox[{"Abort", "[", "]"}], ";"}]}], "\n", "]"}], ";"}], "*)"}], 
     "\n", "\n", "\n", 
     RowBox[{"terms", "=", 
      RowBox[{
       RowBox[{"List", " ", "@@", " ", 
        RowBox[{"(", "terms", ")"}]}], "/.", 
       RowBox[{"Times", "->", "List"}]}]}], ";", "\n", "\[IndentingNewLine]", 
     "\n", 
     RowBox[{"MyPrint", "[", 
      RowBox[{"{", "terms", "}"}], "]"}], ";", "\n", "\n", 
     RowBox[{"(*", " ", 
      RowBox[{
      "I", " ", "want", " ", "to", " ", "check", " ", "if", " ", "terms", " ",
        "is", " ", "a", " ", "list", " ", "of", " ", "lists", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
         "which", " ", "means", " ", "that", " ", "exp", " ", "conatained", 
          " ", "a", " ", "sum"}], ",", " ", 
         RowBox[{
          RowBox[{"i", ".", "e", ".", " ", "multiple"}], " ", "diagrams"}]}], 
        ")"}]}], "*)"}], "\n", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{
         RowBox[{"Head", "[", 
          RowBox[{"terms", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}], " ", "===", "List"}]}], ",",
        "\n", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"TRUE", ":", " ", 
          RowBox[{
          "if", " ", "it", " ", "is", " ", "not", " ", "a", " ", "List", " ", 
           "of", " ", "lists"}]}], ",", " ", 
         RowBox[{
          RowBox[{"let", "'"}], "s", " ", "make", " ", "it", " ", "so"}]}], 
        " ", "*)"}], "\n", "\n", 
       RowBox[{
        RowBox[{"terms", "=", 
         RowBox[{"{", "terms", "}"}]}], ";"}]}], "\n", "\n", "]"}], 
     RowBox[{"(*", 
      RowBox[{"End", " ", "of", " ", "IF"}], "*)"}], ";", "\n", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Set", " ", "up", " ", "the", " ", "list", " ", "variable", " ", "to", 
       " ", "store", " ", "the", " ", "plots"}], "*)"}], "\n", 
     RowBox[{"plot", "=", 
      RowBox[{"{", "}"}]}], ";", "\n", "\n", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<=", 
        RowBox[{"Length", "[", "terms", "]"}]}], ",", 
       RowBox[{"i", "++"}], ",", "\n", "\n", 
       RowBox[{
        RowBox[{"pureProp", "=", 
         RowBox[{"DeleteElements", "[", 
