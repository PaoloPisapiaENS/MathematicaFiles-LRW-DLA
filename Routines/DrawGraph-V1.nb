Cell[BoxData[
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"Style", "[", 
    RowBox[{
     RowBox[{"\"\<~~~~~~~~~~~~~~~~ DrawGraph v\>\"", "<>", 
      RowBox[{"ToString", "[", "$DrawGraphVersion", "]"}], "<>", 
      "\"\< ~~~~~~~~~~~~~~~~~~~~\\n\\\nAuthor: Paolo Pisapia.\\n\\\nRelease \
Date: \>\"", "<>", "$DrawGraphReleaseDate", "<>", 
      "\"\<\\n\\\nTimestamp: \>\"", "<>", 
      RowBox[{"DateString", "[", 
       RowBox[{"FileDate", "[", "$InputFileName", "]"}], "]"}], "<>", 
      "\"\<\\nRead from:\>\"", "<>", "$InputFileName", "<>", 
      "\"\< (CRC32:\>\"", "<>", 
      RowBox[{"ToString", "[", 
       RowBox[{"FileHash", "[", 
        RowBox[{"$InputFileName", ",", "\"\<CRC32\>\""}], "]"}], "]"}], "<>", 
      "\"\<,\>\"", "<>", 
      RowBox[{"ToString", "[", 
       RowBox[{"FileHash", "[", 
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"FileNames", "[", 
            RowBox[{"$LiteRedHomeDirectory", "<>", "\"\<FermatCode/*\>\""}], 
            "]"}], ",", 
           RowBox[{"Not", "@*", "DirectoryQ"}]}], "]"}], ",", 
         "\"\<CRC32\>\""}], "]"}], "]"}], "<>", 
      "\"\<)\\n\\nLiteRed stands for \>\""}], ",", 
     RowBox[{"Style", "[", 
      RowBox[{"\"\<L\>\"", ",", 
       RowBox[{"{", 
        RowBox[{"Lighter", "@", "Red"}], "}"}]}], "]"}], ",", "\"\<oop \>\"", 
     ",", 
     RowBox[{"Style", "[", 
      RowBox[{"\"\<i\>\"", ",", 
       RowBox[{"{", 
        RowBox[{"Lighter", "@", "Red"}], "}"}]}], "]"}], ",", "\"\<n\>\"", 
     ",", 
     RowBox[{"Style", "[", 
      RowBox[{"\"\<te\>\"", ",", 
       RowBox[{"{", 
        RowBox[{"Lighter", "@", "Red"}], "}"}]}], "]"}], ",", 
     "\"\<grals \>\"", ",", 
     RowBox[{"Style", "[", 
      RowBox[{"\"\<Red\>\"", ",", 
       RowBox[{"{", 
        RowBox[{"Lighter", "@", "Red"}], "}"}]}], "]"}], ",", 
     "\"\<uction.\\n\\\nThe package is designed for drawing nice-looking \
graphs. \\\nIt takes inspiration from Kay Wiese's implementation.\\n\\nSee \
?DrawGraph`* for a list of functions. \>\"", ",", 
     RowBox[{"{", 
      RowBox[{"Bold", ",", 
       RowBox[{"Lighter", "@", "Blue"}]}], "}"}]}], "]"}], "]"}], 
