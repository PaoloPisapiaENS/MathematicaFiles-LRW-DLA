   RowBox[{"Coefficients", " ", "of", " ", "my", " ", "sum"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"a", "[", "0", "]"}], "=", "2"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"a", "[", "1", "]"}], "=", 
     RowBox[{"-", 
      FractionBox["1", "3"]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"a", "[", "2", "]"}], "=", 
     RowBox[{"-", 
      FractionBox["1", "9"]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"a", "[", "3", "]"}], "=", "0.211568"}], ";"}], 
   "\[IndentingNewLine]", 
