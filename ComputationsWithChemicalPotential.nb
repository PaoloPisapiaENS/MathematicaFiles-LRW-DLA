      "EQUAL", " ", "TO", " ", "THE", " ", "LOOP", " ", "ORDER"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"IN", " ", "THIS", " ", "CASE", " ", "N"}], "+", "M"}], "=", 
