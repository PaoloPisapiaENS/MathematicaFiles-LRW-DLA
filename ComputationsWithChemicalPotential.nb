   "Pade", " ", "Approximation", " ", "of", " ", "the", " ", "Borel", " ", 
    "resum"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   StyleBox[
    RowBox[{
     RowBox[{"FOR", " ", "THE", " ", 
      RowBox[{"PADE", "'"}], " ", "WE", " ", "NEED", " ", "THE", " ", "SUM", 
