Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\[Gamma]Function", "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "\[Gamma]Function", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{"\"\<print\>\"", "->", "False"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Gamma]Function", "[", 
   RowBox[{"observable_", ",", "bareCoupling_", ",", " ", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"U", ",", "gr", ",", "\[Gamma]f", ",", "nLoop", ",", "i"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"Clear", "[", 
       RowBox[{"g", ",", "g0", ",", "\[Mu]", ",", "\[Epsilon]"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"U", "=", "observable"}], ";", "\[IndentingNewLine]", 
      RowBox[{"gr", "=", "bareCoupling"}], ";", "\[IndentingNewLine]", 
      RowBox[{"nLoop", "=", 
       RowBox[{
        RowBox[{"Exponent", "[", 
         RowBox[{"gr", ",", "g0"}], "]"}], "-", "1"}]}], ";"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Print", "[", "nLoop", "]"}], "*)"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]f", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "\[Mu]"}], " ", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"Log", "[", "U", "]"}], ",", "\[Mu]"}], "]"}]}], "//", 
       "Expand"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"OptionValue", "[", 
        StyleBox["\"\<print\>\"",
         Background->RGBColor[0.9, 1, 1]], 
        StyleBox["]",
         Background->RGBColor[0.9, 1, 1]]}], 
       StyleBox[",",
        Background->RGBColor[0.9, 1, 1]], 
       StyleBox["\[IndentingNewLine]",
        Background->RGBColor[0.9, 1, 1]], 
       StyleBox[
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\< \[Gamma]f(\!\(\*SubscriptBox[StyleBox[\"g\",Background->\
RGBColor[0.9, 1, 1]], \"0\"]\))= \\n \>\"", ",", "\[Gamma]f"}], "]"}], ";"}],
        Background->RGBColor[0.9, 1, 1]]}], 
      StyleBox["]",
       Background->RGBColor[0.9, 1, 1]]}], ";", 
     StyleBox["\[IndentingNewLine]",
      Background->RGBColor[0.9, 1, 1]], "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"gr", "=", 
      RowBox[{"g", "-", "gr", "+", 
       RowBox[{"g0", " ", 
        SuperscriptBox["\[Mu]", 
         RowBox[{"-", "\[Epsilon]"}]]}]}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"OptionValue", "[", 
        StyleBox["\"\<print\>\"",
         Background->RGBColor[0.9, 1, 1]], 
        StyleBox["]",
         Background->RGBColor[0.9, 1, 1]]}], 
       StyleBox[",",
        Background->RGBColor[0.9, 1, 1]], 
       StyleBox["\[IndentingNewLine]",
        Background->RGBColor[0.9, 1, 1]], 
       StyleBox[
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"\"\< Bare coupling= \\n \>\"", ",", "gr"}], "]"}], ";"}],
        Background->RGBColor[0.9, 1, 1]]}], 
      StyleBox["]",
       Background->RGBColor[0.9, 1, 1]]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Gamma]f", "=", 
         RowBox[{
          RowBox[{"\[Gamma]f", "/.", 
           RowBox[{
            SuperscriptBox["g0", "n_"], " ", ":>", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"(", "gr", ")"}], "n"], 
             SuperscriptBox["\[Mu]", 
              RowBox[{"n", " ", "\[Epsilon]"}]]}]}]}], "//", "Expand"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"\[Gamma]f", "=", 
         RowBox[{
          RowBox[{"\[Gamma]f", "/.", 
           RowBox[{
            RowBox[{"(", "g0", " ", ")"}], ":>", 
            RowBox[{
             RowBox[{"(", "gr", ")"}], 
             SuperscriptBox["\[Mu]", "\[Epsilon]"]}]}]}], "//", "Expand"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"\[Gamma]f", "=", 
         RowBox[{"\[Gamma]f", "/.", 
          RowBox[{
           RowBox[{
            SuperscriptBox["g0", "n_"], "/;", 
            RowBox[{"n", ">", "nLoop"}]}], ":>", "0"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"\[Gamma]f", "=", 
         RowBox[{
          RowBox[{"\[Gamma]f", "/.", 
           RowBox[{
            RowBox[{
             SuperscriptBox["g0", "n_"], "/;", 
             RowBox[{"n", "==", "nLoop"}]}], ":>", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"g", " ", 
               SuperscriptBox["\[Mu]", "\[Epsilon]"]}], ")"}], "n"]}]}], "//",
           "Expand"}]}], ";"}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "nLoop"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", 
         RowBox[{"i", "<=", "nLoop"}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
