       StyleBox[",",
        Background->RGBColor[0.9, 1, 1]], 
       StyleBox["\[IndentingNewLine]",
        Background->RGBColor[0.9, 1, 1]], 
       StyleBox[
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<Initial effective couling:\\n \>\"", ",", "gr", ",", 
           "\"\<\\n\>\""}], "]"}], ";"}],
        Background->RGBColor[0.9, 1, 1]]}], 
      StyleBox["]",
       Background->RGBColor[0.9, 1, 1]]}], 
