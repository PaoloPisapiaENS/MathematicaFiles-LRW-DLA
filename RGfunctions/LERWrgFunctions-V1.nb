Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\[Beta]Function", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Beta]Function", "[", "coupling_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"gr", ",", "\[Beta]f", ",", "nLoop", ",", "i"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"Clear", "[", 
       RowBox[{"g", ",", "g0", ",", "\[Mu]", ",", "\[Epsilon]"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"gr", "=", "coupling"}], ";", "\[IndentingNewLine]", 
      RowBox[{"nLoop", "=", 
       RowBox[{"Exponent", "[", 
        RowBox[{"gr", ",", "g0"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Print", "[", "nLoop", "]"}], "*)"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Beta]f", "=", 
      RowBox[{
       RowBox[{"\[Mu]", " ", 
        RowBox[{"D", "[", 
         RowBox[{"gr", ",", "\[Mu]"}], "]"}]}], "//", "Expand"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Print", "[", "\[Beta]f", "]"}], ";"}], "*)"}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"gr", "=", 
      RowBox[{"g", "-", "gr", "+", 
       RowBox[{"g0", " ", 
        SuperscriptBox["\[Mu]", "\[Epsilon]"]}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Beta]f", "=", 
         RowBox[{
          RowBox[{"\[Beta]f", "/.", 
           RowBox[{
            RowBox[{
             SuperscriptBox["g0", "n_"], " ", 
             SuperscriptBox["\[Mu]", 
              RowBox[{"n_", " ", "\[Epsilon]"}]]}], ":>", 
            SuperscriptBox[
             RowBox[{"(", "gr", ")"}], "n"]}]}], "//", "Expand"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"\[Beta]f", "=", 
         RowBox[{
          RowBox[{"\[Beta]f", "/.", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"g0", " ", 
              SuperscriptBox["\[Mu]", "\[Epsilon]"]}], ")"}], ":>", 
            RowBox[{"(", "gr", ")"}]}]}], "//", "Expand"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"\[Beta]f", "=", 
         RowBox[{"\[Beta]f", "/.", 
          RowBox[{
           RowBox[{
            SuperscriptBox["g0", "n_"], "/;", 
            RowBox[{"n", ">", "nLoop"}]}], ":>", "0"}]}]}], ";"}], 
       "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "nLoop"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", 
         RowBox[{"i", "<=", "nLoop"}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\[Beta]f", "=", 
           RowBox[{
            RowBox[{"\[Beta]f", "/.", 
             RowBox[{
              RowBox[{
               SuperscriptBox["g0", "n_"], " ", 
               SuperscriptBox["\[Mu]", 
                RowBox[{"n_", " ", "\[Epsilon]"}]]}], ":>", 
              SuperscriptBox[
               RowBox[{"(", "gr", ")"}], "n"]}]}], "//", "Expand"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"\[Beta]f", "=", 
           RowBox[{
            RowBox[{"\[Beta]f", "/.", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"g0", " ", 
                SuperscriptBox["\[Mu]", "\[Epsilon]"]}], ")"}], ":>", 
              RowBox[{"(", "gr", ")"}]}]}], "//", "Expand"}]}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Beta]f", "=", 
      RowBox[{
       RowBox[{"\[Beta]f", "/.", 
        RowBox[{
         RowBox[{
          SuperscriptBox["g0", "n_"], " ", 
          SuperscriptBox["\[Mu]", 
           RowBox[{"n_", " ", "\[Epsilon]"}]]}], ":>", 
         SuperscriptBox[
          RowBox[{"(", "g", ")"}], "n"]}]}], "//", "Expand"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Beta]f", "=", 
      RowBox[{
       RowBox[{"\[Beta]f", "/.", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"g0", " ", 
           SuperscriptBox["\[Mu]", "\[Epsilon]"]}], ")"}], ":>", 
         RowBox[{"(", "g", ")"}]}]}], "//", "Expand"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Beta]f", "=", 
      RowBox[{
       RowBox[{"Series", "[", 
        RowBox[{"\[Beta]f", ",", 
         RowBox[{"{", 
          RowBox[{"g", ",", "0", ",", "nLoop"}], "}"}]}], "]"}], "//", 
       "Expand"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      StyleBox[
       RowBox[{
        RowBox[{"Print", "[", "\[Beta]f", "]"}], ";"}],
       FontSize->12], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"\[Beta]f", "=", 
        RowBox[{"Normal", "[", "\[Beta]f", "]"}]}], ";"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "\[Beta]f", "]"}]}]}], "]"}]}]}], "Input",
