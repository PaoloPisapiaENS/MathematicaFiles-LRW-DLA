         FractionBox[
          RowBox[{"2", " ", 
           SuperscriptBox["a", "2"]}], "9"], "-", 
         FractionBox["Bu", "2"]}]}]}], ")"}]}], "/.", 
    RowBox[{"g", "->", "gc2"}]}], "//", "Expand"}], 
