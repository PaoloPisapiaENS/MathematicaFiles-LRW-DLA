      RowBox[{
       RowBox[{"Series", "[", 
        RowBox[{"\[Gamma]f", ",", 
         RowBox[{"{", 
          RowBox[{"g", ",", "0", ",", "nLoop"}], "}"}]}], "]"}], "//", 
       "Expand"}]}], ";", "\[IndentingNewLine]", 
