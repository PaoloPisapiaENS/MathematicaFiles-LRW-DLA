   RowBox[{"ClearAll", "[", "\[Gamma]Function", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Gamma]Function", "[", 
   RowBox[{"observable_", ",", "coupling_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"U", ",", "gr", ",", "\[Gamma]f", ",", "nLoop", ",", "i"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"Clear", "[", 
       RowBox[{"g", ",", "g0", ",", "\[Mu]", ",", "\[Epsilon]"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"U", "=", "observable"}], ";", "\[IndentingNewLine]", 
      RowBox[{"gr", "=", "coupling"}], ";", "\[IndentingNewLine]", 
      RowBox[{"nLoop", "=", 
       RowBox[{
        RowBox[{"Exponent", "[", 
         RowBox[{"gr", ",", "g0"}], "]"}], "-", "1"}]}], ";"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Print", "[", "nLoop", "]"}], "*)"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]f", "=", 
      RowBox[{
       RowBox[{"\[Mu]", " ", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"Log", "[", "U", "]"}], ",", "\[Mu]"}], "]"}]}], "//", 
       "Expand"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Print", "[", "\[Gamma]f", "]"}], ";"}], "*)"}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"gr", "=", 
      RowBox[{"g", "-", "gr", "+", 
       RowBox[{"g0", " ", 
        SuperscriptBox["\[Mu]", "\[Epsilon]"]}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Gamma]f", "=", 
         RowBox[{
          RowBox[{"\[Gamma]f", "/.", 
           RowBox[{
            RowBox[{
             SuperscriptBox["g0", "n_"], " ", 
             SuperscriptBox["\[Mu]", 
              RowBox[{"n_", " ", "\[Epsilon]"}]]}], ":>", 
            SuperscriptBox[
             RowBox[{"(", "gr", ")"}], "n"]}]}], "//", "Expand"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"\[Gamma]f", "=", 
         RowBox[{
          RowBox[{"\[Gamma]f", "/.", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"g0", " ", 
              SuperscriptBox["\[Mu]", "\[Epsilon]"]}], ")"}], ":>", 
            RowBox[{"(", "gr", ")"}]}]}], "//", "Expand"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"\[Gamma]f", "=", 
         RowBox[{"\[Gamma]f", "/.", 
          RowBox[{
           RowBox[{
            SuperscriptBox["g0", "n_"], "/;", 
            RowBox[{"n", ">", "nLoop"}]}], ":>", "0"}]}]}], ";"}], 
       "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "nLoop"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", 
         RowBox[{"i", "<=", "nLoop"}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\[Gamma]f", "=", 
           RowBox[{
            RowBox[{"\[Gamma]f", "/.", 
             RowBox[{
              RowBox[{
               SuperscriptBox["g0", "n_"], " ", 
               SuperscriptBox["\[Mu]", 
                RowBox[{"n_", " ", "\[Epsilon]"}]]}], ":>", 
              SuperscriptBox[
               RowBox[{"(", "gr", ")"}], "n"]}]}], "//", "Expand"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"\[Gamma]f", "=", 
           RowBox[{
            RowBox[{"\[Gamma]f", "/.", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"g0", " ", 
                SuperscriptBox["\[Mu]", "\[Epsilon]"]}], ")"}], ":>", 
              RowBox[{"(", "gr", ")"}]}]}], "//", "Expand"}]}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]f", "=", 
      RowBox[{
