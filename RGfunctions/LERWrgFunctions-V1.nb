Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"au", "\[Rule]", 
     FractionBox["a", "3"]}], ",", 
    RowBox[{"Ag", "\[Rule]", 
     RowBox[{
      FractionBox["1", "6"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"4", " ", 
         SuperscriptBox["a", "2"]}], "-", 
        RowBox[{"9", " ", "Bu"}]}], ")"}]}]}], ",", 
    RowBox[{"Bg", "\[Rule]", 
     RowBox[{
      FractionBox[
       RowBox[{"2", " ", 
        SuperscriptBox["a", "2"]}], "3"], "+", 
      RowBox[{"3", " ", "Bu"}]}]}], ",", 
    RowBox[{"Au", "\[Rule]", 
     RowBox[{
      FractionBox[
       RowBox[{"2", " ", 
        SuperscriptBox["a", "2"]}], "9"], "-", 
      FractionBox["Bu", "2"]}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{{3.9608878175584087`*^9, 3.9608878364981823`*^9}, 
   3.960887958329878*^9, {3.960888159003065*^9, 3.9608882004184666`*^9}, 
   3.9608883099690456`*^9, 3.9608887839070873`*^9},
 CellLabel->
  "Out[485]=",ExpressionUUID->"86190137-a497-ce4e-803f-a8cc7efd7a15"]
}, Open  ]],

Cell[TextData[{
 "If we assume that they are all integers, then  ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "510d8ffe-4d27-cb40-a097-e020eb5f9510"],
 " must be a multiple of 3 and Bu of 2"
}], "Text",
 CellChangeTimes->{{3.960888265622814*^9, 3.9608882987084217`*^9}, {
  3.9608883408724422`*^9, 
  3.9608883524844646`*^9}},ExpressionUUID->"6bc1ca4c-b230-b547-9728-\
09da3125cb2a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sol", "/.", 
    RowBox[{"a", "->", 
     RowBox[{"3", " ", "b"}]}]}], " ", "/.", 
   RowBox[{"Bu", "->", 
    RowBox[{"2", " ", "bu"}]}]}], "//", "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.96088831165205*^9, 3.9608883589480114`*^9}},
 CellLabel->
  "In[482]:=",ExpressionUUID->"f915c7e3-1642-6d40-9559-8543ed707427"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Ag", "\[Rule]", 
     RowBox[{
      RowBox[{"6", " ", 
       SuperscriptBox["b", "2"]}], "-", 
      RowBox[{"3", " ", "bu"}]}]}], ",", 
    RowBox[{"Bg", "\[Rule]", 
     RowBox[{"6", " ", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["b", "2"], "+", "bu"}], ")"}]}]}], ",", 
    RowBox[{"Au", "\[Rule]", 
     RowBox[{
      RowBox[{"2", " ", 
       SuperscriptBox["b", "2"]}], "-", "bu"}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{{3.9608883195986347`*^9, 3.9608883259650097`*^9}, 
   3.960888359913389*^9},
 CellLabel->
  "Out[482]=",ExpressionUUID->"250baed2-872c-0244-979c-025762f2c5d1"]
}, Open  ]],

Cell["Then, if they have to be positive, we must have", "Text",
 CellChangeTimes->{{3.9608884013125305`*^9, 
  3.960888414589775*^9}},ExpressionUUID->"7a9cadc3-8d96-e240-83d7-\
058afbe70b3b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"2", " ", 
    SuperscriptBox["b", "2"]}], "-", "bu"}], ">", "0"}]], "Input",
 CellChangeTimes->{{3.9608884190204887`*^9, 3.9608884192374706`*^9}},
 Background->RGBColor[1, 1, 0.85],
 CellLabel->
  "In[483]:=",ExpressionUUID->"a838bee8-5aa9-4141-ba00-1a42dba700f5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"2", " ", 
    SuperscriptBox["b", "2"]}], "-", "bu"}], ">", "0"}]], "Output",
 CellChangeTimes->{3.960888427233713*^9},
 CellLabel->
  "Out[483]=",ExpressionUUID->"b037f8c1-a635-0345-be4a-d08911b5228f"]
}, Open  ]],

Cell[TextData[{
 "In our case, it is very likely that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"a", "=", "3"}], ",", " ", 
    RowBox[{
     RowBox[{"hence", " ", "b"}], "=", "1"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8198c0f4-3f92-0941-a730-363931378818"]
}], "Text",
 CellChangeTimes->{{3.960888462667454*^9, 
  3.960888500484482*^9}},ExpressionUUID->"1bc32171-8c42-904b-9546-\
2ac1b55bb7cb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"2", " ", 
     SuperscriptBox["b", "2"]}], "-", "bu"}], ">", "0"}], "/.", 
  RowBox[{"b", "->", "1"}]}]], "Input",
 CellChangeTimes->{{3.9608884927047176`*^9, 3.960888495253351*^9}},
 CellLabel->
  "In[484]:=",ExpressionUUID->"2054f3d9-11d9-774f-bd34-a2942d010918"],

Cell[BoxData[
 RowBox[{
  RowBox[{"2", "-", "bu"}], ">", "0"}]], "Output",
 CellChangeTimes->{3.96088849578529*^9},
 CellLabel->
  "Out[484]=",ExpressionUUID->"21afb6af-6a04-ba47-9283-27a2681492f3"]
}, Open  ]],

Cell["From which follows", "Text",
 CellChangeTimes->{{3.960888533787079*^9, 
  3.960888538135208*^9}},ExpressionUUID->"c57b7b0f-0f96-7949-ad69-\
fb0f78f28fe0"],

Cell[BoxData[{
 RowBox[{"bu", "<", "2"}], "\[IndentingNewLine]", 
 RowBox[{"Bu", "<", 
  RowBox[{"2", " ", "bu"}], " ", "<", " ", "4"}]}], "Input",
 CellChangeTimes->{{3.9608885421321735`*^9, 
  3.9608885616399956`*^9}},ExpressionUUID->"b3d17802-d12d-a34f-89f0-\
9a77b2bfc80c"]
}, Open  ]]
}, Open  ]]
},
