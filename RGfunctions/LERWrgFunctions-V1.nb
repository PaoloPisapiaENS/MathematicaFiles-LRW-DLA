Cell[CellGroupData[{

Cell["\<\
System of equations for the number of bananas, doubleBananas, and hats\
\>", "Section",
 CellChangeTimes->{{3.960887656614748*^9, 
  3.96088767778541*^9}},ExpressionUUID->"3cbd2d05-006b-434f-bf6b-\
5adb61345045"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sol", "=", 
  RowBox[{
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{"Flatten", "@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"au", "==", 
          FractionBox["a", "3"]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"Ag", "==", 
          RowBox[{
           SuperscriptBox["a", "2"], "-", 
           FractionBox["Bg", "2"]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"Au", "==", 
          RowBox[{
           FractionBox[
            RowBox[{"2", " ", 
             SuperscriptBox["a", "2"]}], "9"], "-", 
           FractionBox["Bu", "2"]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"Bg", "==", 
          RowBox[{
           FractionBox[
            RowBox[{"2", " ", 
             SuperscriptBox["a", "2"]}], "3"], "+", 
           RowBox[{"3", " ", "Bu"}]}]}], "}"}]}], "\[IndentingNewLine]", 
       "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"au", ",", "Ag", ",", "Bg", ",", "Au"}], "}"}]}], "]"}], "//", 
   "FullSimplify"}]}]], "Input",
