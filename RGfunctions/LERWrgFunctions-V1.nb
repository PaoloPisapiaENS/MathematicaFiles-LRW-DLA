          SuperscriptBox["g0", "n_"], " ", 
          SuperscriptBox["\[Mu]", 
           RowBox[{"n_", " ", "\[Epsilon]"}]]}], ":>", 
         SuperscriptBox[
          RowBox[{"(", "g", ")"}], "n"]}]}], "//", "Expand"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]f", "=", 
      RowBox[{
       RowBox[{"\[Gamma]f", "/.", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"g0", " ", 
           SuperscriptBox["\[Mu]", "\[Epsilon]"]}], ")"}], ":>", 
         RowBox[{"(", "g", ")"}]}]}], "//", "Expand"}]}], ";", 
