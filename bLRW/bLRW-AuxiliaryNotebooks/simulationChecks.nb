Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "bLaplacianRW", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "bLaplacianRW", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<draw\>\"", "->", "False"}], ",", 
      RowBox[{"\"\<print\>\"", "->", "TTrue"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bLaplacianRW", "[", 
    RowBox[{"graph_", ",", "path__", ",", 
     RowBox[{"OptionsPattern", "[", "]"}], ",", 
     RowBox[{"b_", ":", "1"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "locSource", ",", "locRoot", ",", "locWeights", ",", "locVertices", ",",
        "denominator", ",", "tempProb", ",", 
       RowBox[{"prob", "=", "1"}]}], "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"locWeights", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"WeightedAdjacencyMatrix", "[", "graph", "]"}], "/.", 
         RowBox[{
          RowBox[{"\[Beta]", "[", "__", "]"}], "->", "1"}]}], "//", 
        "Normal"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"locVertices", "=", 
       RowBox[{"VertexList", "@", "graph"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Print", "[", "locVertices", "]"}], ";"}], "*)"}], 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"locRoot", " ", "=", " ", "\[IndentingNewLine]", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"List", "@@@", 
              RowBox[{"PropertyValue", "[", 
               RowBox[{"graph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
            RowBox[{"[", 
             RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"StringMatchQ", "[", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", 
              RowBox[{"___", "~~", "\"\<ROOT\>\""}]}], "]"}], "&"}]}], "]"}], 
         "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"locSource", " ", "=", " ", "\[IndentingNewLine]", " ", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"graph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<SOURCE\>\""}]}], "]"}], "&"}]}], "]"}],
         "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"locRoot", " ", "=!=", " ", 
         RowBox[{"path", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", " ", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"Style", "[", 
           RowBox[{"\"\<####  WRONG ROOT  ####\>\"", ",", 
            TemplateBox[<|"color" -> RGBColor[1, 0, 0]|>,
             "RGBColorSwatchTemplate"]}], "]"}], "]"}], ";", " ", 
         RowBox[{"Return", "[", "NULL", "]"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"MemberQ", "[", 
          RowBox[{"locSource", ",", 
           RowBox[{"path", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "2"}], "]"}], "]"}]}], "]"}]}], ",", 
        " ", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"Style", "[", 
           RowBox[{"\"\<####  WRONG SOURCE  ####\>\"", ",", 
            TemplateBox[<|"color" -> RGBColor[1, 0, 0]|>,
             "RGBColorSwatchTemplate"]}], "]"}], "]"}], ";", 
         RowBox[{"Return", "[", "NULL", "]"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"locBC", "=", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", "}"}], ",", 
             RowBox[{"{", "}"}]}], "}"}]}], ",", "i", ",", "\[Phi]sol"}], 
         "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Head", "[", "locSource", "]"}], "==", "List"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "1"}], ",", 
             RowBox[{"i", "<=", 
              RowBox[{"Length", "[", "locSource", "]"}]}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{
                RowBox[{"locBC", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{
                 RowBox[{"\[CapitalPhi]", "[", 
                  RowBox[{"locSource", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "]"}], "==", " ", "1"}]}], 
               "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"AppendTo", "[", 
               RowBox[{
                RowBox[{"locBC", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], ",", 
                RowBox[{"locSource", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", ",", 
           RowBox[{"(*", "FALSE", "*)"}], "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"AppendTo", "[", 
             RowBox[{
              RowBox[{"locBC", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{"\[CapitalPhi]", "[", "locSource", "]"}], "==", " ", 
               "1"}]}], "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{
              RowBox[{"locBC", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", "locSource"}], "]"}], 
            ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"i", "=", "1"}], ",", 
           RowBox[{"i", "<=", 
            RowBox[{"Length", "[", "path", "]"}]}], ",", 
           RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"AppendTo", "[", 
             RowBox[{
              RowBox[{"locBC", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{"\[CapitalPhi]", "[", 
                RowBox[{"path", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "==", "0"}]}],
              "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{
              RowBox[{"locBC", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", 
              RowBox[{"path", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "1"}], "]"}], "]"}]}], "]"}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{"\"\<locBC=\>\"", ",", "locBC"}], "]"}], ";"}], "*)"}],
             "\[IndentingNewLine]", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"\[Phi]sol", "=", 
             RowBox[{"LaplaceEqSolver", "[", 
              RowBox[{"graph", ",", 
               RowBox[{"\"\<BC\>\"", "->", "locBC"}]}], 
              RowBox[{"(*", 
               RowBox[{",", "\[Phi]"}], "*)"}], "]"}]}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"Print", "[", "\[Phi]sol", "]"}], ";"}], "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{
              "Return", "[", "\"\<good up to LaplaceEqSolver\>\"", "]"}], 
              ";"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"denominator", "=", 
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"locWeights", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", "y"}], "]"}], 
                 "]"}], "*", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Select", "[", 
                    RowBox[{"\[Phi]sol", ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "==", 
                    RowBox[{"\[CapitalPhi]", "[", "y", "]"}]}], " ", "&"}]}], 
                    "]"}], "[", 
                   RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], ")"}], "^", 
                 "b"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"y", ",", 
                 RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], 
              "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"Print", "[", "denominator", "]"}], ";"}], "*)"}], 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"tempProb", "=", 
             RowBox[{
              FractionBox[
               RowBox[{
                RowBox[{"locWeights", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
                   RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}], 
                "*", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Select", "[", 
                    RowBox[{"\[Phi]sol", ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "==", 
                    RowBox[{"\[CapitalPhi]", "[", 
                    RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}], "]"}]}], " ", 
                    "&"}]}], "]"}], "[", 
                   RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], ")"}], "^", 
                 "b"}]}], "denominator"], "//", "FullSimplify"}]}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"OptionValue", "[", "\"\<print\>\"", "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Print", "[", 
                RowBox[{"\"\<#####  Transition probability \>\"", "<>", 
                 RowBox[{"ToString", "[", 
                  RowBox[{"path", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "<>", 
                 "\"\< to \>\"", "<>", 
                 RowBox[{"ToString", "[", 
                  RowBox[{"path", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}], "]"}], "<>", 
                 "\"\<  #####\>\""}], "]"}], ";", "\[IndentingNewLine]", 
               RowBox[{"Print", "[", "tempProb", "]"}], ";"}]}], 
             "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", 
            RowBox[{"prob", "*=", "tempProb"}], ";", "\[IndentingNewLine]", 
            RowBox[{"Clear", "[", "\[Phi]sol", "]"}], ";"}]}], 
          "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"OptionValue", "[", "\"\<draw\>\"", "]"}], ",", 
          RowBox[{"Print", "[", 
           RowBox[{"DrawOnGraph", "[", 
            RowBox[{"graph", ",", "path"}], "]"}], "]"}]}], "]"}], ";"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Return", "[", "prob", "]"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"bLaplacianRW", "[", 
      RowBox[{"graph_", ",", "path__", ",", 
       RowBox[{"options", ":", 
        RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
     RowBox[{"bLaplacianRW", "[", 
      RowBox[{"graph", ",", "path", ",", "options", ",", "1"}], "]"}]}], 
    ";"}], "*)"}]}]}], "Input",
