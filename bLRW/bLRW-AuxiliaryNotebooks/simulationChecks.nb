Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"symmetryResults", "=", 
   RowBox[{"IterativeSymmetricTally", "[", "paths", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Graphics", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Thick", ",", 
        RowBox[{"Line", "[", 
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
          TemplateBox[<|"color" -> RGBColor[1, 0, 0]|>,
           "RGBColorSwatchTemplate"], ",", 
          RowBox[{"Circle", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
