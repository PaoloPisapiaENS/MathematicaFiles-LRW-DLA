Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "AnalyzeSymmetricPaths", "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Comparison", " ", 
    RowBox[{"test", ":", 
     RowBox[{
     "Returns", " ", "True", " ", "if", " ", "path2", " ", "is", " ", "a", 
      " ", "valid", " ", "symmetry", " ", "transformation", " ", "of", " ", 
      "path1"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"AreSymmetricQ", "[", 
     RowBox[{"path1_", ",", "path2_"}], "]"}], ":=", 
    RowBox[{"MemberQ", "[", 
     RowBox[{
      RowBox[{"GetSymmetryFamily", "[", "path1", "]"}], ",", "path2"}], 
     "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "The", " ", "master", " ", "function", " ", "to", " ", "process", " ", 
    "your", " ", "paths", " ", "array"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"AnalyzeSymmetricPaths", "[", "allPaths_List", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"grouped", ",", "tally"}], "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{"Group", " ", "identical", " ", "paths", " ", "under", " ", 
       RowBox[{"rotation", "/", "reflection"}]}], "*)"}], 
     RowBox[{
      RowBox[{"grouped", "=", 
       RowBox[{"Gather", "[", 
        RowBox[{"allPaths", ",", "AreSymmetricQ"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Return", " ", "a", " ", "structured", " ", 
        RowBox[{"dataset", ":", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Unique", " ", "Representative", " ", "Path"}], ",", 
           RowBox[{"Family", " ", "Occurrence", " ", "Count"}]}], "}"}]}]}], 
       "*)"}], 
      RowBox[{"tally", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"First", "[", "g", "]"}], ",", 
           RowBox[{"Length", "[", "g", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"g", ",", "grouped"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Reverse", "[", 
       RowBox[{"SortBy", "[", 
        RowBox[{"tally", ",", "Last"}], "]"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
