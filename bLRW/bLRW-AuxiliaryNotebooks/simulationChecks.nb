        RowBox[{"Print", "[", "\"\<####  WRONG ROOT  ####\>\"", "]"}], ";", 
        " ", 
        RowBox[{"Return", "[", "NULL", "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"locSource", " ", "=!=", " ", 
