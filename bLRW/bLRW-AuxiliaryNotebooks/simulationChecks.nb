Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"Rotate90", ",", "ReflectX", ",", "GetSymmetryFamily"}], "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Rotates", " ", "90", "\[Degree]", " ", "counter"}], "-", 
    RowBox[{
    "clockwise", " ", "around", " ", "the", " ", "first", " ", "point", " ", 
     "of", " ", "the", " ", "path"}]}], "*)"}], 
  RowBox[{
   RowBox[{"Rotate90", "[", "path_", "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"center", "=", 
       RowBox[{"path", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "-", 
               RowBox[{"center", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], ")"}]}], "+", 
            RowBox[{"center", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "-", 
              RowBox[{"center", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "+", 
            RowBox[{"center", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ")"}], "&"}], ",", 
       "path"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Reflects", " ", "horizontally", " ", "across", " ", "the", " ", 
    "vertical", " ", "line", " ", "passing", " ", "through", " ", "the", " ", 
    "first", " ", "point", " ", 
    RowBox[{"(", 
     RowBox[{"x", "->", 
      RowBox[{"-", "x"}]}], ")"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ReflectX", "[", "path_", "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"center", "=", 
       RowBox[{"path", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "-", 
               RowBox[{"center", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}], "+", 
            RowBox[{"center", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ",", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ")"}], "&"}], ",", 
       "path"}], "]"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Generates", " ", "all", " ", "8", " ", "unique", " ", "rotation", " ", 
    "and", " ", "reflection", " ", "variants", " ", "of", " ", "a", " ", 
    "path"}], "*)"}], 
  RowBox[{
