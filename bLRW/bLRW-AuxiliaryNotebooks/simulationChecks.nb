Cell[CellGroupData[{

Cell["Computes the probability of a given bLaplacian RW", "Item",
 CellChangeTimes->{{3.946455377142837*^9, 3.946455386291591*^9}, {
  3.946977591066313*^9, 3.9469776060515404`*^9}, {3.991799363575455*^9, 
  3.9917993638239136`*^9}},ExpressionUUID->"b92acf31-deeb-9c48-a822-\
a706992c50b9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "bLaplacianRWlogBC", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "bLaplacianRWlogBC", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<draw\>\"", "->", "False"}], ",", 
      RowBox[{"\"\<print\>\"", "->", "tTrue"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bLaplacianRWlogBC", "[", 
    RowBox[{"graph_", ",", "path__", ",", 
     RowBox[{"OptionsPattern", "[", "]"}], ",", 
     RowBox[{"b_", ":", "1"}], ",", 
     RowBox[{"n_", ":", "n"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "locSource", ",", "locRoot", ",", "locWeights", ",", "locVertices", ",",
        "\[IndentingNewLine]", "locIndices", ",", "denominator", ",", 
       "tempProb", ",", 
       RowBox[{"prob", "=", "1"}]}], "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"locWeights", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"WeightedAdjacencyMatrix", "[", "graph", "]"}], "/.", 
         RowBox[{
          RowBox[{"\[Beta]", "[", "__", "]"}], "->", "1"}]}], "//", 
        "Normal"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"locVertices", "=", 
       RowBox[{"VertexList", "@", "graph"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"locIndices", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"i", ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Print", "[", "locVertices", "]"}], ";"}], "*)"}], 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"locRoot", " ", "=", " ", "\[IndentingNewLine]", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"List", "@@@", 
              RowBox[{"PropertyValue", "[", 
               RowBox[{"graph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
            RowBox[{"[", 
             RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"StringMatchQ", "[", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", 
              RowBox[{"___", "~~", "\"\<ROOT\>\""}]}], "]"}], "&"}]}], "]"}], 
         "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"locSource", " ", "=", " ", "\[IndentingNewLine]", " ", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"graph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<SOURCE\>\""}]}], "]"}], "&"}]}], "]"}],
         "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"locRoot", " ", "=!=", " ", 
         RowBox[{"path", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", " ", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"Style", "[", 
           RowBox[{"\"\<####  WRONG ROOT  ####\>\"", ",", 
            TemplateBox[<|"color" -> RGBColor[1, 0, 0]|>,
             "RGBColorSwatchTemplate"]}], "]"}], "]"}], ";", " ", 
         RowBox[{"Return", "[", "NULL", "]"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"MemberQ", "[", 
          RowBox[{"locSource", ",", 
           RowBox[{"path", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "2"}], "]"}], "]"}]}], "]"}]}], ",", 
        " ", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"Style", "[", 
           RowBox[{"\"\<####  WRONG SOURCE  ####\>\"", ",", 
            TemplateBox[<|"color" -> RGBColor[1, 0, 0]|>,
             "RGBColorSwatchTemplate"]}], "]"}], "]"}], ";", 
         RowBox[{"Return", "[", "NULL", "]"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"locBC", "=", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", "}"}], ",", 
             RowBox[{"{", "}"}]}], "}"}]}], ",", "i", ",", "\[Phi]sol"}], 
         "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Head", "[", "locSource", "]"}], "==", "List"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "1"}], ",", 
             RowBox[{"i", "<=", 
              RowBox[{"Length", "[", "locSource", "]"}]}], ",", 
             RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{
                RowBox[{"locBC", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{
                 RowBox[{"\[CapitalPhi]", "[", 
                  RowBox[{"locSource", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "]"}], "==", " ", 
                 RowBox[{"With", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"x", "=", 
                    RowBox[{
                    RowBox[{"Floor", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"locSource", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "-", "1"}], ")"}], "/", 
                    "n"}], "]"}], "-", 
                    RowBox[{"Floor", "[", 
                    RowBox[{"n", "/", "2"}], "]"}]}]}], ",", 
                    RowBox[{"y", "=", 
                    RowBox[{
                    RowBox[{"Mod", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"locSource", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "-", "1"}], ")"}], ",", 
                    "n"}], "]"}], " ", "-", 
                    RowBox[{"(", 
                    RowBox[{"Floor", "[", 
                    RowBox[{"n", "/", "2"}], "]"}], ")"}]}]}]}], "}"}], ",", 
                   "\[IndentingNewLine]", 
