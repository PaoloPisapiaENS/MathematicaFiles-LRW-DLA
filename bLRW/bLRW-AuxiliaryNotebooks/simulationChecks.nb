         RowBox[{"(*", 
          RowBox[{"Print", "[", "\[Phi]sol", "]"}], "*)"}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"denominator", "=", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"locWeights", "[", 
