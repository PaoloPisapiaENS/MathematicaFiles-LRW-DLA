Cell[BoxData[
 RowBox[{
  RowBox[{"SplitListInHalf", "[", "expr_List", "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"expr", "[", 
     RowBox[{"[", 
      RowBox[{"1", ";;", 
