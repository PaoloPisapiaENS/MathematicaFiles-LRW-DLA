         RowBox[{"graph", ",", "path"}], "]"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "prob", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
