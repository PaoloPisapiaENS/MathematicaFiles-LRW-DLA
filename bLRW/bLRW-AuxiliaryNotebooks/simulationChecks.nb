Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "3.", " ", "Generate", " ", "the", " ", "BarChart", " ", "with", " ", 
    "values", " ", "on", " ", "top", " ", "and", " ", "unique", " ", 
    "symmetry", " ", "families", " ", "on", " ", "the", " ", "bottom"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"BarChart", "[", 
   RowBox[{
    RowBox[{"symmetricProbabilities", "[", 
     RowBox[{"[", 
      RowBox[{"1", ";;", "15"}], "]"}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"ChartLabels", "->", 
     RowBox[{"Placed", "[", 
      RowBox[{"symmetricPathLabels", ",", "Axis"}], "]"}]}], ",", 
    RowBox[{"LabelingFunction", "->", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Placed", "[", 
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{"100.", "*", "#1"}], ",", 
              RowBox[{"{", 
               RowBox[{"5", ",", "2"}], "}"}]}], "]"}], ",", "\"\<%\>\""}], 
           "}"}], "]"}], ",", "Above"}], "]"}], "&"}], ")"}]}], ",", 
    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{
      "\"\<Unique Paths (Symmetry Families Included)\>\"", ",", 
       "\"\<Relative Occurrence (Probability)\>\""}], "}"}]}], ",", 
    RowBox[{"PlotLabel", "->", "\"\<Symmetric Path Distribution\>\""}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"ChartStyle", "->", 
     TemplateBox[<|"color" -> RGBColor[0.87, 0.71, 0.34]|>,
      "RGBColorSwatchTemplate"]}], ",", 
    RowBox[{"ImageSize", "->", "900"}], ",", 
    RowBox[{"PlotRange", "->", 
     RowBox[{"{", 
      RowBox[{"All", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{
          RowBox[{"Max", "[", "symmetricProbabilities", "]"}], "*", 
          "1.15"}]}], "}"}]}], "}"}]}]}], "]"}]}]], "Input",
