      RowBox[{"\"\<draw\>\"", "->", "False"}], ",", 
      RowBox[{"\"\<print\>\"", "->", "False"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AllLaplacianRWs", "[", 
   RowBox[{"graph_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"possibleLRW", ",", "i", ",", 
      RowBox[{"probabilityLRW", "=", 
       RowBox[{"{", "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"possibleLRW", "=", 
      RowBox[{"PathFinder", "[", "graph", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", " ", 
       RowBox[{"i", "<=", " ", 
        RowBox[{"Length", "[", "possibleLRW", "]"}]}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"probabilityLRW", ",", 
          RowBox[{"LaplacianRW", "[", 
           RowBox[{"graph", ",", 
            RowBox[{"possibleLRW", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", 
            RowBox[{"OptionValue", "[", "\"\<draw\>\"", "]"}]}], "]"}]}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"OptionValue", "[", "\"\<print\>\"", "]"}], ",", 
          RowBox[{"Print", "[", 
           RowBox[{"i", ",", "\"\<) Laplacian RW \>\"", ",", 
            RowBox[{"possibleLRW", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", 
            "\"\< with probability \>\"", " ", ",", 
            RowBox[{"probabilityLRW", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "\[IndentingNewLine]",
          "]"}]}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{"{", 
       RowBox[{"possibleLRW", ",", "probabilityLRW"}], "}"}], "]"}]}]}], 
