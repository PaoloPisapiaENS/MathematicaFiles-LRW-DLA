               RowBox[{"Print", "[", "tempProb", "]"}], ";"}]}], 
             "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", 
            RowBox[{"prob", "*=", "tempProb"}], ";", "\[IndentingNewLine]", 
            RowBox[{"Clear", "[", "\[Phi]sol", "]"}], ";"}]}], 
          "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"OptionValue", "[", "\"\<draw\>\"", "]"}], ",", 
