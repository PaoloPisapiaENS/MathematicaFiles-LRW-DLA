Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"1.", " ", "Calculate", " ", "relative", " ", "frequencies", " ", 
    RowBox[{"(", "\"\<probabilities\>\"", ")"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"totalPaths", "=", 
     RowBox[{"Length", "[", "paths", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"countsOnly", "=", 
     RowBox[{"pathCounts", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"probabilities", "=", 
     RowBox[{"countsOnly", "/", "totalPaths"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "Convert", " ", "each", " ", "path", " ", 
     RowBox[{"(", 
