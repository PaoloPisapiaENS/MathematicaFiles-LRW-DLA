Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"1.", " ", "Calculate", " ", "relative", " ", "frequencies", " ", 
    RowBox[{"(", "\"\<probabilities\>\"", ")"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"totalPaths", "=", 
     RowBox[{"Length", "[", "paths", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"probabilities", "=", 
     RowBox[{"countsOnly", "/", "totalPaths"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "Convert", " ", "each", " ", "path", " ", 
     RowBox[{"(", 
      RowBox[{"series", " ", "of", " ", "points"}], ")"}], " ", "into", " ", 
     "a", " ", "clean", " ", "text", " ", "label"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Shortens", " ", "coordinates", " ", "to", " ", "strings", " ", "like", 
     " ", "\"\<{(0,1),(1,2)}\>\""}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pathLabels", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Row", "[", 
         RowBox[{
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"RowBox", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<{\>\"", ",", 
                RowBox[{"Row", "[", 
                 RowBox[{"#", ",", "\"\<,\>\""}], "]"}], ",", "\"\<}\>\""}], 
               "}"}], "]"}], "//", 
             RowBox[{"DisplayForm", "&"}]}], ",", "#"}], "]"}], ",", 
          "\"\<, \>\""}], "]"}], "&"}], ",", 
       RowBox[{"pathCounts", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "Generate", " ", "the", " ", "BarChart", " ", "with", " ", 
     "values", " ", "on", " ", "top", " ", "and", " ", "paths", " ", "on", 
     " ", "the", " ", "bottom"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"BarChart", "[", 
    RowBox[{"probabilities", ",", 
     RowBox[{"ChartLabels", "->", 
      RowBox[{"Placed", "[", 
       RowBox[{"pathLabels", ",", "Axis", ",", 
        RowBox[{
         RowBox[{"Rotate", "[", 
          RowBox[{"#", ",", 
           RowBox[{"45", "Degree"}]}], "]"}], "&"}]}], "]"}]}], ",", 
     RowBox[{"(*", 
      RowBox[{"Rotates", " ", "labels", " ", "so", " ", "they", " ", 
       RowBox[{"don", "'"}], "t", " ", "overlap"}], "*)"}], 
     RowBox[{"ChartLabels", "->", 
      RowBox[{"Placed", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Around", "[", 
           RowBox[{"#", ",", "0"}], "]"}], "&"}], "/@", "probabilities"}], 
        ",", "Above"}], "]"}]}], ",", 
     RowBox[{"(*", 
      RowBox[{
      "Forces", " ", "values", " ", "on", " ", "top", " ", "of", " ", 
       "bars"}], "*)"}], 
     RowBox[{"LabelingFunction", "->", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"100.", "*", "#1"}], ",", 
               RowBox[{"{", 
                RowBox[{"5", ",", "2"}], "}"}]}], "]"}], ",", "\"\<%\>\""}], 
            "}"}], "]"}], ",", "Above"}], "]"}], "&"}], ")"}]}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{
       "\"\<Unique Paths\>\"", ",", 
        "\"\<Relative Occurrence (Probability)\>\""}], "}"}]}], ",", 
     RowBox[{"PlotLabel", "->", "\"\<Path Distribution\>\""}], ",", 
     RowBox[{"ChartStyle", "->", 
      RowBox[{"RGBColor", "[", 
       RowBox[{"0.87", ",", "0.71", ",", "0.34"}], "]"}]}], ",", 
     RowBox[{"ImageSize", "->", "900"}], ",", 
     RowBox[{"(*", 
      RowBox[{
      "Made", " ", "wider", " ", "to", " ", "accommodate", " ", "labels", " ",
        "nicely"}], "*)"}], 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{"All", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{
           RowBox[{"Max", "[", "probabilities", "]"}], "*", "1.15"}]}], 
         "}"}]}], "}"}]}]}], " ", 
    RowBox[{"(*", 
     RowBox[{
     "Leaves", " ", "room", " ", "at", " ", "the", " ", "top", " ", "for", 
      " ", "the", " ", "numbers"}], "*)"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9906106526625977`*^9, 3.9906106885979347`*^9}, 
   3.9906108014439335`*^9, {3.990610834882452*^9, 3.990610835016468*^9}, {
