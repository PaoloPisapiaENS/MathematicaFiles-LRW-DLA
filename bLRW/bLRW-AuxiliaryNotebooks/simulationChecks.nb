          RowBox[{"AppendTo", "[", 
           RowBox[{
            RowBox[{"locBC", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", "locSource"}], "]"}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{
            RowBox[{"locBC", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{
             RowBox[{"\[Phi]", "[", 
              RowBox[{"path", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "==", "0"}]}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{
            RowBox[{"locBC", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", 
            RowBox[{"path", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "1"}], "]"}], "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"\[Phi]sol", "=", 
           RowBox[{"LaplaceEqSolver", "[", 
