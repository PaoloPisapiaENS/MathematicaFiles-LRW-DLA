   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{1, 2, 3}, {{{1, 2}, {2, 1}, {2, 3}, {1, 3}}, Null}, {
      EdgeShapeFunction -> {"FilledArrow"}, EdgeStyle -> {
         RGBColor[0, 0, 1]}, 
       VertexLabels -> {"Name", 2 -> "2, ROOT", 3 -> "3, SOURCE"}, 
