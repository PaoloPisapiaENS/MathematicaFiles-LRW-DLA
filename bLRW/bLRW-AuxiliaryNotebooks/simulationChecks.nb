Cell[CellGroupData[{

Cell["Gemini", "Subsection",
 CellChangeTimes->{{3.9889660052473774`*^9, 
  3.9889660060628815`*^9}},ExpressionUUID->"240245bf-fcfa-2a43-b8eb-\
44b5304eaaf4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"1.", " ", "Initialize", " ", "a", " ", "4"}], "-", 
     RowBox[{
     "element", " ", "table", " ", "to", " ", "hold", " ", "counts", " ", 
      "for", " ", "0"}]}], ",", "1", ",", "2", ",", 
    RowBox[{"and", " ", "3"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"tallyCounts", "=", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"2.", " ", "Open", " ", "a", " ", "low"}], "-", 
     RowBox[{
     "level", " ", "binary", " ", "stream", " ", "to", " ", "the", " ", 
      "file"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"stream", "=", 
     RowBox[{"OpenRead", "[", 
      RowBox[{
      "\"\<D:\\\\Offline_Documents\\\\University\\\\PhD_Paris\\\\PhD_work\\\\\
Simulations\\\\bLRW\\\\extractionData\\\\extraction-Histogram-at-70-50-b40-\
Integer8.bin\>\"", ",", 
       RowBox[{"BinaryFormat", "->", "True"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "Process", " ", "the", " ", "file", " ", "in", " ", "chunks", 
     " ", "of", " ", "1", " ", "million", " ", "bytes", " ", "at", " ", "a", 
     " ", "time"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"chunkSize", "=", "1000000"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.988966006817417*^9, 3.9889660068188496`*^9}, {
  3.988966188055456*^9, 3.9889662123945255`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"a8f707d8-4eec-ff4d-afb0-dcbc58d8e96e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Internal`WithLocalSettings", "[", 
   RowBox[{"None", ",", "\[IndentingNewLine]", 
    RowBox[{"While", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"chunk", "=", 
         RowBox[{"BinaryReadList", "[", 
          RowBox[{"stream", ",", "\"\<Integer8\>\"", ",", "chunkSize"}], 
          "]"}]}], ")"}], "=!=", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{"(*", 
       RowBox[{"Scan", " ", "through", " ", "each", " ", 
        RowBox[{"{", 
         RowBox[{"val", ",", "count"}], "}"}], " ", "pair", " ", "from", " ", 
        "Tally", " ", "and", " ", "update", " ", "tallyCounts"}], "*)"}], 
      RowBox[{"Scan", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"pair", ",", 
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"val", "=", 
               RowBox[{"pair", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], ",", 
              RowBox[{"count", "=", 
               RowBox[{"pair", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"0", "<=", "val", "<=", "3"}], ",", 
              RowBox[{
               RowBox[{"tallyCounts", "[", 
                RowBox[{"[", 
                 RowBox[{"val", "+", "1"}], "]"}], "]"}], "+=", "count"}]}], 
             "]"}]}], "]"}]}], "]"}], ",", 
        RowBox[{"Tally", "[", "chunk", "]"}]}], "]"}]}], "]"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
     "4.", " ", "ALWAYS", " ", "close", " ", "the", " ", "file", " ", 
      "stream", " ", "securely", " ", "if", " ", "it", " ", "finishes", " ", 
      "or", " ", "aborts"}], "*)"}], 
    RowBox[{"Close", "[", "stream", "]"}]}], "\[IndentingNewLine]", "]"}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.988966006817417*^9, 3.988966006818849*^9}, {
   3.988966188055456*^9, 3.9889662399000626`*^9}, 
   3.9906897853785267`*^9},ExpressionUUID->"bab9d1bf-3266-b649-ae34-\
f21b2b640533"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "5.", " ", "Compute", " ", "the", " ", "final", " ", "probabilities", " ", 
    "from", " ", "your", " ", "tiny", " ", "tally", " ", "list"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"heights", "=", 
     RowBox[{"N", "[", 
      RowBox[{"tallyCounts", "/", 
       RowBox[{"Total", "[", "tallyCounts", "]"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Final Probabilities: \>\"", ",", "heights"}], "]"}], 
    ";"}]}]}]], "Input",
