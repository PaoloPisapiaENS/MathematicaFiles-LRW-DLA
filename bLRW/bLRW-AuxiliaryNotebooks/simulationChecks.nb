Cell[CellGroupData[{

Cell["\<\
Merge equal length paths. NOTE THAT THIS CHANGES THE PROBABILITIES BECAUSE \
THERE IS AN ENTROPIC FACTOR: SAME LENGTH THAT CAN BE REALIZED IN MANY WAYS \
GETS WEIGHTED MORE\
\>", "Subsubsection",
 CellChangeTimes->{{3.9911317568596144`*^9, 3.991131765853901*^9}, {
  3.991388642210535*^9, 
  3.9913886933017836`*^9}},ExpressionUUID->"30772c49-cf93-4d47-83c4-\
313d2de4fd95"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MergeTwoTalliesEqualLength", "[", 
    RowBox[{"tally1_List", ",", "tally2_List"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"combined", "=", "tally1"}], ",", "matched", ",", "path2", ",",
        "count2"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Do", "[", 
       RowBox[{"(*", 
        RowBox[{
        "Extract", " ", "components", " ", "explicitly", " ", "using", " ", 
         "Pattern", " ", "Matching"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"path2", "=", 
          RowBox[{"item", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"count2", "=", 
          RowBox[{"item", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"matched", "=", 
          RowBox[{
           RowBox[{"Position", "[", 
            RowBox[{"combined", ",", 
             RowBox[{"_", "?", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"SameQ", "[", 
                 RowBox[{
                  RowBox[{"Length", "[", 
                   RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
                  RowBox[{"Length", "[", "path2", "]"}]}], "]"}], "&"}], 
               ")"}]}], ",", 
             RowBox[{"{", "1", "}"}], ",", "1"}], "]"}], "//", "Quiet"}]}], 
         ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "matched", "]"}], ">", "0"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"combined", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"matched", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", "2"}], "]"}], 
             "]"}], "+=", "count2"}], ",", "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"combined", ",", 
             RowBox[{"{", 
              RowBox[{"path2", ",", "count2"}], "}"}]}], "]"}]}], 
          "\[IndentingNewLine]", "]"}]}], ",", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"item", ",", "tally2"}], "}"}]}], " ", 
       RowBox[{"(*", 
        RowBox[{
        "Loops", " ", "through", " ", "each", " ", "full", " ", "pair", " ", 
         "in", " ", "tally2"}], "*)"}], "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "combined"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9911319996653976`*^9, 3.99113208292758*^9}, {
   3.9911321468996105`*^9, 3.9911321546278343`*^9}, {3.991132545940885*^9, 
   3.991132554696886*^9}, {3.991185935468923*^9, 3.991185947211672*^9}, {
   3.991186112291321*^9, 3.9911862124382877`*^9}, {3.991186271889023*^9, 
   3.9911863038320866`*^9}, {3.991186344272241*^9, 3.991186371770331*^9}, {
   3.991187049421545*^9, 3.9911870984923944`*^9}, {3.991187185875601*^9, 
   3.99118730849675*^9}, {3.9911873509929743`*^9, 3.9911873575116377`*^9}, {
   3.99118764266403*^9, 3.9911876677182903`*^9}, 3.991187712130146*^9, 
   3.9911880283220406`*^9, {3.99118852065641*^9, 3.991188522255705*^9}, {
   3.991189454555578*^9, 3.991189455271818*^9}},
