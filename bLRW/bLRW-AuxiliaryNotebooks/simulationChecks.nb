                  RowBox[{"\[Phi]", "[", "y", "]"}]}], " ", "&"}]}], "]"}], 
              "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"y", ",", 
              RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], "]"}]}],
          ";"}], "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Print", "[", "denominator", "]"}], "*)"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"numerator", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"locWeights", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"path", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
              RowBox[{"path", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}], " ", 
           "*", " ", 
           RowBox[{
            RowBox[{"Select", "[", 
             RowBox[{"\[Phi]sol", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "==", 
                RowBox[{"\[Phi]", "[", 
                 RowBox[{"path", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "2"}], "]"}], "]"}], "]"}]}], " ", 
               "&"}]}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "//", 
          "FullSimplify"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"prob", "*=", 
          FractionBox["numerator", "denominator"]}], "//", "FullSimplify"}], 
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<#####  Transition probability \>\"", "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{"path", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "<>", 
          "\"\< to \>\"", "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{"path", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "2"}], "]"}], "]"}], "]"}], "<>", 
          "\"\<  #####\>\""}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{
          RowBox[{"prob", "/.", 
           RowBox[{
            RowBox[{"\[Beta]", "[", 
             RowBox[{"_", ",", "_"}], "]"}], "->", "1"}]}], "//", 
          "FullSimplify"}], "]"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"Clear", "[", 
         RowBox[{"\[Phi]sol", ",", "locBC"}], "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", "2"}], ",", 
          RowBox[{"i", "<=", 
           RowBox[{"Length", "[", "path", "]"}]}], ",", 
          RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{
            "We", " ", "need", " ", "to", " ", "solve", " ", "it", " ", 
             "once", " ", "with", " ", "standard", " ", "BCs", " ", "at", " ",
              "the", " ", "previous", " ", "step"}], ",", " ", 
            RowBox[{
             RowBox[{"i", ".", "e", ".", " ", 
              RowBox[{"\[Phi]", "[", "locSource", "]"}]}], "==", "1"}]}], 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"locBC", "=", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"\[Phi]", "[", "locSource", "]"}], "==", "1"}], 
                "}"}], ",", 
               RowBox[{"{", "locSource", "}"}]}], "}"}]}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"For", "[", 
             RowBox[{
              RowBox[{"j", "=", "1"}], ",", 
              RowBox[{"j", "<=", 
               RowBox[{"i", "-", "1"}]}], ",", 
              RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"AppendTo", "[", 
                RowBox[{
                 RowBox[{"locBC", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", 
                 RowBox[{
                  RowBox[{"\[Phi]", "[", 
                   RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", "1"}], "]"}], "]"}], "]"}], "==", 
                  "0"}]}], "]"}], ";", "\[IndentingNewLine]", 
               RowBox[{"AppendTo", "[", 
                RowBox[{
                 RowBox[{"locBC", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], ",", 
                 RowBox[{"path", "[", 
                  RowBox[{"[", 
                   RowBox[{"j", ",", "1"}], "]"}], "]"}]}], "]"}]}]}], 
             "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{"Print", "[", "locBC", "]"}], "*)"}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"Z", "=", 
             RowBox[{"VertexAssignment", "[", 
              RowBox[{"graph", ",", " ", 
               RowBox[{"\"\<excludedVertices\>\"", "->", 
                RowBox[{"locBC", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"Z", "=", 
             RowBox[{"ExpectationValue", "[", "Z", "]"}]}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"OptionValue", "[", "\"\<print\>\"", "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
               "Print", "[", 
                "\"\<#####  Previous Partition Function  #####\>\"", "]"}], 
               ";", "\[IndentingNewLine]", 
               RowBox[{"Print", "[", "Z", "]"}]}]}], "\[IndentingNewLine]", 
             "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"\[Phi]sol", "=", 
             RowBox[{"LaplaceEqSolver", "[", 
              RowBox[{"graph", ",", "locBC", ",", "\[Phi]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"Print", "[", "\[Phi]sol", "]"}], ";"}], "*)"}], 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"denominator", "=", 
             RowBox[{
              RowBox[{
               FractionBox["1", "Z"], "*", 
               RowBox[{
                RowBox[{"Select", "[", 
                 RowBox[{"\[Phi]sol", ",", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "==", 
                    RowBox[{"\[Phi]", "[", 
                    RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}]}], " ", 
                   "&"}]}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "//", 
              "FullSimplify"}]}], ";", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", 
            RowBox[{"Clear", "[", 
             RowBox[{"\[Phi]sol", ",", " ", "locBC"}], "]"}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
             "Then", " ", "we", " ", "need", " ", "to", " ", "solve", " ", 
              "it", " ", "again", " ", "with", " ", "updated", " ", "BC", " ",
               "at", " ", "the", " ", "current", " ", "step"}], "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"locBC", "=", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"\[Phi]", "[", "locSource", "]"}], "==", 
                 SuperscriptBox["denominator", 
                  RowBox[{"-", "1"}]]}], "}"}], ",", 
               RowBox[{"{", "locSource", "}"}]}], "}"}]}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"For", "[", 
             RowBox[{
              RowBox[{"j", "=", "1"}], ",", 
              RowBox[{"j", "<=", "i"}], ",", 
              RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"AppendTo", "[", 
                RowBox[{
                 RowBox[{"locBC", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", 
                 RowBox[{
                  RowBox[{"\[Phi]", "[", 
                   RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", "1"}], "]"}], "]"}], "]"}], "==", 
                  "0"}]}], "]"}], ";", "\[IndentingNewLine]", 
               RowBox[{"AppendTo", "[", 
                RowBox[{
                 RowBox[{"locBC", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], ",", 
                 RowBox[{"path", "[", 
                  RowBox[{"[", 
                   RowBox[{"j", ",", "1"}], "]"}], "]"}]}], "]"}]}]}], 
             "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{"Print", "[", "locBC", "]"}], "*)"}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"Z", "=", 
             RowBox[{"VertexAssignment", "[", 
              RowBox[{"graph", ",", " ", 
               RowBox[{"\"\<excludedVertices\>\"", "->", 
                RowBox[{"locBC", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"Z", "=", 
             RowBox[{"ExpectationValue", "[", "Z", "]"}]}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"OptionValue", "[", "\"\<print\>\"", "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
               "Print", "[", 
                "\"\<#####  Current Partition Function  #####\>\"", "]"}], 
               ";", "\[IndentingNewLine]", 
               RowBox[{"Print", "[", "Z", "]"}]}]}], "\[IndentingNewLine]", 
             "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"\[Phi]sol", "=", 
             RowBox[{"LaplaceEqSolver", "[", 
              RowBox[{"graph", ",", "locBC", ",", "\[Phi]"}], "]"}]}], ";"}], 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"Print", "[", "\[Phi]sol", "]"}], "*)"}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<#####  Transition probability \>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"path", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "<>", 
             "\"\< to \>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"path", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "2"}], "]"}], "]"}], "]"}], "<>", 
             "\"\<  #####\>\""}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               FractionBox["1", "Z"], "*", 
               FractionBox[
                RowBox[{"locWeights", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
                   RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}], 
                RowBox[{"totWeights", "[", 
                 RowBox[{"[", 
                  RowBox[{"path", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "]"}]], "*", 
               RowBox[{
                RowBox[{"Select", "[", 
                 RowBox[{"\[Phi]sol", ",", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "==", 
                    RowBox[{"\[Phi]", "[", 
                    RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}], "]"}]}], " ", 
                   "&"}]}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "/.", 
              RowBox[{
               RowBox[{"\[Beta]", "[", 
                RowBox[{"_", ",", "_"}], "]"}], "->", "1"}]}], "//", 
             "FullSimplify"}], "]"}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"prob", "*=", 
             RowBox[{
              FractionBox["1", "Z"], "*", 
              FractionBox[
               RowBox[{"locWeights", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"path", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
                  RowBox[{"path", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}], 
               RowBox[{"totWeights", "[", 
                RowBox[{"[", 
                 RowBox[{"path", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "]"}]], "*", 
              RowBox[{
               RowBox[{"Select", "[", 
                RowBox[{"\[Phi]sol", ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "==", 
                   RowBox[{"\[Phi]", "[", 
                    RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}], "]"}]}], " ", 
                  "&"}]}], "]"}], "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "2"}], "]"}], "]"}]}]}], "//", 
            "FullSimplify"}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"Clear", "[", 
            RowBox[{"\[Phi]sol", ",", "locBC"}], "]"}], ";"}]}], 
         "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
