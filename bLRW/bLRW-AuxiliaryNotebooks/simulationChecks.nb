      RowBox[{"{", 
       RowBox[{"All", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{
           RowBox[{"Max", "[", "symmetricProbabilities", "]"}], "*", 
           "1.15"}]}], "}"}]}], "}"}]}]}], "]"}]}]}]], "Input",
