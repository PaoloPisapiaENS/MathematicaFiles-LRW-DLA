Cell[CellGroupData[{

Cell["2nd-to-Linear paths (length=8)", "Subsubsection",
 CellChangeTimes->{{3.991385659479397*^9, 3.991385673738237*^9}, {
  3.9913857914683666`*^9, 3.991385792101998*^9}, {3.991795741386801*^9, 
