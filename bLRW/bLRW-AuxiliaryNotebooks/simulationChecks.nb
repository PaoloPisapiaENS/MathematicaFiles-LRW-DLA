      RowBox[{"locBC", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], " ", ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"variables", ",", 
          RowBox[{"\[CapitalPhi]", "[", 
           RowBox[{"locVertices", "[", 
            RowBox[{"[", "x", "]"}], "]"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"MemberQ", "[", 
           RowBox[{
            RowBox[{"locBC", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", 
            RowBox[{"locVertices", "[", 
             RowBox[{"[", "x", "]"}], "]"}]}], "]"}], ",", 
          RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"equations", ",", " ", 
          RowBox[{
           RowBox[{"\[CapitalPhi]", "[", 
            RowBox[{"locVertices", "[", 
             RowBox[{"[", "x", "]"}], "]"}], "]"}], "==", 
           RowBox[{"FullSimplify", "[", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               FractionBox[
                RowBox[{"locWeights", "[", 
                 RowBox[{"[", 
                  RowBox[{"x", ",", "y"}], "]"}], "]"}], 
                RowBox[{"totWeights", "[", 
                 RowBox[{"[", "x", "]"}], "]"}]], 
               RowBox[{"\[CapitalPhi]", "[", 
                RowBox[{"locVertices", "[", 
                 RowBox[{"[", "y", "]"}], "]"}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"y", ",", 
                RowBox[{"Length", "[", "locIndices", "]"}]}], "}"}]}], "]"}], 
            "]"}]}]}], "]"}]}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "locIndices"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"OptionValue", "[", "\"\<print\>\"", "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{
         "\"\< ##### Equations to be solved: \\n\>\"", ",", "equations"}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{
         "\"\< ##### Equations to be solved: \\n\>\"", ",", "variables"}], 
         "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"solution", "=", 
      RowBox[{"Flatten", "@", 
       RowBox[{"Solve", "[", 
        RowBox[{"equations", ",", 
         RowBox[{"{", "}"}]}], 
        RowBox[{"(*", "variables", "*)"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"solutionLabels", "=", 
      RowBox[{
       RowBox[{"N", "[", "solution", "]"}], "/.", 
       RowBox[{
        RowBox[{"\[CapitalPhi]", "[", "a_", "]"}], "->", 
        RowBox[{"Floor", "[", "a", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"solution", "=", 
      RowBox[{"solution", "/.", "\[VeryThinSpace]", 
       RowBox[{"Rule", "\[Rule]", "List"}]}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"OptionValue", "[", "\"\<drawSolution\>\"", "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"Graph", "[", 
         RowBox[{"graph", ",", 
          RowBox[{"VertexLabels", "->", "solutionLabels"}]}], "]"}], "]"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<selectSolution\>\"", "]"}], "!=", 
        "0"}], ",", 
       RowBox[{"(*", "True", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"solution", "=", 
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{"solution", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "==", 
             RowBox[{"\[CapitalPhi]", "[", 
              RowBox[{"OptionValue", "[", "\"\<selectSolution\>\"", "]"}], 
              "]"}]}], " ", "&"}]}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "2"}], "]"}], "]"}]}]}], "\[IndentingNewLine]", 
      "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "solution", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 InitializationCell->True,
