Cell[CellGroupData[{

Cell["\<\
Merge equal length paths. NOTE THAT THIS CHANGES THE PROBABILITIES BECAUSE \
THERE IS AN ENTROPIC FACTOR: SAME LENGTH THAT CAN BE REALIZED IN MANY WAYS \
GETS WEIGHTED MORE\
\>", "Subsubsection",
 CellChangeTimes->{{3.9911317568596134`*^9, 3.991131765853901*^9}, {
  3.991388642210535*^9, 
  3.9913886933017845`*^9}},ExpressionUUID->"1c61e7e3-f420-3146-a334-\
e8a296ec0989"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MergeTwoTalliesEqualLength", "[", 
    RowBox[{"tally1_List", ",", "tally2_List"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"combined", "=", "tally1"}], ",", "matched", ",", "path2", ",",
        "count2"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Do", "[", 
       RowBox[{"(*", 
        RowBox[{
        "Extract", " ", "components", " ", "explicitly", " ", "using", " ", 
         "Pattern", " ", "Matching"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"path2", "=", 
          RowBox[{"item", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"count2", "=", 
          RowBox[{"item", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"matched", "=", 
          RowBox[{
           RowBox[{"Position", "[", 
            RowBox[{"combined", ",", 
             RowBox[{"_", "?", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"SameQ", "[", 
                 RowBox[{
                  RowBox[{"Length", "[", 
                   RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
                  RowBox[{"Length", "[", "path2", "]"}]}], "]"}], "&"}], 
               ")"}]}], ",", 
             RowBox[{"{", "1", "}"}], ",", "1"}], "]"}], "//", "Quiet"}]}], 
         ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "matched", "]"}], ">", "0"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"combined", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"matched", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", "2"}], "]"}], 
             "]"}], "+=", "count2"}], ",", "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"combined", ",", 
             RowBox[{"{", 
              RowBox[{"path2", ",", "count2"}], "}"}]}], "]"}]}], 
          "\[IndentingNewLine]", "]"}]}], ",", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"item", ",", "tally2"}], "}"}]}], " ", 
       RowBox[{"(*", 
        RowBox[{
        "Loops", " ", "through", " ", "each", " ", "full", " ", "pair", " ", 
         "in", " ", "tally2"}], "*)"}], "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "combined"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9911319996653976`*^9, 3.99113208292758*^9}, {
   3.9911321468996105`*^9, 3.9911321546278343`*^9}, {3.9911325459408855`*^9, 
