                    RowBox[{"Log", "[", 
                    RowBox[{
                    RowBox[{"x", "^", "2"}], "+", 
                    RowBox[{"y", "^", "2"}]}], " ", "]"}]}], "*)"}], "//", 
                    "N"}], ")"}]}], "]"}]}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"AppendTo", "[", 
               RowBox[{
                RowBox[{"locBC", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], ",", 
                RowBox[{"locSource", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", ",", 
