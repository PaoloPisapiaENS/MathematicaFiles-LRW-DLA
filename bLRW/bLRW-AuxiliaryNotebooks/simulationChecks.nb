               RowBox[{"Print", "[", 
                RowBox[{"\"\<locBC=\>\"", ",", 
                 RowBox[{"Sort", "/@", "locBC"}]}], "]"}], ";"}]}], 
             "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"\[Phi]sol", "=", 
