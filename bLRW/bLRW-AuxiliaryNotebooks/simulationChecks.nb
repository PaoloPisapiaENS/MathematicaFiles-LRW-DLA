Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Find", " ", "all", " ", "rectangles", " ", "inside", " ", 
    "the", " ", "graphic", " ", "object"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"allRectangles", "=", 
     RowBox[{"Cases", "[", 
      RowBox[{
       RowBox[{"h", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", "_Rectangle", ",", "All"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "2.", " ", "Find", " ", "the", " ", "rectangle", " ", "with", " ", "the",
       " ", "maximum", " ", "Y"}], "-", 
     RowBox[{"max", " ", 
      RowBox[{"(", 
       RowBox[{"highest", " ", "bar"}], ")"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"tallestRectangle", "=", 
     RowBox[{
      RowBox[{"MaximalBy", "[", 
       RowBox[{"allRectangles", ",", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "2"}], "]"}], "]"}], "&"}]}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "Extract", " ", "its", " ", "X", " ", "boundaries", " ", "to", 
     " ", "identify", " ", "the", " ", "bin", " ", "value"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"modeBin", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"tallestRectangle", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "2"}], "}"}], ",", "1"}], "]"}], "]"}], "/.", 
      RowBox[{"Rectangle", "->", "Sequence"}]}], "}"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"mode", "=", 
    RowBox[{"Mean", "@", "modeBin"}]}]}]}]], "Input",
