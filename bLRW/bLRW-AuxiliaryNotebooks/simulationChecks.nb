Cell[BoxData[{
 RowBox[{
  RowBox[{"BC", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"\[CapitalPhi]", "[", "3", "]"}], "==", 
        RowBox[{"Zeta", "[", "3", "]"}]}], ",", 
       RowBox[{
        RowBox[{"\[CapitalPhi]", "[", "2", "]"}], "==", "0"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "2"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
