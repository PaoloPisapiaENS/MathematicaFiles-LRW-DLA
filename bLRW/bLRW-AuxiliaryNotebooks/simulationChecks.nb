Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"1.", " ", "Calculate", " ", "relative", " ", "frequencies", " ", 
    RowBox[{"(", "\"\<probabilities\>\"", ")"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"totalPaths", "=", 
     RowBox[{"Length", "[", "paths", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"countsOnly", "=", 
     RowBox[{"pathCounts", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"probabilities", "=", 
     RowBox[{"countsOnly", "/", "totalPaths"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "Convert", " ", "each", " ", "path", " ", 
     RowBox[{"(", 
      RowBox[{"series", " ", "of", " ", "points"}], ")"}], " ", "into", " ", 
     "a", " ", "clean", " ", "text", " ", "label"}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Shortens", " ", "coordinates", " ", "to", " ", "strings", " ", "like", 
     " ", "\"\<{(0,1),(1,2)}\>\""}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pathLabels", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Row", "[", 
         RowBox[{
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"RowBox", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<{\>\"", ",", 
                RowBox[{"Row", "[", 
                 RowBox[{"#", ",", "\"\<,\>\""}], "]"}], ",", "\"\<}\>\""}], 
               "}"}], "]"}], "//", 
             RowBox[{"DisplayForm", "&"}]}], ",", "#"}], "]"}], ",", 
          "\"\<, \>\""}], "]"}], "&"}], ",", 
       RowBox[{"pathCounts", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pathLabels", "=", 
     RowBox[{"ParallelMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Graphics", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Thick", ",", 
            RowBox[{"Line", "[", "#", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{
              TemplateBox[<|"color" -> RGBColor[1, 0, 0]|>,
               "RGBColorSwatchTemplate"], ",", 
              RowBox[{"Circle", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"xMax", "/", "2"}], "+", "0.5"}], ",", 
                  RowBox[{
                   RowBox[{"yMax", "/", "2"}], "+", "0.5"}]}], "}"}], ",", 
                RowBox[{
                 RowBox[{"xMax", "/", "2"}], "-", "0.5"}]}], "]"}]}], "}"}]}],
            "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"PlotRange", "->", "globalPlotRange"}], ",", 
          RowBox[{"PlotRangePadding", "->", "0.2"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"GridLines", "->", "globalGridLines"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Frame", "->", "True"}], ",", 
          RowBox[{"FrameTicks", "->", "None"}], ",", 
          RowBox[{"Axes", "->", "False"}], ",", "\[IndentingNewLine]", 
          RowBox[{"ImageSize", "->", "200"}]}], "]"}], "&"}], 
       "\[IndentingNewLine]", ",", 
       RowBox[{"pathCounts", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
