Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"1.", " ", "Calculate", " ", "relative", " ", "frequencies", " ", 
    RowBox[{"(", "\"\<probabilities\>\"", ")"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"totalPaths", "=", 
     RowBox[{"Length", "[", "paths", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"symmetricProbabilities", "=", 
     RowBox[{"symmetricCounts", "/", "totalPaths"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Convert", " ", "each", " ", "unique", " ", "representative", 
     " ", "path", " ", "into", " ", "your", " ", "clean", " ", "coordinate", 
     " ", "string", " ", "format"}], "*)"}], 
   RowBox[{
    RowBox[{"symmetricPathLabels", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Row", "[", 
         RowBox[{
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"RowBox", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<{\>\"", ",", 
                RowBox[{"Row", "[", 
                 RowBox[{"#", ",", "\"\<,\>\""}], "]"}], ",", "\"\<}\>\""}], 
               "}"}], "]"}], "//", 
             RowBox[{"DisplayForm", "&"}]}], ",", "#"}], "]"}], ",", 
          "\"\<, \>\""}], "]"}], "&"}], ",", "uniqueSymmetricPaths"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"symmetricPathLabels", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Graphics", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Thick", ",", 
            RowBox[{"Line", "[", "#", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{
              TemplateBox[<|"color" -> RGBColor[1, 0, 0]|>,
               "RGBColorSwatchTemplate"], ",", 
              RowBox[{"Circle", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"xMax", "/", "2"}], "+", "0.5"}], ",", 
                  RowBox[{
                   RowBox[{"yMax", "/", "2"}], "+", "0.5"}]}], "}"}], ",", 
                RowBox[{
                 RowBox[{"xMax", "/", "2"}], "-", "0.5"}]}], "]"}]}], "}"}]}],
            "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"PlotRange", "->", "globalPlotRange"}], ",", 
          RowBox[{"PlotRangePadding", "->", "0.2"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"GridLines", "->", "globalGridLines"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Frame", "->", "True"}], ",", 
          RowBox[{"FrameTicks", "->", "None"}], ",", 
          RowBox[{"Axes", "->", "False"}], ",", "\[IndentingNewLine]", 
          RowBox[{"ImageSize", "->", "200"}]}], "]"}], "&"}], 
       "\[IndentingNewLine]", ",", "uniqueSymmetricPaths"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "Generate", " ", "the", " ", "BarChart", " ", "with", " ", 
     "values", " ", "on", " ", "top", " ", "and", " ", "unique", " ", 
     "symmetry", " ", "families", " ", "on", " ", "the", " ", "bottom"}], 
    "*)"}], 
   RowBox[{
    RowBox[{
     RowBox[{"BarChart", "[", 
      RowBox[{
       RowBox[{"symmetricProbabilities", "[", 
        RowBox[{"[", "#", "]"}], "]"}], ",", 
       RowBox[{"ChartLabels", "->", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"symmetricPathLabels", "[", 
           RowBox[{"[", "#", "]"}], "]"}], ",", "Axis"}], "]"}]}], ",", 
       RowBox[{"LabelingFunction", "->", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Placed", "[", 
           RowBox[{
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"NumberForm", "[", 
                RowBox[{
                 RowBox[{"100.", "*", "#1"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"5", ",", "2"}], "}"}]}], "]"}], ",", "\"\<%\>\""}],
               "}"}], "]"}], ",", "Above"}], "]"}], "&"}], ")"}]}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{
