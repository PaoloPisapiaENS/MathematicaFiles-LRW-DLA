Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"IterativeSymmetricTally", "[", 
    RowBox[{"allPaths_List", ",", 
     RowBox[{"batchSize_Integer", ":", "100"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"batches", ",", "currentTallies"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"DistributeDefinitions", "[", 
       RowBox[{
       "AnalyzeSymmetricPaths", ",", "MergeTwoTallies", ",", 
        "AreSymmetricQ"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"1.", " ", "Initial", " ", 
        RowBox[{"Step", ":", " ", 
         RowBox[{
         "partition", " ", "and", " ", "analyze", " ", "individual", " ", 
          "batches"}]}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"batches", "=", 
       RowBox[{"Partition", "[", 
        RowBox[{"allPaths", ",", 
         RowBox[{"UpTo", "[", "batchSize", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"currentTallies", "=", 
       RowBox[{"ParallelMap", "[", 
        RowBox[{"AnalyzeSymmetricPaths", ",", "batches"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"2.", " ", "Reduction", " ", 
        RowBox[{"Loop", ":", " ", 
         RowBox[{
         "merge", " ", "pairs", " ", "of", " ", "batches", " ", "until", " ", 
          "only", " ", "1", " ", "master", " ", "tally", " ", "is", " ", 
          "left"}]}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "currentTallies", "]"}], ">", "1"}], ",", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"currentTallies", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"OddQ", "[", 
             RowBox[{"Length", "[", "currentTallies", "]"}], "]"}], ",", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{
              "If", " ", "odd", " ", "number", " ", "of", " ", "batches"}], 
              ",", 
              RowBox[{
              "hold", " ", "the", " ", "last", " ", "one", " ", "and", " ", 
               "merge", " ", "the", " ", "pairs"}]}], "*)"}], 
            RowBox[{"Append", "[", 
             RowBox[{
              RowBox[{"Map", "[", 
               RowBox[{
                RowBox[{"Apply", "[", "MergeTwoTallies", "]"}], ",", 
                RowBox[{"Partition", "[", 
                 RowBox[{
                  RowBox[{"Drop", "[", 
                   RowBox[{"currentTallies", ",", 
                    RowBox[{"-", "1"}]}], "]"}], ",", "2"}], "]"}]}], "]"}], 
              ",", 
              RowBox[{"Last", "[", "currentTallies", "]"}]}], "]"}], ",", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"If", " ", "even"}], ",", 
              RowBox[{
              "merge", " ", "all", " ", "pairs", " ", "straight", " ", 
               "across"}]}], "*)"}], "\[IndentingNewLine]", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{"Apply", "[", "MergeTwoTallies", "]"}], ",", 
              RowBox[{"Partition", "[", 
               RowBox[{"currentTallies", ",", "2"}], "]"}]}], "]"}]}], 
           "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<Remaining batch blocks to merge: \>\"", ",", 
           RowBox[{"Length", "[", "currentTallies", "]"}]}], "]"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "3.", " ", "Final", " ", "Sort", " ", "by", " ", "count", " ", "in", 
        " ", "descending", " ", "order"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Reverse", "[", 
       RowBox[{"SortBy", "[", 
        RowBox[{
         RowBox[{"First", "[", "currentTallies", "]"}], ",", "Last"}], "]"}], 
       "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.990693122784086*^9, 3.990693176992199*^9}, {
