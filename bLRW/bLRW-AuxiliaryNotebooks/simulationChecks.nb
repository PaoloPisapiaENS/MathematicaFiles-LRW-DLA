Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"1.", " ", "Calculate", " ", "relative", " ", "frequencies", " ", 
    RowBox[{"(", "\"\<probabilities\>\"", ")"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"totalPaths", "=", 
     RowBox[{"Length", "[", "paths", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"symmetricProbabilities", "=", 
     RowBox[{"symmetricCounts", "/", "totalPaths"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Convert", " ", "each", " ", "unique", " ", "representative", 
     " ", "path", " ", "into", " ", "your", " ", "clean", " ", "coordinate", 
     " ", "string", " ", "format"}], "*)"}], 
   RowBox[{
    RowBox[{"symmetricPathLabels", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Row", "[", 
         RowBox[{
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"RowBox", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<{\>\"", ",", 
                RowBox[{"Row", "[", 
                 RowBox[{"#", ",", "\"\<,\>\""}], "]"}], ",", "\"\<}\>\""}], 
               "}"}], "]"}], "//", 
             RowBox[{"DisplayForm", "&"}]}], ",", "#"}], "]"}], ",", 
          "\"\<, \>\""}], "]"}], "&"}], ",", "uniqueSymmetricPaths"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"symmetricPathLabels", "=", 
     RowBox[{"ParallelMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Graphics", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Thick", ",", 
            RowBox[{"Line", "[", "#", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{
              TemplateBox[<|"color" -> RGBColor[1, 0, 0]|>,
               "RGBColorSwatchTemplate"], ",", 
              RowBox[{"Circle", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"xMax", "/", "2"}], "+", "0.5"}], ",", 
                  RowBox[{
                   RowBox[{"yMax", "/", "2"}], "+", "0.5"}]}], "}"}], ",", 
                RowBox[{
                 RowBox[{"xMax", "/", "2"}], "-", "0.5"}]}], "]"}]}], "}"}]}],
            "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"PlotRange", "->", "globalPlotRange"}], ",", 
          RowBox[{"PlotRangePadding", "->", "0.2"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"GridLines", "->", "globalGridLines"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Frame", "->", "True"}], ",", 
          RowBox[{"FrameTicks", "->", "None"}], ",", 
          RowBox[{"Axes", "->", "False"}], ",", "\[IndentingNewLine]", 
          RowBox[{"ImageSize", "->", "200"}]}], "]"}], "&"}], 
       "\[IndentingNewLine]", ",", "uniqueSymmetricPaths"}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9906106526625986`*^9, 3.990610688597935*^9}, 
