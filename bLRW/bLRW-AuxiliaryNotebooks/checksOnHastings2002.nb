Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"multifractalDims", "=", 
  RowBox[{"Table", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Tau]", "=", 
      RowBox[{"a0", " ", "+", " ", 
       RowBox[{"a1", " ", 
        RowBox[{"(", 
         RowBox[{"q", "-", "q0"}], ")"}]}]}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"serTip", "=", 
      RowBox[{
       RowBox[{"Normal", "@", 
        RowBox[{"Series", "[", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"\[Tau]tip", "[", 
            RowBox[{"-", "\[Tau]"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"q", ",", "q0", ",", "1"}], "}"}]}], "]"}]}], "/.", 
       RowBox[{
        RowBox[{"q", "-", "q0"}], "->", "x"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"equasTip", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"serTip", "/.", 
           RowBox[{"x", "->", "0"}]}], ")"}], "==", "q0"}], ",", " ", 
        "\[IndentingNewLine]", "\t\t", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"serTip", ",", "x"}], "]"}], "/.", 
           RowBox[{"x", "->", "0"}]}], ")"}], "==", " ", "1"}]}], "}"}]}], 
     ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"serBulk", "=", 
      RowBox[{
       RowBox[{"Normal", "@", 
        RowBox[{"Series", "[", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"\[Tau]bulk", "[", 
            RowBox[{"-", "\[Tau]"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"q", ",", "q0", ",", "1"}], "}"}]}], "]"}]}], "/.", 
       RowBox[{
        RowBox[{"q", "-", "q0"}], "->", "x"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"equasBulk", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"serBulk", "/.", 
           RowBox[{"x", "->", "0"}]}], ")"}], "==", "q0"}], ",", " ", 
        "\[IndentingNewLine]", "\t\t", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"serBulk", ",", "x"}], "]"}], "/.", 
           RowBox[{"x", "->", "0"}]}], ")"}], "==", " ", "1"}]}], "}"}]}], 
     ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"solTip", "=", 
      RowBox[{
       RowBox[{"Solve", "[", 
        RowBox[{"equasTip", ",", 
         RowBox[{"{", 
          RowBox[{"a0", ",", "a1"}], "}"}], ",", "Reals"}], "]"}], "//", 
       "FS"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"solBulk", "=", 
      RowBox[{
       RowBox[{"Solve", "[", 
        RowBox[{"equasBulk", ",", 
         RowBox[{"{", 
          RowBox[{"a0", ",", "a1"}], "}"}], ",", "Reals"}], "]"}], "//", 
       "FS"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Row", "[", 
