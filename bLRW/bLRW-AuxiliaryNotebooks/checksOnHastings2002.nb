Cell[TextData[StyleBox["KEY: THIS IS THE MULTIFRACTAL SPECTRUM OF THE \
HARMONIC MEASURE!!",
 FontSize->24]], "Text",
 CellChangeTimes->{{3.9902473235707817`*^9, 
  3.990247337669899*^9}},ExpressionUUID->"84cdedda-88d1-f84b-bc9c-\
f7622d66d49d"],

Cell[TextData[{
 StyleBox["The physical multifractal spectrum \[Tau](q) is related to the one \
in mathematical space ",
  FontSize->16],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Tau]", "y"], "(", "q", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,
  FontSize->16,ExpressionUUID->"5d74bc45-cc1c-c84f-a98d-0c1747873c11"],
 StyleBox[" through the relation",
  FontSize->16]
}], "Text",
 CellChangeTimes->{{3.990155672182022*^9, 
  3.9901557256865044`*^9}},ExpressionUUID->"f0c920a3-ebce-1349-aac1-\
30e6584ee712"],

Cell[BoxData[
 RowBox[{"\t\t\t\t\t\t\t\t\t\t\t\t", 
  StyleBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", 
         SubscriptBox["\[Tau]", 
          StyleBox["y", "TI"]], 
         RowBox[{"(", 
           RowBox[{"-", "\[Tau]", 
             RowBox[{"(", 
               StyleBox["q", "TI"], ")"}]}], ")"}], "\[LongEqual]", 
         StyleBox["q", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "-\\tau_y(-\\tau(q))=q", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"],
   FontSize->24]}]], "Input",
 CellChangeTimes->{{3.99015572854294*^9, 3.9901557577745495`*^9}, {
  3.990155788510372*^9, 3.990155791382786*^9}, {3.9901558411932144`*^9, 
  3.9901558413817863`*^9}},ExpressionUUID->"f325e4e4-0b0f-494c-8b89-\
06bad2aa1139"],

Cell[TextData[{
 StyleBox["There are two expressions for ",
  FontSize->16],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Tau]", "y"], "(", "q", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,
  FontSize->16,ExpressionUUID->"c6b34d08-9958-8043-9b57-fd5e97d07fa0"],
 ": one around the growing tip and another one away from it"
}], "Text",
 CellChangeTimes->{{3.990155651851362*^9, 3.990155666061146*^9}, {
  3.990155877650181*^9, 
  3.990155897170397*^9}},ExpressionUUID->"616c0639-2739-9e4b-b360-\
b87d61445973"],

Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       SubsuperscriptBox["\[Tau]", 
        StyleBox["y", "TI"], 
        RowBox[{
          StyleBox["t", "TI"], 
          StyleBox["i", "TI"], 
          StyleBox["p", "TI"]}]], 
       RowBox[{"(", 
         StyleBox["q", "TI"], ")"}], "\[LongEqual]", "2", 
       StyleBox["q", "TI"], "-", 
       StyleBox["m", "TI"], "-", "1", "+", 
       SqrtBox[
        RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{
               StyleBox["m", "TI"], "+", "1"}], ")"}], "2"], "-", "2", 
          StyleBox["m", "TI"], 
          StyleBox["q", "TI"]}]], "\n", 
       SubsuperscriptBox["\[Tau]", 
        StyleBox["y", "TI"], 
        RowBox[{
          StyleBox["b", "TI"], 
          StyleBox["u", "TI"], 
          StyleBox["l", "TI"], 
          StyleBox["k", "TI"]}]], 
       RowBox[{"(", 
         StyleBox["q", "TI"], ")"}], "\[LongEqual]", "2", 
       StyleBox["q", "TI"], "-", 
       StyleBox["m", "TI"], "-", "1", "+", 
       SqrtBox[
        RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{
               StyleBox["m", "TI"], "+", "1"}], ")"}], "2"], "-", "2", 
          StyleBox["m", "TI"], 
          StyleBox["q", "TI"]}]], "-", 
       FractionBox[
        RowBox[{
          StyleBox["m", "TI"], "+", "1", "-", 
          SqrtBox[
           RowBox[{
             SuperscriptBox[
              RowBox[{"(", 
                RowBox[{
                  StyleBox["m", "TI"], "+", "1"}], ")"}], "2"], "-", "2", 
             StyleBox["m", "TI"], 
             StyleBox["q", "TI"]}]]}], 
        StyleBox["m", "TI"]], "-", "1"}], TraditionalForm], "errors" -> {}, 
   "input" -> 
   "{\\tau^{tip}_y(q)=2q-m-1+\\sqrt{(m+1)^2-2mq}\\\\\\tau^{bulk}_y(q)=2q-m-1+\
\\sqrt{(m+1)^2-2mq}-\\frac{m+1-\\sqrt{(m+1)^2-2mq}}{m}-1}", "state" -> 
   "Boxes"|>,
  "TeXAssistantTemplate"]], "Input",
 CellChangeTimes->{{3.99015590527952*^9, 3.9901559241738005`*^9}},
