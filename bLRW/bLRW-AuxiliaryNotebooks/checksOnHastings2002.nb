    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{"\[Tau]bulk", "[", 
        RowBox[{"-", "\[Tau]data"}], "]"}]}], "==", "q"}], ",", "\[Tau]data", 
     ",", "Reals"}], "]"}]}]}]], "Input",
