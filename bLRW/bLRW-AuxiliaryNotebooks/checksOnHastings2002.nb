  StyleBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", 
         SubscriptBox["\[Tau]", 
          StyleBox["y", "TI"]], 
         RowBox[{"(", 
           RowBox[{"-", "\[Tau]", 
             RowBox[{"(", 
               StyleBox["q", "TI"], ")"}]}], ")"}], "\[LongEqual]", 
         StyleBox["q", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "-\\tau_y(-\\tau(q))=q", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"],
