Cell[TextData[{
 "Gemini says\n\t\t\t\t\t\t\t\t\t",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       FractionBox[
        SuperscriptBox[
         StyleBox["e", "TI"], 
         FractionBox[
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["k", "TI"], 
            StyleBox["x", "TI"]}], 
          RowBox[{"1", "-", 
            StyleBox["i", "TI"], 
            StyleBox["a", "TI"], 
            StyleBox["k", "TI"], 
            StyleBox["t", "TI"]}]]], 
        SuperscriptBox[
         RowBox[{"(", 
           RowBox[{"1", "-", 
             StyleBox["i", "TI"], 
             StyleBox["a", "TI"], 
             StyleBox["k", "TI"], 
             StyleBox["t", "TI"]}], ")"}], "2"]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\frac{e^{\\frac{i k x}{1-i a k t}}}{(1-i a k t)^2}$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6e5f9345-0431-e445-ab29-111d3c6ebd36"]
}], "Text",
 CellChangeTimes->{{3.982743638180126*^9, 3.9827436429451447`*^9}, {
  3.982744142350643*^9, 
  3.9827441491077595`*^9}},ExpressionUUID->"e774e678-308d-1b4a-8e6b-\
c0af58c34e67"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"pFT", "[", 
   RowBox[{"x_", ",", "k0_", ",", "t_", ",", "a_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", "/", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"I", "*", "a", "*", "k0", "*", "t"}]}], ")"}], "^", "2"}]}], 
    ")"}], "*", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"I", "*", "k0", "*", "x"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"I", "*", "a", "*", "k0", "*", "t"}]}], ")"}]}], 
    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pFT", "[", 
    RowBox[{"x", ",", "k", ",", "t", ",", "a"}], "]"}], "//", "TeXForm"}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9827436437582607`*^9, 3.9827436557142773`*^9}, {
  3.9827440220241203`*^9, 3.9827440238792477`*^9}, {3.9827441256948776`*^9, 
  3.9827441641713123`*^9}},
 CellLabel->"In[69]:=",ExpressionUUID->"02010e71-3591-7a40-a5c8-3ab8341f662c"],

