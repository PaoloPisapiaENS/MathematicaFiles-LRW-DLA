Cell[CellGroupData[{

Cell["\<\
Check that the Fourier of a square is the Convolution 
(with Assaf\[CloseCurlyQuote]s trick to write the convolution as momentum \
conservation)\
\>", "Section",
 CellChangeTimes->{{3.98359461922736*^9, 
  3.983594658616844*^9}},ExpressionUUID->"e6dec2c5-4885-5641-b4fc-\
99a58b001f2d"],

Cell[TextData[{
 "Assaf\[CloseCurlyQuote]s trick amounts to write the nasty convolution as a \
momentum conservation integral\n\t\t\t\t\t\t\t\t\t\t",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Integral]", 
          SubscriptBox[
           StyleBox["k", "TI"], "1"]], 
         StyleBox["f", "TI"], 
         RowBox[{"(", 
           SubscriptBox[
            StyleBox["k", "TI"], "1"], ")"}], 
         StyleBox["g", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["k", "TI"], "-", 
             SubscriptBox[
              StyleBox["k", "TI"], "1"]}], ")"}], "\[LongEqual]", 
         SubscriptBox["\[Integral]", 
          RowBox[{
            SubscriptBox[
             StyleBox["k", "TI"], "1"], ",", 
            SubscriptBox[
             StyleBox["k", "TI"], "2"]}]], 
         StyleBox["f", "TI"], 
         RowBox[{"(", 
           SubscriptBox[
            StyleBox["k", "TI"], "1"], ")"}], 
         StyleBox["g", "TI"], 
         RowBox[{"(", 
           SubscriptBox[
            StyleBox["k", "TI"], "2"], ")"}], "\[Delta]", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["k", "TI"], "1"], "+", 
             SubscriptBox[
              StyleBox["k", "TI"], "2"], "-", 
             StyleBox["k", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "$\\int_{k_1} f(k_1) g(k-k_1) = \\int_{k_1,k_2} f(k_1) \
g(k_2)\\delta(k_1+k_2-k)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "320a49bd-520b-534f-8b5b-fef109dda1e2"]
}], "Text",
 CellChangeTimes->{{3.9835946637253723`*^9, 3.9835947011011047`*^9}, {
  3.983594733213476*^9, 3.9835947490974255`*^9}, {3.983594780199541*^9, 
  3.9835948028998528`*^9}},ExpressionUUID->"e6273995-beb5-5f4c-a1ed-\
64db39f267dd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"FourierTransform", "[", 
  RowBox[{
   RowBox[{"Sin", "[", "x", "]"}], ",", "x", ",", "k"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"%", "^", "2"}], "//", 
  "Expand"}], "\[IndentingNewLine]", "0", "\[IndentingNewLine]", 
 RowBox[{"FourierTransform", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Sin", "[", "x", "]"}], "^", "2"}], ",", "x", ",", "k"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    FractionBox["1", 
     SqrtBox[
      RowBox[{"2", "\[Pi]"}]]], 
    RowBox[{"FourierTransform", "[", 
     RowBox[{
      RowBox[{"Sin", "[", "x", "]"}], ",", "x", ",", "k1"}], "]"}], 
    RowBox[{"FourierTransform", "[", 
     RowBox[{
      RowBox[{"Sin", "[", "x", "]"}], ",", "x", ",", "k2"}], "]"}], 
    RowBox[{"DiracDelta", "[", 
     RowBox[{"k1", "+", "k2", "-", "k"}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"k1", ",", 
     RowBox[{"-", "\[Infinity]"}], ",", "\[Infinity]"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"k2", ",", 
     RowBox[{"-", "\[Infinity]"}], ",", "\[Infinity]"}], "}"}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.9835944313695984`*^9, 3.983594605421543*^9}, {
  3.9835948231227016`*^9, 3.9835948537925816`*^9}},
 CellLabel->
  "In[144]:=",ExpressionUUID->"1183ce3a-9a42-b249-bd97-1c5e74692494"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ImaginaryI]", " ", 
   SqrtBox[
    FractionBox["\[Pi]", "2"]], " ", 
   RowBox[{"DiracDelta", "[", 
    RowBox[{
     RowBox[{"-", "1"}], "+", "k"}], "]"}]}], "-", 
  RowBox[{"\[ImaginaryI]", " ", 
   SqrtBox[
    FractionBox["\[Pi]", "2"]], " ", 
   RowBox[{"DiracDelta", "[", 
