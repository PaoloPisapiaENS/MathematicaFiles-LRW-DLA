Cell[CellGroupData[{

Cell["Backward with drift", "Section",
 CellChangeTimes->{{3.9827445425931168`*^9, 
  3.9827445463067455`*^9}},ExpressionUUID->"aef89e4b-e86d-454c-889c-\
48195a072a8c"],

Cell[TextData[{
 "Gemini says that the solution to the BACKWARD Diffusion equation with Diff \
coeff linear in x \n\t\t\t\t\t\t\t\t\t\t\t\t",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox["\[PartialD]", 
          RowBox[{"\[PartialD]", 
            StyleBox["t", "TI"]}]], 
         StyleBox["p", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", 
             StyleBox["t", "TI"]}], ")"}], "\[LongEqual]", 
         StyleBox["D", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], 
         FractionBox[
          RowBox[{"\[PartialD]", 
            SuperscriptBox["\[Null]", "2"]}], 
          RowBox[{"\[PartialD]", 
            SuperscriptBox[
             StyleBox["x", "TI"], "2"]}]], 
         StyleBox["p", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", 
             StyleBox["t", "TI"]}], ")"}], "+", 
         StyleBox["F", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], 
         FractionBox["\[PartialD]", 
          RowBox[{"\[PartialD]", 
            StyleBox["x", "TI"]}]], 
         StyleBox["p", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", 
             StyleBox["t", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "$\\frac{\\partial{}}{\\partial{t}}p(x,t) = \
D(x)\\frac{\\partial{}^2}{\\partial{x^2}} \
p(x,t)+F(x)\\frac{\\partial{}}{\\partial{x}} p(x,t)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bc33a1d7-54fa-eb48-a8e2-1efcc1574c36"],
 "\n\t\t\t\t\t\t\t\t\t\t\t\t\t",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["D", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
         StyleBox["a", "TI"], 
         StyleBox["x", "TI"], ",", 
         StyleBox["F", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", "2", 
         FractionBox["\[PartialD]", 
          RowBox[{"\[PartialD]", 
            StyleBox["x", "TI"]}]], 
         StyleBox["D", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "$D(x)=ax, F(x) = 2\\frac{\\partial{}}{\\partial{x}} D(x) $", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8237632a-2da7-8944-8d35-5b6e98352611"],
 "\nis\n\t\t\t\t\t\t\t\t\t\t\t",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["p", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", 
             SubscriptBox[
              StyleBox["x", "TI"], "0"], ",", 
             StyleBox["t", "TI"], ",", 
             StyleBox["a", "TI"]}], ")"}], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["e", "TI"], 
             FractionBox[
              RowBox[{"-", 
                StyleBox["x", "TI"], "-", 
                SubscriptBox[
                 StyleBox["x", "TI"], "0"]}], 
              RowBox[{
                StyleBox["a", "TI"], 
                StyleBox["t", "TI"]}]]], 
            SubscriptBox[
             StyleBox["I", "TI"], "0"], 
            RowBox[{"(", 
              FractionBox[
               RowBox[{"2", 
                 SqrtBox[
                  RowBox[{
                    StyleBox["x", "TI"], 
                    SubscriptBox[
                    StyleBox["x", "TI"], "0"]}]]}], 
               RowBox[{
                 StyleBox["a", "TI"], 
                 StyleBox["t", "TI"]}]], ")"}]}], 
          RowBox[{
            StyleBox["a", "TI"], 
            StyleBox["t", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "$p(x,x_0,t,a)=\\frac{e^{\\frac{-x-x_0}{a t}} I_0\\left(\\frac{2 \
\\sqrt{x x_0}}{a t}\\right)}{a t}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "45d894a5-cf16-484d-a864-cd41e2c22450"]
}], "Text",
 CellChangeTimes->{{3.9827415771743717`*^9, 3.9827416015161476`*^9}, {
   3.9827417070057163`*^9, 3.982741708250908*^9}, {3.9827420912214203`*^9, 
   3.9827421235681953`*^9}, {3.9827421610232506`*^9, 3.982742165260975*^9}, 
   3.9827423057208977`*^9, {3.982742546399143*^9, 3.982742548454338*^9}, {
   3.982742582006321*^9, 3.982742583418993*^9}, {3.9827431257883987`*^9, 
   3.982743162781271*^9}, {3.982744562196308*^9, 
   3.98274463595788*^9}},ExpressionUUID->"9643c493-5048-e54b-a945-\
945de955d23a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"pBackward", "[", 
   RowBox[{"x_", ",", "x0_", ",", "t_", ",", "a_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"a", "*", "t"}], ")"}]}], ")"}], "*", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"x", "+", "x0"}], ")"}]}], "/", 
     RowBox[{"(", 
      RowBox[{"a", "*", "t"}], ")"}]}], "]"}], "*", 
   RowBox[{"BesselI", "[", 
    RowBox[{"0", ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", "*", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"x", "*", "x0"}], "]"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"a", "*", "t"}], ")"}]}]}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pBackward", "[", 
    RowBox[{"x", ",", 
     SubscriptBox["x", "0"], ",", "t", ",", "a"}], "]"}], "//", "TeXForm"}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9827445481207275`*^9, 3.982744548121708*^9}, {
  3.982744647592924*^9, 3.9827446780920315`*^9}},
 CellLabel->"In[81]:=",ExpressionUUID->"23d65a89-038a-2c4a-8518-2b3f2c4edf00"],

