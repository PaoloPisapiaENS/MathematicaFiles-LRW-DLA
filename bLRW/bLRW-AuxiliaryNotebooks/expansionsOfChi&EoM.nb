Cell[CellGroupData[{

Cell["Std Diffusion", "Section",
 CellChangeTimes->{{3.9827473596788597`*^9, 
  3.9827473638974667`*^9}},ExpressionUUID->"fbf1e198-537c-f644-a013-\
3fc29bacd92c"],

Cell[TextData[{
 "The solution to the BACKWARD Diffusion equation with constant Diff coeff  \n\
\t\t\t\t\t\t\t\t\t\t\t\t\t",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox["\[PartialD]", 
          RowBox[{"\[PartialD]", 
            StyleBox["t", "TI"]}]], 
         StyleBox["p", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", 
             StyleBox["t", "TI"]}], ")"}], "\[LongEqual]", 
         StyleBox["D", "TI"], 
         FractionBox[
          RowBox[{"\[PartialD]", 
            SuperscriptBox["\[Null]", "2"]}], 
          RowBox[{"\[PartialD]", 
            SuperscriptBox[
             StyleBox["x", "TI"], "2"]}]], 
         StyleBox["p", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", 
             StyleBox["t", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "$\\frac{\\partial{}}{\\partial{t}}p(x,t) = \
D\\frac{\\partial{}^2}{\\partial{x^2}} p(x,t)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7b033bcb-542a-464f-85f3-06f6680eff82"],
 "\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["D", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", "\[Gamma]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "$D(x)=\\gamma $", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bd9ab855-49d2-f749-82a6-c5f250e4e817"],
 "\nis\n\t\t\t\t\t\t\t\t\t\t\t",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["p", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", 
             StyleBox["t", "TI"], ";", "\[Gamma]", ",", 
             StyleBox["d", "TI"]}], ")"}], "\[LongEqual]", 
         FractionBox[
          SuperscriptBox[
           StyleBox["e", "TI"], 
           RowBox[{"-", 
             FractionBox[
              SuperscriptBox[
               StyleBox["x", "TI"], "2"], 
              RowBox[{"4", "\[Gamma]", 
                StyleBox["t", "TI"]}]]}]], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"4", "\[Gamma]\[Pi]", 
               StyleBox["t", "TI"]}], ")"}], 
           RowBox[{
             StyleBox["d", "TI"], "/", "2"}]]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$p(x,t;\\gamma,d)=\\frac{ e^{-\\frac{x^2}{4\\gamma t}}}{(4 \\gamma \\pi \
t)^{d/2}}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e90691b5-c353-e84e-9ea4-f1a0a52ed848"]
}], "Text",
 CellChangeTimes->{{3.982741577174372*^9, 3.9827416015161476`*^9}, {
   3.982741707005717*^9, 3.982741708250908*^9}, {3.9827420912214203`*^9, 
   3.9827421235681944`*^9}, {3.9827421610232496`*^9, 3.982742165260975*^9}, 
   3.9827423057208977`*^9, {3.982742546399143*^9, 3.982742548454338*^9}, {
   3.982742582006321*^9, 3.982742583418993*^9}, {3.9827431257883987`*^9, 
