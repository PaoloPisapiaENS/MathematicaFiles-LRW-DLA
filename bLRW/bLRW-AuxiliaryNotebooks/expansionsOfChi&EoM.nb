Cell[TextData[{
 "The solution to the BACKWARD Diffusion equation with constant Diff coeff  \n\
\t\t\t\t\t\t\t\t\t\t\t\t\t",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox["\[PartialD]", 
          RowBox[{"\[PartialD]", 
            StyleBox["t", "TI"]}]], 
         StyleBox["p", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", 
             StyleBox["t", "TI"]}], ")"}], "\[LongEqual]", 
         StyleBox["D", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], 
         FractionBox[
          RowBox[{"\[PartialD]", 
            SuperscriptBox["\[Null]", "2"]}], 
          RowBox[{"\[PartialD]", 
            SuperscriptBox[
             StyleBox["x", "TI"], "2"]}]], 
         StyleBox["p", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", 
             StyleBox["t", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "$\\frac{\\partial{}}{\\partial{t}}p(x,t) = \
D(x)\\frac{\\partial{}^2}{\\partial{x^2}} p(x,t)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b7839d0e-d736-5c4e-9934-f17b1840da50"],
 "\nis obtained by the Liouville Transform\n\t\t\t\t\t\t\t\t\t\t\t\t",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["z", "TI"], "\[LongEqual]", 
         SubsuperscriptBox["\[Integral]", "0", 
          StyleBox["x", "TI"]], 
         FractionBox["1", 
          SqrtBox[
           RowBox[{
             StyleBox["D", "TI"], "(", 
             SubscriptBox[
              StyleBox["x", "TI"], "0"], ")"}]]], 
         StyleBox["d", "TI"], 
         SubscriptBox[
          StyleBox["x", "TI"], "0"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "$z=\\int_0^x \\frac{1}{\\sqrt{D(x_0)}}dx_0$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2cfed719-570a-a34e-bc55-bbcd72f795c6"],
 "\n\t\t\t\t\t\t\t\t\t\t\t\t",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["p", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["z", "TI"], ",", 
             StyleBox["t", "TI"], ";", "\[Gamma]", ",", 
             StyleBox["d", "TI"]}], ")"}], "\[LongEqual]", 
         FractionBox[
          SuperscriptBox[
           StyleBox["e", "TI"], 
           RowBox[{"-", 
             FractionBox[
              SuperscriptBox[
               StyleBox["z", "TI"], "2"], 
              RowBox[{"4", 
                StyleBox["t", "TI"]}]]}]], 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"4", "\[Pi]", 
               StyleBox["t", "TI"]}], ")"}], 
           RowBox[{
             StyleBox["d", "TI"], "/", "2"}]]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$p(z,t;\\gamma,d)=\\frac{ e^{-\\frac{z^2}{4 t}}}{(4 \\pi t)^{d/2}}$", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "81ff87de-e9d4-6f45-983f-7ce2206fa349"]
}], "Text",
