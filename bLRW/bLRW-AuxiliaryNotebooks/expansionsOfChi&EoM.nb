   3.9827474003585043`*^9}},ExpressionUUID->"a51e75c1-0f9d-674f-bd6d-\
01c4495e5978"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"p", "[", 
   RowBox[{"x_", ",", "t_", ",", "\[Gamma]_", ",", "d_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", "/", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"4", " ", "\[Pi]", " ", "\[Gamma]", " ", "t"}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"d", "/", "2"}], ")"}]}]}], ")"}], "*", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{
       RowBox[{"(", "x", ")"}], "^", "2"}]}], "/", 
     RowBox[{"(", 
      RowBox[{"4", "\[Gamma]", "*", "t"}], ")"}]}], 
    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p", "[", 
    RowBox[{"x", ",", "x0", ",", "t", ",", "a"}], "]"}], "//", "TeXForm"}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9827426181365604`*^9, 3.9827426181365604`*^9}, 
