Cell[CellGroupData[{

Cell["Forward", "Subsection",
 CellChangeTimes->{{3.982742561798847*^9, 
  3.9827425634681187`*^9}},ExpressionUUID->"992d08cf-298b-5141-ac35-\
13956976baba"],

Cell[TextData[{
 "Gemini says that the solution to the FORWARD Diffusion equation with Diff \
coeff linear in x \n\t\t\t\t\t\t\t\t\t\t\t\t\t",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox["\[PartialD]", 
          RowBox[{"\[PartialD]", 
            StyleBox["t", "TI"]}]], 
         StyleBox["u", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", 
             StyleBox["t", "TI"]}], ")"}], "\[LongEqual]", 
         FractionBox["\[PartialD]", 
          RowBox[{"\[PartialD]", 
            StyleBox["x", "TI"]}]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["D", "TI"], 
             RowBox[{"(", 
               StyleBox["x", "TI"], ")"}], 
             FractionBox["\[PartialD]", 
              RowBox[{"\[PartialD]", 
                StyleBox["x", "TI"]}]], 
             StyleBox["u", "TI"], 
             RowBox[{"(", 
               RowBox[{
                 StyleBox["x", "TI"], ",", 
                 StyleBox["t", "TI"]}], ")"}]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\frac{\\partial{}}{\\partial{t}}u(x,t) = \
\\frac{\\partial{}}{\\partial{x}}\\big(D(x)\\frac{\\partial{}}{\\partial{x}} \
u(x,t )\\big)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c3e9f119-273f-5f40-a0fc-19ea3413281d"],
 "\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["D", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
         StyleBox["a", "TI"], 
         StyleBox["x", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "$D(x)=ax$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7fc852f5-173a-3645-8517-cd25ca82c7bc"],
 "\nis\n\t\t\t\t\t\t\t\t\t\t\t\t",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["u", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", 
             StyleBox["t", "TI"], ",", 
             SubscriptBox[
              StyleBox["x", "TI"], "0"], ",", 
             StyleBox["a", "TI"]}], ")"}], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["e", "TI"], 
             FractionBox[
              RowBox[{"-", 
                StyleBox["x", "TI"], "-", 
                SubscriptBox[
                 StyleBox["x", "TI"], "0"]}], 
              RowBox[{
                StyleBox["a", "TI"], 
                StyleBox["t", "TI"]}]]], 
            SubscriptBox[
             StyleBox["I", "TI"], "0"], 
            RowBox[{"(", 
              FractionBox[
               RowBox[{"2", 
                 SqrtBox[
                  RowBox[{
                    StyleBox["x", "TI"], 
                    SubscriptBox[
                    StyleBox["x", "TI"], "0"]}]]}], 
               RowBox[{
                 StyleBox["a", "TI"], 
                 StyleBox["t", "TI"]}]], ")"}]}], 
          RowBox[{
            StyleBox["a", "TI"], 
            StyleBox["t", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "$u(x,t,x_0,a)=\\frac{e^{\\frac{-x-x_0}{a t}} I_0\\left(\\frac{2 \
\\sqrt{x x_0}}{a t}\\right)}{a t}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a5a30339-17bb-2f42-971d-4fe8bf7fdc97"]
}], "Text",
 CellChangeTimes->{{3.9827415771743717`*^9, 3.9827416015161476`*^9}, {
   3.9827417070057163`*^9, 3.982741708250908*^9}, {3.9827420912214203`*^9, 
   3.9827421235681953`*^9}, {3.9827421610232506`*^9, 3.982742165260975*^9}, 
   3.9827423057208977`*^9, {3.982742546399143*^9, 3.982742548454338*^9}, {
   3.982743213063019*^9, 
   3.982743237235445*^9}},ExpressionUUID->"9119a648-1d81-2b45-91d6-\
643e87602a66"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"u", "[", 
   RowBox[{"x_", ",", "t_", ",", "x0_", ",", "a_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"a", "*", "t"}], ")"}]}], ")"}], "*", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"x", "+", "x0"}], ")"}]}], "/", 
     RowBox[{"(", 
      RowBox[{"a", "*", "t"}], ")"}]}], "]"}], "*", 
   RowBox[{"BesselI", "[", 
    RowBox[{"0", ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", "*", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"x", "*", "x0"}], "]"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"a", "*", "t"}], ")"}]}]}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
