 CellChangeTimes->{{3.9827425728772736`*^9, 
  3.982742574626831*^9}},ExpressionUUID->"f5639bca-7366-d74a-8e53-\
6adcaa94630b"],

Cell[TextData[{
 "Gemini says that the solution to the BACKWARD Diffusion equation with Diff \
coeff linear in x \n\t\t\t\t\t\t\t\t\t\t\t\t\t",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox["\[PartialD]", 
          RowBox[{"\[PartialD]", 
            StyleBox["t", "TI"]}]], 
         StyleBox["p", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", 
             StyleBox["t", "TI"]}], ")"}], "\[LongEqual]", 
         StyleBox["D", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], 
         FractionBox[
          RowBox[{"\[PartialD]", 
            SuperscriptBox["\[Null]", "2"]}], 
          RowBox[{"\[PartialD]", 
            SuperscriptBox[
             StyleBox["x", "TI"], "2"]}]], 
         StyleBox["p", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", 
             StyleBox["t", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "$\\frac{\\partial{}}{\\partial{t}}p(x,t) = \
D(x)\\frac{\\partial{}^2}{\\partial{x^2}} p(x,t)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "693a327e-e877-474b-bbd9-57ed9514a508"],
 "\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["D", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
         StyleBox["a", "TI"], 
         StyleBox["x", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "$D(x)=ax$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "867db7d1-99ba-7b46-a13b-0a30507a9fcd"],
 "\nis\n\t\t\t\t\t\t\t\t\t\t\t",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["p", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", 
             SubscriptBox[
              StyleBox["x", "TI"], "0"], ",", 
             StyleBox["t", "TI"], ",", 
             StyleBox["a", "TI"]}], ")"}], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            SqrtBox[
             FractionBox[
              SubscriptBox[
               StyleBox["x", "TI"], "0"], 
              StyleBox["x", "TI"]]], 
            SuperscriptBox[
             StyleBox["e", "TI"], 
             FractionBox[
              RowBox[{"-", 
                StyleBox["x", "TI"], "-", 
                SubscriptBox[
                 StyleBox["x", "TI"], "0"]}], 
              RowBox[{
                StyleBox["a", "TI"], 
                StyleBox["t", "TI"]}]]], 
            SubscriptBox[
             StyleBox["I", "TI"], "1"], 
            RowBox[{"(", 
              FractionBox[
               RowBox[{"2", 
                 SqrtBox[
                  RowBox[{
                    StyleBox["x", "TI"], 
                    SubscriptBox[
                    StyleBox["x", "TI"], "0"]}]]}], 
               RowBox[{
                 StyleBox["a", "TI"], 
                 StyleBox["t", "TI"]}]], ")"}]}], 
          RowBox[{
            StyleBox["a", "TI"], 
            StyleBox["t", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "$p(x,x_0,t,a)=\\frac{\\sqrt{\\frac{x_0}{x}} e^{\\frac{-x-x_0}{a t}} I_1\
\\left(\\frac{2 \\sqrt{x x_0}}{a t}\\right)}{a t}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fc16c583-d711-1a4b-bf7c-d913fb36366a"]
}], "Text",
 CellChangeTimes->{{3.9827415771743717`*^9, 3.9827416015161476`*^9}, {
