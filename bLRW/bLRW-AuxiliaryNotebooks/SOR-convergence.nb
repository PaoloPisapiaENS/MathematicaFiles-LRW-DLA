Cell["Drop the first few", "Subsection",
 CellChangeTimes->{{3.97071663987309*^9, 3.970716649585865*^9}, {
  3.970716728416941*^9, 
  3.9707167291998158`*^9}},ExpressionUUID->"5150ac95-bbd5-8c4c-ae23-\
