Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"threshold", "=", "120"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dropped", "=", 
   RowBox[{
    StyleBox["dropped1",
     Background->RGBColor[1, 0.5, 0]], "=", 
    RowBox[{"DeleteCases", "[", 
     RowBox[{"rawData1", ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a_", ",", "_"}], "}"}], "/;", 
       RowBox[{"a", ">", "threshold"}]}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lm", "=", 
    RowBox[{"LinearModelFit", "[", 
     RowBox[{
      RowBox[{"Log", "[", "dropped", "]"}], ",", "x", ",", "x"}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Show", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ListLogLogPlot", "[", 
      RowBox[{"rawData1", ",", 
       RowBox[{"PlotStyle", "->", "Black"}]}], "]"}], ",", 
     RowBox[{"ListLogLogPlot", "[", 
      RowBox[{"dropped", ",", 
       RowBox[{"PlotStyle", "->", "Green"}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"lm", "[", "x", "]"}], ",", 
