Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"plotsm6", "[", 
     RowBox[{"[", "2", "]"}], "]"}], "/.", 
    RowBox[{
     RowBox[{"RGBColor", "[", "___", "]"}], "->", "Purple"}]}], "/.", 
   RowBox[{
    RowBox[{"PointLegend", "[", 
     RowBox[{"bef_", ",", 
      RowBox[{"{", "__", "}"}], ",", "opts__"}], "]"}], ":>", 
    RowBox[{"PointLegend", "[", 
     RowBox[{"bef", ",", 
      RowBox[{"{", 
       RowBox[{"Row", "[", 
        RowBox[{"{", "\"\<\[Epsilon] = 1e-6\>\"", "}"}], "]"}], "}"}], ",", 
      "opts"}], "]"}]}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Pull", " ", "the", " ", "data", " ", "points", " ", "out", " ",
     "of", " ", "the", " ", "existing", " ", "plot"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"data", "=", 
    RowBox[{"Cases", "[", 
     RowBox[{"%", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Line", "|", "Point"}], ")"}], "[", 
        RowBox[{"pts_", "?", "MatrixQ"}], "]"}], ":>", "pts"}], ",", 
      "Infinity"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"logdata", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"Log", "[", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}], "&"}], "/@", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"data", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ")"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ">", "0"}], "&"}]}], "]"}]}]}], 
   ";"}], "\n", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lm", "=", 
    RowBox[{"LinearModelFit", "[", 
     RowBox[{"logdata", ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "x", ",", 
        RowBox[{"x", "^", "2"}]}], "}"}], ",", "x"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Show", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ListLogPlot", "[", "data", "]"}], "\[IndentingNewLine]", ",", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"lm", "[", "x", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "5001"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", "Red"}]}], "]"}]}], "}"}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
