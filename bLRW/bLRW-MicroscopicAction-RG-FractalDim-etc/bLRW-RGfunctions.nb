Cell[TextData[{
 "Other way (maybe with a factor of 1/2): ",
 Cell[BoxData[
  RowBox[{"\t", 
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["g", "TI"], "\[Phi]\[Phi]"], "\[LongEqual]", 
         OverscriptBox[
          StyleBox["g", "TI"], "~"], "+", 
         OverscriptBox[
          StyleBox["g", "TI"], "^"], "\n", "\[DoubleLongRightArrow]  ", 
         SubscriptBox["\[Beta]", "\[Phi]\[Psi]"], 
         RowBox[{"(", 
           RowBox[{
             OverscriptBox[
              StyleBox["g", "TI"], "~"], ",", 
             OverscriptBox[
              StyleBox["g", "TI"], "^"]}], ")"}], "\[LongEqual]", 
         OverscriptBox["\[Beta]", "~"], 
         RowBox[{"(", 
           RowBox[{
             OverscriptBox[
              StyleBox["g", "TI"], "~"], ",", 
             OverscriptBox[
              StyleBox["g", "TI"], "^"]}], ")"}], "+", 
         OverscriptBox["\[Beta]", "^"], 
         RowBox[{"(", 
           RowBox[{
             OverscriptBox[
              StyleBox["g", "TI"], "~"], ",", 
             OverscriptBox[
              StyleBox["g", "TI"], "^"]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "g_{\\phi\\phi}= \\tilde g +\\hat g \\\\ \\implies\\quad \
\\beta_{\\phi\\psi}(\\tilde g, \\hat g) = \\tilde \\beta(\\tilde g, \\hat g) \
+\\hat \\beta(\\tilde g, \\hat g)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"]}]], "Input",
  CellChangeTimes->{{3.9942426513799515`*^9, 3.994242660406481*^9}, {
   3.9942428150064507`*^9, 3.994242835596773*^9}},
  FontSize->18,ExpressionUUID->"de8bb741-dd3f-9946-a0f7-91cfc355d642"],
 "\[LineSeparator]with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          OverscriptBox[
           StyleBox["g", "TI"], "~"], 
          StyleBox["B", "TI"]], "\[LongEqual]", 
         SuperscriptBox["\[Mu]", "\[Epsilon]"], 
         SubscriptBox[
          OverscriptBox[
           StyleBox["g", "TI"], "~"], 
          StyleBox["R", "TI"]], 
         SubscriptBox[
          StyleBox["Z", "TI"], 
          OverscriptBox[
           StyleBox["g", "TI"], "~"]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\tilde g_B = \\mu^{\\epsilon} \\tilde g_R Z_{\\tilde g}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9e881974-8157-634c-a032-600dcabd8339"],
 " and  ",
