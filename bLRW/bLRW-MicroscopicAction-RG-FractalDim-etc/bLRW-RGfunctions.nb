              RowBox[{
                StyleBox["c", "TI"], 
                StyleBox["r", "TI"], 
                StyleBox["o", "TI"], 
                StyleBox["s", "TI"], 
                StyleBox["s", "TI"]}]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
