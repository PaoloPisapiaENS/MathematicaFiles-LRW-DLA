            RowBox[{
             SuperscriptBox["g0", "n_"], " ", 
             SuperscriptBox["\[Mu]", 
              RowBox[{
               RowBox[{"-", "n_"}], " ", "\[Epsilon]"}]]}], ":>", 
            RowBox[{
             SuperscriptBox[
