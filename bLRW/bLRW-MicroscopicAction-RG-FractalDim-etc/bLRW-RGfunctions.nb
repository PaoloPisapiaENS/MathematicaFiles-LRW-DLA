            RowBox[{
             RowBox[{"(", "gr", ")"}], 
             SuperscriptBox["\[Mu]", 
              RowBox[{" ", "\[Epsilon]"}]]}]}]}], "//", "Expand"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"\[Beta]f", "=", 
