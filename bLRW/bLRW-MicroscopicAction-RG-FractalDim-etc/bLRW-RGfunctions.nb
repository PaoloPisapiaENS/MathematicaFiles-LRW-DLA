        "\[IndentingNewLine]", 
        RowBox[{"\[Beta]f", "=", 
         RowBox[{
          RowBox[{"\[Beta]f", "/.", 
           RowBox[{
            RowBox[{
             SuperscriptBox["g0", "n_"], "/;", 
             RowBox[{"n", "==", "nLoop"}]}], ":>", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"g", " ", 
               SuperscriptBox["\[Mu]", "\[Epsilon]"]}], ")"}], "n"]}]}], "//",
           "Expand"}]}], ";", "\[IndentingNewLine]", 
        StyleBox[
         RowBox[{"If", "[", 
