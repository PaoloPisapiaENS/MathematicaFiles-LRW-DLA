Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\[Beta]FunctionFromZ", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "\[Beta]FunctionFromZ", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{"\"\<print\>\"", "->", "False"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Beta]FunctionFromZ", "[", 
   RowBox[{"Zg_", ",", 
    RowBox[{"LoopOrder_", ":", "0"}], ",", 
    RowBox[{"gg_", ":", 
     RowBox[{"{", "g", "}"}]}], ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"z", ",", "\[Beta]f", ",", "nLoop", ",", "i"}], "}"}], ",", 
    "\[IndentingNewLine]", 
