              RowBox[{"n", " ", "\[Epsilon]"}]]}]}]}], "//", "Expand"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"\[Beta]f", "=", 
         RowBox[{
          RowBox[{"\[Beta]f", "/.", 
