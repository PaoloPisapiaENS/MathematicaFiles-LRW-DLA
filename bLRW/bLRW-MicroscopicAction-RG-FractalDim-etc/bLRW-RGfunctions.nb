Cell[TextData[StyleBox["Here I just replace Z_gt by Z_g*Z_\[Gamma]1, but this \
should be the wrong way to compute \[Beta]... However the result is correct",
 Background->RGBColor[1, 1, 0.85]]], "Item",
 CellChangeTimes->{{3.9942426305053253`*^9, 3.9942426448503056`*^9}, {
  3.9942428532562904`*^9, 
