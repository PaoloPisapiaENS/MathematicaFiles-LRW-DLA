Cell[CellGroupData[{

Cell["More convincing inversion of Z\[Phi]", "Subsubsection",
 CellChangeTimes->{{3.974540476484211*^9, 3.974540494467901*^9}, 
   3.974541101543621*^9},ExpressionUUID->"8e303f00-f200-1142-8087-\
3e1bab38b293"],

Cell[TextData[{
 "The way we do it is to define effective (renormalized) quantities starting \
from bare ones, e.g.  g",
 Cell[BoxData[
  FormBox[
   RowBox[{"=", 
    RowBox[{
     SuperscriptBox["Zg", 
      RowBox[{"-", "1"}]], "g0"}]}], TraditionalForm]],ExpressionUUID->
  "7972a093-b642-a54d-bbe7-298d2ae14569"],
 ", and for us the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["Z", 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "73a11588-7023-7141-b2fe-2554772f30a4"],
 " are expressed in terms of bare quantities. So, i think that this is the \
way to do it, not as in the following section"
}], "Text",
 CellChangeTimes->{{3.974541112004286*^9, 
  3.974541260671614*^9}},ExpressionUUID->"24eeba2c-2b79-e94f-8165-\
8ef2783f46d6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"g", "=", 
   RowBox[{
    RowBox[{"g0", " ", 
     SuperscriptBox["\[Mu]", 
      RowBox[{"-", "\[Epsilon]"}]]}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"b", "+", "2"}], ")"}], "banana", " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"g0", " ", 
        SuperscriptBox["\[Mu]", 
         RowBox[{"-", "\[Epsilon]"}]]}], ")"}], "2"]}], "+", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"g0", " ", 
        SuperscriptBox["\[Mu]", 
         RowBox[{"-", "\[Epsilon]"}]]}], ")"}], "3"], 
     RowBox[{"(", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"b", "+", "2"}], ")"}], 
       RowBox[{"(", " ", 
        RowBox[{"doubleBanana", " ", "+", " ", 
         RowBox[{"2", 
          RowBox[{"(", 
           RowBox[{"b", "+", "1"}], ")"}], " ", "hat"}]}], ")"}]}], 
      ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Z\[Phi]inv", " ", "=", " ", 
   RowBox[{"1", "-", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"g0", " ", 
        SuperscriptBox["\[Mu]", 
         RowBox[{"-", "\[Epsilon]"}]]}], ")"}], "2"], 
     FractionBox[
      RowBox[{"b", 
       RowBox[{"(", 
        RowBox[{"b", "-", "1"}], ")"}]}], "2"], 
     RowBox[{"(", " ", 
      RowBox[{"sunset", " ", "+", " ", 
       RowBox[{"(", 
        RowBox[{"hat", "-", 
         RowBox[{
          FractionBox["1", "2"], 
          RowBox[{
           RowBox[{"(", "banana", ")"}], "^", "2"}]}]}], 
        RowBox[{"(*", " ", 
         RowBox[{"From", " ", "\[CapitalGamma]2", " ", "counterterm"}], 
         "*)"}], ")"}]}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"\[Beta]Function", "[", 
  RowBox[{
   RowBox[{"Z\[Phi]inv", " ", "g"}], ",", 
   RowBox[{"\"\<g0Order\>\"", "->", "3"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"%", "/.", 
       RowBox[{"banana", " ", "->", 
        RowBox[{"1", "/", "\[Epsilon]"}]}]}], "/.", 
      RowBox[{"doubleBanana", " ", "->", 
       RowBox[{"1", "/", 
        SuperscriptBox["\[Epsilon]", "2"]}]}]}], "/.", 
     RowBox[{"hat", " ", "->", 
      RowBox[{
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"2", 
          SuperscriptBox["\[Epsilon]", "2"]}], ")"}]}], "+", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"4", "\[Epsilon]"}], ")"}]}]}]}]}], "/.", 
    RowBox[{"sunset", "->", 
     RowBox[{
      RowBox[{"-", "1"}], "/", 
      RowBox[{"(", 
       RowBox[{"8", "\[Epsilon]"}], ")"}]}]}]}], "//", "FullSimplify"}], "//",
   "Factor"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RGeq2", "=", 
   RowBox[{
    RowBox[{"Simplify", "[", 
     RowBox[{"Normal", "[", "%", "]"}], "]"}], "==", "0"}]}], ";"}]}], "Input",
