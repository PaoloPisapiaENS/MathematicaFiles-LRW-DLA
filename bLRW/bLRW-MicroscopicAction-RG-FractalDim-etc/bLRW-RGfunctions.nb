  RowBox[{"Series", "[", 
   RowBox[{"%", ",", 
    RowBox[{"{", 
     RowBox[{"\[Epsilon]", ",", "0", ",", "3"}], "}"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Flatten", "@", 
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{"Normal", "[", "%", "]"}], ",", "B"}], "]"}]}], "//", 
  "FS"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gc2", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"gc2", "/.", "%"}], ")"}], "//", "FullSimplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"gc2", "=", 
  RowBox[{"Collect", "[", 
   RowBox[{
    RowBox[{"Expand", "@", "gc2"}], ",", "\[Epsilon]", ",", "Simplify"}], 
   "]"}]}]}], "Input",
