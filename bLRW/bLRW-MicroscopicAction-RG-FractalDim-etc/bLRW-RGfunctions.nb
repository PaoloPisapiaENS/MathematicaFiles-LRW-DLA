      RowBox[{
       RowBox[{"nLoop", "==", "0"}], ",", 
       RowBox[{"nLoop", "=", 
        RowBox[{"Exponent", "[", 
         RowBox[{"coupling", ",", "g0"}], "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"gr", "=", 
      RowBox[{"Normal", "@", 
       RowBox[{"Series", "[", 
        RowBox[{"coupling", ",", 
         RowBox[{"{", 
          RowBox[{"g0", ",", "0", ",", "nLoop"}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"OptionValue", "[", 
