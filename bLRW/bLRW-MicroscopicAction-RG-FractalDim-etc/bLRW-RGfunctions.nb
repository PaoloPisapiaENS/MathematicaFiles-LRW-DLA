Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Zg", "=", 
    RowBox[{"1", "+", 
     RowBox[{"2", " ", "g", " ", 
      FractionBox["1", "\[Epsilon]"]}], "-", 
     RowBox[{
      RowBox[{"g", "^", "2"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         FractionBox[
          RowBox[{"-", "7"}], 
          RowBox[{"\[Epsilon]", "^", "2"}]], 
         StyleBox[
          FractionBox["5", "7"],
          Background->RGBColor[1, 0.5, 0]]}], "+", 
        FractionBox["5", 
         RowBox[{"2", "\[Epsilon]"}]]}], ")"}]}]}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"a", "=", 
    StyleBox[
     FractionBox["5", "7"],
     Background->RGBColor[1, 0.5, 0]]}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Z\[Gamma]1", "=", 
    RowBox[{"1", "+", " ", 
     RowBox[{"g", " ", 
      FractionBox["1", "\[Epsilon]"]}], "-", 
     RowBox[{
      RowBox[{"g", "^", "2"}], " ", 
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         RowBox[{"-", "2"}], 
         RowBox[{"\[Epsilon]", "^", "2"}]], "+", 
        FractionBox["1", 
         RowBox[{"2", "\[Epsilon]"}]]}], ")"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
