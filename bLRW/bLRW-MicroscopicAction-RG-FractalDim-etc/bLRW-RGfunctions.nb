Cell[TextData[{
 "The way we do it is to define effective (renormalized) quantities starting \
from bare ones, e.g.  g",
 Cell[BoxData[
  FormBox[
   RowBox[{"=", 
    RowBox[{
     SuperscriptBox["Zg", 
      RowBox[{"-", "1"}]], "g0"}]}], TraditionalForm]],ExpressionUUID->
  "c52429c5-abbb-e04f-8087-778d7676b86d"],
 ", and for us the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["Z", 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "8bab957e-d1e5-e54b-9695-55e9f22522b9"],
 " are expressed in terms of bare quantities. So, i think that this is the \
way to do it, not as in the following section"
}], "Text",
 CellChangeTimes->{{3.974541112004286*^9, 
  3.974541260671614*^9}},ExpressionUUID->"fee94c30-00ea-c840-9da9-\
343efd21a826"],

