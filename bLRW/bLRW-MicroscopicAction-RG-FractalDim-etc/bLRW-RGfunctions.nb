              RowBox[{"{", 
               RowBox[{"g0", ",", "0", ",", "nLoop"}], "}"}]}], "]"}], "//", 
            "Expand"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"\[Beta]f", "=", 
         RowBox[{"\[Beta]f", "/.", 
