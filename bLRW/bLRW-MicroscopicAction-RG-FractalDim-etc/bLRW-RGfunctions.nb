  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          OverscriptBox[
           StyleBox["g", "TI"], "^"], 
          StyleBox["B", "TI"]], "\[LongEqual]", 
         SuperscriptBox["\[Mu]", "\[Epsilon]"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              OverscriptBox[
               StyleBox["g", "TI"], "^"], 
              StyleBox["R", "TI"]], 
             SubscriptBox[
              StyleBox["Z", "TI"], 
              OverscriptBox[
