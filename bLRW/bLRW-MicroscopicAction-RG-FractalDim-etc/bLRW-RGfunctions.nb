Cell[CellGroupData[{

Cell[TextData[{
 "I can write \[Beta] as  ",
 Cell[BoxData[
  RowBox[{"\[IndentingNewLine]", 
   RowBox[{
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{"\[Beta]", "\[LongEqual]", "\[Epsilon]", 
          SubscriptBox[
           StyleBox["g", "TI"], 
           StyleBox["R", "TI"]], 
          FractionBox["1", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["g", "TI"], 
              StyleBox["R", "TI"]], 
             SubscriptBox["\[PartialD]", 
              SubscriptBox[
               StyleBox["g", "TI"], 
               StyleBox["R", "TI"]]], "log", 
             StyleBox["Z", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
      "input" -> 
      "\\beta = \\epsilon g_R \\frac{1}{1+g_R \\partial_{g_R}\\log Z}", 
      "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], " ", "with", " ", 
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{
          SubscriptBox[
           StyleBox["g", "TI"], 
           StyleBox["B", "TI"]], "\[LongEqual]", 
          SubscriptBox[
           StyleBox["g", "TI"], 
           StyleBox["R", "TI"]], 
          StyleBox["Z", "TI"], 
          SuperscriptBox["\[Mu]", "\[Epsilon]"]}], TraditionalForm], 
      "errors" -> {}, "input" -> "g_B = g_R Z \\mu^\\epsilon", "state" -> 
      "Boxes"|>,
     "TeXAssistantTemplate"]}]}]], "Text",
  CellChangeTimes->{
   3.994148719760748*^9, {3.994148774824318*^9, 3.9941488411754227`*^9}, 
    3.9942218761480465`*^9},ExpressionUUID->
  "2413de6b-43e6-8247-a228-047be7fb25cf"]
}], "Subsection",
 CellChangeTimes->{{3.994148661957676*^9, 3.994148680559944*^9}, {
  3.994221895704813*^9, 
  3.994221896304943*^9}},ExpressionUUID->"4f1e5dea-b89a-b649-85d8-\
1f9a61132f0c"],

