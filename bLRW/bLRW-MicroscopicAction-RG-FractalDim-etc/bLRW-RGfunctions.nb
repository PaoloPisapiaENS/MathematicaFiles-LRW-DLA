Cell[CellGroupData[{

Cell[TextData[{
 "The correct \[Beta] should be:",
 Cell[BoxData[
  RowBox[{"\t", 
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["g", "TI"], "~"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["g", "TI"], "\[Phi]\[Psi]"], 
         FractionBox[
          SubscriptBox["\[Gamma]", "1"], "\[Gamma]"], "+", 
         OverscriptBox[
          StyleBox["g", "TI"], "^"], "\n", "\[DoubleLongRightArrow]  ", 
         "\[Beta]", 
         RowBox[{"(", 
           OverscriptBox[
            StyleBox["g", "TI"], "~"], ")"}], "\[LongEqual]", 
         SubscriptBox["\[Beta]", "\[Phi]\[Psi]"], 
         FractionBox[
          SubscriptBox["\[Gamma]", "1"], "\[Gamma]"], "+", 
         SubscriptBox[
          StyleBox["g", "TI"], "\[Phi]\[Psi]"], 
         RowBox[{"(", 
           RowBox[{"-", "\[Mu]"}], ")"}], 
         FractionBox["\[PartialD]", 
          RowBox[{"\[PartialD]", "\[Mu]"}]], 
         RowBox[{"(", 
           FractionBox[
            SubscriptBox["\[Gamma]", "1"], "\[Gamma]"], ")"}], "+", 
         OverscriptBox["\[Beta]", "^"], 
         RowBox[{"(", 
           OverscriptBox[
            StyleBox["g", "TI"], "~"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\tilde g= g_{\\phi\\psi}\\frac{\\gamma_1}{\\gamma}+\\hat g \\\\ \
\\implies\\quad \\beta(\\tilde g) = \
\\beta_{\\phi\\psi}\\frac{\\gamma_1}{\\gamma}+g_{\\phi\\psi}(-\\mu)\\frac{\\\
partial{}}{\\partial{\\mu}}\\left(\\frac{\\gamma_1}{\\gamma}\\right)+\\hat \
\\beta(\\tilde g)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"]}]], "Input",
  CellChangeTimes->{{3.9942426513799515`*^9, 3.994242660406481*^9}, {
   3.9942428150064507`*^9, 3.994242835596773*^9}},
  FontSize->18,ExpressionUUID->"ab71b5c4-c7ee-294d-9b75-b601c491e951"],
 "\[LineSeparator]and with the \[Beta]-functions that can be computed as   ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Beta]", "\[LongEqual]", "\[Epsilon]", 
         SubscriptBox[
          StyleBox["g", "TI"], 
          StyleBox["R", "TI"]], 
         FractionBox["1", 
          RowBox[{"1", "+", 
            SubscriptBox[
             StyleBox["g", "TI"], 
             StyleBox["R", "TI"]], 
            SubscriptBox["\[PartialD]", 
             SubscriptBox[
              StyleBox["g", "TI"], 
              StyleBox["R", "TI"]]], "log", 
            SubscriptBox[
             StyleBox["Z", "TI"], 
             StyleBox["g", "TI"]]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\beta = \\epsilon g_R \\frac{1}{1+g_R \\partial_{g_R}\\log Z_g}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8c2bf39e-ab41-544a-b3a7-c960fc996890"],
 " EXCEPT for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox["\[Beta]", "^"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\hat \\beta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d18e2592-9b95-2d49-b0ae-fd3125d5d6c6"],
 ", which contains both the self correction (the term I just wrote) PLUS a \
cross term coming from the contributions of  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["g", "TI"], "\[Phi]\[Psi]"], 
         SubscriptBox["\[Gamma]", "1"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "g_{\\phi\\psi}{\\gamma_1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c2756e62-7beb-5646-9bc4-88a8b882d71e"],
 " together: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox["\[Beta]", "^"], "\[LongEqual]", "\[Epsilon]", 
         SubscriptBox[
          OverscriptBox[
           StyleBox["g", "TI"], "^"], 
          StyleBox["R", "TI"]], 
         FractionBox["1", 
          RowBox[{"1", "+", 
            SubscriptBox[
             OverscriptBox[
              StyleBox["g", "TI"], "^"], 
             StyleBox["R", "TI"]], 
            SubscriptBox["\[PartialD]", 
             SubscriptBox[
              OverscriptBox[
               StyleBox["g", "TI"], "^"], 
              StyleBox["R", "TI"]]], "log", 
            SubscriptBox[
             StyleBox["Z", "TI"], 
             OverscriptBox[
              StyleBox["g", "TI"], "^"]]}]], "+", 
         SubscriptBox["\[Beta]", 
          RowBox[{
            StyleBox["c", "TI"], 
            StyleBox["r", "TI"], 
            StyleBox["o", "TI"], 
            StyleBox["s", "TI"], 
            StyleBox["s", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\hat \\beta = \\epsilon \\hat g_R \\frac{1}{1+\\hat g_R \
\\partial_{\\hat g_R}\\log Z_{\\hat g}} + \\beta_{cross}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8ecabc7a-4b30-b642-b945-eb0b418bccf6"],
 ".\[LineSeparator]Now, since we do not actually have any self correction \
from ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox["\[Beta]", "^"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\hat \\beta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "13300fbc-5751-a54e-af77-375758efa106"],
 " because we do not have this term in the Lagrangian if not at perturbative \
level (to take care of some divergences), then ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["Z", "TI"], 
          OverscriptBox[
           StyleBox["g", "TI"], "^"]], "\[LongEqual]", "1"}], 
       TraditionalForm], "errors" -> {}, "input" -> "Z_{\\hat g}=1", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1d5ec8ad-2530-b340-8530-0936820f12ce"],
 ", and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox["\[Beta]", "^"], "\[LongEqual]", "\[Epsilon]", 
         SubscriptBox[
          OverscriptBox[
           StyleBox["g", "TI"], "^"], 
          StyleBox["R", "TI"]], "+", 
         SubscriptBox["\[Beta]", 
          RowBox[{
            StyleBox["c", "TI"], 
            StyleBox["r", "TI"], 
            StyleBox["o", "TI"], 
            StyleBox["s", "TI"], 
            StyleBox["s", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\hat \\beta = \\epsilon \\hat g_R + \\beta_{cross}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "55e0b78b-d601-0e42-9012-a5b2cdf46915"],
 "\[LineSeparator]\[LineSeparator]I do not know whether it is equivalent, but \
I obtained the following analytical result, with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["g", "TI"], "4"], ":", "\[LongEqual]", 
         SubscriptBox[
          StyleBox["g", "TI"], "\[Phi]\[Psi]"], 
         FractionBox[
          SubscriptBox["\[Gamma]", "1"], "\[Gamma]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "g_4 := g_{\\phi\\psi}\\frac{\\gamma_1}{\\gamma}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a6d2904f-1478-974a-b761-a22ccdba8851"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          OverscriptBox[
           StyleBox["g", "TI"], "^"], 
          StyleBox["B", "TI"]], "\[LongEqual]", 
         SuperscriptBox["\[Mu]", "\[Epsilon]"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              OverscriptBox[
               StyleBox["g", "TI"], "^"], 
              StyleBox["R", "TI"]], "+", 
             SubscriptBox[
              StyleBox["c", "TI"], 
              RowBox[{
                StyleBox["c", "TI"], 
                StyleBox["r", "TI"], 
                StyleBox["o", "TI"], 
                StyleBox["s", "TI"], 
                StyleBox["s", "TI"]}]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\hat g_B = \\mu^{\\epsilon} (\\hat g_R + c_{cross})", "state" -> 
     "Boxes"|>,
