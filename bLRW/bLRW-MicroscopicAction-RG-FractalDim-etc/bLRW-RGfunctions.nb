          "\[IndentingNewLine]", 
          RowBox[{"\[Beta]f", "=", 
           RowBox[{
            RowBox[{"\[Beta]f", "/.", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"g0", " ", 
                SuperscriptBox["\[Mu]", "\[Epsilon]"]}], ")"}], ":>", 
              RowBox[{"(", "gr", ")"}]}]}], "//", "Expand"}]}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Beta]f", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Normal", "[", "\[Beta]f", "]"}], "/.", 
        RowBox[{
         SuperscriptBox["g0", "n_"], " ", ":>", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"g", " ", 
            SuperscriptBox["\[Mu]", "\[Epsilon]"]}], ")"}], "n"]}]}], "//", 
       "Expand"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Beta]f", "=", 
      RowBox[{
       RowBox[{"\[Beta]f", "/.", 
        RowBox[{
         RowBox[{"(", "g0", " ", ")"}], ":>", 
         RowBox[{"(", 
          RowBox[{"g", " ", 
           SuperscriptBox["\[Mu]", "\[Epsilon]"]}], ")"}]}]}], "//", 
       "Expand"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Beta]f", "=", 
      RowBox[{
       RowBox[{"Series", "[", 
        RowBox[{"\[Beta]f", ",", 
         RowBox[{"{", 
          RowBox[{"g", ",", "0", ",", "nLoop"}], "}"}]}], "]"}], "//", 
       RowBox[{
