Cell[TextData[{
 "I can also write it as (this is a mess to implement with the derivative wrt \
\[Mu]) NOT IMPLEMENTED\n",
 Cell[BoxData[
  RowBox[{
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Beta]", "\[LongEqual]", "\[Epsilon]", 
         SubscriptBox[
          StyleBox["g", "TI"], 
          StyleBox["R", "TI"]], "+", 
         SubscriptBox[
          StyleBox["g", "TI"], 
          StyleBox["R", "TI"]], "\[Mu]", 
         SubscriptBox["\[PartialD]", "\[Mu]"], "log", 
         StyleBox["Z", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\beta = \\epsilon g_R + g_R \\mu \\partial_{\\mu}\\log Z", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], " ", "with", " ", 
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["g", "TI"], 
          StyleBox["B", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["g", "TI"], 
          StyleBox["R", "TI"]], 
         StyleBox["Z", "TI"], 
         SuperscriptBox["\[Mu]", "\[Epsilon]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "g_B = g_R Z \\mu^\\epsilon", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"]}]], "Input",ExpressionUUID->
  "317f6a52-61de-a644-888c-c881b15f04c9"],
