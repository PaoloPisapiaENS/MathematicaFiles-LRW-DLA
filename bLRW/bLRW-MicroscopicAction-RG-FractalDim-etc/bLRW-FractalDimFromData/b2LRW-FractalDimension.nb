Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"empirical", "=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "sampled", ",", "lm", ",", "a", ",", "df", ",", "x", ",", "slopeData", 
       ",", "meanSlope", ",", "stdDevSlope"}], "}"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"slopeData", "=", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"sampled", "=", 
           RowBox[{"RandomSample", "[", 
            RowBox[{
             RowBox[{"Log", "[", "joinedData", "]"}], ",", 
             RowBox[{"Floor", "[", 
              RowBox[{
               RowBox[{"Length", "[", "joinedData", "]"}], "/", "2"}], 
              "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"lm", "=", 
           RowBox[{"FindFit", "[", 
            RowBox[{"sampled", ",", 
             RowBox[{"a", "+", 
              RowBox[{"df", " ", "*", "x"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"a", ",", "df"}], "}"}], ",", "x"}], "]"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"df", "/.", "lm"}]}], "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "10000"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"meanSlope", "=", 
       RowBox[{"Mean", "[", "slopeData", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"stdDevSlope", "=", 
       RowBox[{"StandardDeviation", " ", "[", "slopeData", "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{"{", 
        RowBox[{"meanSlope", ",", "stdDevSlope"}], "}"}], "]"}], ";"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
