Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"threshold", "=", "10"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dropped", "=", 
   RowBox[{
    StyleBox["droppedb0",
     Background->RGBColor[1, 0.5, 0]], "=", 
    RowBox[{"DeleteCases", "[", 
     RowBox[{"rawData", ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a_", ",", "_"}], "}"}], "/;", 
       RowBox[{"a", "<", "threshold"}]}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lm", "=", 
    RowBox[{"LinearModelFit", "[", 
     RowBox[{
      RowBox[{"Log", "[", "dropped", "]"}], ",", "x", ",", "x"}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"{", 
