Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"threshold", "=", "150"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dropped", "=", 
   RowBox[{
    StyleBox["droppedb15",
     Background->RGBColor[1, 0.5, 0]], "=", 
    RowBox[{"DeleteCases", "[", 
     RowBox[{"rawData", ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a_", ",", "_"}], "}"}], "/;", 
       RowBox[{"a", "<", "threshold"}]}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lmdropped", "=", 
    RowBox[{"LinearModelFit", "[", 
     RowBox[{
      RowBox[{"Log", "[", "dropped", "]"}], ",", "x", ",", "x"}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ListLogLogPlot", "[", 
       RowBox[{"rawData", ",", 
        RowBox[{"PlotStyle", "->", "Black"}]}], "]"}], ",", 
      RowBox[{"ListLogLogPlot", "[", 
       RowBox[{"dropped", ",", 
        RowBox[{"PlotStyle", "->", "Green"}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"lm", "[", "x", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{"Log", "[", 
           RowBox[{"threshold", "-", "1"}], "]"}], ",", "1000"}], "}"}], ",", 
        RowBox[{"PlotStyle", "->", "Red"}]}], "]"}]}], "}"}], 
    "\[IndentingNewLine]", ",", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"PlotRange", "->", "All"}], ","}], "*)"}], 
    RowBox[{"PlotLabel", "->", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\< b = \>\"", ",", "b"}], "}"}], "]"}]}]}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", " ", 
  RowBox[{
  "\"\<From all the data: \!\(\*SubscriptBox[\(d\), \(f\)]\)=\>\"", ",", 
   RowBox[{"df", "/.", 
    RowBox[{"FindFit", "[", 
     RowBox[{
      RowBox[{"Log", "[", "rawData", "]"}], ",", 
      RowBox[{"a", "+", 
       RowBox[{"df", " ", "*", "x"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"a", ",", "df"}], "}"}], ",", "x"}], "]"}]}], ",", 
   "\"\<\[PlusMinus]\>\"", ",", 
   RowBox[{
    RowBox[{"lm", "[", "\"\<ParameterErrors\>\"", "]"}], "[", 
    RowBox[{"[", "2", "]"}], "]"}], ",", 
   "\"\<\nFrom dropped data: \!\(\*SubscriptBox[\(d\), \(f\)]\)=\>\"", ",", 
   RowBox[{"df", "/.", 
    RowBox[{"FindFit", "[", 
     RowBox[{
      RowBox[{"Log", "[", "dropped", "]"}], ",", 
      RowBox[{"a", "+", 
       RowBox[{"df", " ", "*", "x"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"a", ",", "df"}], "}"}], ",", "x"}], "]"}]}], ",", 
   "\"\<\[PlusMinus]\>\"", ",", 
   RowBox[{
    RowBox[{"lmdropped", "[", "\"\<ParameterErrors\>\"", "]"}], "[", 
    RowBox[{"[", "2", "]"}], "]"}], ",", 
   "\"\<\nResult from the litterature (exact with SLE): \>\"", ",", 
   RowBox[{"(", 
    RowBox[{"dfSLE", "/.", 
     RowBox[{"bb", "->", "b"}]}], ")"}], ",", "\"\< = \>\"", ",", 
   RowBox[{"(", 
    RowBox[{"dfSLE", "/.", 
     RowBox[{"bb", "->", 
      RowBox[{"b", "/", "1."}]}]}], ")"}]}], "]"}]}], "Input",
