Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"threshold", "=", "50"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dropped", "=", 
