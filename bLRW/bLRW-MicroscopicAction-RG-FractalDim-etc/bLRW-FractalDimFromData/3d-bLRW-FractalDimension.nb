Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"threshold", "=", "10"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dropped", "=", 
   RowBox[{
    StyleBox["droppedb5",
     Background->RGBColor[1, 0.5, 0]], "=", 
    RowBox[{"DeleteCases", "[", 
     RowBox[{"rawData", ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a_", ",", "_"}], "}"}], "/;", 
       RowBox[{"a", "<", "threshold"}]}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lm", "=", 
    RowBox[{"LinearModelFit", "[", 
     RowBox[{
      RowBox[{"Log", "[", "dropped", "]"}], ",", "x", ",", "x"}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ListLogLogPlot", "[", 
       RowBox[{"rawData", ",", 
        RowBox[{"PlotStyle", "->", "Black"}]}], "]"}], ",", 
      RowBox[{"ListLogLogPlot", "[", 
       RowBox[{"dropped", ",", 
        RowBox[{"PlotStyle", "->", "Green"}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"lm", "[", "x", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{"Log", "[", 
           RowBox[{"threshold", "-", "1"}], "]"}], ",", "1000"}], "}"}], ",", 
