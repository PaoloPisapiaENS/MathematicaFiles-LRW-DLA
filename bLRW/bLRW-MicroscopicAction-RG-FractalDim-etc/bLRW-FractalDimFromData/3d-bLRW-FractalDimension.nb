     RowBox[{"rawData", ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a_", ",", "_"}], "}"}], "/;", 
       RowBox[{"a", "<", "threshold"}]}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lm", "=", 
    RowBox[{"LinearModelFit", "[", 
     RowBox[{
      RowBox[{"Log", "[", "dropped", "]"}], ",", "x", ",", "x"}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"{", 
