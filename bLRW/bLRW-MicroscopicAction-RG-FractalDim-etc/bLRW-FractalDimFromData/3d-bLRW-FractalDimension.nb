      RowBox[{"ListLogLogPlot", "[", 
       RowBox[{"dropped", ",", 
        RowBox[{"PlotStyle", "->", "Green"}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"lm", "[", "x", "]"}], ",", 
        RowBox[{"{", 
