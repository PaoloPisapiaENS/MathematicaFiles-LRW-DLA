      RowBox[{"ListLogLogPlot", "[", 
       RowBox[{"rawData", ",", 
        RowBox[{"PlotStyle", "->", "Black"}]}], "]"}], ",", 
      RowBox[{"ListLogLogPlot", "[", 
       RowBox[{"dropped", ",", 
        RowBox[{"PlotStyle", "->", "Green"}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"lm", "[", "x", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{"Log", "[", 
           RowBox[{"threshold", "-", "1"}], "]"}], ",", "1000"}], "}"}], ",", 
