Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"dropped", "=", 
   RowBox[{"Drop", "[", 
    RowBox[{"joinedData", ",", "nDropped"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"lm", "=", 
   RowBox[{"LinearModelFit", "[", 
    RowBox[{
     RowBox[{"Log", "[", "dropped", "]"}], ",", "x", ",", "x"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ListLogLogPlot", "[", "dropped", "]"}], ",", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"lm", "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1000"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", "Red"}]}], "]"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", " ", 
  RowBox[{"\"\<\!\(\*SubscriptBox[\(d\), \(f\)]\)=\>\"", ",", 
   RowBox[{"df", "/.", 
    RowBox[{"FindFit", "[", 
     RowBox[{
      RowBox[{"Log", "[", "dropped", "]"}], ",", 
      RowBox[{"a", "+", 
       RowBox[{"df", " ", "*", "x"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"a", ",", "df"}], "}"}], ",", "x"}], "]"}]}]}], 
  "]"}], "\[IndentingNewLine]", 
