     RowBox[{
      RowBox[{"{", 
       RowBox[{"mant", ",", "exp"}], "}"}], "=", 
      RowBox[{"MantissaExponent", "[", "expr", "]"}]}], ";", 
     "\[IndentingNewLine]", 
