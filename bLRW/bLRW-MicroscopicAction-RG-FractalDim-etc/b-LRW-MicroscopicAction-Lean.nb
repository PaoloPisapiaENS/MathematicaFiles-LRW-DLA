 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "bLRWactionStatic", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<sourceBC\>\"", "->", "1"}], ",", 
