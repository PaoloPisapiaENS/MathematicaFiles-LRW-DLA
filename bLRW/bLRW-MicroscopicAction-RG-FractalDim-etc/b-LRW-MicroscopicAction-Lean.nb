Cell[CellGroupData[{

Cell["PathFinder[] ", "Section",
 CellChangeTimes->{{3.946456070766676*^9, 3.9464560749901676`*^9}, {
   3.9464679376629086`*^9, 3.946467941569351*^9}, 
   3.9465276330894184`*^9},ExpressionUUID->"7ef1e39f-00b6-f34d-9d5e-\
6176742967b1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "PathFinder", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PathFinder", "[", "graph_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pathList", "=", 
      RowBox[{"{", 
       RowBox[{"{", "}"}], "}"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"Step", "[", "subgraph_", "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "locEdges", ",", "locVertices", ",", "locWeights", ",", "locRoot", 
          ",", "locSource", ",", "locMoves", ",", "newEdges", ",", " ", 
          "newRoot", ",", "smallerGraph", ",", "i"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"locEdges", " ", "=", " ", 
           RowBox[{
            RowBox[{"EdgeList", "@", "subgraph"}], "/.", 
            RowBox[{"DirectedEdge", "->", "List"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"locVertices", "=", 
           RowBox[{"VertexList", "@", "subgraph"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "locVertices", "]"}], "==", "1"}], ",", 
            RowBox[{"Return", "[", "NULL", "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"locWeights", "=", 
           RowBox[{
            RowBox[{"WeightedAdjacencyMatrix", "[", "subgraph", "]"}], "//", 
            "Normal"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"locRoot", " ", "=", " ", "\[IndentingNewLine]", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"Select", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"List", "@@@", 
                  RowBox[{"PropertyValue", "[", 
                   RowBox[{"subgraph", ",", "VertexLabels"}], "]"}]}], ")"}], 
                "[", 
                RowBox[{"[", 
                 RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
               RowBox[{
                RowBox[{"StringMatchQ", "[", 
                 RowBox[{
                  RowBox[{"#", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], ",", 
                  RowBox[{"___", "~~", "\"\<ROOT\>\""}]}], "]"}], "&"}]}], 
              "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"locSource", " ", "=", " ", "\[IndentingNewLine]", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"Select", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"List", "@@@", 
                  RowBox[{"PropertyValue", "[", 
                   RowBox[{"subgraph", ",", "VertexLabels"}], "]"}]}], ")"}], 
                "[", 
                RowBox[{"[", 
                 RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
               RowBox[{
                RowBox[{"StringMatchQ", "[", 
                 RowBox[{
                  RowBox[{"#", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], ",", 
                  RowBox[{"___", "~~", "\"\<SOURCE\>\""}]}], "]"}], "&"}]}], 
              "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"locMoves", "=", 
           RowBox[{
            RowBox[{"Select", "[", 
             RowBox[{"locEdges", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "==", "locRoot"}], " ", 
               "&"}]}], "]"}], "[", 
            RowBox[{"[", "All", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Print", "[", "\"\<###  LocMoves  ####\>\"", "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", "locMoves", "]"}], ";"}], "*)"}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"i", "=", "1"}], ",", " ", 
           RowBox[{"i", "<=", 
            RowBox[{"Length", "[", "locMoves", "]"}]}], ",", 
           RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"i", " ", "==", 
                 RowBox[{"Length", "[", "locMoves", "]"}]}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{"(*", "True", "*)"}], 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"locMoves", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}], "==", 
                   "locSource"}], ",", "\[IndentingNewLine]", " ", 
                  RowBox[{"(*", "Ture", "*)"}], 
                  RowBox[{
                   RowBox[{"pathList", "=", 
                    RowBox[{"Append", "[", 
                    RowBox[{
                    RowBox[{"pathList", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
                    RowBox[{"Append", "[", 
                    RowBox[{
                    RowBox[{"pathList", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"locMoves", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "]"}]}], ";", 
                   " ", 
                   RowBox[{"Continue", "[", "]"}]}], ",", 
                  "\[IndentingNewLine]", " ", 
                  RowBox[{"(*", "False", "*)"}], 
                  RowBox[{"pathList", "=", 
                   RowBox[{"Prepend", "[", 
                    RowBox[{
                    RowBox[{"pathList", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
                    RowBox[{"Append", "[", 
                    RowBox[{
                    RowBox[{"pathList", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"locMoves", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "]"}]}]}], 
                 "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
                RowBox[{"(*", "False", "*)"}], "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"locMoves", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}], "==", 
                   "locSource"}], ",", "\[IndentingNewLine]", " ", 
                  RowBox[{"(*", "True", "*)"}], 
                  RowBox[{
                   RowBox[{"pathList", "=", 
                    RowBox[{"Append", "[", 
                    RowBox[{"pathList", ",", 
                    RowBox[{"Append", "[", 
                    RowBox[{
                    RowBox[{"pathList", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"locMoves", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "]"}]}], ";", 
                   RowBox[{"Continue", "[", "]"}]}], ",", 
                  "\[IndentingNewLine]", " ", 
                  RowBox[{"(*", "False", "*)"}], 
                  RowBox[{"pathList", "=", 
                   RowBox[{"Prepend", "[", 
                    RowBox[{"pathList", ",", 
                    RowBox[{"Append", "[", 
                    RowBox[{
                    RowBox[{"pathList", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"locMoves", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "]"}]}]}], 
                 "\[IndentingNewLine]", "]"}]}], "]"}], ";"}], 
             "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{"Print", "[", "\"\<###  pathList  ####\>\"", "]"}], 
               ";", "\[IndentingNewLine]", 
               RowBox[{"Print", "[", "pathList", "]"}], ";"}], "*)"}], ";", 
             "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{"newEdges", "=", 
              RowBox[{
               RowBox[{"Select", "[", 
                RowBox[{"locEdges", ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "=!=", "locRoot"}], " ", "&&",
                    " ", 
                   RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "=!=", "locRoot"}]}], " ",
                   "&"}]}], "]"}], "[", 
               RowBox[{"[", "All", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"newRoot", " ", "=", " ", 
              RowBox[{"locMoves", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Length", "[", "newEdges", "]"}], " ", "<=", " ", 
                "0"}], ",", 
               RowBox[{"Continue", "[", "]"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"smallerGraph", "=", 
              RowBox[{
               RowBox[{"MyGraph", "[", 
                RowBox[{"newEdges", ",", "newRoot", ",", "locSource", ",", 
                 RowBox[{"\"\<undirected\>\"", "->", "False"}]}], "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]",
             "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"Print", "[", "smallerGraph", "]"}], ";"}], "*)"}], ";",
             "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"Step", "[", "smallerGraph", "]"}]}]}], 
          "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
     ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Step", "[", "graph", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "pathList", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
