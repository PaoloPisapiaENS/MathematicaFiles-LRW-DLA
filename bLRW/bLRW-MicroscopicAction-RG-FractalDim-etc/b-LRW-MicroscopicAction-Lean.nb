Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "bLRWaction\[Xi]SameAs\[Chi]", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "bLRWaction\[Xi]SameAs\[Chi]", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<sourceBC\>\"", "->", "1"}], ",", 
