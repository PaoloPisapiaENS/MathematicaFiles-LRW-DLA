Cell[CellGroupData[{

Cell["Automated solver of the Laplace equation", "Title",
 CellChangeTimes->{{3.9464410666533813`*^9, 3.946441081074249*^9}, {
  3.9464553226433964`*^9, 
  3.946455324321228*^9}},ExpressionUUID->"0a503f64-c18e-904d-803a-\
47b32d1b555f"],

Cell[CellGroupData[{

Cell["LaplaceEqSolver[]", "Section",
 CellChangeTimes->{{3.946441766489065*^9, 
  3.946441773101034*^9}},ExpressionUUID->"8a58f404-33d2-fe4e-a034-\
43abe0b0ba3d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "LaplaceEqSolver", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "LaplaceEqSolver", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<BC\>\"", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", "}"}], ",", 
         RowBox[{"{", "}"}]}], "}"}]}], " ", ",", " ", 
      RowBox[{"\"\<selectSolution\>\"", "->", "0"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LaplaceEqSolver", "[", 
   RowBox[{"graph_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "locVertices", ",", "locWeights", ",", "totWeights", ",", "locRoot", ",",
       "locSource", ",", "locBC", ",", "equations", ",", 
      RowBox[{"variables", "=", 
       RowBox[{"{", "}"}]}], ",", "x", ",", "solution"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Clear", "[", "\[CapitalPhi]", "]"}], ";", "\[IndentingNewLine]",
      "\[IndentingNewLine]", 
     RowBox[{"locVertices", " ", "=", " ", 
      RowBox[{"VertexList", "@", "graph"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"locWeights", "=", 
      RowBox[{
       RowBox[{"WeightedAdjacencyMatrix", "[", "graph", "]"}], "//", 
       "Normal"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"totWeights", " ", "=", 
      RowBox[{"Total", "[", 
       RowBox[{"locWeights", ",", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"locRoot", " ", "=", " ", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"graph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<ROOT\>\""}]}], "]"}], "&"}]}], "]"}], 
        "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"locSource", " ", "=", " ", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"graph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<SOURCE\>\""}]}], "]"}], "&"}]}], "]"}],
         "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"locBC", "=", 
      RowBox[{"OptionValue", "[", "\"\<BC\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"locBC", "=!=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", "}"}], ",", 
          RowBox[{"{", "}"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{
          RowBox[{"locBC", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"\[CapitalPhi]", "[", "locSource", "]"}], "==", " ", 
           "1"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{
          RowBox[{"locBC", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"\[CapitalPhi]", "[", "locRoot", "]"}], "==", "0"}]}], 
         "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{
          RowBox[{"locBC", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", "locSource"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{
          RowBox[{"locBC", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", "locRoot"}], "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"equations", " ", "=", 
      RowBox[{"locBC", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], " ", ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"x", "=", "1"}], ",", 
       RowBox[{"x", "<=", 
        RowBox[{"Length", "[", "locVertices", "]"}]}], ",", 
       RowBox[{"x", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"variables", ",", 
          RowBox[{"\[CapitalPhi]", "[", "x", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"MemberQ", "[", 
           RowBox[{
            RowBox[{"locBC", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", "x"}], "]"}], ",", 
          RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"equations", ",", " ", 
          RowBox[{
           RowBox[{"\[CapitalPhi]", "[", "x", "]"}], "==", 
           RowBox[{"FullSimplify", "[", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               FractionBox[
                RowBox[{"locWeights", "[", 
                 RowBox[{"[", 
                  RowBox[{"x", ",", "y"}], "]"}], "]"}], 
                RowBox[{"totWeights", "[", 
                 RowBox[{"[", "x", "]"}], "]"}]], 
               RowBox[{"\[CapitalPhi]", "[", "y", "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"y", ",", 
                RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], "]"}],
             "]"}]}]}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Print", "[", "equations", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "variables", "]"}], ";"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"solution", "=", 
      RowBox[{
       RowBox[{"Flatten", "@", 
        RowBox[{"Solve", "[", 
         RowBox[{"equations", ",", "variables"}], "]"}]}], "/.", 
       "\[VeryThinSpace]", 
       RowBox[{"Rule", "\[Rule]", "List"}]}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<selectSolution\>\"", "]"}], "!=", 
        "0"}], ",", 
       RowBox[{"(*", "True", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"solution", "=", 
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{"solution", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "==", 
             RowBox[{"\[CapitalPhi]", "[", 
              RowBox[{"OptionValue", "[", "\"\<selectSolution\>\"", "]"}], 
              "]"}]}], " ", "&"}]}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "2"}], "]"}], "]"}]}]}], "\[IndentingNewLine]", 
      "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "solution", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.946441776152518*^9, 3.946442034031185*^9}, {
   3.946442067258043*^9, 3.946442239351692*^9}, {3.94644232963853*^9, 
   3.94644249454768*^9}, {3.946442582198704*^9, 3.946442667995975*^9}, {
   3.946442871898123*^9, 3.946442874522405*^9}, {3.946446420810716*^9, 
   3.946446422719105*^9}, {3.946446468608801*^9, 3.946446472428168*^9}, 
   3.946446630711107*^9, {3.9465396102628555`*^9, 3.946539618290997*^9}, {
   3.946539655884903*^9, 3.946539660475697*^9}, {3.9465397513536453`*^9, 
   3.9465398263218975`*^9}, {3.946632390818865*^9, 3.946632413147239*^9}, {
   3.946954362209366*^9, 3.946954378515587*^9}, {3.947306936693016*^9, 
   3.947306952419607*^9}, {3.947308788114344*^9, 3.9473090394452*^9}, {
   3.947309148799464*^9, 3.9473091824696045`*^9}, {3.947318319900563*^9, 
   3.9473184614448357`*^9}, {3.9527417468262844`*^9, 3.952741771995102*^9}},
 Background->RGBColor[1, 0.9, 0.8],
 CellLabel->"In[1]:=",ExpressionUUID->"669e7481-8422-5142-ab0d-246fc0f45edf"],

Cell[CellGroupData[{

Cell["Usage example of LaplaceEqSolver[]", "Subsection",
 CellChangeTimes->{{3.946442738012907*^9, 3.946442753933218*^9}, {
  3.946527676348884*^9, 
  3.946527678716404*^9}},ExpressionUUID->"0e7a87e0-1576-5548-91f8-\
e58ffda7c96e"],

Cell["\<\
\[OpenCurlyDoubleQuote]boundaryConditions\[CloseCurlyDoubleQuote] should be a \
2d list with the boundary conditions given as a first list, e.g. {\[Phi][1] \
== 1, \[Phi][2] == 0}. The second list must contain the vertices in the \
boundary, e.g. {1, 2}\
\>", "Text",
 CellChangeTimes->{{3.946442762983862*^9, 
  3.946442839653866*^9}},ExpressionUUID->"b095dfc7-b2cc-604b-9f01-\
84ce8a0ae485"],

