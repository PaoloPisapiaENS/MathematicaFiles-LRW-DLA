Cell[CellGroupData[{

Cell["\<\
Let\[CloseCurlyQuote]s keep the value at the source general. The idea is that \
we want to use it to impose the normalization such that \[Phi] are already \
properly normalized for being transition probabilities. \
\>", "Item",
 CellChangeTimes->{{3.946954246495419*^9, 3.946954342633593*^9}, {
  3.946954459309431*^9, 
  3.946954459543581*^9}},ExpressionUUID->"42c0fb4f-edae-244d-bd3f-\
d24d469891a8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"BC", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"\[CapitalPhi]", "[", "3", "]"}], "==", 
        RowBox[{"Zeta", "[", "3", "]"}]}], ",", 
       RowBox[{
        RowBox[{"\[CapitalPhi]", "[", "2", "]"}], "==", "0"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "2"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"path1", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "3"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"sol", "=", 
  RowBox[{"LaplaceEqSolver", "[", 
   RowBox[{"g", ",", "BC", ",", "\[CapitalPhi]"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.946954483069048*^9, 3.94695449135864*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"f0600574-5c8a-fe42-8d90-b42cd42c22f8"],

Cell[BoxData[
 RowBox[{"LaplaceEqSolver", "[", 
  RowBox[{"g", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"\[CapitalPhi]", "[", "3", "]"}], "\[Equal]", 
        RowBox[{"Zeta", "[", "3", "]"}]}], ",", 
       RowBox[{
        RowBox[{"\[CapitalPhi]", "[", "2", "]"}], "\[Equal]", "0"}]}], "}"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "2"}], "}"}]}], "}"}], ",", "\[CapitalPhi]"}], 
  "]"}]], "Output",
 CellChangeTimes->{{3.9469544794773426`*^9, 3.94695449178113*^9}, 
   3.9695976294369125`*^9},
 CellLabel->"Out[16]=",ExpressionUUID->"280563c8-8918-4642-ab36-89a8014f60f1"]
}, Open  ]]
}, Closed]],

Cell["\<\
As you can see from the previous example, the source\[CloseCurlyQuote]s value \
appear at numerator. So, we need to instead take its inverse. THE CRUCIAL \
THING IS THAT IT IS EXTREMELY EASY TO TAKE THE INVERSE OF A NUMBER, COMPARED \
TO THE INVERSE OF AN EXPECTATION VALUE!!!!!\
\>", "Text",
 CellChangeTimes->{{3.946954502670002*^9, 
  3.946954587983448*^9}},ExpressionUUID->"2345a3d4-9867-ff4c-b8e0-\
008cd5553b0e"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["bLaplacianRW[]", "Section",
 CellChangeTimes->{{3.946443133239404*^9, 3.946443137980442*^9}, 
   3.9695303099261*^9},ExpressionUUID->"70e0c9c6-8bd2-1247-b810-a3353259542c"],

Cell[CellGroupData[{

Cell["Computes the probability of a given Laplacian RW", "Item",
 CellChangeTimes->{{3.946455377142837*^9, 3.946455386291591*^9}, {
  3.946977591066313*^9, 
  3.9469776060515404`*^9}},ExpressionUUID->"50577d2a-258f-0a4f-8605-\
7d1258692c33"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "bLaplacianRW", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "bLaplacianRW", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<draw\>\"", "->", "False"}], ",", 
     RowBox[{"\"\<print\>\"", "->", "False"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bLaplacianRW", "[", 
   RowBox[{"graph_", ",", "path__", ",", "b_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "locSource", ",", "locRoot", ",", "locWeights", ",", "locVertices", ",", 
      "denominator", ",", 
      RowBox[{"prob", "=", "1"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"locWeights", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"WeightedAdjacencyMatrix", "[", "graph", "]"}], "/.", 
        RowBox[{
         RowBox[{"\[Beta]", "[", "__", "]"}], "->", "1"}]}], "//", 
       "Normal"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"locVertices", "=", 
      RowBox[{"VertexList", "@", "graph"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"locRoot", " ", "=", " ", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"graph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<ROOT\>\""}]}], "]"}], "&"}]}], "]"}], 
        "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"locSource", " ", "=", " ", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"graph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<SOURCE\>\""}]}], "]"}], "&"}]}], "]"}],
         "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"locRoot", " ", "=!=", " ", 
        RowBox[{"path", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<####  WRONG ROOT  ####\>\"", "]"}], ";", 
        " ", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"locSource", " ", "=!=", " ", 
        RowBox[{"path", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "2"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<####  WRONG SOURCE  ####\>\"", "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"locBC", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", "}"}], ",", 
            RowBox[{"{", "}"}]}], "}"}]}], ",", "\[Phi]", ",", "i", ",", 
         "\[Phi]sol"}], "}"}], ",", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{
          RowBox[{"locBC", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"\[CapitalPhi]", "[", "locSource", "]"}], "==", "1"}]}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{
          RowBox[{"locBC", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", "locSource"}], "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", "1"}], ",", 
          RowBox[{"i", "<=", 
           RowBox[{"Length", "[", "path", "]"}]}], ",", 
          RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"AppendTo", "[", 
             RowBox[{
              RowBox[{"locBC", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{"\[CapitalPhi]", "[", 
                RowBox[{"path", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "==", "0"}]}],
              "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{
              RowBox[{"locBC", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", 
              RowBox[{"path", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "1"}], "]"}], "]"}]}], "]"}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"Print", "[", "locBC", "]"}], ";"}], "*)"}], 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"\[Phi]sol", "=", 
             RowBox[{
              RowBox[{"LaplaceEqSolver", "[", 
               RowBox[{"graph", ",", 
                RowBox[{"\"\<BC\>\"", "->", "locBC"}]}], "]"}], "/.", 
              RowBox[{
               RowBox[{"\[Beta]", "[", "__", "]"}], "->", "1"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"Print", "[", "\[Phi]sol", "]"}], ";"}], "*)"}], 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"Print", "[", "\"\< ##### OK SO FAR ##### \>\"", "]"}], 
              ";"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"denominator", "=", 
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"locWeights", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", "y"}], "]"}], 
                 "]"}], "*", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Select", "[", 
                    RowBox[{"\[Phi]sol", ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "==", 
                    RowBox[{"\[CapitalPhi]", "[", "y", "]"}]}], " ", "&"}]}], 
                    "]"}], "[", 
                   RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], ")"}], "^", 
                 "b"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"y", ",", 
                 RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], 
              "]"}]}], ";"}], "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"Print", "[", "denominator", "]"}], "*)"}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"OptionValue", "[", "\"\<print\>\"", "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{"\"\<#####  Transition probability \>\"", "<>", 
                RowBox[{"ToString", "[", 
                 RowBox[{"path", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "<>", 
                "\"\< to \>\"", "<>", 
                RowBox[{"ToString", "[", 
                 RowBox[{"path", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "2"}], "]"}], "]"}], "]"}], "<>", 
                "\"\<  #####\>\""}], "]"}], ";", "\[IndentingNewLine]", 
              "\[IndentingNewLine]", 
              RowBox[{"Print", "[", 
               RowBox[{
                RowBox[{
                 FractionBox[
                  RowBox[{
                   RowBox[{"locWeights", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}], 
                   "*", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Select", "[", 
                    RowBox[{"\[Phi]sol", ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "==", 
                    RowBox[{"\[CapitalPhi]", "[", 
                    RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}], "]"}]}], " ", 
                    "&"}]}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], ")"}], "^", 
                    "b"}]}], "denominator"], "/.", 
                 RowBox[{
                  RowBox[{"\[Beta]", "[", 
                   RowBox[{"_", ",", "_"}], "]"}], "->", "1"}]}], "//", 
                "FullSimplify"}], "]"}], ";"}]}], "\[IndentingNewLine]", 
            "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"prob", "*=", 
             RowBox[{
              FractionBox[
               RowBox[{
                RowBox[{"locWeights", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
                   RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}], 
                "*", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Select", "[", 
                    RowBox[{"\[Phi]sol", ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "==", 
                    RowBox[{"\[CapitalPhi]", "[", 
                    RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}], "]"}]}], " ", 
                    "&"}]}], "]"}], "[", 
                   RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], ")"}], "^", 
                 "b"}]}], "denominator"], "/.", 
              RowBox[{
               RowBox[{"\[Beta]", "[", "__", "]"}], "->", "1"}]}]}], "//", 
            "FullSimplify"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Clear", "[", "\[Phi]sol", "]"}], ";"}]}], 
         "\[IndentingNewLine]", "]"}], ";"}]}], 
      RowBox[{"(*", 
       RowBox[{"END", " ", "OF", " ", "FOR"}], "*)"}], "\[IndentingNewLine]", 
      "]"}], ";", 
     RowBox[{"(*", 
      RowBox[{"END", " ", "OF", " ", "MODULE"}], "*)"}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"OptionValue", "[", "\"\<draw\>\"", "]"}], ",", 
       RowBox[{"Print", "[", 
        RowBox[{"DrawOnGraph", "[", 
         RowBox[{"graph", ",", "path"}], "]"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "prob", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.946443142020031*^9, 3.946443183424503*^9}, {
   3.946444853882334*^9, 3.946444872542319*^9}, {3.946445277082453*^9, 
