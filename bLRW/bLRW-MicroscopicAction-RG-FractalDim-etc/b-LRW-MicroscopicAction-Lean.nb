Cell["\<\
Let\[CloseCurlyQuote]s write a modified LaplacianRW function that uses the \
normalization trick to normalize the transition probability. The only problem \
is the first step, so we compute it separately using the standard procedure.\
\>", "Item",
 CellChangeTimes->{{3.946957127946188*^9, 3.946957169640173*^9}, {
  3.946957252938444*^9, 3.946957283161177*^9}, {3.94695740552399*^9, 
  3.946957416491047*^9}},ExpressionUUID->"8b715af0-19e5-d94e-a6c1-\
30de1ab3265b"],

Cell["\<\
(*****************************************************************************\
***********************************************)
NOT SO EASY, PLEASE LOOK AT IT MORE CAREFULLY. IN PARTICULAR WE NEED TO \
DIVIDE BY THE PARTITION FUNCTION!!!!!
So, we need to use a partition function calculator. I am trying to implement \
it in another notebook following Kay\[CloseCurlyQuote]s advice. But I am not \
able to reproduce it. So, since its program is just an optimization, I will \
use mine and think about how to improve it in the future.
(*****************************************************************************\
***********************************************)
\
\>", "Text",
 CellChangeTimes->{{3.9469604567199936`*^9, 3.9469605147963886`*^9}, {
  3.9469766495515404`*^9, 
  3.946976752987471*^9}},ExpressionUUID->"13b252f5-b730-ba48-aaa6-\
efa0be55b080"],

Cell[CellGroupData[{

Cell["", "Item",
 CellChangeTimes->{
  3.969530375335167*^9},ExpressionUUID->"a90901ac-d11a-784a-87df-\
26faea051266"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "LaplacianRW2", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "LaplacianRW2", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<draw\>\"", "->", "False"}], ",", 
      RowBox[{"\"\<print\>\"", "->", "False"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LaplacianRW2", "[", 
   RowBox[{"graph_", ",", "path__", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "locSource", ",", "locRoot", ",", "locWeights", ",", "totWeights", ",", 
      "locVertices", ",", "denominator", ",", 
      RowBox[{"prob", "=", "1"}], ",", " ", "Z", ",", "numerator"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"locWeights", "=", 
      RowBox[{
       RowBox[{"WeightedAdjacencyMatrix", "[", "graph", "]"}], "//", 
       "Normal"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"totWeights", " ", "=", 
      RowBox[{"Total", "[", 
       RowBox[{"locWeights", ",", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"locVertices", "=", 
      RowBox[{"VertexList", "@", "graph"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"locRoot", " ", "=", " ", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"graph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<ROOT\>\""}]}], "]"}], "&"}]}], "]"}], 
        "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"locSource", " ", "=", " ", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"graph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<SOURCE\>\""}]}], "]"}], "&"}]}], "]"}],
         "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"locRoot", " ", "=!=", " ", 
        RowBox[{"path", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<####  WRONG ROOT  ####\>\"", "]"}], ";", 
        " ", 
        RowBox[{"Return", "[", "NULL", "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"locSource", " ", "=!=", " ", 
        RowBox[{"path", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "2"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<####  WRONG SOURCE  ####\>\"", "]"}], ";", 
        RowBox[{"Return", "[", "NULL", "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"locBC", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", "}"}], ",", 
            RowBox[{"{", "}"}]}], "}"}]}], ",", "\[Phi]", ",", 
         RowBox[{"i", "=", "1"}], ",", "j", ",", "\[Phi]sol"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{
            RowBox[{"locBC", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{
             RowBox[{"\[Phi]", "[", "locSource", "]"}], "==", "1"}]}], "]"}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{
            RowBox[{"locBC", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", "locSource"}], "]"}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{
            RowBox[{"locBC", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{
             RowBox[{"\[Phi]", "[", 
              RowBox[{"path", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "==", "0"}]}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{
            RowBox[{"locBC", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", 
            RowBox[{"path", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "1"}], "]"}], "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"\[Phi]sol", "=", 
           RowBox[{"LaplaceEqSolver", "[", 
            RowBox[{"graph", ",", "locBC", ",", "\[Phi]"}], "]"}]}], ";"}], 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Print", "[", "\[Phi]sol", "]"}], "*)"}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"denominator", "=", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"locWeights", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"path", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", "y"}], "]"}], 
              "]"}], "*", 
             RowBox[{
              RowBox[{"Select", "[", 
               RowBox[{"\[Phi]sol", ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"#", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "==", 
                  RowBox[{"\[Phi]", "[", "y", "]"}]}], " ", "&"}]}], "]"}], 
              "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"y", ",", 
              RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], "]"}]}],
          ";"}], "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Print", "[", "denominator", "]"}], "*)"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"numerator", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"locWeights", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"path", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
              RowBox[{"path", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}], " ", 
           "*", " ", 
           RowBox[{
            RowBox[{"Select", "[", 
             RowBox[{"\[Phi]sol", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "==", 
                RowBox[{"\[Phi]", "[", 
                 RowBox[{"path", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "2"}], "]"}], "]"}], "]"}]}], " ", 
               "&"}]}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "//", 
          "FullSimplify"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"prob", "*=", 
          FractionBox["numerator", "denominator"]}], "//", "FullSimplify"}], 
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<#####  Transition probability \>\"", "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{"path", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "<>", 
          "\"\< to \>\"", "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{"path", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "2"}], "]"}], "]"}], "]"}], "<>", 
          "\"\<  #####\>\""}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{
          RowBox[{"prob", "/.", 
           RowBox[{
            RowBox[{"\[Beta]", "[", 
             RowBox[{"_", ",", "_"}], "]"}], "->", "1"}]}], "//", 
          "FullSimplify"}], "]"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"Clear", "[", 
         RowBox[{"\[Phi]sol", ",", "locBC"}], "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", "2"}], ",", 
          RowBox[{"i", "<=", 
           RowBox[{"Length", "[", "path", "]"}]}], ",", 
          RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{
            "We", " ", "need", " ", "to", " ", "solve", " ", "it", " ", 
             "once", " ", "with", " ", "standard", " ", "BCs", " ", "at", " ",
              "the", " ", "previous", " ", "step"}], ",", " ", 
            RowBox[{
             RowBox[{"i", ".", "e", ".", " ", 
              RowBox[{"\[Phi]", "[", "locSource", "]"}]}], "==", "1"}]}], 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"locBC", "=", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"\[Phi]", "[", "locSource", "]"}], "==", "1"}], 
                "}"}], ",", 
               RowBox[{"{", "locSource", "}"}]}], "}"}]}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"For", "[", 
             RowBox[{
              RowBox[{"j", "=", "1"}], ",", 
              RowBox[{"j", "<=", 
               RowBox[{"i", "-", "1"}]}], ",", 
              RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"AppendTo", "[", 
                RowBox[{
                 RowBox[{"locBC", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", 
                 RowBox[{
                  RowBox[{"\[Phi]", "[", 
                   RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", "1"}], "]"}], "]"}], "]"}], "==", 
                  "0"}]}], "]"}], ";", "\[IndentingNewLine]", 
               RowBox[{"AppendTo", "[", 
                RowBox[{
                 RowBox[{"locBC", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], ",", 
                 RowBox[{"path", "[", 
                  RowBox[{"[", 
                   RowBox[{"j", ",", "1"}], "]"}], "]"}]}], "]"}]}]}], 
             "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{"Print", "[", "locBC", "]"}], "*)"}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"Z", "=", 
             RowBox[{"VertexAssignment", "[", 
              RowBox[{"graph", ",", " ", 
               RowBox[{"\"\<excludedVertices\>\"", "->", 
                RowBox[{"locBC", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"Z", "=", 
             RowBox[{"ExpectationValue", "[", "Z", "]"}]}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"OptionValue", "[", "\"\<print\>\"", "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
               "Print", "[", 
                "\"\<#####  Previous Partition Function  #####\>\"", "]"}], 
               ";", "\[IndentingNewLine]", 
               RowBox[{"Print", "[", "Z", "]"}]}]}], "\[IndentingNewLine]", 
             "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"\[Phi]sol", "=", 
             RowBox[{"LaplaceEqSolver", "[", 
              RowBox[{"graph", ",", "locBC", ",", "\[Phi]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"Print", "[", "\[Phi]sol", "]"}], ";"}], "*)"}], 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"denominator", "=", 
             RowBox[{
              RowBox[{
               FractionBox["1", "Z"], "*", 
               RowBox[{
                RowBox[{"Select", "[", 
                 RowBox[{"\[Phi]sol", ",", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "==", 
                    RowBox[{"\[Phi]", "[", 
                    RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}]}], " ", 
                   "&"}]}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "//", 
              "FullSimplify"}]}], ";", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", 
            RowBox[{"Clear", "[", 
             RowBox[{"\[Phi]sol", ",", " ", "locBC"}], "]"}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
             "Then", " ", "we", " ", "need", " ", "to", " ", "solve", " ", 
              "it", " ", "again", " ", "with", " ", "updated", " ", "BC", " ",
               "at", " ", "the", " ", "current", " ", "step"}], "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"locBC", "=", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"\[Phi]", "[", "locSource", "]"}], "==", 
                 SuperscriptBox["denominator", 
                  RowBox[{"-", "1"}]]}], "}"}], ",", 
               RowBox[{"{", "locSource", "}"}]}], "}"}]}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"For", "[", 
             RowBox[{
              RowBox[{"j", "=", "1"}], ",", 
              RowBox[{"j", "<=", "i"}], ",", 
              RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"AppendTo", "[", 
                RowBox[{
                 RowBox[{"locBC", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", 
