Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"\[CapitalPhi]", "[", "3", "]"}], "==", "1"}], ",", 
     RowBox[{
      RowBox[{"\[CapitalPhi]", "[", "1", "]"}], "==", "0"}], ",", 
     RowBox[{
      RowBox[{"\[CapitalPhi]", "[", "2", "]"}], "==", 
      RowBox[{
       FractionBox["1", "3"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[CapitalPhi]", "[", "1", "]"}], "+", 
         RowBox[{"\[CapitalPhi]", "[", "3", "]"}], "+", 
         RowBox[{"\[CapitalPhi]", "[", "4", "]"}]}], ")"}]}]}], ",", 
     RowBox[{
      RowBox[{"\[CapitalPhi]", "[", "4", "]"}], "==", 
      RowBox[{
       FractionBox["1", "2"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[CapitalPhi]", "[", "2", "]"}], "+", 
         RowBox[{"\[CapitalPhi]", "[", "3", "]"}]}], ")"}]}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[CapitalPhi]", "[", "1", "]"}], ",", 
     RowBox[{"\[CapitalPhi]", "[", "2", "]"}], ",", 
     RowBox[{"\[CapitalPhi]", "[", "3", "]"}], ",", 
     RowBox[{"\[CapitalPhi]", "[", "4", "]"}]}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9527418718471584`*^9, 3.952741955731455*^9}, {
   3.952742408662769*^9, 3.952742513999256*^9}, 3.9527444616519623`*^9},
 CellLabel->"In[13]:=",ExpressionUUID->"3c5c5d24-5de2-874d-aa22-c2d035e0bc9f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"\[CapitalPhi]", "[", "1", "]"}], "\[Rule]", "0"}], ",", 
    RowBox[{
     RowBox[{"\[CapitalPhi]", "[", "2", "]"}], "\[Rule]", 
     FractionBox["3", "5"]}], ",", 
    RowBox[{
     RowBox[{"\[CapitalPhi]", "[", "3", "]"}], "\[Rule]", "1"}], ",", 
    RowBox[{
     RowBox[{"\[CapitalPhi]", "[", "4", "]"}], "\[Rule]", 
