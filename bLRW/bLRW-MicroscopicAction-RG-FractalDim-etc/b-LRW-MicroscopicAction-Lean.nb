             RowBox[{"ToString", "[", 
              RowBox[{"path", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "2"}], "]"}], "]"}], "]"}], "<>", 
             "\"\<  #####\>\""}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               FractionBox["1", "Z"], "*", 
               FractionBox[
                RowBox[{"locWeights", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
                   RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}], 
                RowBox[{"totWeights", "[", 
                 RowBox[{"[", 
                  RowBox[{"path", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "]"}]], "*", 
               RowBox[{
                RowBox[{"Select", "[", 
                 RowBox[{"\[Phi]sol", ",", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "==", 
                    RowBox[{"\[Phi]", "[", 
                    RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}], "]"}]}], " ", 
                   "&"}]}], "]"}], "[", 
                RowBox[{"[", 
