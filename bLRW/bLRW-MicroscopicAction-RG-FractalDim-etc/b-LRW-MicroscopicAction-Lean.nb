Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "bLRWnorm", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "bLRWnorm", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<graph\>\"", "->", "g"}], ",", 
      RowBox[{"\"\<endTime\>\"", "->", "endTime"}], ",", 
      RowBox[{"\"\<fieldsToExclude\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"\[Phi]s", ",", "\[Psi]s"}], "}"}]}], ",", 
      RowBox[{"\"\<theory\>\"", "->", "\"\<LERW\>\""}], ",", 
      RowBox[{"\"\<\[Beta]rule\>\"", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Beta]", "[", "__", "]"}], "->", "1."}], "}"}]}], ",", 
      RowBox[{"\"\<fields\>\"", "->", 
       RowBox[{"FieldsNamesGenerator", "[", 
