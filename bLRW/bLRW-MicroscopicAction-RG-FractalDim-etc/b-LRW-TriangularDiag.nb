 CellLabel->"In[7]:=",ExpressionUUID->"063c9385-4592-8a4a-841a-8bf211870d28"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"int1", "=", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["u", "1"], "+", 
         SubscriptBox["u", "2"], "+", 
         SubscriptBox["u", "3"]}], ")"}], 
       RowBox[{"3", "-", "d"}]], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["u", "1"], "*", 
         SubscriptBox["u", "2"], "*", 
         SubscriptBox["u", "3"]}], ")"}], 
       RowBox[{
        RowBox[{"d", "/", "2"}], " ", "-", " ", "2"}]], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox[
           RowBox[{"(", 
            SubscriptBox["p", "1"], ")"}], "2"]}], 
         SubscriptBox["u", "1"]}], "-", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           SubscriptBox["p", "2"], ")"}], "2"], 
         SubscriptBox["u", "2"]}], "-", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["p", "1"], "+", 
            SubscriptBox["p", "2"]}], ")"}], "2"], 
         SubscriptBox["u", "3"]}]}], "]"}]}], "/.", "rule"}], ",", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["u", "1"], ",", "0", ",", "\[Infinity]"}], "}"}], ",", " ", 
    RowBox[{"Assumptions", "->", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubscriptBox["p", "1"], "\[Element]", 
        TemplateBox[{},
         "Reals"]}], "&&", 
       RowBox[{
        SubscriptBox["p", "1"], ">", "0"}], "&&", 
       RowBox[{
        SubscriptBox["u", "2"], ">", "0"}], "&&", 
       RowBox[{
        SubscriptBox["u", "3"], ">", "0"}]}], ")"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.970547409511938*^9, 3.970547412877552*^9}, {
