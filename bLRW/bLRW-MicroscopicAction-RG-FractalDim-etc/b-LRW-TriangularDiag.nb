Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"p", " ", 
         SubscriptBox["t", "2"]}], "+", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"p", "+", "k"}], ")"}], 
         SubscriptBox["t", "3"]}]}], ")"}], "^", "2"}], 
     RowBox[{
      SubscriptBox["t", "1"], "+", 
      SubscriptBox["t", "2"], "+", 
      SubscriptBox["t", "3"]}]], "+", 
    RowBox[{
     RowBox[{"p", "^", "2"}], " ", 
     SubscriptBox["t", "2"]}], " ", "+", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"p", "+", "k"}], ")"}], "^", "2"}], " ", 
     SubscriptBox["t", "3"]}]}], "//", "Expand"}], "//", 
  "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.9696924861513443`*^9, 3.9696925911051273`*^9}, {
  3.96969296099027*^9, 3.9696929819083347`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"41079426-905a-e744-ae13-8205e73b612b"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["p", "2"], " ", 
    SubscriptBox["t", "2"], " ", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["t", "1"], "+", 
      RowBox[{"2", " ", 
       SubscriptBox["t", "2"]}]}], ")"}]}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"k", "+", "p"}], ")"}], "2"], " ", 
       SubscriptBox["t", "1"]}], "+", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"k", "+", 
          RowBox[{"2", " ", "p"}]}], ")"}], "2"], " ", 
       SubscriptBox["t", "2"]}]}], ")"}], " ", 
    SubscriptBox["t", "3"]}], "+", 
   RowBox[{"2", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"k", "+", "p"}], ")"}], "2"], " ", 
    SubsuperscriptBox["t", "3", "2"]}]}], 
  RowBox[{
   SubscriptBox["t", "1"], "+", 
   SubscriptBox["t", "2"], "+", 
