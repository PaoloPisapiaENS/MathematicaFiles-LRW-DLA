Cell[CellGroupData[{

Cell["I will use 3*Zeta[3] instead of d to trick Mathematica", "Subsection",
 CellChangeTimes->{{3.970547429291815*^9, 
  3.970547450046414*^9}},ExpressionUUID->"49601dc9-a6e0-d74a-b641-\
9047224a4412"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"rule", "=", 
   RowBox[{"{", 
    RowBox[{"d", "->", 
     RowBox[{"3", "*", 
      RowBox[{"Zeta", "[", "3", "]"}]}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"invRule", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Zeta", "[", "3", "]"}], "->", 
     RowBox[{"d", "/", "3"}]}], "}"}]}], ";"}]}], "Input",
