               "/", 
               RowBox[{"totWeights", "[", 
                RowBox[{"[", 
                 RowBox[{"path", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], "*",
               "Z"}], "//", "FullSimplify"}]}], ";", "\n", "\n", 
           RowBox[{"Print", "[", 
