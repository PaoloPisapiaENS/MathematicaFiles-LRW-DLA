Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "Znorm", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "Znorm", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<graph\>\"", "->", "g"}], ",", 
      RowBox[{"\"\<fieldsToExclude\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"\[Phi]s", ",", "\[Psi]s"}], "}"}]}], ",", 
      RowBox[{"\"\<theory\>\"", "->", "\"\<LERW\>\""}], ",", 
      RowBox[{"\"\<\[Beta]rule\>\"", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Beta]", "[", "__", "]"}], "->", "1."}], "}"}]}]}], 
     "}"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Znorm", "[", 
   RowBox[{"expression_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "locZnorm", ",", "excludedVertices", ",", "token", ",", "index"}], "}"}],
     ",", "\n", "\n", 
    RowBox[{
     RowBox[{"excludedVertices", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"expression", " ", "*", " ", "2"}], ")"}], "/.", 
         RowBox[{
          RowBox[{"R", "[", "__", "]"}], "->", "1"}]}], "/.", 
        RowBox[{"\[Gamma]", "->", "1"}]}], "//", "Expand"}]}], ";", "\n", 
     RowBox[{"excludedVertices", "=", 
      RowBox[{"List", " ", "@@", "excludedVertices"}]}], ";", "\n", 
     RowBox[{"excludedVertices", "=", 
      RowBox[{"excludedVertices", "[", 
       RowBox[{"[", 
        RowBox[{"2", ";;"}], "]"}], "]"}]}], ";", " ", 
     RowBox[{"(*", 
      RowBox[{
      "Gets", " ", "rid", " ", "of", " ", "the", " ", "numerical", " ", 
       "coefficient"}], "*)"}], "\n", "\n", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"index", "=", "1"}], ",", 
       RowBox[{"index", "<=", 
        RowBox[{"Length", "[", 
         RowBox[{"OptionValue", "[", "\"\<fieldsToExclude\>\"", "]"}], 
         "]"}]}], ",", 
       RowBox[{"index", "++"}], ",", "\n", 
       RowBox[{
        RowBox[{"excludedVertices", "=", 
         RowBox[{"excludedVertices", "/.", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"OptionValue", "[", "\"\<fieldsToExclude\>\"", "]"}], 
             "[", 
             RowBox[{"[", "index", "]"}], "]"}], "[", 
            RowBox[{"a_", ",", "__"}], "]"}], "->", "a"}]}]}], ";"}]}], "\n", 
      "]"}], ";", "\n", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"excludedVertices", "=", 
        RowBox[{"excludedVertices", "/.", 
         RowBox[{
          RowBox[{"\[Psi]s", "[", 
           RowBox[{"a_", ",", "__"}], "]"}], "->", "a"}]}]}], ";", "\n", 
       RowBox[{"excludedVertices", "=", 
        RowBox[{"excludedVertices", "/.", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Psi]s", "[", 
            RowBox[{"a_", ",", "__"}], "]"}], 
           RowBox[{"\[Psi]s", "[", 
            RowBox[{"a_", ",", "__"}], "]"}]}], "->", "a"}]}]}], ";", "\n", 
       RowBox[{"excludedVertices", "=", 
        RowBox[{"excludedVertices", "/.", 
         RowBox[{
          RowBox[{"\[Xi]s", "[", 
           RowBox[{"a_", ",", "__"}], "]"}], "->", "a"}]}]}], ";", "\n", 
       RowBox[{"excludedVertices", "=", 
        RowBox[{"excludedVertices", "/.", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Xi]s", "[", 
            RowBox[{"a_", ",", "__"}], "]"}], 
           RowBox[{"\[Xi]s", "[", 
            RowBox[{"a_", ",", "__"}], "]"}]}], "->", "a"}]}]}], ";"}], 
      "*)"}], "\n", "\n", 
     RowBox[{"locZnorm", "=", 
      RowBox[{
       RowBox[{"VertexAssignment", "[", 
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<graph\>\"", "]"}], ",", 
         RowBox[{"\"\<system\>\"", "->", "\"\<LERW\>\""}], ",", 
         RowBox[{"\"\<excludedVertices\>\"", "->", "excludedVertices"}]}], 
        "]"}], "/.", 
       RowBox[{"OptionValue", "[", "\"\<\[Beta]rule\>\"", "]"}]}]}], ";", 
     "\n", "\n", 
     RowBox[{
      RowBox[{"ExpectationValueBlock", "[", 
       RowBox[{
        RowBox[{"locZnorm", " ", "*", " ", "token"}], ",", 
        RowBox[{"\"\<graph\>\"", "->", 
         RowBox[{"OptionValue", "[", "\"\<graph\>\"", "]"}]}], ",", 
        RowBox[{"\"\<fields\>\"", "->", 
         RowBox[{"FieldsNamesGenerator", "[", 
          RowBox[{"{", 
           RowBox[{"\[Phi]", ",", "\[Chi]"}], "}"}], "]"}]}]}], "]"}], "/.", 
      RowBox[{"token", "->", "1"}]}]}]}], "\n", "]"}]}]}], "Input",
 InitializationCell->True,
 CellLabel->
  "In[186]:=",ExpressionUUID->"54447578-53f4-c245-9201-48ebd24a49d1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "LRWaction", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "LRWaction", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<sourceBC\>\"", "->", "1"}], ",", 
      RowBox[{"\"\<excludedVertices\>\"", "->", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{"\"\<graph\>\"", "->", "g"}], ",", 
      RowBox[{"\"\<startingTime\>\"", "->", "1"}], ",", 
      RowBox[{"\"\<endTime\>\"", "->", "10"}]}], "}"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"LRWaction", "[", 
   RowBox[{"OptionsPattern", "[", "]"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "locGraph", ",", "locStartingTime", ",", "locEndTime", ",", "locSource", 
      ",", "locRoot", ",", "locWeights", ",", "totWeights", ",", 
      "locVertices", ",", "actionTimeSlice", ",", "action"}], "}"}], ",", 
    "\n", 
    RowBox[{
     RowBox[{"Clear", "[", 
      RowBox[{"i", ",", "k", ",", "j", ",", "\[Gamma]"}], "]"}], ";", "\n", 
     "\n", "\n", 
     RowBox[{"locGraph", "=", 
      RowBox[{"OptionValue", "[", "\"\<graph\>\"", "]"}]}], ";", "\n", 
     RowBox[{"locStartingTime", " ", "=", 
      RowBox[{"OptionValue", "[", "\"\<startingTime\>\"", "]"}]}], ";", "\n", 
     RowBox[{"locEndTime", " ", "=", 
      RowBox[{"OptionValue", "[", "\"\<endTime\>\"", "]"}]}], ";", "\n", "\n", 
     RowBox[{"locWeights", "=", 
      RowBox[{
       RowBox[{"WeightedAdjacencyMatrix", "[", "locGraph", "]"}], "//", 
       "Normal"}]}], ";", "\n", 
     RowBox[{"totWeights", " ", "=", 
      RowBox[{"Total", "[", 
       RowBox[{"locWeights", ",", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\n", "\n", 
     RowBox[{"locVertices", "=", 
      RowBox[{"VertexList", "@", "locGraph"}]}], ";", "\n", "\n", 
     RowBox[{"locRoot", " ", "=", " ", "\n", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"locGraph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<ROOT\>\""}]}], "]"}], "&"}]}], "]"}], 
        "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", 
     RowBox[{"locSource", " ", "=", " ", "\n", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"locGraph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<SOURCE\>\""}]}], "]"}], "&"}]}], "]"}],
         "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "\n", "\n", 
     RowBox[{
      RowBox[{"actionTimeSlice", " ", "[", "T_", "]"}], ":=", " ", 
      RowBox[{
       RowBox[{"Product", "[", "\n", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"totWeights", "[", 
              RowBox[{"[", "x", "]"}], "]"}], "===", "0"}], "  ", "||", " ", 
            RowBox[{"MemberQ", "[", 
             RowBox[{
              RowBox[{"OptionValue", "[", "\"\<excludedVertices\>\"", "]"}], 
              ",", "x"}], "]"}]}], ",", "1", ",", "\n", 
           RowBox[{"(*", "FALSE", "*)"}], 
           RowBox[{"V", "[", 
            RowBox[{"(", 
             RowBox[{"1", "+", 
              RowBox[{"\[Gamma]", " ", 
               RowBox[{"Sum", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"locWeights", "[", 
                   RowBox[{"[", 
                    RowBox[{"x", ",", "y"}], "]"}], "]"}], 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"R", "[", 
                    RowBox[{"x", ",", "y", ",", "Red"}], "]"}], 
                    RowBox[{"\[Phi]s", "[", 
                    RowBox[{"y", ",", 
                    RowBox[{"Subscript", "[", 
                    RowBox[{"t", ",", " ", 
                    RowBox[{"T", "+", "1"}]}], "]"}], ",", 
                    RowBox[{"Subscript", "[", 
                    RowBox[{"k", ",", " ", "y"}], "]"}]}], "]"}], 
                    RowBox[{"\[Psi]s", "[", 
                    RowBox[{"x", ",", 
                    RowBox[{"Subscript", "[", 
                    RowBox[{"t", ",", " ", 
                    RowBox[{"T", "+", "1"}]}], "]"}], ",", 
                    RowBox[{"Subscript", "[", 
                    RowBox[{"ll", ",", " ", "x"}], "]"}]}], "]"}]}], "-", 
                    RowBox[{"\[Phi]s", "[", 
                    RowBox[{"x", ",", 
                    RowBox[{"Subscript", "[", 
                    RowBox[{"t", ",", " ", 
                    RowBox[{"T", "+", "1"}]}], "]"}], ",", 
                    RowBox[{"Subscript", "[", 
                    RowBox[{"k", ",", " ", "x"}], "]"}]}], "]"}]}], ")"}], 
                  RowBox[{"\[Chi]s", "[", 
                   RowBox[{"y", ",", 
                    RowBox[{"Subscript", "[", 
                    RowBox[{"t", ",", " ", "T"}], "]"}], ",", "1"}], "]"}], 
                  "*", 
                  RowBox[{"\[Phi]", "[", 
                   RowBox[{"x", ",", 
                    RowBox[{"Subscript", "[", 
                    RowBox[{"t", ",", " ", "T"}], "]"}], ",", 
                    RowBox[{"Subscript", "[", 
                    RowBox[{"k", ",", " ", "x"}], "]"}]}], "]"}]}], ",", 
                 RowBox[{"{", 
                  RowBox[{"y", ",", 
                   RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], 
                "]"}]}], "+", 
              RowBox[{"Sum", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"locWeights", "[", 
                   RowBox[{"[", 
                    RowBox[{"x", ",", "y"}], "]"}], "]"}], "/", 
                  RowBox[{"totWeights", "[", 
                   RowBox[{"[", "x", "]"}], "]"}]}], " ", 
                 RowBox[{"R", "[", 
                  RowBox[{"x", ",", "y", ",", "Blue"}], "]"}], 
                 RowBox[{"\[Chi]s", "[", 
                  RowBox[{"y", ",", 
                   RowBox[{"Subscript", "[", 
                    RowBox[{"t", ",", " ", "T"}], "]"}], ",", 
                   RowBox[{"Subscript", "[", 
                    RowBox[{"i", ",", " ", "x"}], "]"}]}], "]"}], 
                 RowBox[{"\[Chi]", "[", 
                  RowBox[{"x", ",", 
                   RowBox[{"Subscript", "[", 
                    RowBox[{"t", ",", " ", "T"}], "]"}], ",", 
                   RowBox[{"Subscript", "[", 
                    RowBox[{"i", ",", " ", "x"}], "]"}]}], "]"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"y", ",", 
                  RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], 
               "]"}], "\n", "+", 
              RowBox[{"(*", 
               RowBox[{"COPY", " ", "\[Phi]"}], "*)"}], " ", 
              RowBox[{
               RowBox[{"\[Phi]s", "[", 
                RowBox[{"x", ",", 
                 RowBox[{"Subscript", "[", 
                  RowBox[{"t", ",", " ", 
