Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "DrawFromExpression", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "DrawFromExpression", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<graph\>\"", "->", "g"}], ",", 
      RowBox[{"\"\<drawOthers\>\"", "->", "False"}]}], "}"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"DrawFromExpression", "[", 
   RowBox[{"exp_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"terms", ",", 
      RowBox[{"graphs", "=", 
       RowBox[{"{", "}"}]}], ",", "i"}], "}"}], ",", "\n", 
    RowBox[{
     RowBox[{"terms", "=", 
      RowBox[{
       RowBox[{"exp", "//.", 
        RowBox[{
         RowBox[{
          RowBox[{"R", "[", 
           RowBox[{"a_", ",", "b_", ",", "c_"}], "]"}], "^", "n_"}], "->", 
         RowBox[{"R", "[", 
          RowBox[{"a", ",", "b", ",", "c"}], "]"}]}]}], "//", "Expand"}]}], 
     ";", "\n", 
     RowBox[{"terms", "=", 
      RowBox[{"List", " ", "@@", " ", 
       RowBox[{"(", 
