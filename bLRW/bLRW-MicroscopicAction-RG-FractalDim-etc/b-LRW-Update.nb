          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"graph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<ROOT\>\""}]}], "]"}], "&"}]}], "]"}], 
        "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", 
     RowBox[{"locSource", " ", "=", " ", "\n", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"graph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<SOURCE\>\""}]}], "]"}], "&"}]}], "]"}],
         "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "\n", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"locRoot", " ", "=!=", " ", 
        RowBox[{"path", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<####  WRONG ROOT  ####\>\"", "]"}], ";", 
        " ", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\n", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"locSource", " ", "=!=", " ", 
        RowBox[{"path", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "2"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<####  WRONG SOURCE  ####\>\"", "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\n", "\n", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"locBC", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", "}"}], ",", 
            RowBox[{"{", "}"}]}], "}"}]}], ",", "\[Phi]", ",", "i", ",", 
         "\[Phi]sol"}], "}"}], ",", "\n", "\n", 
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{
          RowBox[{"locBC", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"\[CapitalPhi]", "[", "locSource", "]"}], "==", "1"}]}], 
         "]"}], ";", "\n", 
        RowBox[{"AppendTo", "[", 
         RowBox[{
          RowBox[{"locBC", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", "locSource"}], "]"}], ";", 
        "\n", "\n", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", "1"}], ",", 
          RowBox[{"i", "<=", 
           RowBox[{"Length", "[", "path", "]"}]}], ",", 
          RowBox[{"i", "++"}], ",", "\n", 
          RowBox[{
           RowBox[{
            RowBox[{"AppendTo", "[", 
             RowBox[{
              RowBox[{"locBC", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{"\[CapitalPhi]", "[", 
                RowBox[{"path", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "==", "0"}]}],
              "]"}], ";", "\n", 
            RowBox[{"AppendTo", "[", 
             RowBox[{
              RowBox[{"locBC", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", 
              RowBox[{"path", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "1"}], "]"}], "]"}]}], "]"}], ";", "\n", 
            "\n", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"Print", "[", "locBC", "]"}], ";"}], "*)"}], "\n", "\n", 
            RowBox[{"\[Phi]sol", "=", 
             RowBox[{
              RowBox[{"LaplaceEqSolver", "[", 
               RowBox[{"graph", ",", 
                RowBox[{"\"\<BC\>\"", "->", "locBC"}]}], "]"}], "/.", 
              RowBox[{
               RowBox[{"\[Beta]", "[", "__", "]"}], "->", "1"}]}]}], ";", 
            "\n", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"Print", "[", "\[Phi]sol", "]"}], ";"}], "*)"}], "\n", 
            "\n", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"Print", "[", "\"\< ##### OK SO FAR ##### \>\"", "]"}], 
              ";"}], "*)"}], "\n", "\n", 
            RowBox[{"denominator", "=", 
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"locWeights", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", "y"}], "]"}], 
                 "]"}], "*", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Select", "[", 
                    RowBox[{"\[Phi]sol", ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "==", 
                    RowBox[{"\[CapitalPhi]", "[", "y", "]"}]}], " ", "&"}]}], 
                    "]"}], "[", 
                   RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], ")"}], "^", 
                 "b"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"y", ",", 
                 RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], 
              "]"}]}], ";"}], "\n", 
           RowBox[{"(*", 
            RowBox[{"Print", "[", "denominator", "]"}], "*)"}], ";", "\n", 
           "\n", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"OptionValue", "[", "\"\<print\>\"", "]"}], ",", "\n", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{"\"\<#####  Transition probability \>\"", "<>", 
                RowBox[{"ToString", "[", 
                 RowBox[{"path", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "<>", 
                "\"\< to \>\"", "<>", 
                RowBox[{"ToString", "[", 
                 RowBox[{"path", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "2"}], "]"}], "]"}], "]"}], "<>", 
                "\"\<  #####\>\""}], "]"}], ";", "\n", "\n", 
              RowBox[{"Print", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"locWeights", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}], 
                    "*", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Select", "[", 
                    RowBox[{"\[Phi]sol", ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "==", 
                    RowBox[{"\[CapitalPhi]", "[", 
                    RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}], "]"}]}], " ", 
                    "&"}]}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], ")"}], "^", 
                    "b"}]}], ")"}], "/", "denominator"}], "/.", 
                 RowBox[{
                  RowBox[{"\[Beta]", "[", 
                   RowBox[{"_", ",", "_"}], "]"}], "->", "1"}]}], "//", 
                "FullSimplify"}], "]"}], ";"}]}], "\n", "]"}], ";", "\n", 
           "\n", 
           RowBox[{
            RowBox[{"prob", "*=", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"locWeights", "[", 
                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}], 
                 "*", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"Select", "[", 
                    RowBox[{"\[Phi]sol", ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "==", 
                    RowBox[{"\[CapitalPhi]", "[", 
                    RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}], "]"}]}], " ", 
                    "&"}]}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], ")"}], "^", 
                  "b"}]}], ")"}], "/", "denominator"}], "/.", 
              RowBox[{
               RowBox[{"\[Beta]", "[", "__", "]"}], "->", "1"}]}]}], "//", 
            "FullSimplify"}], ";", "\n", 
           RowBox[{"Clear", "[", "\[Phi]sol", "]"}], ";"}]}], "\n", "]"}], 
        ";"}]}], 
      RowBox[{"(*", 
       RowBox[{"END", " ", "OF", " ", "FOR"}], "*)"}], "\n", "]"}], ";", 
     RowBox[{"(*", 
      RowBox[{"END", " ", "OF", " ", "MODULE"}], "*)"}], "\n", "\n", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"OptionValue", "[", "\"\<draw\>\"", "]"}], ",", 
       RowBox[{"Print", "[", 
        RowBox[{"DrawOnGraph", "[", 
         RowBox[{"graph", ",", "path"}], "]"}], "]"}]}], "]"}], ";", "\n", 
     RowBox[{"Return", "[", "prob", "]"}]}]}], "\n", "]"}]}], "\n"}], "Code",
 CellLabel->
  "In[214]:=",ExpressionUUID->"9ba19c6d-afc3-a145-bc81-608b263ca70a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "PathFinder", "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"PathFinder", "[", "graph_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pathList", "=", 
      RowBox[{"{", 
       RowBox[{"{", "}"}], "}"}]}], "}"}], ",", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"Step", "[", "subgraph_", "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "locEdges", ",", "locVertices", ",", "locWeights", ",", "locRoot", 
          ",", "locSource", ",", "locMoves", ",", "newEdges", ",", " ", 
          "newRoot", ",", "smallerGraph", ",", "i"}], "}"}], ",", "\n", 
        RowBox[{
         RowBox[{
          RowBox[{"locEdges", " ", "=", " ", 
           RowBox[{
            RowBox[{"EdgeList", "@", "subgraph"}], "/.", 
            RowBox[{"DirectedEdge", "->", "List"}]}]}], ";", "\n", 
          RowBox[{"locVertices", "=", 
           RowBox[{"VertexList", "@", "subgraph"}]}], ";", "\n", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "locVertices", "]"}], "==", "1"}], ",", 
            RowBox[{"Return", "[", "NULL", "]"}]}], "]"}], ";", "\n", 
          RowBox[{"locWeights", "=", 
           RowBox[{
            RowBox[{"WeightedAdjacencyMatrix", "[", "subgraph", "]"}], "//", 
            "Normal"}]}], ";", "\n", 
          RowBox[{"locRoot", " ", "=", " ", "\n", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"Select", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"List", "@@@", 
                  RowBox[{"PropertyValue", "[", 
                   RowBox[{"subgraph", ",", "VertexLabels"}], "]"}]}], ")"}], 
                "[", 
                RowBox[{"[", 
                 RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
               RowBox[{
                RowBox[{"StringMatchQ", "[", 
                 RowBox[{
                  RowBox[{"#", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], ",", 
                  RowBox[{"___", "~~", "\"\<ROOT\>\""}]}], "]"}], "&"}]}], 
              "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", 
          RowBox[{"locSource", " ", "=", " ", "\n", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"Select", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"List", "@@@", 
                  RowBox[{"PropertyValue", "[", 
                   RowBox[{"subgraph", ",", "VertexLabels"}], "]"}]}], ")"}], 
                "[", 
                RowBox[{"[", 
                 RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
               RowBox[{
                RowBox[{"StringMatchQ", "[", 
                 RowBox[{
                  RowBox[{"#", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], ",", 
                  RowBox[{"___", "~~", "\"\<SOURCE\>\""}]}], "]"}], "&"}]}], 
              "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", 
          RowBox[{"locMoves", "=", 
           RowBox[{
            RowBox[{"Select", "[", 
             RowBox[{"locEdges", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "==", "locRoot"}], " ", 
               "&"}]}], "]"}], "[", 
            RowBox[{"[", "All", "]"}], "]"}]}], ";"}], "\n", "\n", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Print", "[", "\"\<###  LocMoves  ####\>\"", "]"}], ";", 
           "\n", 
           RowBox[{"Print", "[", "locMoves", "]"}], ";"}], "*)"}], ";", "\n", 
         "\n", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"i", "=", "1"}], ",", " ", 
           RowBox[{"i", "<=", 
            RowBox[{"Length", "[", "locMoves", "]"}]}], ",", 
           RowBox[{"i", "++"}], ",", "\n", "\n", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"i", " ", "==", 
                 RowBox[{"Length", "[", "locMoves", "]"}]}], ",", "\n", 
                RowBox[{"(*", "True", "*)"}], 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"locMoves", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}], "==", 
                   "locSource"}], ",", "\n", " ", 
                  RowBox[{"(*", "Ture", "*)"}], 
                  RowBox[{
                   RowBox[{"pathList", "=", 
                    RowBox[{"Append", "[", 
                    RowBox[{
                    RowBox[{"pathList", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
                    RowBox[{"Append", "[", 
                    RowBox[{
                    RowBox[{"pathList", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"locMoves", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "]"}]}], ";", 
                   " ", 
                   RowBox[{"Continue", "[", "]"}]}], ",", "\n", " ", 
                  RowBox[{"(*", "False", "*)"}], 
                  RowBox[{"pathList", "=", 
                   RowBox[{"Prepend", "[", 
                    RowBox[{
                    RowBox[{"pathList", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
                    RowBox[{"Append", "[", 
                    RowBox[{
                    RowBox[{"pathList", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"locMoves", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "]"}]}]}], 
                 "\n", "]"}], ",", "\n", 
                RowBox[{"(*", "False", "*)"}], "\n", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"locMoves", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}], "==", 
                   "locSource"}], ",", "\n", " ", 
                  RowBox[{"(*", "True", "*)"}], 
                  RowBox[{
                   RowBox[{"pathList", "=", 
                    RowBox[{"Append", "[", 
                    RowBox[{"pathList", ",", 
                    RowBox[{"Append", "[", 
                    RowBox[{
                    RowBox[{"pathList", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"locMoves", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "]"}]}], ";", 
                   RowBox[{"Continue", "[", "]"}]}], ",", "\n", " ", 
                  RowBox[{"(*", "False", "*)"}], 
                  RowBox[{"pathList", "=", 
                   RowBox[{"Prepend", "[", 
                    RowBox[{"pathList", ",", 
                    RowBox[{"Append", "[", 
                    RowBox[{
                    RowBox[{"pathList", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"locMoves", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "]"}]}]}], 
                 "\n", "]"}]}], "]"}], ";"}], "\n", "\n", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{"Print", "[", "\"\<###  pathList  ####\>\"", "]"}], 
               ";", "\n", 
               RowBox[{"Print", "[", "pathList", "]"}], ";"}], "*)"}], ";", 
             "\n", "\n", 
             RowBox[{"newEdges", "=", 
              RowBox[{
               RowBox[{"Select", "[", 
                RowBox[{"locEdges", ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "=!=", "locRoot"}], " ", "&&",
                    " ", 
                   RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "=!=", "locRoot"}]}], " ",
                   "&"}]}], "]"}], "[", 
               RowBox[{"[", "All", "]"}], "]"}]}], ";", "\n", 
             RowBox[{"newRoot", " ", "=", " ", 
              RowBox[{"locMoves", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ";", "\n", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Length", "[", "newEdges", "]"}], " ", "<=", " ", 
                "0"}], ",", 
               RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\n", 
             RowBox[{"smallerGraph", "=", 
              RowBox[{
               RowBox[{"MyGraph", "[", 
                RowBox[{"newEdges", ",", "newRoot", ",", "locSource", ",", 
                 RowBox[{"\"\<undirected\>\"", "->", "False"}]}], "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", "\n", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"Print", "[", "smallerGraph", "]"}], ";"}], "*)"}], ";",
             "\n", "\n", 
            RowBox[{"Step", "[", "smallerGraph", "]"}]}]}], "\n", "]"}]}]}], 
       "\n", "]"}]}], ";", "\n", "\n", 
     RowBox[{"Step", "[", "graph", "]"}], ";", "\n", 
     RowBox[{"Return", "[", "pathList", "]"}]}]}], "\n", "]"}]}]}], "Code",
 CellLabel->
  "In[217]:=",ExpressionUUID->"2fb06a73-634a-b64e-9caa-776d48083bf4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "AllbLaplacianRWs", "]"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "AllbLaplacianRWs", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<draw\>\"", "->", "False"}], ",", 
      RowBox[{"\"\<print\>\"", "->", "False"}]}], "}"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"AllbLaplacianRWs", "[", 
   RowBox[{"graph_", ",", "b_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"possibleLRW", ",", "i", ",", 
      RowBox[{"probabilityLRW", "=", 
       RowBox[{"{", "}"}]}]}], "}"}], ",", "\n", 
    RowBox[{
     RowBox[{"possibleLRW", "=", 
      RowBox[{"PathFinder", "[", "graph", "]"}]}], ";", "\n", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", " ", 
       RowBox[{"i", "<=", " ", 
        RowBox[{"Length", "[", "possibleLRW", "]"}]}], ",", 
       RowBox[{"i", "++"}], ",", "\n", 
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"probabilityLRW", ",", 
          RowBox[{"bLaplacianRW", "[", 
           RowBox[{"graph", ",", 
            RowBox[{"possibleLRW", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", "b", ",", 
            RowBox[{"\"\<draw\>\"", "->", 
             RowBox[{"OptionValue", "[", "\"\<draw\>\"", "]"}]}]}], "]"}]}], 
         "]"}], ";", "\n", "\n", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"OptionValue", "[", "\"\<print\>\"", "]"}], ",", 
          RowBox[{"Print", "[", 
           RowBox[{"i", ",", "\"\<) Laplacian RW \>\"", ",", 
            RowBox[{"possibleLRW", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", 
            "\"\< with probability \>\"", " ", ",", 
            RowBox[{"probabilityLRW", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "\n", "]"}]}]}], "\n",
       "]"}], ";", "\n", "\[IndentingNewLine]", 
     RowBox[{"possibleLRW", "=", "\[IndentingNewLine]", 
      RowBox[{"Replace", "[", 
       RowBox[{"possibleLRW", ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"a_", "?", "NumberQ"}], ",", 
           RowBox[{"c_", "?", "NumberQ"}]}], "}"}], ":>", 
         RowBox[{"R", "[", 
          RowBox[{"a", ",", "c", ",", 
           TemplateBox[<|"color" -> RGBColor[1, 0, 0]|>,
            "RGBColorSwatchTemplate"]}], "]"}]}], ",", "3"}], "]"}]}], ";", 
     "\n", "\n", 
     RowBox[{"Return", "[", 
      RowBox[{"{", 
       RowBox[{"possibleLRW", ",", "probabilityLRW"}], "}"}], "]"}]}]}], "\n",
    "]"}]}]}], "Code",
 CellChangeTimes->{{3.9820537893514156`*^9, 3.982053793395689*^9}},
 CellLabel->
  "In[235]:=",ExpressionUUID->"02151fb0-01f3-d749-9721-fc9c6ad4295a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Clear", "[", "b", "]"}], ";"}]], "Code",
 CellLabel->
  "In[222]:=",ExpressionUUID->"d1aa3344-c243-7242-90a0-a231a755c452"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "AllbLaplacianRWs", "]"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "AllbLaplacianRWs", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<draw\>\"", "->", "False"}], ",", 
      RowBox[{"\"\<print\>\"", "->", "False"}]}], "}"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"AllbLaplacianRWs", "[", 
   RowBox[{"graph_", ",", "b_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"possibleLRW", ",", "i", ",", 
      RowBox[{"probabilityLRW", "=", 
       RowBox[{"{", "}"}]}]}], "}"}], ",", "\n", 
    RowBox[{
     RowBox[{"possibleLRW", "=", 
      RowBox[{"PathFinder", "[", "graph", "]"}]}], ";", "\n", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", " ", 
       RowBox[{"i", "<=", " ", 
        RowBox[{"Length", "[", "possibleLRW", "]"}]}], ",", 
       RowBox[{"i", "++"}], ",", "\n", 
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"probabilityLRW", ",", 
          RowBox[{"bLaplacianRW", "[", 
           RowBox[{"graph", ",", 
            RowBox[{"possibleLRW", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", "b", ",", 
            RowBox[{"\"\<draw\>\"", "->", 
             RowBox[{"OptionValue", "[", "\"\<draw\>\"", "]"}]}]}], "]"}]}], 
         "]"}], ";", "\n", "\n", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"OptionValue", "[", "\"\<print\>\"", "]"}], ",", 
          RowBox[{"Print", "[", 
           RowBox[{"i", ",", "\"\<) Laplacian RW \>\"", ",", 
            RowBox[{"possibleLRW", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", 
            "\"\< with probability \>\"", " ", ",", 
            RowBox[{"probabilityLRW", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "\n", "]"}]}]}], "\n",
       "]"}], ";", "\n", 
     RowBox[{"Return", "[", 
      RowBox[{"{", 
       RowBox[{"possibleLRW", ",", "probabilityLRW"}], "}"}], "]"}]}]}], "\n",
    "]"}]}]}], "Code",
