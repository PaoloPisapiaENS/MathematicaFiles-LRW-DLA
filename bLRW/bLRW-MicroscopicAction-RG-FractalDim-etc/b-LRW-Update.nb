        RowBox[{"DrawOnGraph", "[", 
         RowBox[{"graph", ",", "path"}], "]"}], "]"}]}], "]"}], ";", "\n", 
     RowBox[{"Return", "[", "prob", "]"}]}]}], "\n", "]"}]}]}], "Input",
