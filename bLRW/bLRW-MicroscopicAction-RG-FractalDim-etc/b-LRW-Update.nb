             "FullSimplify"}], "]"}], ";", "\n", "\n", 
           RowBox[{
            RowBox[{"prob", "*=", "numerator"}], "//", "FullSimplify"}], 
           ";"}]}], "\n", "]"}]}]}], "\n", "]"}], ";", "\n", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"OptionValue", "[", "\"\<draw\>\"", "]"}], ",", 
