Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "ConvergencebLRW", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "ConvergencebLRW", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<graph\>\"", "->", "g"}], ",", 
      RowBox[{"\"\<fields\>\"", "->", 
       RowBox[{"FieldsNamesGenerator", "[", 
        RowBox[{"{", 
         RowBox[{"\[Phi]", ",", "\[Psi]", ",", "\[Xi]", ",", "\[Chi]"}], 
         "}"}], "]"}]}], ",", 
      RowBox[{"\"\<steps\>\"", "->", "10"}], ",", 
      RowBox[{"\"\<precision\>\"", "->", 
       RowBox[{"10", "^", 
        RowBox[{"-", "9"}]}]}], ",", 
      RowBox[{"\"\<gammaValue\>\"", "->", "0.1"}]}], "}"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"ConvergencebLRW", "[", 
   RowBox[{"operator_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "Z", ",", "locOperator", ",", "locPrecision", ",", "loc\[Gamma]", ",", 
      "exp", ",", "i", ",", "temp", ",", "token"}], "}"}], ",", "\n", "\n", 
    RowBox[{
     RowBox[{"i", "=", "1"}], ";", "\n", "\n", 
     RowBox[{"Z", "=", 
      RowBox[{
       RowBox[{"bLRWaction", "[", 
        RowBox[{
         RowBox[{"\"\<graph\>\"", "->", 
          RowBox[{"OptionValue", "[", " ", "\"\<graph\>\"", "]"}]}], ",", 
         RowBox[{"\"\<endTime\>\"", "->", "1"}]}], "]"}], "/.", 
       RowBox[{
        RowBox[{"\[Beta]", "[", "__", "]"}], "->", "1"}]}]}], ";", "\n", "\n", 
     RowBox[{"locOperator", "=", " ", 
      RowBox[{"operator", " ", "/", 
       RowBox[{"bLRWnorm", "[", 
        RowBox[{"operator", ",", 
         RowBox[{"\"\<graph\>\"", "->", 
          RowBox[{"OptionValue", "[", " ", "\"\<graph\>\"", "]"}]}], ",", 
         RowBox[{"\"\<endTime\>\"", "->", "1"}], ",", 
         RowBox[{"\"\<\[Beta]rule\>\"", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Beta]", "[", "__", "]"}], "->", "1"}], "}"}]}], ",", 
         RowBox[{"\"\<fields\>\"", "->", 
          RowBox[{"OptionValue", "[", "\"\<fields\>\"", "]"}]}]}], "]"}]}]}], 
     ";", "\n", "\n", 
     RowBox[{"locPrecision", "=", 
      RowBox[{"OptionValue", "[", "\"\<precision\>\"", "]"}]}], ";", "\n", 
     RowBox[{"loc\[Gamma]", "=", 
      RowBox[{"OptionValue", "[", "\"\<gammaValue\>\"", "]"}]}], ";", "\n", 
     "\n", 
     RowBox[{"exp", "=", 
      RowBox[{"ExpectationValueBlock", "[", 
       RowBox[{
        RowBox[{"Z", " ", "locOperator"}], ",", 
        RowBox[{"\"\<endTime\>\"", "->", "1"}], ",", 
        RowBox[{"\"\<fields\>\"", "->", 
         RowBox[{"OptionValue", "[", "\"\<fields\>\"", "]"}]}], ",", 
        RowBox[{"\"\<Rrule\>\"", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"R", "[", 
            RowBox[{"__", ",", "Blue"}], "]"}], "->", "1"}], "}"}]}], ",", 
        RowBox[{"\"\<graph\>\"", "->", 
         RowBox[{"OptionValue", "[", " ", "\"\<graph\>\"", "]"}]}], ",", 
        RowBox[{"\"\<n\[Chi]\>\"", "->", 
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}]}]}], "]"}]}], ";", "\n", 
     RowBox[{"exp", "=", 
      RowBox[{"exp", "/.", 
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"t", ",", " ", "a_"}], "]"}], "->", 
        RowBox[{"Subscript", "[", 
         RowBox[{"t", ",", " ", 
          RowBox[{"a", "-", "1"}]}], "]"}]}]}]}], ";", "\n", 
     RowBox[{"exp", "=", 
      RowBox[{"exp", "/.", 
       RowBox[{"\[Gamma]", "->", "loc\[Gamma]"}]}]}], ";", "\n", "\n", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<########## i=\>\"", "<>", 
         RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<, \>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Coefficient", "[", 
             RowBox[{"exp", ",", " ", 
              RowBox[{"\[Phi]s", "[", 
               RowBox[{"1", ",", 
                RowBox[{"Subscript", "[", 
                 RowBox[{"t", ",", " ", "1"}], "]"}], ",", 
                RowBox[{"Subscript", "[", 
                 RowBox[{"k", ",", " ", "1"}], "]"}]}], "]"}]}], "]"}], "/.", 
            RowBox[{
             RowBox[{"R", "[", "__", "]"}], "->", "0"}]}], ")"}], "]"}], 
         "<>", "\"\< ############\>\""}], "]"}], ";"}], "*)"}], "\n", "\n", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "2"}], ",", 
       RowBox[{"i", "<=", 
        RowBox[{"OptionValue", "[", "\"\<steps\>\"", "]"}]}], " ", 
       RowBox[{"(*", 
        RowBox[{"&&", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Coefficient", "[", 
              RowBox[{"exp", ",", "  ", 
               RowBox[{"\[Phi]s", "[", 
                RowBox[{"1", ",", 
                 RowBox[{"Subscript", "[", 
                  RowBox[{"t", ",", " ", "1"}], "]"}], ",", 
                 RowBox[{"Subscript", "[", 
                  RowBox[{"k", ",", " ", "1"}], "]"}]}], "]"}]}], "]"}], "/.", 
             RowBox[{
              RowBox[{"R", "[", "__", "]"}], "->", "0"}]}], "/.", 
            RowBox[{"\[Gamma]", "->", "loc\[Gamma]"}]}], ")"}], ">=", 
          "locPrecision"}]}], "*)"}], ",", 
       RowBox[{"i", "++"}], ",", "\n", "\n", 
       RowBox[{
        RowBox[{"exp", "=", 
         RowBox[{"Replace", "[", 
          RowBox[{"exp", ",", 
           RowBox[{
            RowBox[{"a_", "/;", 
             RowBox[{"(", 
              RowBox[{"!", 
               RowBox[{"NumericQ", "[", "a", "]"}]}], ")"}]}], ":>", 
            RowBox[{"a", "/", 
             RowBox[{"(", 
              RowBox[{"bLRWnorm", "[", 
               RowBox[{"a", ",", 
                RowBox[{"\"\<graph\>\"", "->", 
                 RowBox[{"OptionValue", "[", " ", "\"\<graph\>\"", "]"}]}], 
                ",", 
                RowBox[{"\"\<endTime\>\"", "->", "1"}], ",", 
                RowBox[{"\"\<\[Beta]rule\>\"", "->", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"\[Beta]", "[", "__", "]"}], "->", "1"}], "}"}]}], 
                ",", 
                RowBox[{"\"\<fields\>\"", "->", 
                 RowBox[{"OptionValue", "[", "\"\<fields\>\"", "]"}]}]}], 
               "]"}], ")"}]}]}], ",", "1"}], "]"}]}], ";", "\n", "\n", 
        RowBox[{"exp", "=", 
         RowBox[{"ExpectationValueBlock", "[", 
          RowBox[{
           RowBox[{"Z", " ", "exp"}], ",", 
           RowBox[{"\"\<endTime\>\"", "->", "1"}], ",", 
           RowBox[{"\"\<fields\>\"", "->", 
            RowBox[{"OptionValue", "[", "\"\<fields\>\"", "]"}]}], ",", 
           RowBox[{"\"\<Rrule\>\"", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"R", "[", 
               RowBox[{"__", ",", "Blue"}], "]"}], "->", "1"}], "}"}]}], ",", 
           RowBox[{"\"\<graph\>\"", "->", 
            RowBox[{"OptionValue", "[", " ", "\"\<graph\>\"", "]"}]}], ",", 
           RowBox[{"\"\<n\[Chi]\>\"", "->", 
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}]}]}], "]"}]}], ";", "\n", 
        RowBox[{"exp", "=", 
         RowBox[{"exp", "/.", 
          RowBox[{
           RowBox[{"Subscript", "[", 
            RowBox[{"t", ",", " ", "a_"}], "]"}], "->", 
           RowBox[{"Subscript", "[", 
            RowBox[{"t", ",", " ", 
             RowBox[{"a", "-", "1"}]}], "]"}]}]}]}], ";", "\n", 
        RowBox[{"exp", "=", 
         RowBox[{"exp", "/.", 
          RowBox[{"\[Gamma]", "->", "loc\[Gamma]"}]}]}], ";"}]}], "\n", "\n", 
      "]"}], ";", "\n", "\n", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<########## i=\>\"", ",", 
       RowBox[{"i", "-", "1"}], ",", "\"\<, \>\"", ",", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Coefficient", "[", 
          RowBox[{"exp", ",", " ", 
           RowBox[{"\[Phi]s", "[", 
            RowBox[{"1", ",", 
             RowBox[{"Subscript", "[", 
              RowBox[{"t", ",", " ", "1"}], "]"}], ",", 
             RowBox[{"Subscript", "[", 
              RowBox[{"k", ",", " ", "1"}], "]"}]}], "]"}]}], "]"}], "/.", 
         RowBox[{
          RowBox[{"R", "[", "__", "]"}], "->", "0"}]}], ")"}], ",", 
       "\"\< ############\>\""}], "]"}], ";", "\n", "\n", 
     RowBox[{"Return", "[", "exp", "]"}], ";"}]}], "\n", "]"}]}]}], "Code",
