Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "LERWtransitionProb", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "LERWtransitionProb", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<draw\>\"", "->", "False"}], ",", 
      RowBox[{"\"\<print\>\"", "->", "False"}]}], "}"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"LERWtransitionProb", "[", 
   RowBox[{"graph_", ",", "path__", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "locSource", ",", "locRoot", ",", "locWeights", ",", "totWeights", ",", 
      "locVertices", ",", "denominator", ",", 
      RowBox[{"prob", "=", "1"}], ",", " ", "Z", ",", "numerator"}], "}"}], 
    ",", "\n", 
    RowBox[{
     RowBox[{"locWeights", "=", 
      RowBox[{
       RowBox[{"WeightedAdjacencyMatrix", "[", "graph", "]"}], "//", 
       "Normal"}]}], ";", "\n", 
     RowBox[{"totWeights", " ", "=", 
      RowBox[{"Total", "[", 
       RowBox[{"locWeights", ",", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\n", "\n", 
     RowBox[{"locVertices", "=", 
      RowBox[{"VertexList", "@", "graph"}]}], ";", "\n", "\n", 
     RowBox[{"locRoot", " ", "=", " ", "\n", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"graph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<ROOT\>\""}]}], "]"}], "&"}]}], "]"}], 
        "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", 
     RowBox[{"locSource", " ", "=", " ", "\n", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"graph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<SOURCE\>\""}]}], "]"}], "&"}]}], "]"}],
         "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "\n", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"locRoot", " ", "=!=", " ", 
        RowBox[{"path", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<####  WRONG ROOT  ####\>\"", "]"}], ";", 
        " ", 
        RowBox[{"Return", "[", "NULL", "]"}]}]}], "]"}], ";", "\n", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"locSource", " ", "=!=", " ", 
        RowBox[{"path", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "2"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<####  WRONG SOURCE  ####\>\"", "]"}], ";", 
        RowBox[{"Return", "[", "NULL", "]"}]}]}], "]"}], ";", "\n", "\n", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"locBC", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", "}"}], ",", 
            RowBox[{"{", "}"}]}], "}"}]}], ",", "\[Phi]", ",", 
         RowBox[{"i", "=", "1"}], ",", "j"}], "}"}], ",", "\n", 
       RowBox[{
        RowBox[{"locBC", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[Phi]", "[", "locSource", "]"}], "==", "1"}], "}"}], 
           ",", 
           RowBox[{"{", "locSource", "}"}]}], "}"}]}], ";", "\n", "\n", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", "1"}], ",", 
          RowBox[{"i", "<=", 
           RowBox[{"Length", "[", "path", "]"}]}], ",", 
          RowBox[{"i", "++"}], ",", "\n", "\n", 
          RowBox[{
           RowBox[{
            RowBox[{"Z", "=", 
             RowBox[{"VertexAssignment", "[", 
              RowBox[{"graph", ",", " ", 
               RowBox[{"\"\<excludedVertices\>\"", "->", 
                RowBox[{"locBC", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}]}], ";", "\n", 
            RowBox[{"Z", "=", 
             RowBox[{"ExpectationValue", "[", 
              RowBox[{"Z", "*", 
               RowBox[{"\[Chi]s", "[", 
                RowBox[{
                 RowBox[{"path", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", "1"}], "]"}]}],
               "]"}]}], ";", "\n", "\n", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"OptionValue", "[", "\"\<print\>\"", "]"}], ",", "\n", 
              RowBox[{
               RowBox[{
               "Print", "[", 
                "\"\<#####  Previous Partition Function  #####\>\"", "]"}], 
               ";", "\n", 
               RowBox[{"Print", "[", "Z", "]"}]}]}], "\n", "]"}], ";", "\n", 
            "\n", 
            RowBox[{"denominator", "=", 
             RowBox[{"Z", "//", "FullSimplify"}]}], ";", "\n", "\n", "\n", 
            RowBox[{"(*", 
             RowBox[{
             "Then", " ", "we", " ", "need", " ", "to", " ", "solve", " ", 
              "it", " ", "again", " ", "with", " ", "updated", " ", "BC", " ",
               "at", " ", "the", " ", "current", " ", "step"}], "*)"}], "\n", 
            "\n", 
            RowBox[{"AppendTo", "[", 
             RowBox[{
              RowBox[{"locBC", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{"\[Phi]", "[", 
                RowBox[{"path", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "==", "0"}]}],
              "]"}], ";", "\n", 
            RowBox[{"AppendTo", "[", 
             RowBox[{
              RowBox[{"locBC", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", 
              RowBox[{"path", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "1"}], "]"}], "]"}]}], "]"}], ";"}], "\n", 
           RowBox[{"(*", 
            RowBox[{"Print", "[", "locBC", "]"}], "*)"}], ";", "\n", "\n", 
           "\n", 
           RowBox[{"Z", "=", 
            RowBox[{"VertexAssignment", "[", 
             RowBox[{"graph", ",", " ", 
              RowBox[{"\"\<excludedVertices\>\"", "->", 
               RowBox[{"locBC", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], ",", 
              RowBox[{"\"\<sourceBC\>\"", "->", 
               RowBox[{"denominator", "^", 
                RowBox[{"-", "1"}]}]}]}], "]"}]}], ";", "\n", 
           RowBox[{"Z", "=", 
            RowBox[{"ExpectationValue", "[", 
             RowBox[{"Z", "*", 
              RowBox[{"\[Chi]s", "[", 
               RowBox[{
                RowBox[{"path", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", "1"}], "]"}]}], 
             " ", "]"}]}], ";", "\n", "\n", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"OptionValue", "[", "\"\<print\>\"", "]"}], ",", "\n", 
             RowBox[{
              RowBox[{
              "Print", "[", 
               "\"\<#####  Current Partition Function  #####\>\"", "]"}], ";",
               "\n", 
              RowBox[{"Print", "[", "Z", "]"}]}]}], "\n", "]"}], ";", "\n", 
           "\n", 
           RowBox[{"numerator", "=", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"locWeights", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"path", "[", 
