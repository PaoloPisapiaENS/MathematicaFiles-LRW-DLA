       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "\n", 
     RowBox[{"(*", "LERW", "*)"}], "\n", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<system\>\"", "]"}], "==", 
        "\"\<LERW\>\""}], ",", "\n", 
