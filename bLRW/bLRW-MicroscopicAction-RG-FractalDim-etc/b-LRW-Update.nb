           RowBox[{"AppendTo", "[", 
            RowBox[{"locWeights", ",", 
             RowBox[{"\[Beta]", "[", 
              RowBox[{
               RowBox[{"edges", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
               RowBox[{"edges", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "]"}]}], " ", 
            "]"}]}]}], "\n", "]"}], ";", "\n", "\n", 
        RowBox[{"locEdges", "=", 
