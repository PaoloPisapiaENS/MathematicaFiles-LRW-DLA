              RowBox[{"[", "i", "]"}], "]"}], "]"}], ";", "\n", 
            RowBox[{"Print", "[", 
             RowBox[{"Weight", " ", "==", 
              RowBox[{"terms", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "1"}], "]"}], "]"}]}], "]"}], ";"}]}], "\n",
           "]"}], "*)"}], ";"}], ",", "\n", "\n", 
       RowBox[{"(*", "False", "*)"}], 
       RowBox[{"z", "=", 
        RowBox[{"z", "/.", 
