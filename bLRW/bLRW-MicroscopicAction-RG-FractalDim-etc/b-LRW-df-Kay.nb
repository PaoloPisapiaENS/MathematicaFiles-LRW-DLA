Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
   "<<", "\"\</Users/wiese/Mathematica/libraries/Kay-initialization.m\>\""}], 
   ";"}]}]], "Input",
 CellChangeTimes->{{3.969702714223052*^9, 3.969702718406156*^9}, {
  3.9703699211162376`*^9, 
  3.9703699216413136`*^9}},ExpressionUUID->"ad1506d5-588d-4028-a235-\
ad1c86d5e024"],

Cell[BoxData["\<\"Directory for read/write is \
\\\"/Users/wiese/Dropbox/tex/Kay/DLA/\\\"\"\>"], "Print",
 CellChangeTimes->{3.969702718944965*^9},
 CellLabel->
  "During evaluation of \
In[174]:=",ExpressionUUID->"653de58f-94b3-4a94-8df9-93f19afd8cca"]
}, Open  ]],

Cell[TextData[{
 "we look at corrections to g. There are two diagrams which have the same \
counting as a tree, and one which has an additional b. \nIf we suppose that \
\[Beta](g)=\[Epsilon]g-3",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["g", "2"], " ", "for", " ", "LERW"}], ",", " ", 
    RowBox[{
     RowBox[{"then", " ", "for", " ", "b"}], "-", 
     RowBox[{"LRW", " ", "we", " ", "get", " "}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "74c9c888-9e8d-42fa-b4c7-f6b5ff4c966d"],
 "\[Beta](g)=\[Epsilon]g-(2+b)",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["g", "2"], ".", "  "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4cecb837-25cb-4a05-9b54-6a9bf763226b"],
 "\nFor ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["d", "f"], " ", "there", " ", "is", " ", "one", " ", 
     "diagram"}], " ", ",", " ", 
    RowBox[{"proportional", " ", "to", " ", 
     RowBox[{"b", "."}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ffd54bdc-2794-44c5-8240-1e950b873853"],
 " This gives (we want to reproduce LERW) ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["d", "f"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dc89db69-8e92-470e-a6b2-b08fa2d1017e"],
 "=2-bg. The final result is\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["d", "f"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "309daca4-060b-4b7f-b794-e0bb706d6d67"],
 "=",
 Cell[BoxData[
  RowBox[{"2", "-", 
   FractionBox[
    RowBox[{"b", " ", "\[Epsilon]"}], 
    RowBox[{"2", "+", "b"}]]}]],
  CellChangeTimes->{3.969705707760529*^9},ExpressionUUID->
  "0036ef3a-66b6-4758-a1ae-c8526a7f9ab6"]
}], "Text",
 CellChangeTimes->{{3.9697054787516937`*^9, 
  3.969705716919013*^9}},ExpressionUUID->"857835fe-808c-43d7-8944-\
ffde9aee3b17"],

Cell[BoxData[{
 RowBox[{"dfRG1L", ":=", 
  RowBox[{"2", "-", 
   RowBox[{"b", " ", 
    RowBox[{"\[Epsilon]", "/", 
     RowBox[{"(", 
      RowBox[{"2", "+", "b"}], ")"}]}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{"dfRG2L", ":=", 
  RowBox[{"2", "-", 
   RowBox[{"b", " ", 
    RowBox[{"\[Epsilon]", "/", 
     RowBox[{"(", 
      RowBox[{"2", "+", "b"}], ")"}]}]}], "-", 
   RowBox[{"b", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[Epsilon]", "/", 
       RowBox[{"(", 
        RowBox[{"2", "+", "b"}], ")"}]}], ")"}], "^", 
     "2"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dfSLE", "=", 
   RowBox[{"1", "+", 
    RowBox[{"3", "/", 
     RowBox[{"(", 
      RowBox[{"4", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "b"}], "+", "1"}], ")"}]}], ")"}]}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.969701194553884*^9, 3.9697012442320647`*^9}, {
   3.96970186537675*^9, 3.969701874804262*^9}, 3.969701960023587*^9, {
   3.970369971115612*^9, 3.9703699782474008`*^9}, {3.970370046747254*^9, 
