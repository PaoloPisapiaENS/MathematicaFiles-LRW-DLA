     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"\[CapitalMu]Action", "=", 
      RowBox[{
       RowBox[{"\[CapitalMu]Action", "//.", 
        RowBox[{
         RowBox[{"F_", "[", 
          RowBox[{"1", ",", 
           SubscriptBox["t", "1"], ",", "c___"}], "]"}], ":>", 
         RowBox[{"\[Kappa]", " ", 
          RowBox[{"F", "[", 
           RowBox[{"x", ",", "t", ",", "c"}], "]"}]}]}]}], "//", "Expand"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"\[CapitalMu]Action", "=", 
      RowBox[{
