                RowBox[{"1", ",", 
                 SubscriptBox["t", "1"], ",", 
                 SubscriptBox["i", "1"], ",", 
                 SubscriptBox["\[Alpha]", "1"]}], "]"}], " ", 
               RowBox[{"\[Chi]s", "[", 
                RowBox[{"1", ",", 
                 SubscriptBox["t", "1"], ",", 
                 SubscriptBox["i", "1"], ",", 
                 SubscriptBox["\[Alpha]", "1"]}], "]"}]}], "-", " ", 
              RowBox[{
               SubscriptBox["r", "x"], " ", 
               RowBox[{"\[Chi]", "[", 
