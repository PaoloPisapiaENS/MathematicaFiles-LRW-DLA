Cell["\<\
I NEED TO USE \[Beta] EVERYWHERE, AND NOT \[Beta]hat!!!!
Also, if \[OpenCurlyDoubleQuote]justSmallestOrder\[CloseCurlyDoubleQuote] -> \
True, then there are some extra term in \[Gamma]g, but we don\
\[CloseCurlyQuote]t really care about \[Gamma]g\
\>", "Text",
 CellChangeTimes->{{3.956917081038988*^9, 3.956917100687214*^9}, {
   3.956995275060177*^9, 3.956995311278618*^9}, 
   3.9592395105230904`*^9},ExpressionUUID->"eb486b7b-c501-5e41-b96b-\
0ca62ae04d19"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "ToContinuum", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "ToContinuum", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<print\>\"", "->", "False"}], ",", 
      RowBox[{"\"\<justSmallestOrder\>\"", "->", "False"}], ",", 
      RowBox[{"\"\<\[Gamma]gterms\>\"", "->", "True"}], ",", 
      RowBox[{"\"\<CollectLaplacian\>\"", "->", "True"}], ",", 
      RowBox[{"\"\<\[Delta]\[Psi]\>\"", "->", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{"\"\<\[Delta]\[Chi]\>\"", "->", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{"\"\<\[Kappa]Order\>\"", "->", "6"}], ",", " ", 
      RowBox[{"\"\<rx\>\"", "->", 
       RowBox[{"{", 
        RowBox[{
         SubscriptBox["r", "a_"], ":>", "\[CapitalSigma]\[Beta]"}], "}"}]}], 
      ",", 
      RowBox[{"\"\<gauss\[Psi]\>\"", "->", "True"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ToContinuum", "[", 
   RowBox[{"\[Mu]Action_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[CapitalMu]Action", ",", "\[Kappa]order", ",", "purificationRule", ",",
       "purifiedAction", ",", "freeAction", ",", "gAction", ",", 
      "\[Gamma]Action", ",", "\[Gamma]gAction"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Clear", "[", "g", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[CapitalMu]Action", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"V", "[", 
            SuperscriptBox["\[ExponentialE]", 
             RowBox[{
              RowBox[{
               RowBox[{"-", 
                RowBox[{"\[Phi]", "[", 
                 RowBox[{"1", ",", 
                  SubscriptBox["t", "1"], ",", 
