Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"V\[Gamma]1", ",", "V\[Gamma]1b", ",", "b"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"V\[Gamma]1", "[", 
     RowBox[{"space_", ",", "time_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "r", "}"}], ",", 
      RowBox[{
       RowBox[{"r", "=", 
        RowBox[{"RandomInteger", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", "100000"}], "}"}], "]"}]}], ";", "\n", 
       RowBox[{"V", "[", 
        RowBox[{"\[Gamma]", " ", 
         SubscriptBox["g", "\[Gamma]"], " ", 
         RowBox[{"\[Phi]", "[", 
          RowBox[{"space", ",", 
           SubscriptBox["t", "time"]}], "]"}], 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"b", "*", 
            RowBox[{"\[Delta]\[Chi]s", "[", 
             RowBox[{"space", ",", "1", ",", "2", ",", 
              SubscriptBox["t", "time"]}], "]"}]}], "+", 
           RowBox[{"b", 
            FractionBox[
             RowBox[{"(", 
              RowBox[{"b", "-", "1"}], ")"}], "2"], "*", 
