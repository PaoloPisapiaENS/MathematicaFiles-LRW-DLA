Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"TwoLoopBackboneWithInteractions", ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"TwoLoop", "=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"exprToContract", ",", "contracted"}], "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"exprToContract", "=", "TwoLoopBackboneWithInteractions"}], 
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"contracted", "=", 
        RowBox[{"Plus", "@@", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"WickContractionSpaceVerticesMODfaster", "[", 
             RowBox[{"#", ",", " ", 
              RowBox[{"\"\<endTime\>\"", "->", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Cases", "[", 
                   RowBox[{"#", ",", 
                    RowBox[{
                    RowBox[{"\[Phi]s", "[", 
                    RowBox[{"_", ",", 
                    RowBox[{"Subscript", "[", 
                    RowBox[{"t", ",", "k_"}], "]"}]}], "]"}], ":>", "k"}], 
                    ",", "All"}], "]"}], "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "-", "1"}], ")"}]}], ",", 
              StyleBox[
               RowBox[{"\"\<print\>\"", "->", "False"}],
               Background->RGBColor[1, 1, 0]], ",", 
              RowBox[{"\"\<fields\>\"", "->", 
               RowBox[{"FieldsNamesGenerator", "[", 
                RowBox[{"{", 
                 RowBox[{"\[Chi]", ",", "\[Psi]"}], "}"}], "]"}]}], ",", 
              RowBox[{"\"\<\[Delta]rule\>\"", "->", "True"}], ",", 
              RowBox[{"\"\<\[Delta]ruleExternal\>\"", "->", "True"}], ",", 
              RowBox[{"\"\<\!\(\*SubscriptBox[\(n\), \(\[Chi]\)]\)\>\"", "->", 
               RowBox[{"(", 
                RowBox[{"-", "1"}], ")"}]}], ",", 
              RowBox[{"\"\<\!\(\*SubscriptBox[\(n\), \(\[Alpha]\)]\)\>\"", "->", 
               RowBox[{"(", "0", ")"}]}], ",", 
              RowBox[{"\"\<kill\[Psi]\>\"", "->", "True"}], ",", 
              RowBox[{"\"\<maxContractions\>\"", "->", "100"}]}], "]"}], 
            "&"}], "/@", "exprToContract"}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", "contracted"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
  "]"}]}], "Input",
