Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"TwoLoopBIS", "=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"exprToContract", ",", "contracted", ",", "i"}], "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"exprToContract", "=", "TwoLoopBackboneWithInteractionsBIS"}], 
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"contracted", "=", 
        RowBox[{"(", 
         RowBox[{"Table", "[", " ", 
          RowBox[{
           RowBox[{"WickContractionSpaceVerticesMODfaster", "[", 
            RowBox[{
             RowBox[{"exprToContract", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
             RowBox[{"\"\<endTime\>\"", "->", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"Cases", "[", 
                  RowBox[{
                   RowBox[{"exprToContract", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", 
                   RowBox[{
                    RowBox[{"\[Phi]s", "[", 
                    RowBox[{"_", ",", 
                    RowBox[{"Subscript", "[", 
                    RowBox[{"t", ",", "k_"}], "]"}]}], "]"}], ":>", "k"}], 
                   ",", "All"}], "]"}], "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "-", "1"}], ")"}]}], ",", 
             StyleBox[
              RowBox[{"\"\<print\>\"", "->", "False"}],
              Background->RGBColor[1, 1, 0]], ",", 
             RowBox[{"\"\<fields\>\"", "->", 
              RowBox[{"FieldsNamesGenerator", "[", 
               RowBox[{"{", 
                RowBox[{"\[Chi]", ",", "\[Psi]"}], "}"}], "]"}]}], ",", 
             RowBox[{"\"\<\[Delta]rule\>\"", "->", "True"}], ",", 
             RowBox[{"\"\<\[Delta]ruleExternal\>\"", "->", "True"}], ",", 
             RowBox[{"\"\<\!\(\*SubscriptBox[\(n\), \(\[Chi]\)]\)\>\"", "->", 
              RowBox[{"(", 
               RowBox[{"-", "1"}], ")"}]}], ",", 
             RowBox[{"\"\<\!\(\*SubscriptBox[\(n\), \(\[Alpha]\)]\)\>\"", "->", 
              RowBox[{"(", "0", ")"}]}], ",", 
             RowBox[{"\"\<kill\[Psi]\>\"", "->", "True"}], ",", 
             RowBox[{"\"\<maxContractions\>\"", "->", "100"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"1", 
              StyleBox["*",
               FontSize->12], 
              StyleBox[
               RowBox[{"Length", "[", "exprToContract", "]"}],
               FontSize->12]}]}], "}"}]}], "]"}], ")"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Total", "@", "contracted"}], "/.", 
        RowBox[{
         RowBox[{"\[Chi]s", "[", "__", "]"}], "->", "1"}]}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
  "]"}]], "Input",
