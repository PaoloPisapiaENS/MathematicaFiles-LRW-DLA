Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "EvaluateVertices", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "EvaluateVertices", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<print\>\"", "->", "False"}], ",", " ", 
      RowBox[{"\"\<n\[Gamma]1\[Delta]\>\"", "->", "0"}], ",", " ", 
      RowBox[{"\"\<n\[Gamma]2\>\"", "->", "0"}], ",", 
      RowBox[{"\"\<n\[Gamma]2Minus\>\"", "->", "0"}], ",", 
      RowBox[{"\"\<\[Delta]fields\>\"", "->", "False"}], ",", 
      RowBox[{"\"\<endTime\>\"", "->", "0"}], ",", 
      RowBox[{"\"\<initialTime\>\"", "->", "0"}], ",", 
      RowBox[{"\"\<evaluate\>\"", "->", "True"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"EvaluateVertices", "[", 
    RowBox[{"vertexList_", ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", " ", 
   RowBox[{"Module", "[", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "i", ",", "j", ",", "el", ",", "locVertexList", ",", " ", "endTime", 
       ",", 
       RowBox[{"evaluatedVertexList", "=", 
        RowBox[{"{", "}"}]}]}], " ", "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Start", " ", "by", " ", "checking", " ", "that", " ", "vertexList", 
       " ", "is", " ", "a", " ", "List", " ", "of", " ", "Lists"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Head", "[", "vertexList", "]"}], "=!=", "List"}], " ", "||",
          " ", 
         RowBox[{
          RowBox[{"Head", "[", 
           RowBox[{"vertexList", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], "=!=", "List"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"Style", "[", 
           RowBox[{"\"\< PLEASE, PROVIDE A LIST OF LISTS \>\"", ",", "Red"}], 
           "]"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Loop", " ", "over", " ", "vertexList", " ", "elements"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"el", "=", "1"}], ",", 
        RowBox[{"el", "<=", 
         RowBox[{"Length", "[", "vertexList", "]"}]}], ",", 
        RowBox[{"el", "++"}], ",", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"locVertexList", "=", 
          RowBox[{"vertexList", "[", 
           RowBox[{"[", "el", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
          "Then", " ", "define", " ", "the", " ", "endTime", " ", "variable", 
           " ", "if", " ", "not", " ", "provided", " ", "by", " ", "the", " ",
            "user"}], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"If", "[", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"OptionValue", "[", "\"\<endTime\>\"", "]"}], "==", "0"}],
            ",", "\[IndentingNewLine]", 
           RowBox[{"(*", "TRUE", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"endTime", " ", "=", 
            RowBox[{"Length", "[", "locVertexList", "]"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", "FALSE", "*)"}], "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"endTime", " ", "=", " ", 
             RowBox[{"OptionValue", "[", "\"\<endTime\>\"", "]"}]}], ";"}]}], 
          "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
          "Loop", " ", "over", " ", "the", " ", "elements", " ", "of", " ", 
           "locVertexList", " ", "and", " ", "assign", " ", "the", " ", 
           RowBox[{"(", 
            RowBox[{"x", ",", "t"}], ")"}], " ", "arguments"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"j", "=", "1"}], ",", 
           RowBox[{"j", "<=", 
            RowBox[{"Length", "[", "locVertexList", "]"}]}], ",", 
           RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"MatchQ", "[", 
               RowBox[{
                RowBox[{"locVertexList", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], ",", 
                RowBox[{"-", "_"}]}], "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{"(*", "TRUE", "*)"}], "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"locVertexList", "[", 
                RowBox[{"[", "j", "]"}], "]"}], "=", 
               RowBox[{"-", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"-", 
                   RowBox[{"locVertexList", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], ")"}], "[", 
                 RowBox[{
                  RowBox[{"Subscript", "[", 
                   RowBox[{"x", ",", " ", 
                    RowBox[{"j", "+", 
                    RowBox[{
                    "OptionValue", "[", "\"\<initialTime\>\"", "]"}]}]}], 
                   "]"}], ",", 
                  RowBox[{"j", "+", 
                   RowBox[{
                   "OptionValue", "[", "\"\<initialTime\>\"", "]"}]}]}], 
                 "]"}]}]}], ",", "\[IndentingNewLine]", 
              RowBox[{"(*", "FALSE", "*)"}], "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"locVertexList", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "=", 
                RowBox[{
                 RowBox[{"locVertexList", "[", 
                  RowBox[{"[", "j", "]"}], "]"}], "[", 
                 RowBox[{
                  RowBox[{"Subscript", "[", 
                   RowBox[{"x", ",", " ", 
                    RowBox[{"j", "+", 
                    RowBox[{
                    "OptionValue", "[", "\"\<initialTime\>\"", "]"}]}]}], 
                   "]"}], ",", 
                  RowBox[{"j", "+", 
                   RowBox[{
                   "OptionValue", "[", "\"\<initialTime\>\"", "]"}]}]}], 
                 "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
          "\[IndentingNewLine]", "]"}], ";", 
         RowBox[{"(*", 
          RowBox[{"End", " ", "of", " ", "For", " ", "over", " ", "j"}], 
          "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"evaluatedVertexList", ",", 
           RowBox[{
            RowBox[{"V", "[", 
             RowBox[{"\[Phi]s", "[", 
              RowBox[{
               SubscriptBox["x", "0"], ",", 
               SubscriptBox["t", "1"]}], "]"}], "]"}], 
            RowBox[{"(", 
             RowBox[{"Times", "@@", "locVertexList"}], ")"}]}]}], "]"}], 
         ";"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], ";", 
      RowBox[{"(*", 
       RowBox[{"End", " ", "of", " ", "For", " ", "over", " ", "el"}], "*)"}],
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", "evaluatedVertexList", "]"}], ";"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
