Cell[TextData[{
 "Rule 2: \[Gamma]1FollowedBy\[Gamma]2p[]: \n\[Gamma]1 followed by ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Gamma]2", "+"], TraditionalForm]],ExpressionUUID->
  "277501a1-b16c-1646-828f-d1c0595837bb"],
