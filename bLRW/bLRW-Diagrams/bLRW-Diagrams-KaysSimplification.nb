b2b33708ee74"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Rule 1: Last\[Gamma]2pCancelsLast\[Gamma]2m[]: \nif the outgoing \
redline is not used, ",
  Background->RGBColor[1, 0.5, 0.5]],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Gamma]2", "+"], TraditionalForm]],
  Background->RGBColor[1, 0.5, 0.5],ExpressionUUID->
  "b8b15d62-31a7-654b-91e9-5f6f2bfdfa00"],
 StyleBox[" cancels with ",
  Background->RGBColor[1, 0.5, 0.5]],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Gamma]2", "-"], TraditionalForm]],
  Background->RGBColor[1, 0.5, 0.5],ExpressionUUID->
  "4d0a49f7-1043-b44e-8db2-1d78ae8023c3"],
 "\nTHIS IS NOT AN EXACT RULE AND SHOULD NOT BE USED IN GENERAL"
}], "Section",
 CellChangeTimes->{{3.971928737660063*^9, 3.97192876625494*^9}, {
  3.9719465706938076`*^9, 3.971946570779119*^9}, {3.972014441080002*^9, 
  3.972014441351202*^9}, {3.972025999126211*^9, 3.972026003892412*^9}, {
  3.9732484755662823`*^9, 
  3.973248495972372*^9}},ExpressionUUID->"8132c659-a801-ad4f-8949-\
175e58c7fb62"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "Last\[Gamma]2pCancelsLast\[Gamma]2m", "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Last\[Gamma]2pCancelsLast\[Gamma]2m", "[", "expr_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "locExpr1", ",", "locExpr2", ",", "i", ",", "terms", ",", "temp1", ",", 
       "el", ",", 
       RowBox[{"tot", "=", 
        RowBox[{"{", "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Head", "[", "expr", "]"}], "!=", "List"}], " ", "||", " ", 
         RowBox[{
          RowBox[{"Head", "[", 
           RowBox[{"expr", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], "!=", "List"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"Style", "[", 
           RowBox[{"\"\< PLEASE, PROVIDE A LIST OF LISTS \>\"", ",", "Red"}], 
           "]"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"locExpr1", "=", "expr"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"locExpr2", "=", 
       RowBox[{"Replace", "[", 
        RowBox[{"locExpr1", ",", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"B___", ",", 
            RowBox[{"{", 
             RowBox[{"A___", ",", "V\[Gamma]2"}], "}"}], ",", "D___", ",", 
            RowBox[{"{", 
             RowBox[{"A___", ",", "V\[Gamma]2Minus"}], "}"}], ",", "C___"}], 
           "}"}], ":>", 
          RowBox[{"{", 
           RowBox[{"B", ",", "D", ",", "C"}], "}"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"locExpr2", "=", 
       RowBox[{"Replace", "[", 
        RowBox[{"locExpr2", ",", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"B___", ",", 
            RowBox[{"{", 
             RowBox[{"A___", ",", "V\[Gamma]2Minus"}], "}"}], ",", "D___", 
            ",", 
            RowBox[{"{", 
             RowBox[{"A___", ",", "V\[Gamma]2"}], "}"}], ",", "C___"}], "}"}],
           ":>", 
          RowBox[{"{", 
           RowBox[{"B", ",", "D", ",", "C"}], "}"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{"locExpr1", "!=", "locExpr2"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"locExpr1", "=", "locExpr2"}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"locExpr2", "=", 
          RowBox[{"Replace", "[", 
           RowBox[{"locExpr2", ",", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"B___", ",", 
               RowBox[{"{", 
                RowBox[{"A___", ",", "V\[Gamma]2"}], "}"}], ",", "D___", ",", 
               RowBox[{"{", 
                RowBox[{"A___", ",", "V\[Gamma]2Minus"}], "}"}], ",", 
               "C___"}], "}"}], ":>", 
             RowBox[{"{", 
              RowBox[{"B", ",", "D", ",", "C"}], "}"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "1"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"locExpr2", "=", 
          RowBox[{"Replace", "[", 
           RowBox[{"locExpr2", ",", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"B___", ",", 
               RowBox[{"{", 
                RowBox[{"A___", ",", "V\[Gamma]2Minus"}], "}"}], ",", "D___", 
               ",", 
               RowBox[{"{", 
                RowBox[{"A___", ",", "V\[Gamma]2"}], "}"}], ",", "C___"}], 
              "}"}], ":>", 
             RowBox[{"{", 
              RowBox[{"B", ",", "D", ",", "C"}], "}"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "1"}], "}"}]}], "]"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"Return", "[", "locExpr2", "]"}], ";"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
