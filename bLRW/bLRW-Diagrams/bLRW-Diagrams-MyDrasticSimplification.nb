Cell[CellGroupData[{

Cell["\<\
Rework: no permutations anymore, but manual positioning. OPTIMIZED FOR MY \
SIMPLIFIED VERTICES\
\>", "Subsection",
 CellChangeTimes->{{3.9875594043680687`*^9, 3.9875594374581604`*^9}, {
  3.987559511632477*^9, 
  3.987559526458809*^9}},ExpressionUUID->"327d259b-99c0-1947-882b-\
98b82cf5af87"],

Cell["\<\
So far, this is implemented to work only up to 3Loop. The reason is that \
beyond that one should also consider different permutations of \
V\[Gamma]2Minus2 and V\[Gamma]2\
\>", "Text",
 CellChangeTimes->{{3.9876638170378666`*^9, 3.987663835451107*^9}, {
  3.9876638847355576`*^9, 
  3.9876639233365726`*^9}},ExpressionUUID->"9b6ed423-39b0-284e-9a02-\
450157ff1881"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "Spread\[Gamma]New", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "Spread\[Gamma]New", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<print\>\"", "->", "False"}], ",", 
      RowBox[{"\"\<observable\>\"", "->", "\"\<prop\>\""}]}], "}"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Spread\[Gamma]New", "[", 
    RowBox[{"nLoop_", ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"vertexList", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"string", "=", 
        RowBox[{"{", "}"}]}], ",", "i", ",", "j", ",", "k", ",", "combFact"}],
       "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Special", " ", 
        RowBox[{"Case", ":", " ", "nLoop"}]}], "=", "1"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"nLoop", "==", "1"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"string", "=", 
          RowBox[{"{", "V\[Gamma]1", "}"}]}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"OptionValue", "[", "\"\<observable\>\"", "]"}], "==", 
            "\"\<psi\>\""}], ",", "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"string", ",", "V\[Gamma]1"}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"vertexList", ",", 
             RowBox[{"{", "V\[Gamma]g", "}"}]}], "]"}]}], 
          "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"string", ",", "V\[Gamma]2Minus1"}], "]"}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"vertexList", ",", "string"}], "]"}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"Return", "[", "vertexList", "]"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"General", " ", 
        RowBox[{"case", ":", " ", 
         RowBox[{"n\[Gamma]", ">", "1"}]}]}], "*)"}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "0"}], ",", 
        RowBox[{"i", "<=", 
         RowBox[{"Floor", "[", 
          RowBox[{
           RowBox[{"(", "nLoop", ")"}], "/", "2"}], "]"}]}], ",", 
        RowBox[{"i", "++"}], ",", 
        RowBox[{"(*", 
         RowBox[{"Number", " ", "of", " ", 
          RowBox[{"\[Gamma]2Minus2", "''"}], "s"}], "*)"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"j", "=", "0"}], ",", 
           RowBox[{"j", "<=", 
            RowBox[{"(", 
             RowBox[{"nLoop", "-", 
              RowBox[{"HeavisideTheta", "[", 
               RowBox[{"0.5", "-", "i"}], "]"}], "-", 
              RowBox[{"2", "i"}]}], ")"}]}], ",", 
           RowBox[{"j", "++"}], ",", 
           RowBox[{"(*", 
            RowBox[{"Number", " ", "of", " ", 
             RowBox[{"\[Gamma]g", "'"}], "s"}], "*)"}], "\[IndentingNewLine]",
            "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"For", "[", 
             RowBox[{
              RowBox[{"k", "=", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"nLoop", "-", "j", "-", 
                  RowBox[{"2", "*", "i"}]}], ")"}], "*", 
                RowBox[{"HeavisideTheta", "[", 
                 RowBox[{"0.5", "-", "j", "-", 
                  RowBox[{"2", "*", "i"}]}], "]"}]}]}], 
              RowBox[{"(*", 
               RowBox[{
               "It", " ", "must", " ", "be", " ", "maximal", " ", "if", " ", 
                "the", " ", "others", " ", "are", " ", "0"}], "*)"}], ",", 
              RowBox[{"k", "<=", 
               RowBox[{"(", 
                RowBox[{"nLoop", "-", "j", "-", 
                 RowBox[{"2", "*", "i"}]}], ")"}]}], ",", 
              RowBox[{"k", "++"}], ",", 
              RowBox[{"(*", 
               RowBox[{"Number", " ", "of", " ", 
                RowBox[{"\[Gamma]2Minus1", "''"}], "s"}], "*)"}], 
              "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"combFact", "=", 
                RowBox[{"1", "/", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"i", "!"}], 
                   RowBox[{"j", "!"}], 
                   RowBox[{"k", "!"}]}], ")"}]}]}], ";", 
               "\[IndentingNewLine]", "\[IndentingNewLine]", 
               RowBox[{"string", "=", 
                RowBox[{"Flatten", "[", 
                 RowBox[{
                  RowBox[{"(", "\[IndentingNewLine]", 
                   RowBox[{"Join", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"PadRight", "[", 
                    RowBox[{
                    RowBox[{"{", "}"}], ",", "k", ",", "V\[Gamma]2Minus1"}], 
                    "]"}], ",", "\[IndentingNewLine]", 
                    RowBox[{"PadRight", "[", 
                    RowBox[{
                    RowBox[{"{", "}"}], ",", "i", ",", "V\[Gamma]2Minus2"}], 
                    "]"}], ",", "\[IndentingNewLine]", 
                    RowBox[{"PadRight", "[", 
                    RowBox[{
                    RowBox[{"{", "}"}], ",", "j", ",", "V\[Gamma]g"}], "]"}], 
                    ",", "\[IndentingNewLine]", 
                    RowBox[{"PadLeft", "[", 
                    RowBox[{
                    RowBox[{"{", "}"}], ",", 
                    RowBox[{"(", 
                    RowBox[{"nLoop", "-", "j"}], ")"}], ",", "V\[Gamma]1"}], 
                    "]"}]}], "\[IndentingNewLine]", "]"}], ")"}], 
                  "\[IndentingNewLine]", ",", "2"}], "]"}]}], ";", 
               "\[IndentingNewLine]", "\[IndentingNewLine]", 
               RowBox[{"string", "=", 
                RowBox[{"DeleteDuplicates", "[", "\[IndentingNewLine]", 
                 RowBox[{"Select", "[", 
                  RowBox[{
                   RowBox[{"Permutations", "@", "string"}], ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"Last", "[", "#", "]"}], "=!=", "V\[Gamma]1"}], 
                    "\[IndentingNewLine]", "&&", 
                    RowBox[{
                    RowBox[{"First", "[", "#", "]"}], "==", "V\[Gamma]1"}], 
                    "\[IndentingNewLine]", "&&", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"j", "==", "0"}], ",", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "==", "V\[Gamma]1"}], ",",
                     "True"}], "]"}], "\[IndentingNewLine]", "&&", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "=!=", 
                    "V\[Gamma]2Minus1"}], "\[IndentingNewLine]", "&&", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "=!=", 
                    "V\[Gamma]2Minus2"}], "\[IndentingNewLine]", "&&", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", 
                    RowBox[{"-", "1"}], "]"}], "]"}], "===", 
                    "V\[Gamma]2Minus1"}], ",", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", 
                    RowBox[{"-", "2"}], "]"}], "]"}], "=!=", "V\[Gamma]1"}], 
                    ",", "True"}], "]"}], "\[IndentingNewLine]", "&&", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"k", "+", 
                    RowBox[{"2", "i"}]}], ")"}], "==", 
                    RowBox[{"(", 
                    RowBox[{"nLoop", "-", "j"}], ")"}]}], ",", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", 
                    RowBox[{"-", "1"}], "]"}], "]"}], "=!=", "V\[Gamma]g"}], 
                    ",", "True"}], "]"}]}], "&"}]}], "]"}], 
                 "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
               "\[IndentingNewLine]", 
               RowBox[{"string", "=", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Prepend", "[", 
                   RowBox[{"#", ",", "combFact"}], "]"}], "&"}], "/@", 
                 "string"}]}], ";", "\[IndentingNewLine]", 
               "\[IndentingNewLine]", 
               RowBox[{"AppendTo", "[", 
                RowBox[{"vertexList", ",", "string"}], "]"}], ";"}]}], 
             "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], ";"}]}], 
          RowBox[{"(*", 
           RowBox[{"End", " ", "of", " ", "For", " ", "over", " ", "i"}], 
           "*)"}], "\[IndentingNewLine]", "]"}], ";"}]}], 
       RowBox[{"(*", 
        RowBox[{"End", " ", "of", " ", "For", " ", "over", " ", "j"}], "*)"}],
        "\[IndentingNewLine]", "]"}], ";", 
      RowBox[{"(*", 
       RowBox[{"End", " ", "of", " ", "For", " ", "over", " ", "k"}], "*)"}], 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"vertexList", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"vertexList", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]",
       "\[IndentingNewLine]", 
      RowBox[{"vertexList", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Replace", "[", 
          RowBox[{"#", ",", 
           RowBox[{
            RowBox[{"a__", "/;", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"Count", "[", 
                   RowBox[{"#", ",", "V\[Gamma]1"}], "]"}], "-", 
                  RowBox[{"Count", "[", 
                   RowBox[{"#", ",", "V\[Gamma]2Minus1"}], "]"}], "-", 
                  RowBox[{"2", "*", 
                   RowBox[{"Count", "[", 
                    RowBox[{"#", ",", "V\[Gamma]2Minus2"}], "]"}]}]}], ")"}], 
                ">", "0"}], "&&", 
               RowBox[{
                RowBox[{"Count", "[", 
                 RowBox[{"#", ",", "V\[Gamma]2Minus2"}], "]"}], ">", "0"}]}], 
              ")"}]}], ":>", 
            RowBox[{"Sequence", "[", 
             RowBox[{"a", ",", 
              RowBox[{"a", "/.", 
               RowBox[{"V\[Gamma]2Minus2", ":>", 
                RowBox[{"Sequence", "[", 
                 RowBox[{"V\[Gamma]2Minus2", ",", "V\[Gamma]2"}], "]"}]}]}]}],
              "]"}]}], ",", 
           RowBox[{"{", "0", "}"}]}], "]"}], "&"}], "/@", "vertexList"}]}], 
      ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<observable\>\"", "]"}], "==", 
         "\"\<psi\>\""}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"vertexList", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"DeleteDuplicates", "[", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"Insert", "[", 
                RowBox[{"#", ",", "V\[Gamma]1", ",", "i"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "2", ",", 
                 RowBox[{"Length", "@", "#"}]}], "}"}]}], "]"}], "]"}], "&"}],
            "/@", "vertexList"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"vertexList", "=", 
          RowBox[{"Flatten", "[", 
           RowBox[{"vertexList", ",", "1"}], "]"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", "vertexList", "]"}], ";"}]}], "\n", "\n", 
    "]"}]}], ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.986551494240076*^9, 3.9865515382757607`*^9}, {
   3.986551616134868*^9, 3.986551672590504*^9}, {3.986551858483423*^9, 
   3.986551865679436*^9}, {3.986886242032877*^9, 3.9868862461335754`*^9}, {
