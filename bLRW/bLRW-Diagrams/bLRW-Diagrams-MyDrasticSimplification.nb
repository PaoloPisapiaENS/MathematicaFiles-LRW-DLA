        RowBox[{"el", "++"}], ",", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"locVertexList", "=", 
          RowBox[{"vertexList", "[", 
           RowBox[{"[", "el", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
