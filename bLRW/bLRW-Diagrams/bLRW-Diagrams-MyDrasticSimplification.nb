Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "RemoveGaps", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RemoveGaps", "[", "expr_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"i", ",", "terms", ",", "temp1"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"terms", "=", "expr"}], ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<=", "10"}], ",", 
       RowBox[{"i", "++"}], ",", "\n", 
       RowBox[{
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"FreeQ", "[", 
            RowBox[{"terms", ",", 
             RowBox[{"Subscript", "[", 
              RowBox[{"x", ",", " ", "i"}], "]"}]}], "]"}], ")"}], ",", "\n", 
          RowBox[{
           RowBox[{"temp1", "=", 
            RowBox[{"terms", "/.", 
             RowBox[{
              RowBox[{
               RowBox[{"Subscript", "[", 
                RowBox[{"x", ",", " ", "a_"}], "]"}], "/;", 
               RowBox[{"(", 
                RowBox[{"a", ">", "i"}], ")"}]}], ":>", 
              RowBox[{"Subscript", "[", 
               RowBox[{"x", ",", " ", 
                RowBox[{"a", "-", "1"}]}], "]"}]}]}]}], ";", "\n", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"temp1", "===", "terms"}], ",", " ", 
             RowBox[{"Break", "[", "]"}], ",", 
             RowBox[{"terms", "=", "temp1"}]}], "]"}]}]}], "\n", "]"}], 
        ";"}]}], "\n", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<=", "10"}], ",", 
       RowBox[{"i", "++"}], ",", "\n", 
       RowBox[{
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"FreeQ", "[", 
            RowBox[{"terms", ",", 
             RowBox[{"Subscript", "[", 
              RowBox[{"t", ",", " ", "i"}], "]"}]}], "]"}], ")"}], ",", "\n", 
          RowBox[{
           RowBox[{"temp1", "=", 
            RowBox[{"terms", "/.", 
             RowBox[{
              RowBox[{
               RowBox[{"Subscript", "[", 
                RowBox[{"t", ",", " ", "a_"}], "]"}], "/;", 
               RowBox[{"(", 
                RowBox[{"a", ">", "i"}], ")"}]}], ":>", 
              RowBox[{"Subscript", "[", 
               RowBox[{"t", ",", " ", 
                RowBox[{"a", "-", "1"}]}], "]"}]}]}]}], ";", "\n", 
           RowBox[{"If", "[", 
            RowBox[{
