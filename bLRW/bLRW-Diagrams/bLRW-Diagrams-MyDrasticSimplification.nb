      RowBox[{"\"\<Append\[Phi]0\>\"", "->", "False"}]}], "}"}]}], ";"}], 
  "\n", "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"EvaluateVertices", "[", 
    RowBox[{"vertexList_", ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", " ", 
   RowBox[{"Module", "[", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "i", ",", "j", ",", "el", ",", "locVertexList", ",", " ", "endTime", 
       ",", 
       RowBox[{"evaluatedVertexList", "=", 
        RowBox[{"{", "}"}]}], " ", ",", 
       RowBox[{"skipFirst", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Start", " ", "by", " ", "checking", " ", "that", " ", "vertexList", 
       " ", "is", " ", "a", " ", "List", " ", "of", " ", "Lists"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Head", "[", "vertexList", "]"}], "=!=", "List"}], " ", "||",
          " ", 
         RowBox[{
          RowBox[{"Head", "[", 
           RowBox[{"vertexList", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], "=!=", "List"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"Style", "[", 
           RowBox[{"\"\< PLEASE, PROVIDE A LIST OF LISTS \>\"", ",", "Red"}], 
           "]"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Loop", " ", "over", " ", "vertexList", " ", "elements"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"el", "=", "1"}], ",", 
        RowBox[{"el", "<=", 
