          RowBox[{"LogMessage", "[", 
           RowBox[{"{", "terms", "}"}], "]"}]}], "]"}], ";", "\n", "\n", 
        RowBox[{"pureProp", "=", 
         RowBox[{"DeleteElements", "[", 
          RowBox[{"terms", ",", 
           RowBox[{"{", 
            RowBox[{
