              "\[IndentingNewLine]", 
              RowBox[{"(*", "FALSE", "*)"}], "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"locVertexList", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "=", 
                RowBox[{
                 RowBox[{"locVertexList", "[", 
                  RowBox[{"[", "j", "]"}], "]"}], "[", 
                 RowBox[{"(*", 
                  RowBox[{"Subscript", "[", 
                   RowBox[{"x", ",", " ", 
                    RowBox[{"j", "+", 
