           RowBox[{"Print", "[", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{
                "\"\<!!ZERO at position \>\"", ",", "i", ",", "\"\<!!\>\""}], 
                "}"}], "]"}], ",", "Red"}], "]"}], "]"}], ";", " ", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"Abort", "[", "]"}], ";"}], "*)"}], "\n", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"plot", ",", "0"}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Continue", "[", "]"}], ";"}]}], "\n", "]"}], ";", "\n", 
        "\n", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"OptionValue", "[", "\"\<showEndLines\>\"", "]"}]}], ",", 
          " ", "\n", 
          RowBox[{
           RowBox[{"terms", "=", 
            RowBox[{"terms", "/.", 
             RowBox[{
              RowBox[{"\[Chi]s", "[", "__", "]"}], "->", "1"}]}]}], ";"}]}], 
         "\n", "]"}], ";", "\n", "\n", 
        RowBox[{"terms", "=", 
         RowBox[{
          RowBox[{"List", " ", "@@", " ", 
