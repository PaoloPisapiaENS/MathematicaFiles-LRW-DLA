Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "SpreadInteractions", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "SpreadInteractions", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<print\>\"", "->", "False"}], ",", " ", 
      RowBox[{"\"\<\[Delta]\[Psi]\[Chi]\>\"", "->", "False"}], ",", 
      RowBox[{"\"\<V\[Gamma]2\[Delta]\>\"", "->", "False"}], ",", 
      RowBox[{"\"\<endTime\>\"", "->", "0"}]}], "}"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SpreadInteractions", "[", 
    RowBox[{"nInt_", ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "comps", ",", "maxLen", ",", "padded", ",", "interactionVertices", ",", 
       "i", ",", "jj", ",", "endTime", ",", 
       RowBox[{"V\[Gamma]2correction", "=", "0"}]}], "}"}], ",", "\n", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"nInt", "==", "0"}], ",", " ", 
        RowBox[{"Return", "[", "1", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "\n", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<endTime\>\"", "]"}], "==", "0"}], 
        ",", 
        RowBox[{"endTime", "=", 
         RowBox[{"nInt", "+", "1"}]}], ",", 
        RowBox[{
         RowBox[{"endTime", "=", 
          RowBox[{"OptionValue", "[", "\"\<endTime\>\"", "]"}]}], ";"}]}], 
       "]"}], ";", "\n", "\n", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<V\[Gamma]2\[Delta]\>\"", "]"}], ",", 
        RowBox[{"V\[Gamma]2correction", "=", "1"}], ",", 
        RowBox[{"V\[Gamma]2correction", "=", "0"}]}], "]"}], ";", "\n", "\n", 
      RowBox[{"interactionVertices", "=", "0"}], ";", "\n", "\n", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"jj", "=", "1"}], ",", 
        RowBox[{"jj", "<=", "nInt"}], ",", 
        RowBox[{"jj", "++"}], ",", "\n", "\n", 
        RowBox[{
         RowBox[{"comps", "=", 
          RowBox[{"Join", "@@", 
           RowBox[{"Permutations", "/@", 
            RowBox[{"IntegerPartitions", "[", "jj", "]"}]}]}]}], ";", "\n", 
         "\n", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"OptionValue", "[", "\"\<print\>\"", "]"}], ",", "\n", 
           RowBox[{"Print", "[", 
            RowBox[{
            "\"\< The compositions of \>\"", ",", " ", "j", ",", " ", 
             "\"\< are :\\n \>\"", ",", "comps"}], "]"}]}], "]"}], ";", "\n", 
         "\n", 
         RowBox[{"maxLen", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"Length", "/@", "comps"}], "]"}]}], ";", "\n", 
         RowBox[{"maxLen", "=", "endTime"}], ";", "\n", "\n", 
         RowBox[{"padded", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"PadRight", "[", 
             RowBox[{"#", ",", "maxLen", ",", "0"}], "]"}], "&"}], "/@", 
           "comps"}]}], ";", "\n", 
         RowBox[{"padded", "=", 
          RowBox[{"DeleteDuplicates", "[", 
           RowBox[{"Flatten", "[", 
            RowBox[{
             RowBox[{"Permutations", "/@", "padded"}], ",", "1"}], "]"}], 
           "]"}]}], ";", "\n", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"padded", "=", 
            RowBox[{"DeleteDuplicates", "[", 
             RowBox[{"Select", "[", 
              RowBox[{"padded", ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"First", "[", "#", "]"}], "=!=", "0"}], "&"}]}], 
              "]"}], "]"}]}], ";"}], "*)"}], "\n", "\n", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"OptionValue", "[", "\"\<print\>\"", "]"}], ",", "\n", 
           RowBox[{"Print", "[", 
            RowBox[{
            "\"\< After padding with Zeros and removing leading zeros :\\n \>\
\"", ",", "padded"}], "]"}]}], "]"}], ";", "\n", "\n", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"OptionValue", "[", "\"\<\[Delta]\[Psi]\[Chi]\>\"", "]"}], 
           ",", 
           RowBox[{
            RowBox[{"interactionVertices", "=", 
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{"Product", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"1", "/", 
                   RowBox[{"Factorial", "[", " ", 
                    RowBox[{"Abs", "[", 
                    RowBox[{
                    RowBox[{"padded", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "j"}], "]"}], "]"}], "-", 
                    "V\[Gamma]2correction"}], "]"}], " ", "]"}]}], " ", 
                  RowBox[{"Product", "[", 
                   RowBox[{
                    RowBox[{"V\[Delta]\[Psi]\[Chi]", "[", 
                    RowBox[{
                    RowBox[{"Subscript", "[", 
                    RowBox[{"x", ",", " ", 
                    RowBox[{"ToExpression", "[", 
                    RowBox[{
                    RowBox[{"ToString", "[", "j", "]"}], "<>", 
                    RowBox[{"ToString", "[", "nIndex", "]"}]}], "]"}]}], 
                    "]"}], ",", 
                    RowBox[{"endTime", "-", "j", "+", "1"}]}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"nIndex", ",", "1", ",", 
                    RowBox[{"padded", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "j"}], "]"}], "]"}]}], " ", "}"}]}], 
                   "]"}]}], ",", 
                 RowBox[{"{", 
                  RowBox[{"j", ",", "1", ",", "nInt"}], 
                  RowBox[{"(*", 
                   RowBox[{"this", " ", "is", " ", "equal", " ", "to", " ", 
                    RowBox[{"Length", "[", 
                    RowBox[{"padded", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "*)"}], "}"}]}], 
                "]"}], ",", "\n", 
               RowBox[{"{", 
                RowBox[{"i", ",", "1", ",", 
                 RowBox[{"Length", "[", "padded", "]"}]}], "}"}]}], "]"}]}], 
            ";", "\n", 
            RowBox[{"Return", "[", "interactionVertices", "]"}], ";"}]}], 
          "\n", "]"}], ";", "\n", "\n", 
         RowBox[{"interactionVertices", "+=", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"Product", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"1", "/", 
                RowBox[{"Factorial", "[", " ", 
                 RowBox[{"Abs", "[", 
                  RowBox[{
                   RowBox[{"padded", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "j"}], "]"}], "]"}], "-", 
                   "V\[Gamma]2correction"}], "]"}], " ", "]"}]}], " ", 
               RowBox[{"Product", "[", 
                RowBox[{
                 RowBox[{"V\[Psi]\[Chi]", "[", 
                  RowBox[{
                   RowBox[{"Subscript", "[", 
                    RowBox[{"x", ",", " ", 
                    RowBox[{"ToExpression", "[", 
                    RowBox[{
                    RowBox[{"ToString", "[", "j", "]"}], "<>", 
                    RowBox[{"ToString", "[", "nIndex", "]"}]}], "]"}]}], 
                    "]"}], ",", 
                   RowBox[{"endTime", "-", "j", "+", "1"}]}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"nIndex", ",", "1", ",", 
                   RowBox[{"padded", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "j"}], "]"}], "]"}]}], " ", "}"}]}], 
                "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", "1", ",", "maxLen"}], 
               RowBox[{"(*", 
                RowBox[{"this", " ", "is", " ", "equal", " ", "to", " ", 
                 RowBox[{"Length", "[", 
                  RowBox[{"padded", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "*)"}], "}"}]}], 
             "]"}], ",", "\n", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", 
              RowBox[{"Length", "[", "padded", "]"}]}], "}"}]}], "]"}]}]}]}], 
       "\n", "]"}], ";", "\n", 
      RowBox[{"Return", "[", "interactionVertices", "]"}], ";"}]}], "\n", 
    "]"}]}], ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.986887851820418*^9, 3.9868878680296555`*^9}, {
  3.9868894984339314`*^9, 3.986889502107561*^9}, {3.986889557486992*^9, 
  3.9868895596009083`*^9}, {3.986889623898741*^9, 3.986889630465149*^9}},
 Background->RGBColor[1, 0.925, 0.925],
 CellLabel->"In[42]:=",ExpressionUUID->"45c524b0-e906-e64d-98c4-2e9fcd2b7cb1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "GiveInteractionVertices", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "GiveInteractionVertices", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<print\>\"", "->", "False"}], ",", " ", 
      RowBox[{"\"\<nInteractions\>\"", "->", "nInteractionVertices"}], ",", 
      RowBox[{"\"\<\[Delta]fields\>\"", "->", "False"}], ",", 
      RowBox[{"\"\<endTime\>\"", "->", "endTime"}], ",", 
      RowBox[{"\"\<initialTime\>\"", "->", "0"}]}], "}"}]}], ";"}], "\n", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"GiveInteractionVertices", "[", 
      RowBox[{"vertexList_List", ",", 
       RowBox[{"options", ":", 
        RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], "/;", 
     RowBox[{
      RowBox[{"Head", "[", 
       RowBox[{"vertexList", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "]"}], "==", "List"}]}], ":=", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"GiveInteractionVertices", "[", 
        RowBox[{"#", ",", "options"}], "]"}], "&"}], "/@", "vertexList"}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"GiveInteractionVertices", "[", 
    RowBox[{"vertexList_", ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", " ", 
   RowBox[{"Module", "[", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "i", ",", "j", ",", "el", ",", "locVertexList", ",", " ", "endTime", 
       ",", "nInteractions", ",", 
       RowBox[{"VertexListWithInteractions", "=", 
        RowBox[{"{", "}"}]}]}], " ", "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Start", " ", "by", " ", "checking", " ", "that", " ", "vertexList", 
       " ", "is", " ", "a", " ", "List"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "vertexList", "]"}], "=!=", "List"}], " ", ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"Style", "[", 
           RowBox[{"\"\< PLEASE, PROVIDE A LIST \>\"", ",", "Red"}], "]"}], 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Abort", "[", "]"}]}]}], "\[IndentingNewLine]", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"Loop", " ", "over", " ", "vertexList", " ", "elements"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"el", "=", "1"}], ",", 
          RowBox[{"el", "<=", 
           RowBox[{"Length", "[", "vertexList", "]"}]}], ",", 
          RowBox[{"el", "++"}], ",", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"locVertexList", "=", 
            RowBox[{"vertexList", "[", 
             RowBox[{"[", "el", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             StyleBox[
              RowBox[{"OptionValue", "[", "\"\<print\>\"", "]"}],
              Background->RGBColor[0.9, 1, 1]], ",", "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{"\"\< Considering : \>\"", ",", " ", "locVertexList"}], 
              "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
            "Count", " ", "if", " ", "there", " ", "already", " ", "are", " ",
              "some", " ", "g", " ", "present", " ", "in", " ", "the", " ", 
             "list", " ", "and", " ", "define", " ", "the", " ", "number", 
             " ", "of", " ", "interactions", " ", "available"}], "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"nInteractions", "=", 
            RowBox[{
             RowBox[{"OptionValue", "[", "\"\<nInteractions\>\"", "]"}], "-", 
             RowBox[{"Exponent", "[", 
              RowBox[{"locVertexList", ",", "g"}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             StyleBox[
              RowBox[{"OptionValue", "[", "\"\<print\>\"", "]"}],
              Background->RGBColor[0.9, 1, 1]], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{"\"\< Number of g already present = \>\"", ",", " ", 
                RowBox[{"Exponent", "[", 
                 RowBox[{"locVertexList", ",", "g"}], "]"}]}], "]"}], ";", 
              "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{"Print", "[", 
               RowBox[{
               "\"\< Then: \
OptionValue[\\\"nInteractions\\\"]-Exponent[locVertexList,g] = \>\"", ",", 
                "nInteractions"}], "]"}], ";"}]}], "]"}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
            "Then", " ", "define", " ", "the", " ", "endTime", " ", 
             "variable", " ", "if", " ", "not", " ", "provided", " ", "by", 
             " ", "the", " ", "user"}], " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"If", "[", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"OptionValue", "[", "\"\<endTime\>\"", "]"}], "==", 
              "0"}], ",", "\[IndentingNewLine]", 
             RowBox[{"(*", "TRUE", "*)"}], "\[IndentingNewLine]", 
             RowBox[{"endTime", " ", "=", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"Cases", "[", 
                  RowBox[{"locVertexList", ",", 
                   RowBox[{
                    RowBox[{"\[Phi]s", "[", 
                    RowBox[{"_", ",", 
                    RowBox[{"Subscript", "[", 
                    RowBox[{"t", ",", "k_"}], "]"}]}], "]"}], ":>", "k"}], 
                   ",", "All"}], "]"}], "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "-", "1"}], ")"}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"(*", "FALSE", "*)"}], "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"endTime", " ", "=", " ", 
               RowBox[{"OptionValue", "[", "\"\<endTime\>\"", "]"}]}], 
              ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
            "Multiply", " ", "the", " ", "locVertexList", " ", "with", " ", 
             "the", " ", "interaction", " ", "vertices"}], "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"locVertexList", "=", 
            RowBox[{"List", "@@", 
             RowBox[{"(", 
              RowBox[{"Plus", "@@", 
               RowBox[{"Expand", "[", 
                RowBox[{"locVertexList", "*", "\[IndentingNewLine]", 
                 RowBox[{"SpreadInteractions", "[", 
                  RowBox[{"nInteractions", ",", 
                   RowBox[{"\"\<endTime\>\"", "->", "endTime"}], ",", 
                   StyleBox[
                    RowBox[{"\"\<V\[Gamma]2\[Delta]\>\"", "->", "True"}],
                    Background->RGBColor[1, 1, 0]]}], "]"}]}], 
                "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
              ")"}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"VertexListWithInteractions", ",", "locVertexList"}], 
            "]"}], ";"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
         "]"}], ";"}], 
       RowBox[{"(*", 
        RowBox[{"End", " ", "of", " ", "For", " ", "over", " ", "el"}], 
        "*)"}], "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "W", " ", "A", " ", "Y", "  ", "M", " ", "O", " ", "R", " ", "E", "  ",
         "E", " ", "F", " ", "F", " ", "I", " ", "C", " ", "I", " ", "E", " ",
         "N", " ", "T", "  ", "C", " ", "O", " ", "D", " ", 
        RowBox[{"E", ":"}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"VertexListWithInteractions", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Times", "[", 
          RowBox[{"#", ",", 
           RowBox[{"(", 
            RowBox[{"SpreadInteractions", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"OptionValue", "[", "\"\<nInteractions\>\"", "]"}], 
               "-", 
               RowBox[{"Exponent", "[", 
                RowBox[{"#", ",", "g"}], "]"}]}], ",", 
              RowBox[{"\"\<endTime\>\"", "->", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"OptionValue", "[", "\"\<endTime\>\"", "]"}], "+", 
                 "1", "-", 
                 RowBox[{"Exponent", "[", 
                  RowBox[{"#", ",", "g"}], "]"}]}], ")"}]}], ",", 
              StyleBox[
               RowBox[{"\"\<V\[Gamma]2\[Delta]\>\"", "->", "True"}],
               Background->RGBColor[1, 1, 0]]}], "]"}], ")"}]}], "]"}], "&"}],
         "/@", 
        RowBox[{"(", "vertexList", ")"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"VertexListWithInteractions", "=", 
       RowBox[{"MapApply", "[", 
        RowBox[{"List", ",", 
         RowBox[{
