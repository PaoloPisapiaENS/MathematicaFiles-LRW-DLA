Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"exhaustiveReplace", ",", "exhaustiveReplaceOld"}], "]"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"exhaustiveReplaceOld", "[", 
      RowBox[{"expr_Plus", ",", "rules_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"exhaustiveReplace", "[", 
        RowBox[{"#", ",", "rules"}], "]"}], "&"}], "/@", 
      RowBox[{"(", "expr", ")"}]}]}], ";", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"exhaustiveReplaceOld", "[", 
      RowBox[{"expr_", ",", "rules_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"exprList", ",", 
         RowBox[{"count", "=", "0"}], ",", "results", ",", "junk"}], "}"}], 
       ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"exprList", "=", 
         RowBox[{"DeleteElements", "[", 
          RowBox[{
           RowBox[{"List", "@@", 
            RowBox[{"(", 
             RowBox[{"expr", "+", "junk"}], ")"}]}], ",", 
           RowBox[{"{", "junk", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"results", "=", 
         RowBox[{"Total", "@", 
          RowBox[{"FixedPoint", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"count", "++"}], ";", "\[IndentingNewLine]", 
               RowBox[{"DeleteElements", "[", 
                RowBox[{
                 RowBox[{"List", "@@", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"Total", "[", 
                    RowBox[{"Join", "@@", 
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"With", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"replaced", "=", 
                    RowBox[{"Level", "[", 
                    RowBox[{
                    RowBox[{"ReplaceList", "[", 
                    RowBox[{"e", ",", "rules"}], "]"}], ",", 
                    RowBox[{"{", "1", "}"}]}], "]"}]}], "}"}], ",", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"replaced", "===", 
                    RowBox[{"{", "}"}]}], ",", 
                    RowBox[{"{", "e", "}"}], ",", "replaced"}], "]"}]}], 
                    "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"e", ",", "#"}], "}"}]}], "]"}]}], "]"}], "+", 
                    "junk"}], ")"}]}], ",", 
                 RowBox[{"{", "junk", "}"}]}], "]"}]}], ")"}], "&"}], 
            "\[IndentingNewLine]", ",", "exprList", ",", "10"}], "]"}]}]}], 
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"Expand", "[", 
         FractionBox["results", 
          RowBox[{"1", "*", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"count", "-", "1"}], ")"}], "!"}]}]], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"exhaustiveReplace", "[", 
     RowBox[{"expr_Plus", ",", "rules_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"exhaustiveReplace", "[", 
       RowBox[{"#", ",", "rules"}], "]"}], "&"}], "/@", 
     RowBox[{"(", "expr", ")"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"exhaustiveReplace", "[", 
   RowBox[{"expr_", ",", "rules_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"exprList", ",", 
      RowBox[{"count", "=", "0"}], ",", "results", ",", "junk"}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"exprList", "=", 
      RowBox[{"ReleaseHold", "[", 
       RowBox[{"List", "@@", 
        RowBox[{"(", 
         RowBox[{"expr", "+", 
          RowBox[{"Hold", "[", "0", "]"}]}], ")"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"results", "=", 
      RowBox[{"Total", "@", 
       RowBox[{"FixedPoint", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"count", "++"}], ";", "\[IndentingNewLine]", 
            RowBox[{"ReleaseHold", "[", 
             RowBox[{"List", "@@", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Total", "[", 
                 RowBox[{"Join", "@@", 
                  RowBox[{"Table", "[", 
                   RowBox[{
                    RowBox[{"With", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"replaced", "=", 
                    RowBox[{"Level", "[", 
                    RowBox[{
                    RowBox[{"ReplaceList", "[", 
                    RowBox[{"e", ",", "rules"}], "]"}], ",", 
                    RowBox[{"{", "1", "}"}]}], "]"}]}], "}"}], ",", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"replaced", "===", 
                    RowBox[{"{", "}"}]}], ",", 
                    RowBox[{"{", "e", "}"}], ",", "replaced"}], "]"}]}], 
                    "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"e", ",", "#"}], "}"}]}], "]"}]}], "]"}], "+", 
                RowBox[{"Hold", "[", "0", "]"}]}], ")"}]}], "]"}]}], ")"}], 
          "&"}], "\[IndentingNewLine]", ",", "exprList", ",", "10"}], 
        "]"}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Expand", "[", 
      FractionBox["results", 
