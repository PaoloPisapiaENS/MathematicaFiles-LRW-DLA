Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "Spread\[Gamma]", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "Spread\[Gamma]", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<print\>\"", "->", "False"}], ",", " ", 
      RowBox[{"\"\<n\[Gamma]1\[Delta]\>\"", "->", "0"}], ",", " ", 
      RowBox[{"\"\<n\[Gamma]2\>\"", "->", "0"}], ",", 
      RowBox[{"\"\<n\[Gamma]2Minus\>\"", "->", "0"}], ",", 
      RowBox[{"\"\<n\[Gamma]2Minus2\>\"", "->", "0"}], ",", 
      RowBox[{"\"\<n\[Gamma]g\>\"", "->", "0"}], ",", 
      RowBox[{"\"\<\[Delta]fields\>\"", "->", "True"}], ",", 
      RowBox[{"\"\<endTime\>\"", "->", "0"}], ",", 
      RowBox[{"\"\<initialTime\>\"", "->", "0"}], ",", 
      RowBox[{"\"\<evaluate\>\"", "->", "True"}], ",", 
      RowBox[{"\"\<observable\>\"", "->", "\"\<psi\>\""}]}], "}"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Spread\[Gamma]", "[", 
    RowBox[{"n\[Gamma]1_", ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"vertexList", "=", 
        RowBox[{"{", "}"}]}], ",", "i", ",", "j", ",", "endTime"}], "}"}], 
     ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<endTime\>\"", "]"}], "==", "0"}], 
        ",", 
        RowBox[{"endTime", "=", 
         RowBox[{"n\[Gamma]1", "+", 
          RowBox[{"OptionValue", "[", "\"\<n\[Gamma]1\[Delta]\>\"", "]"}], 
          "+", 
          RowBox[{"OptionValue", "[", "\"\<n\[Gamma]2\>\"", "]"}], "+", 
          RowBox[{"OptionValue", "[", "\"\<n\[Gamma]2Minus\>\"", "]"}]}]}], 
        ",", 
        RowBox[{
         RowBox[{"endTime", "=", 
          RowBox[{"OptionValue", "[", "\"\<endTime\>\"", "]"}]}], ";"}]}], 
       "]"}], ";", "\n", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<\[Delta]fields\>\"", "]"}], ",", 
        "\n", 
        RowBox[{"(*", " ", 
         RowBox[{"WITH", " ", "\[Delta]fields"}], " ", "*)"}], "\n", 
        RowBox[{
         RowBox[{"vertexList", "=", "\[IndentingNewLine]", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"PadRight", "[", 
             RowBox[{
              RowBox[{"{", "}"}], ",", 
              RowBox[{"(", 
               RowBox[{"n\[Gamma]1", "-", 
                RowBox[{
                "OptionValue", "[", "\"\<n\[Gamma]1\[Delta]\>\"", "]"}]}], 
               ")"}], ",", "V\[Gamma]1"}], "]"}], "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{",", 
              RowBox[{"PadRight", "[", 
               RowBox[{
                RowBox[{"{", "}"}], ",", 
                RowBox[{
                "OptionValue", "[", "\"\<n\[Gamma]1\[Delta]\>\"", "]"}], ",", 
                "V\[Gamma]1\[Delta]"}], "]"}]}], "*)"}], 
            "\[IndentingNewLine]", ",", 
            RowBox[{"PadRight", "[", 
             RowBox[{
              RowBox[{"{", "}"}], ",", 
              RowBox[{"OptionValue", "[", "\"\<n\[Gamma]2\>\"", "]"}], ",", 
              "V\[Gamma]2\[Delta]"}], "]"}], "\[IndentingNewLine]", ",", 
            RowBox[{"PadRight", "[", 
             RowBox[{
              RowBox[{"{", "}"}], ",", 
              RowBox[{"OptionValue", "[", "\"\<n\[Gamma]2Minus\>\"", "]"}], 
              ",", "V\[Gamma]2Minus1"}], "]"}], "\[IndentingNewLine]", ",", 
            RowBox[{"PadRight", "[", 
             RowBox[{
              RowBox[{"{", "}"}], ",", 
              RowBox[{"OptionValue", "[", "\"\<n\[Gamma]g\>\"", "]"}], ",", 
              "V\[Gamma]g"}], "]"}], "\[IndentingNewLine]", ",", 
            RowBox[{"PadRight", "[", 
             RowBox[{
              RowBox[{"{", "}"}], ",", 
              RowBox[{"Floor", "[", 
               RowBox[{"OptionValue", "[", "\"\<n\[Gamma]2Minus2\>\"", "]"}], 
               "]"}], ",", "V\[Gamma]2Minus2"}], "]"}]}], 
           "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", ",", 
        "\n", 
        RowBox[{"(*", " ", 
         RowBox[{"WITHOUT", " ", "\[Delta]fields"}], "*)"}], "\n", 
        RowBox[{
         RowBox[{"vertexList", "=", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"PadRight", "[", 
             RowBox[{
              RowBox[{"{", "}"}], ",", 
              RowBox[{"(", 
               RowBox[{"n\[Gamma]1", "-", 
                RowBox[{
                "OptionValue", "[", "\"\<n\[Gamma]1\[Delta]\>\"", "]"}]}], 
               ")"}], ",", "V\[Gamma]1"}], "]"}], ",", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"PadRight", "[", 
               RowBox[{
                RowBox[{"{", "}"}], ",", 
                RowBox[{
                "OptionValue", "[", "\"\<n\[Gamma]1\[Delta]\>\"", "]"}], ",", 
                "V\[Gamma]1\[Delta]"}], "]"}], ","}], "*)"}], 
            RowBox[{"PadRight", "[", 
             RowBox[{
              RowBox[{"{", "}"}], ",", 
              RowBox[{"OptionValue", "[", "\"\<n\[Gamma]2\>\"", "]"}], ",", 
              "V\[Gamma]2"}], "]"}], ",", 
            RowBox[{"PadRight", "[", 
             RowBox[{
              RowBox[{"{", "}"}], ",", 
              RowBox[{"OptionValue", "[", "\"\<n\[Gamma]2Minus\>\"", "]"}], 
              ",", "V\[Gamma]2Minus"}], "]"}]}], "]"}]}], ";"}]}], "\n", 
       "]"}], ";", "\[IndentingNewLine]", "\n", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<print\>\"", "]"}], ",", "\n", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\< The vertices are :\\n \>\"", ",", "vertexList"}], 
         "]"}]}], "]"}], ";", "\n", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "\n", 
      RowBox[{"(*", " ", 
       RowBox[{
       "REMOVE", " ", "STRINGS", " ", "CONTAINING", " ", "\[Gamma]s", " ", 
        "IN", " ", "THE", " ", "WRONG", " ", "PLACES"}], " ", "*)"}], "\n", 
      RowBox[{"vertexList", "=", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Permutations", "@", "vertexList"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Last", "[", "#", "]"}], "=!=", "V\[Gamma]1"}], 
            RowBox[{"(*", 
             RowBox[{"&&", 
              RowBox[{
               RowBox[{"First", "[", "#", "]"}], "=!=", 
               "V\[Gamma]1\[Delta]"}], "&&", 
              RowBox[{
               RowBox[{"First", "[", "#", "]"}], "=!=", "V\[Gamma]2"}], "&&", 
              RowBox[{
               RowBox[{"First", "[", "#", "]"}], "=!=", "V\[Gamma]2Minus"}]}],
              "*)"}], "&&", 
            RowBox[{
             RowBox[{"First", "[", "#", "]"}], "=!=", "V\[Gamma]2Minus1"}], "&&", 
            RowBox[{
             RowBox[{"First", "[", "#", "]"}], "=!=", "V\[Gamma]2Minus2"}], "&&", 
            RowBox[{
             RowBox[{"First", "[", "#", "]"}], "=!=", "V\[Gamma]g"}], "&&", 
            RowBox[{
             RowBox[{"First", "[", "#", "]"}], "=!=", "V\[Gamma]2\[Delta]"}], 
            "&&", 
            RowBox[{
             RowBox[{"First", "[", "#", "]"}], "=!=", 
             "V\[Gamma]2Minus\[Delta]"}]}], "&"}]}], "]"}], "]"}]}], ";", 
      "\n", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<print\>\"", "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{
         "\"\< After permutations and removing leading \[Delta]\[Chi]s's:\\n \
\>\"", ",", "vertexList"}], "]"}]}], "]"}], ";", "\n", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<n\[Gamma]2Minus\>\"", "]"}], ">", 
         "1"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"vertexList", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"Prepend", "[", 
             RowBox[{"#", ",", 
              RowBox[{"1", "/", 
               RowBox[{
                RowBox[{"OptionValue", "[", "\"\<n\[Gamma]2Minus\>\"", "]"}], 
                "!"}]}]}], "]"}], "&"}], "/@", "vertexList"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\n", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"OptionValue", "[", "\"\<evaluate\>\"", "]"}], "==", 
         "False"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Return", "[", "vertexList", "]"}]}], "]"}], ";", "\n", 
      "\[IndentingNewLine]", "\n", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "<=", "endTime"}], ",", 
        RowBox[{"i", "++"}], ",", "\n", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"j", "=", "1"}], ",", 
           RowBox[{"j", "<=", 
            RowBox[{"Length", "[", "vertexList", "]"}]}], ",", 
           RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"vertexList", "[", 
              RowBox[{"[", 
               RowBox[{"j", ",", "i"}], "]"}], "]"}], "=", 
             RowBox[{
              RowBox[{"vertexList", "[", 
               RowBox[{"[", 
                RowBox[{"j", ",", "i"}], "]"}], "]"}], "[", 
              RowBox[{
               RowBox[{"Subscript", "[", 
                RowBox[{"x", ",", " ", 
                 RowBox[{"i", "+", 
                  RowBox[{
                  "OptionValue", "[", "\"\<initialTime\>\"", "]"}]}]}], "]"}],
                ",", 
               RowBox[{"i", "+", 
                RowBox[{"OptionValue", "[", "\"\<initialTime\>\"", "]"}]}]}], 
              "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\n", "\[IndentingNewLine]", "\n", 
      RowBox[{"vertexList", "=", 
       RowBox[{"Plus", "@@", 
        RowBox[{"Apply", "[", 
         RowBox[{"Times", ",", "vertexList", ",", "1"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
      RowBox[{"Return", "[", "vertexList", "]"}], ";"}]}], "\n", "\n", 
    "]"}]}], ";"}]}], "Input",
 InitializationCell->True,
