          "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"skipFirst", "=", "0"}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
          "Loop", " ", "over", " ", "the", " ", "elements", " ", "of", " ", 
           "locVertexList", " ", "and", " ", "assign", " ", "the", " ", 
           RowBox[{"(", 
            RowBox[{"x", ",", "t"}], ")"}], " ", "arguments"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"For", "[", 
