Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "WickContractionSpaceVerticesMODfasterLoc", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "WickContractionSpaceVerticesMODfasterLoc", "]"}],
     "=", 
    RowBox[{"{", "\n", 
     RowBox[{
      RowBox[{"\"\<print\>\"", "->", "False"}], ",", "\n", 
      RowBox[{"\"\<fields\>\"", "->", 
       RowBox[{"FieldsNamesGenerator", "[", 
        RowBox[{"{", "\[Phi]", 
         RowBox[{"(*", 
          RowBox[{",", "\[Chi]", ",", "\[Psi]"}], "*)"}], "}"}], "]"}]}], ",",
       " ", "\n", 
      RowBox[{"\"\<startingTime\>\"", "->", "1"}], ",", " ", "\n", 
      RowBox[{"\"\<endTime\>\"", "->", "1"}], ",", "\n", 
      RowBox[{"\"\<#vertices\>\"", "->", "10"}], ",", "\n", 
      RowBox[{"\"\<\[Delta]rule\>\"", "->", "True"}], ",", "\n", 
      RowBox[{"\"\<\[Delta]ruleExternal\>\"", "->", "True"}], ",", "\n", 
      RowBox[{"\"\<\\!\\(\\*SubscriptBox[\\(n\\), \\(\[Chi]\\)]\\)\>\"", "->", 
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}]}], ",", "\n", 
      RowBox[{"\"\<\\!\\(\\*SubscriptBox[\\(n\\), \\(\[Alpha]\\)]\\)\>\"", "->", 
       RowBox[{"(", "0", ")"}]}], ",", "\n", 
      RowBox[{"\"\<maxContractions\>\"", "->", "3"}], ",", "\n", 
      RowBox[{"\"\<kill\[Psi]\>\"", "->", "False"}], ",", "\n", 
      RowBox[{"\"\<SimplifyPropagators\>\"", "->", "True"}], ",", "\n", 
      RowBox[{"\"\<SimplifyG\[Psi]\>\"", "->", "True"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"\"\<SimplifyLoops\>\"", "->", "False"}], ",", "\n", 
      RowBox[{"\"\<ReturnJustAction\>\"", "->", "False"}], ",", "\n", 
      RowBox[{"\"\<FreeAction\>\"", "->", "FreeAction"}]}], "}"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"WickContractionSpaceVerticesMODfasterLoc", "[", 
     RowBox[{
      RowBox[{"A_", " ", "+", "B_"}], ",", 
      RowBox[{"opts", ":", 
       RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
