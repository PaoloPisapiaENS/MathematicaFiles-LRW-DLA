   3.987481987025049*^9, {3.987482028696717*^9, 3.987482029087742*^9}, 
   3.9874820734536953`*^9, {3.987482174332508*^9, 3.9874822300483704`*^9}, {
   3.987482279591444*^9, 3.987482348830155*^9}, {3.9874823815925694`*^9, 
   3.987482393591791*^9}, {3.987482480952914*^9, 3.9874825233276653`*^9}, 
   3.987482572228586*^9, {3.987482602867949*^9, 3.9874826823869095`*^9}, {
