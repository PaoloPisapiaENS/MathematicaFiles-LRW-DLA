           RowBox[{"Print", "[", "terms", "]"}], ";"}]}], "\n", "]"}], ";"}], 
       "*)"}], "\n", "\n", 
      RowBox[{"terms", "=", 
       RowBox[{
        RowBox[{"terms", "/.", 
         RowBox[{
          RowBox[{"\[Delta]t", "[", "__", "]"}], "->", "1"}]}], "/.", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Subscript", "[", 
            RowBox[{"G", ",", " ", "\[Psi]"}], "]"}], "[", "A___", "]"}], "^",
           "n_"}], "->", 
         RowBox[{
          RowBox[{"Subscript", "[", 
           RowBox[{"G", ",", " ", "\[Psi]"}], "]"}], "[", "A", "]"}]}]}]}], 
      ";", "\n", "\n", 
      RowBox[{"(*", " ", 
       RowBox[{"Eliminate", " ", "useless", " ", "gaps"}], " ", "*)"}], "\n", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "<=", "5"}], ",", 
        RowBox[{"i", "++"}], ",", "\n", 
        RowBox[{
         RowBox[{"While", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"FreeQ", "[", 
             RowBox[{"terms", ",", 
              RowBox[{"Subscript", "[", 
               RowBox[{"x", ",", " ", "i"}], "]"}]}], "]"}], ")"}], ",", "\n", 
           RowBox[{
            RowBox[{"temp1", "=", 
             RowBox[{"terms", "/.", 
              RowBox[{
               RowBox[{
                RowBox[{"Subscript", "[", 
                 RowBox[{"x", ",", " ", "a_"}], "]"}], "/;", 
                RowBox[{"(", 
                 RowBox[{"a", ">", "i"}], ")"}]}], ":>", 
               RowBox[{"Subscript", "[", 
                RowBox[{"x", ",", " ", 
                 RowBox[{"a", "-", "1"}]}], "]"}]}]}]}], ";", "\n", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"temp1", "===", "terms"}], ",", " ", 
              RowBox[{"Break", "[", "]"}], ",", 
              RowBox[{"terms", "=", "temp1"}]}], "]"}]}]}], "\n", "]"}], 
         ";"}]}], "\n", "]"}], ";", 
      RowBox[{"(*", " ", 
       RowBox[{"END", " ", "OF", " ", "FOR"}], "*)"}], "\n", "\n", 
