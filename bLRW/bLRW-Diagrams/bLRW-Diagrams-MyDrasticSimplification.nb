                    "OptionValue", "[", "\"\<initialTime\>\"", "]"}]}]}], 
                   "]"}], "*)"}], 
                 RowBox[{
                  RowBox[{"j", "+", 
                   RowBox[{"OptionValue", "[", "\"\<initialTime\>\"", "]"}], 
                   "-", "skipFirst"}], ",", 
                  RowBox[{"j", "+", 
                   RowBox[{"OptionValue", "[", "\"\<initialTime\>\"", "]"}], 
                   "-", "skipFirst"}]}], "]"}]}], ";"}]}], 
             "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
          "]"}], ";", 
         RowBox[{"(*", 
          RowBox[{"End", " ", "of", " ", "For", " ", "over", " ", "j"}], 
          "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"evaluatedVertexList", ",", 
           RowBox[{
            RowBox[{"If", "[", 
