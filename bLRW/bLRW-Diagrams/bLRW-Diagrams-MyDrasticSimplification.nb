            RowBox[{"(", 
             RowBox[{"Times", "@@", "locVertexList"}], ")"}]}]}], "]"}], 
         ";"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], ";", 
      RowBox[{"(*", 
