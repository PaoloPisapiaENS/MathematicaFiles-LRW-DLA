Cell[BoxData[{
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"i", ",", "terms", ",", "temp1"}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"terms", "=", 
     RowBox[{"EvaluatePropagators", "[", 
      RowBox[{"twoLoopMod", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"i", "=", "1"}], ",", 
      RowBox[{"i", "<=", "5"}], ",", 
      RowBox[{"i", "++"}], ",", "\n", 
      RowBox[{
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"FreeQ", "[", 
           RowBox[{"terms", ",", 
            RowBox[{"Subscript", "[", 
             RowBox[{"x", ",", " ", "i"}], "]"}]}], "]"}], ")"}], ",", "\n", 
         RowBox[{
          RowBox[{"temp1", "=", 
           RowBox[{"terms", "/.", 
            RowBox[{
             RowBox[{
              RowBox[{"Subscript", "[", 
               RowBox[{"x", ",", " ", "a_"}], "]"}], "/;", 
              RowBox[{"(", 
               RowBox[{"a", ">", "i"}], ")"}]}], ":>", 
             RowBox[{"Subscript", "[", 
              RowBox[{"x", ",", " ", 
               RowBox[{"a", "-", "1"}]}], "]"}]}]}]}], ";", "\n", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"temp1", "===", "terms"}], ",", " ", 
            RowBox[{"Break", "[", "]"}], ",", 
            RowBox[{"terms", "=", "temp1"}]}], "]"}]}]}], "\n", "]"}], 
       ";"}]}], "\n", "]"}], ";", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "terms"}]}], "\[IndentingNewLine]", 
  "]"}], "\[IndentingNewLine]", 
