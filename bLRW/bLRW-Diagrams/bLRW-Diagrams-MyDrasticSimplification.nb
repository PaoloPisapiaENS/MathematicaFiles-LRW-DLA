              "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"MatchQ", "[", 
               RowBox[{
                RowBox[{"locVertexList", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], ",", 
                RowBox[{"-", "_"}]}], "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{"(*", "TRUE", "*)"}], "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"locVertexList", "[", 
                RowBox[{"[", "j", "]"}], "]"}], "=", 
               RowBox[{"-", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"-", 
