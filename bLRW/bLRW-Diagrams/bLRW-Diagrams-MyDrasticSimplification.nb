                    RowBox[{"[", "j", "]"}], "]"}]}], ")"}], "[", 
                 StyleBox[
                  RowBox[{"(*", 
                   RowBox[{"Subscript", "[", 
                    RowBox[{"x", ",", " ", 
                    RowBox[{"j", "+", 
                    RowBox[{
                    "OptionValue", "[", "\"\<initialTime\>\"", "]"}]}]}], 
                    "]"}], "*)"}],
                  FontSize->12], 
                 RowBox[{
                  RowBox[{"j", "+", 
                   RowBox[{"OptionValue", "[", "\"\<initialTime\>\"", "]"}], 
                   "-", "skipFirst"}], ",", 
                  RowBox[{"j", "+", 
                   RowBox[{"OptionValue", "[", "\"\<initialTime\>\"", "]"}], 
