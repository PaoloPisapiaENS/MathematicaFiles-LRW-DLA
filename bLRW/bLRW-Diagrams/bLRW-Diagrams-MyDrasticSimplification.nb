Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"DrawFromContractionGeneral", ",", "x"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "DrawFromContractionGeneral", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<pointSize\>\"", "->", "0.015"}], ",", 
      RowBox[{"\"\<ArrowHeadSize\>\"", "->", "0.05"}], ",", 
      RowBox[{"\"\<\[Psi]sLength\>\"", "->", "0.4"}], ",", 
      RowBox[{"\"\<print\>\"", "->", "False"}], ",", 
      RowBox[{"\"\<showEndLines\>\"", "->", "False"}], ",", 
      RowBox[{"\"\<ImageSize\>\"", "->", "Medium"}], ",", 
      RowBox[{"\"\<export\>\"", "->", "False"}], ",", 
      RowBox[{"\"\<exportDirectory\>\"", "->", "\"\<myFile.pdf\>\""}], ",", 
      RowBox[{"\"\<initialIndex\>\"", "->", "1"}]}], "}"}]}], ";"}], "\n", 
  "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"DrawFromContractionGeneral", "[", 
      RowBox[{"exp_List", ",", 
       RowBox[{"opts", ":", 
        RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"DrawFromContractionGeneral", "[", 
         RowBox[{"#", ",", "opts"}], "]"}], "&"}], "/@", 
       RowBox[{"(", "exp", ")"}]}], ")"}]}], ";"}], "*)"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"DrawFromContractionGeneral", "[", 
   RowBox[{"exp_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "locExp", ",", "terms", ",", "i", ",", "pureProp", ",", " ", "weight", 
      ",", " ", "dots", ",", "plot"}], "}"}], ",", "\n", "\n", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"OptionValue", "[", "\"\<print\>\"", "]"}], ",", 
       RowBox[{"DeleteFile", "[", "LogFile", "]"}]}], "]"}], ";", "  ", 
     RowBox[{"(*", 
      RowBox[{
      "Place", " ", "at", " ", "the", " ", "top", " ", "of", " ", "the", " ", 
       "notebook"}], "*)"}], "\n", "\[IndentingNewLine]", 
     RowBox[{"locExp", "=", 
      RowBox[{"exp", "/.", 
       RowBox[{
        RowBox[{"V", "[", "a___", "]"}], "->", "a"}]}]}], ";", "\n", 
     RowBox[{"(*", " ", 
      RowBox[{
      "I", " ", "want", " ", "to", " ", "check", " ", "if", " ", "terms", " ",
        "is", " ", "a", " ", "list", " ", "of", " ", "lists", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
         "which", " ", "means", " ", "that", " ", "exp", " ", "conatained", 
          " ", "a", " ", "sum"}], ",", " ", 
         RowBox[{
          RowBox[{"i", ".", "e", ".", " ", "multiple"}], " ", "diagrams"}]}], 
        ")"}]}], "*)"}], "\n", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{
         RowBox[{"Head", "[", "locExp", "]"}], " ", "===", "List"}]}], ",", 
       "\n", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"TRUE", ":", " ", 
          RowBox[{
          "if", " ", "it", " ", "is", " ", "not", " ", "a", " ", "List", " ", 
           "of", " ", "lists"}]}], ",", " ", 
         RowBox[{
          RowBox[{"let", "'"}], "s", " ", "make", " ", "it", " ", "so"}]}], 
        " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"locExp", "=", 
        RowBox[{"{", "locExp", "}"}]}], "\[IndentingNewLine]", ",", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", "FALSE", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Head", "[", "locExp", "]"}], " ", "===", "Plus"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{"True", ":", " ", 
            RowBox[{
            "make", " ", "sure", " ", "that", " ", "each", " ", "term", " ", 
             "does", " ", "not", " ", "contain", " ", "sums"}]}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"locExp", "=", 
            RowBox[{"List", "@@", 
             RowBox[{"(", "locExp", ")"}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"Row", "[", 
               RowBox[{"{", "\"\<Some of them are sums!!\>\"", "}"}], "]"}], 
              ",", "Red"}], "]"}], "]"}], ";"}]}], " ", "\[IndentingNewLine]",
          "]"}], 
        RowBox[{"(*", 
         RowBox[{"End", " ", "of", " ", "IF", " ", "on", " ", "Plus"}], 
         "*)"}], ";"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], 
     RowBox[{"(*", 
      RowBox[{"End", " ", "of", " ", "IF", " ", "on", " ", "List"}], "*)"}], 
     ";", "\n", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"plot", "=", 
      RowBox[{"{", "}"}]}], ";", "\n", "\n", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<=", 
        RowBox[{"Length", "[", "locExp", "]"}]}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", "\n", 
       RowBox[{
        RowBox[{"terms", "=", 
         RowBox[{"locExp", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], ";", "\n", "\n", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"terms", "==", "0"}], " ", ",", "\n", 
