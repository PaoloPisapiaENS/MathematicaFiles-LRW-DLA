Cell[CellGroupData[{

Cell[TextData[{
 "Finding rules with basis: {sp[q+k], l, l + k, p, p + k, q, p - q, l - q}\n\
",
 StyleBox["IT NEEDS TO ADD:  l\[CenterDot]p",
  Background->RGBColor[1, 1, 0]]
}], "Subsection",
 CellChangeTimes->{{3.7854606187281713`*^9, 3.785460624428533*^9}, {
  3.9717773072392654`*^9, 3.971777367425865*^9}, {3.971777412911087*^9, 
  3.971777415239109*^9}},ExpressionUUID->"060ed20b-c6e0-8041-8e24-\
c751b1d5dfa9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "borsalino2", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Timing", "[", 
  RowBox[{"NewDsBasis", "[", 
   RowBox[{"borsalino2", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"sp", "[", 
       RowBox[{"q", "+", "k"}], "]"}], ",", "l", ",", 
      RowBox[{"l", "+", "k"}], ",", "p", ",", 
      RowBox[{"p", "+", "k"}], ",", "q", ",", 
      RowBox[{"p", "-", "q"}], ",", 
      RowBox[{"l", "-", "q"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"l", ",", "p", ",", "q"}], "}"}], ",", 
    RowBox[{"AnalyzeSectors", "->", 
     RowBox[{"{", 
      RowBox[{"0", ",", "__"}], "}"}]}], 
    RowBox[{"(*", 
     RowBox[{"This", " ", "means", " ", "that", " ", "the", " ", "first", " ", 
      RowBox[{"entry", ":", " ", 
       RowBox[{"q", "+", 
        RowBox[{
        "k", " ", "corresponds", " ", "to", " ", "a", " ", 
         "numerator"}]}]}]}], "*)"}], ",", 
    RowBox[{"Append", "->", "True"}], ",", 
    RowBox[{"Directory", "\[Rule]", "\"\<Bases/borsalino2\>\""}], ",", 
    RowBox[{"SolvejSector", "\[Rule]", "True"}]}], "]"}], "]"}]}], "Input",
 CellChangeTimes->{{3.782707214576947*^9, 3.782707257165472*^9}, {
   3.782707289214075*^9, 3.782707306701565*^9}, {3.78453074174669*^9, 
