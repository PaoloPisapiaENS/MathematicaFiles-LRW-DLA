Cell[BoxData["\<\"borsalino is valid basis. The definitions of the basis will \
be saved in \\\"Bases/borsalino\\\" directory.\\n    Ds[borsalino] \
\[LongDash] denominators,\\n    SPs[borsalino] \[LongDash] scalar products \
involving loop momenta,\\n    LMs[borsalino] \[LongDash] loop momenta,\\n    \
EMs[borsalino] \[LongDash] external momenta,\\n    Parameters[borsalino] \
\[LongDash] parameters (invariants, masses, dimension),\\n    Toj[borsalino] \
\[LongDash] rules to transform scalar products to denominators,\\n    \
CutDs[borsalino] \[LongDash] flag vector of cut denominators.\"\>"], "Print",
 CellChangeTimes->{3.9717734771091576`*^9},
 CellLabel->
  "During evaluation of \
