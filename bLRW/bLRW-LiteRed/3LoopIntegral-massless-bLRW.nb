In[75]:=",ExpressionUUID->"0410bf4a-2a7d-e94b-bd4c-00e429f3cd61"],

Cell[BoxData["\<\"borsalino5 is valid basis. The definitions of the basis \
will be saved in \\\"Bases/borsalino5\\\" directory.\\n    Ds[borsalino5] \
\[LongDash] denominators,\\n    SPs[borsalino5] \[LongDash] scalar products \
involving loop momenta,\\n    LMs[borsalino5] \[LongDash] loop momenta,\\n    \
EMs[borsalino5] \[LongDash] external momenta,\\n    Parameters[borsalino5] \
\[LongDash] parameters (invariants, masses, dimension),\\n    Toj[borsalino5] \
\[LongDash] rules to transform scalar products to denominators,\\n    \
CutDs[borsalino5] \[LongDash] flag vector of cut denominators.\"\>"], "Print",\

 CellChangeTimes->{3.971780546566538*^9, 3.972367288374695*^9},
 CellLabel->
  "During evaluation of \
In[75]:=",ExpressionUUID->"d8589262-8dc8-ba4d-a29f-7e9e314fa894"],

