Cell[BoxData["\<\"Found 209(47) zero(nonzero) sectors out of 256.\\n    \
ZeroSectors[borsalino5] \[LongDash] zero sectors,\\n    \
NonZeroSectors[borsalino5] \[LongDash] nonzero sectors,\\n    \
SimpleSectors[borsalino5] \[LongDash] simple sectors (no nonzero subsectors),\
\\n    BasisSectors[borsalino5] \[LongDash] basis sectors (at least one \
immediate subsector is zero),\\n    ZerojRule[borsalino5] \[LongDash] a rule \
to nullify all zero j[borsalino5\[Ellipsis]],\\n    CutDs[borsalino5] \
\[LongDash] a flag list of cut denominators (1=cut).\"\>"], "Print",
 CellChangeTimes->{3.971780546566538*^9, 3.9723672918394604`*^9},
