  3.784862301954615*^9}},ExpressionUUID->"33d8c953-e9d0-4ace-beb8-\
1a17b202f566"],

Cell[CellGroupData[{

Cell["\<\
ALREADY COMPUTED IN \[OpenCurlyDoubleQuote]3LoopIntegral-bLRW.nb\
\[CloseCurlyDoubleQuote]. Use the basis: borsalino3\
\>", "Subtitle",
 CellChangeTimes->{{3.9723616839489155`*^9, 3.972361714096182*^9}, {
  3.9723617626604996`*^9, 
  3.9723617657246666`*^9}},ExpressionUUID->"19851282-bbf8-754f-b2b6-\
9a1b9de00b1a"],

Cell[CellGroupData[{

Cell[TextData[{
 "Finding rules with basis: borsalino5: {sp[q+k], l, l + k, p, p + k, q, p - \
q, l - q}. NO SPECIFICATION OF AnalyzeSectors -> {0, __}...\n",
 StyleBox["IT NEEDS TO ADD:  l\[CenterDot]p",
  Background->RGBColor[1, 1, 0]]
}], "Subsection",
 CellChangeTimes->{{3.7854606187281713`*^9, 3.785460624428533*^9}, {
  3.971777307239265*^9, 3.971777367425865*^9}, {3.971777412911087*^9, 
  3.971777415239109*^9}, {3.972367241577776*^9, 
  3.9723672731142807`*^9}},ExpressionUUID->"958b58e3-c9bf-784b-92f2-\
d61c99fe6130"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "borsalino5", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Timing", "[", 
  RowBox[{"NewDsBasis", "[", 
   RowBox[{"borsalino5", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"sp", "[", 
       RowBox[{"q", "+", "k"}], "]"}], ",", "l", ",", 
      RowBox[{"l", "+", "k"}], ",", "p", ",", 
      RowBox[{"p", "+", "k"}], ",", "q", ",", 
      RowBox[{"p", "-", "q"}], ",", 
      RowBox[{"l", "-", "q"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"l", ",", "p", ",", "q"}], "}"}], 
    RowBox[{"(*", 
     RowBox[{",", 
      RowBox[{"AnalyzeSectors", "->", 
       RowBox[{"{", 
        RowBox[{"0", ",", "__"}], "}"}]}]}], "*)"}], 
    RowBox[{"(*", 
     RowBox[{"This", " ", "means", " ", "that", " ", "the", " ", "first", " ", 
      RowBox[{"entry", ":", " ", 
       RowBox[{"q", "+", 
        RowBox[{
        "k", " ", "corresponds", " ", "to", " ", "a", " ", 
         "numerator"}]}]}]}], "*)"}], ",", 
    RowBox[{"Append", "->", "True"}], ",", 
    RowBox[{"Directory", "\[Rule]", "\"\<Bases/borsalino5\>\""}], ",", 
    RowBox[{"SolvejSector", "\[Rule]", "True"}]}], "]"}], "]"}]}], "Input",
 CellChangeTimes->{{3.782707214576947*^9, 3.782707257165472*^9}, {
   3.782707289214075*^9, 3.782707306701565*^9}, {3.78453074174669*^9, 
   3.784530944403606*^9}, {3.785460275565236*^9, 3.785460275958813*^9}, {
   3.785460570672735*^9, 3.785460571677868*^9}, {3.8140479308344*^9, 
   3.814047960191569*^9}, {3.814053600960239*^9, 3.814053601247509*^9}, {
   3.8140544529993277`*^9, 3.81405445997545*^9}, 3.814054501558899*^9, {
   3.8140546180244703`*^9, 3.814054764784285*^9}, {3.814055062041252*^9, 
   3.814055067323856*^9}, 3.814055177749291*^9, 3.8140552314474707`*^9, {
   3.814055325021037*^9, 3.814055335204389*^9}, {3.814753105543578*^9, 
