Cell["\<\
Suppose we want to choose some other master integrals, e.g. we want to \
replace mis[[3]]=j[borsalino5, 0, 0, 1, 1, 1, 1, 0, 1, 0] with j[borsalino5, \
1, 1, 0, 1, 1, 0, 1, 1, 0]. This is the ever-present triangle-triangle-loop \
diagram. Or j[borsalino5, 1, 1, 0, 0, 1, 1, 1, 1, 0], the jet-pack diagram.\
\>", "Text",
 CellChangeTimes->{{3.886883498295726*^9, 3.8868835454333344`*^9}, {
  3.886883667791916*^9, 3.88688367630656*^9}, {3.9723632464006233`*^9, 
  3.97236325037043*^9}, {3.9723633010506535`*^9, 3.9723633396973248`*^9}, {
  3.9723635216873703`*^9, 3.9723635251992245`*^9}, {3.972363932878414*^9, 
  3.972363943416258*^9}, {3.9723667917516193`*^9, 3.9723667957504387`*^9}, {
  3.972368547340435*^9, 
  3.972368571628639*^9}},ExpressionUUID->"0fd5be9d-ae3e-0640-b9e7-\
1d00995b4034"],

