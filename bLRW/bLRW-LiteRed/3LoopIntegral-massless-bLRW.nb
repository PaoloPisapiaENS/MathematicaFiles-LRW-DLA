                    RowBox[{
                    RowBox[{
                    RowBox[{"Head", "[", "LiteRed`Private`x", "]"}], "===", 
                    "List"}], ",", 
                    RowBox[{"Thread", "[", 
                    
                    RowBox[{"LiteRed`Private`x", "\[Rule]", 
                    "LiteRed`Private`Mi"}], "]"}], ",", 
                    
                    RowBox[{"LiteRed`Private`x", "\[Rule]", 
                    "LiteRed`Private`Mi"}]}], "]"}]}]}], "]"}]}]}, {" "}}, 
                  GridBoxAlignment -> {"Columns" -> {{Left}}}, 
