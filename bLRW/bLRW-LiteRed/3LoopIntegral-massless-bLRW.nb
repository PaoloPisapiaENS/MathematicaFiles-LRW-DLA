                 Annotation[#, "Definitions", "Tooltip"]& ], "DialogStyle",
                StripOnInput->False]},
              {
               TemplateBox[{"\"\[ThinSpace]\"", 
                 GridBox[{{
                    RowBox[{
                    RowBox[{"MakeDSystem", "[", 
                    RowBox[{
                    RowBox[{"LiteRed`Private`mis", ":", 
                    RowBox[{"{", "__j", "}"}]}], ",", "LiteRed`Private`x_", 
                    ",", 
                    RowBox[{"LiteRed`Private`opts", ":", 
                    RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
                    RowBox[{"MakeDSystem", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"LiteRed`Private`mis", ",", 
                    RowBox[{"{", "}"}]}], "}"}], ",", "LiteRed`Private`x", 
                    ",", "LiteRed`Private`opts"}], "]"}]}]}, {" "}, {
                    RowBox[{
                    RowBox[{"MakeDSystem", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"LiteRed`Private`mis_List", ",", 
                    RowBox[{"LiteRed`Private`tomis_List", ":", 
                    RowBox[{"{", "}"}]}]}], "}"}], ",", "LiteRed`Private`x_", 
                    ",", 
                    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
                    RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    
                    RowBox[{"LiteRed`Private`eqs", ",", 
                    "LiteRed`Private`Mi"}], "}"}], ",", 
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Head", "[", "LiteRed`Private`x", "]"}], "===", 
                    "List"}], ",", 
                    RowBox[{
                    RowBox[{"LiteRed`Private`eqs", "=", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"OptionValue", "[", "IBPReduce", "]"}], "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Dinv", "[", 
                    RowBox[{"LiteRed`Private`mis", ",", "#1"}], "]"}], "&"}], 
                    ")"}], "/@", "LiteRed`Private`x"}], "]"}], "/.", 
                    "\[VeryThinSpace]", "LiteRed`Private`tomis"}]}], ";", 
                    RowBox[{"LiteRed`Private`Mi", "=", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Outer", "[", 
                    
                    RowBox[{"Coefficient", ",", "#1", ",", 
                    "LiteRed`Private`mis"}], "]"}], "&"}], ")"}], "/@", 
                    "LiteRed`Private`eqs"}]}]}], ",", 
                    RowBox[{
                    RowBox[{"LiteRed`Private`eqs", "=", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"OptionValue", "[", "IBPReduce", "]"}], "[", 
                    RowBox[{"Dinv", "[", 
                    RowBox[{"LiteRed`Private`mis", ",", "LiteRed`Private`x"}],
                     "]"}], "]"}], "/.", "\[VeryThinSpace]", 
                    "LiteRed`Private`tomis"}]}], ";", 
                    RowBox[{"LiteRed`Private`Mi", "=", 
                    RowBox[{"Outer", "[", 
                    
                    RowBox[{"Coefficient", ",", "LiteRed`Private`eqs", ",", 
                    "LiteRed`Private`mis"}], "]"}]}]}]}], "]"}], ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"!", 
                    RowBox[{"MatchQ", "[", 
                    RowBox[{
                    RowBox[{"Flatten", "[", 
                    RowBox[{"Collectj", "[", 
                    RowBox[{
                    RowBox[{"LiteRed`Private`eqs", "-", 
                    
                    RowBox[{"LiteRed`Private`Mi", ".", 
                    "LiteRed`Private`mis"}]}], ",", "Factor"}], "]"}], "]"}], 
                    ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"(", "0", ")"}], ".."}], "}"}]}], "]"}]}], ",", 
                    RowBox[{"Message", "[", 
