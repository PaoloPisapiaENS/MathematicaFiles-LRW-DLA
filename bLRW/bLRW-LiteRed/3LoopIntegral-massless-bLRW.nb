61060cac51e6"],

Cell[TextData[{
 "We can do it with\n",
 StyleBox["WARNING",
  Background->RGBColor[1, 0.5, 0.5]],
 ": sometimes it works, sometimes it doesn\[CloseCurlyQuote]t. Make sure that \
the substitution works."
}], "Text",
