  InformationData[<|
   "ObjectType" -> "Symbol", "Usage" -> 
    "MakeDSystem[j_,toj_:{},x_] constructs matrix M in the differential \
system \!\(\*SubscriptBox[\(\[PartialD]\), \(x\)]\)j=Mj. The second argument \
toj corresponds to additional rules applied after reduction. If x is a list \
of variables, the result is also a list of the corresponding matrices.", 
    "Documentation" -> None, "OwnValues" -> None, "UpValues" -> None, 
    "DownValues" -> 
    Information`InformationValueForm[
     DownValues, LiteRed`MakeDSystem, {LiteRed`MakeDSystem[
         Pattern[LiteRed`Private`mis, {
           BlankSequence[LiteRed`j]}], 
         Pattern[LiteRed`Private`x, 
          Blank[]], 
         Pattern[LiteRed`Private`opts, 
          OptionsPattern[]]] :> 
       LiteRed`MakeDSystem[{LiteRed`Private`mis, {}}, LiteRed`Private`x, 
         LiteRed`Private`opts], LiteRed`MakeDSystem[{
          Pattern[LiteRed`Private`mis, 
           Blank[List]], 
          Optional[
           Pattern[LiteRed`Private`tomis, 
            Blank[List]], {}]}, 
         Pattern[LiteRed`Private`x, 
          Blank[]], 
         OptionsPattern[]] :> 
       Module[{LiteRed`Private`eqs, LiteRed`Private`Mi}, 
         If[Head[LiteRed`Private`x] === List, LiteRed`Private`eqs = ReplaceAll[
              OptionValue[LiteRed`IBPReduce][
               Map[
               LiteRed`Dinv[LiteRed`Private`mis, #]& , LiteRed`Private`x]], 
              LiteRed`Private`tomis]; 
           LiteRed`Private`Mi = 
            Map[Outer[Coefficient, #, LiteRed`Private`mis]& , 
              LiteRed`Private`eqs], LiteRed`Private`eqs = ReplaceAll[
              OptionValue[LiteRed`IBPReduce][
               LiteRed`Dinv[LiteRed`Private`mis, LiteRed`Private`x]], 
              LiteRed`Private`tomis]; 
           LiteRed`Private`Mi = 
            Outer[Coefficient, LiteRed`Private`eqs, LiteRed`Private`mis]]; 
         If[
           Not[
            MatchQ[
             Flatten[
              LiteRed`Collectj[
              LiteRed`Private`eqs - Dot[
               LiteRed`Private`Mi, LiteRed`Private`mis], Factor]], {
              Repeated[0]}]], 
           Message[
            MessageName[LiteRed`MakeDSystem, "err"], LiteRed`Private`mis]]; 
         If[Head[LiteRed`Private`x] === List, 
           Thread[LiteRed`Private`x -> LiteRed`Private`Mi], LiteRed`Private`x -> 
           LiteRed`Private`Mi]]}], "SubValues" -> None, "DefaultValues" -> 
    None, "NValues" -> None, "FormatValues" -> None, 
    "Options" -> {LiteRed`IBPReduce -> LiteRed`IBPReduce}, "Attributes" -> {},
