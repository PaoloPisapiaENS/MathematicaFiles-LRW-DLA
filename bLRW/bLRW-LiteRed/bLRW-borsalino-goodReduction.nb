              System`InformationDump`open$$, True],
             Evaluator->Automatic,
             FrameMargins->{{9, 0}, {0, 0}},
             ImageMargins->0,
             ImageSize->Full,
             Method->"Preemptive"],
            
            EventHandlerTag[{
             "MouseEntered" :> 
              FEPrivate`Set[System`InformationDump`mouseOver$$, True], 
              "MouseExited" :> 
              FEPrivate`Set[System`InformationDump`mouseOver$$, False], 
              Method -> "Preemptive", PassEventsDown -> Automatic, 
              PassEventsUp -> True}]],
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False], "\[SpanFromLeft]"}
        },
        AutoDelete->False,
        FrameStyle->Directive[
          GrayLevel[0.8], 
          Thickness[Tiny]],
        GridBoxAlignment->{"Columns" -> {Left, Right}, "Rows" -> {{Center}}},
        GridBoxDividers->{
         "Columns" -> {{None}}, "Rows" -> {False, {True}, False}},
        GridBoxItemSize->{
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
       "Grid"]}, Dynamic[System`InformationDump`open$$],
      BaselinePosition->Baseline,
      FrameMargins->0,
      ImageSize->Automatic],
     DynamicModuleValues:>{}],
    BaseStyle->"InformationGridFrame",
    StripOnInput->False], "InformationGridPlain",
   StripOnInput->False],
  InformationData[<|
   "ObjectType" -> "Symbol", "Usage" -> 
    "Collectj[\[ScriptE]\[ScriptX]\[ScriptP]\[ScriptR],\[ScriptF]] collects \
the \[ScriptE]\[ScriptX]\[ScriptP]\[ScriptR] with respect to j[\[Ellipsis]] \
applying the function \[ScriptF] to the coefficient.\n \nCollectj[\[ScriptE]\
\[ScriptX]\[ScriptP]\[ScriptR]] does the same with \[ScriptF] taken from the \
option \"SimplifyFunction\" of Collectj.", "Documentation" -> None, 
    "OwnValues" -> None, "UpValues" -> None, "DownValues" -> 
    Information`InformationValueForm[
     DownValues, LiteRed`Collectj, {LiteRed`Collectj[
         Pattern[LiteRed`Private`expr, 
          Blank[List]], 
         Pattern[LiteRed`Private`x, 
          BlankNullSequence[]]] :> 
       Map[LiteRed`Collectj[#, LiteRed`Private`x]& , LiteRed`Private`expr], 
       LiteRed`Collectj[
         Pattern[LiteRed`Private`expr, 
          Alternatives[
           Blank[Rule], 
           Blank[RuleDelayed]]], 
         Pattern[LiteRed`Private`x, 
          BlankNullSequence[]]] :> 
       MapAt[LiteRed`Collectj[#, LiteRed`Private`x]& , LiteRed`Private`expr, 
         2], LiteRed`Collectj[
         Pattern[LiteRed`Private`expr, 
          Blank[]], 
         OptionsPattern[]] :> 
       Module[{LiteRed`Private`sf, LiteRed`Private`sa, 
          LiteRed`Private`freeterm, LiteRed`Private`jterms, 
          LiteRed`Private`csow, LiteRed`Private`jpat}, ReleaseHold[
           ReplaceAll[
            Hold[LiteRed`Private`csow[
                Pattern[LiteRed`Private`x, 
                 Blank[Plus]], 
                Pattern[LiteRed`Private`y, 
                 Blank[]]] := 
              Map[LiteRed`Private`csow[#, LiteRed`Private`y]& , 
                LiteRed`Private`x]; Condition[
                LiteRed`Private`csow[Pattern[LiteRed`Private`x, 
                   BlankSequence[]] Pattern[LiteRed`Private`y, 
                   Blank[]], 
                 Pattern[LiteRed`Private`z, 
                  Blank[]]], 
                FreeQ[{LiteRed`Private`x}, LiteRed`Private`jpat]] := 
              LiteRed`Private`csow[
               LiteRed`Private`y, LiteRed`Private`x LiteRed`Private`z]; 
             LiteRed`Private`csow[
                Pattern[LiteRed`Private`x, LiteRed`Private`jpat], 
                Pattern[LiteRed`Private`y, 
                 Blank[]]] := (Sow[LiteRed`Private`y, LiteRed`Private`x]; 0); 
             LiteRed`Private`csow[0, 
                Pattern[LiteRed`Private`y, 
                 Blank[]]] := 0; LiteRed`Private`csow[PatternTest[
                  Pattern[LiteRed`Private`x, 
                   BlankSequence[]], FreeQ[#, LiteRed`Private`jpat]& ] 
                Pattern[LiteRed`Private`y, 
                  Blank[]], 
                Pattern[LiteRed`Private`z, 
                 Blank[]]] := 
              LiteRed`Private`csow[
               LiteRed`Private`y, LiteRed`Private`x LiteRed`Private`z]; 
             LiteRed`Private`csow[
                Pattern[LiteRed`Private`x, 
                 Blank[]], 
                Pattern[LiteRed`Private`y, 
                 Blank[]]] := LiteRed`Private`x LiteRed`Private`y], 
            LiteRed`Private`jpat -> OptionValue[LiteRed`jPattern]]]; {
           LiteRed`Private`sf, LiteRed`Private`sa} = {
            OptionValue[LiteRed`SimplifyFunction], 
            OptionValue[LiteRed`SimplifyAlways]}; {
           LiteRed`Private`freeterm, LiteRed`Private`jterms} = Reap[
            LiteRed`Private`csow[LiteRed`Private`expr, 1], 
            Blank[LiteRed`j], {#, #2}& ]; If[LiteRed`Private`freeterm =!= 0, 
           Message[
            MessageName[LiteRed`Collectj, "nonuniform"], 
            LiteRed`Private`freeterm]]; LiteRed`Private`freeterm + Apply[Plus, 
            MapApply[# If[LiteRed`Private`sa, 
               LiteRed`Private`sf[
                Apply[Plus, #2]], 
               If[Length[#2] == 1, 
                First[#2], 
                LiteRed`Private`sf[
                 Apply[Plus, #2]]]]& , LiteRed`Private`jterms]]], 
       LiteRed`Collectj[
         Pattern[LiteRed`Private`expr, 
          Blank[]], 
         Pattern[LiteRed`Private`f, 
          Blank[]], 
         Pattern[LiteRed`Private`opts, 
          RepeatedNull[
           Alternatives[
            Blank[Rule], 
            Blank[RuleDelayed]]]]] :> 
       LiteRed`Collectj[
        LiteRed`Private`expr, LiteRed`SimplifyFunction -> LiteRed`Private`f, 
         LiteRed`Private`opts]}], "SubValues" -> None, "DefaultValues" -> 
    None, "NValues" -> None, "FormatValues" -> None, 
    "Options" -> {LiteRed`SimplifyFunction -> (Cancel[
        Together[#]]& ), LiteRed`SimplifyAlways -> True, LiteRed`jPattern -> 
      Blank[LiteRed`j]}, "Attributes" -> {}, "FullName" -> 
    "LiteRed`Collectj"|>, False]]], "Print",
 CellTags->
  "Info-839e9293-bea6-4f45-a7e9-61863e214418",ExpressionUUID->"dfd5ba0c-9d16-\
be49-bd44-b929feffce62"]
}, Open  ]]
