Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "borsalinoGradient", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Timing", "[", 
  RowBox[{"NewDsBasis", "[", 
   RowBox[{"borsalinoGradient", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"sp", "[", 
       RowBox[{
        RowBox[{"p", "+", "k"}], ",", 
        RowBox[{"p", "-", "q"}]}], "]"}], ",", "l", ",", 
      RowBox[{"l", "+", "k"}], ",", "p", ",", 
      RowBox[{"p", "+", "k"}], ",", "q", ",", 
      RowBox[{"p", "-", "q"}], ",", 
      RowBox[{"l", "-", "q"}], ",", 
      RowBox[{"l", "-", "p"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"l", ",", "p", ",", "q"}], "}"}], ",", 
    RowBox[{"AnalyzeSectors", "->", 
     RowBox[{"{", 
      RowBox[{"0", ",", "__"}], "}"}]}], 
    RowBox[{"(*", 
     RowBox[{"This", " ", "means", " ", "that", " ", "the", " ", "first", " ", 
      RowBox[{"entry", ":", " ", 
       RowBox[{
        RowBox[{"sp", "[", 
         RowBox[{
          RowBox[{"p", "+", "k"}], ",", 
          RowBox[{"p", "-", "q"}]}], "]"}], " ", "corresponds", " ", "to", 
        " ", "a", " ", "numerator"}]}]}], "*)"}], ",", 
    RowBox[{"Append", "->", "True"}], ",", 
    RowBox[{"Directory", "\[Rule]", "\"\<Bases/borsalinoGradient\>\""}], ",", 
    
    RowBox[{"SolvejSector", "\[Rule]", "True"}]}], "]"}], "]"}]}], "Input",
