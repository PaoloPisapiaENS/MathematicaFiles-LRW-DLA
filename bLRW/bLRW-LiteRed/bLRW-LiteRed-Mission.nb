Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "Diagram\[Epsilon]Expansion", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Diagram\[Epsilon]Expansion", "[", "\"\<hat\>\"", "]"}], "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"2", " ", 
      SuperscriptBox["\[Epsilon]", "2"]}]], "+", 
    FractionBox["1", 
     RowBox[{"4", "\[Epsilon]"}]], "+", 
    RowBox[{
     FractionBox[
      RowBox[{"1", "-", 
       RowBox[{"4", " ", "C3"}]}], "8"], 
     RowBox[{"HoldForm", "[", 
      SuperscriptBox["\[Epsilon]", "0"], "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Diagram\[Epsilon]Expansion", "[", "\"\<sunset\>\"", "]"}], "=", 
