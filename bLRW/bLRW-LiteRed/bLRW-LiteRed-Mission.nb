Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "myMission5", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Timing", "[", 
  RowBox[{"NewDsBasis", "[", 
   RowBox[{"myMission5", ",", 
    RowBox[{"{", 
     RowBox[{"k1", ",", 
      RowBox[{"sp", "[", 
       RowBox[{"k1", "+", "p1"}], "]"}], ",", 
      RowBox[{"sp", "[", 
       RowBox[{"k1", "-", "p2"}], "]"}], ",", 
      RowBox[{"sp", "[", 
       RowBox[{"k1", "+", "k2"}], "]"}], ",", 
      RowBox[{"sp", "[", "k2", "]"}], ",", 
      RowBox[{"sp", "[", 
       RowBox[{"k2", "+", "p2"}], "]"}], ",", 
      RowBox[{"sp", "[", 
       RowBox[{"k2", "-", "p1"}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"k1", ",", "k2"}], "}"}], 
    RowBox[{"(*", 
     RowBox[{
     "This", " ", "means", " ", "that", " ", "the", " ", "last", " ", 
      "entries", " ", "are", " ", "irreducible", " ", "numerators"}], "*)"}], 
    ",", 
    RowBox[{"Append", "->", "True"}], ",", 
