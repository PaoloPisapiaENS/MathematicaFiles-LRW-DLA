Cell[BoxData[{
 RowBox[{
  RowBox[{"FS", "=", "FullSimplify"}], ";"}], "\n", 
 RowBox[{"SetDirectory", "[", 
  RowBox[{"NotebookDirectory", "[", "]"}], "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"$Post", "=", 
    RowBox[{"Function", "[", 
     RowBox[{"expr", ",", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"nbFile", "=", 
           RowBox[{"Quiet", "[", 
            RowBox[{"NotebookFileName", "[", "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Head", "[", "nbFile", "]"}], "===", "String"}], ",", 
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"safeDate", "=", 
                RowBox[{"StringReplace", "[", 
                 RowBox[{
                  RowBox[{"DateString", "[", "\"\<ISODateTime\>\"", "]"}], 
                  ",", 
                  RowBox[{"\"\<:\>\"", "->", "\"\<-\>\""}]}], "]"}]}], ",", 
               RowBox[{"baseName", "=", 
                RowBox[{"StringReplace", "[", 
                 RowBox[{"nbFile", ",", 
                  RowBox[{"\"\<.nb\>\"", "->", "\"\<\>\""}]}], "]"}]}]}], 
              "}"}], ",", 
             RowBox[{"(*", 
              RowBox[{"Changing", " ", "extension", " ", 
               RowBox[{"to", ".", "wl"}], " ", "and", " ", "format", " ", 
               "specification", " ", "to", " ", "\"\<WL\>\""}], "*)"}], 
             RowBox[{"With", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"backupPath", "=", 
                 RowBox[{
                 "baseName", "<>", "\"\<_backup_\>\"", "<>", "safeDate", 
                  "<>", "\"\<.wl\>\""}]}], "}"}], ",", 
               RowBox[{"Quiet", "[", 
                RowBox[{"Export", "[", 
                 RowBox[{"backupPath", ",", 
                  RowBox[{"EvaluationNotebook", "[", "]"}], ",", 
                  "\"\<WL\>\""}], "]"}], "]"}]}], "]"}]}], "]"}]}], "]"}]}], 
        "]"}], ";", "\[IndentingNewLine]", "expr"}]}], "]"}]}], ";"}], 
