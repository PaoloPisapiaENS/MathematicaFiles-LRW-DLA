                    RowBox[{"StringJoin", "@@", 
                    RowBox[{"ToString", "/@", "LiteRed`Private`frame"}]}], 
                    ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"{\"", "\[Rule]", "\"(\""}], ",", 
                    RowBox[{"\"}\"", "\[Rule]", "\")\""}], ",", 
                    RowBox[{"\" \"", "\[Rule]", "\"\""}]}], "}"}]}], "]"}], 
