  InformationData[<|
   "ObjectType" -> "Symbol", "Usage" -> 
    "jGraphFeynMP[j[...]] produces feynmp graph. See Options[jGraphFeynMP].", 
    "Documentation" -> None, "OwnValues" -> None, "UpValues" -> None, 
    "DownValues" -> 
    Information`InformationValueForm[
     DownValues, LiteRed`jGraphFeynMP, {LiteRed`jGraphFeynMP[
         Pattern[LiteRed`Private`jj, 
          Blank[LiteRed`j]], 
         OptionsPattern[]] :> 
       Module[{LiteRed`Private`jgraph = LiteRed`jGraph[LiteRed`Private`jj], 
          LiteRed`Private`vs, LiteRed`Private`left, LiteRed`Private`right, 
          LiteRed`Private`edge, LiteRed`Private`begin, LiteRed`Private`part1, 
          LiteRed`Private`part2, LiteRed`Private`part3, LiteRed`Private`end, 
          LiteRed`Private`t = 0, LiteRed`Private`dn = 0, 
          LiteRed`Private`frame, LiteRed`Private`title, 
          LiteRed`Private`multirules}, LiteRed`Private`left = Replace[
            OptionValue[Left], Automatic -> Cases[
              Part[LiteRed`Private`jgraph, All, 1, 1], 
              PatternTest[
               Blank[], Negative]]]; LiteRed`Private`right = Replace[
            OptionValue[Right], Automatic -> Cases[
              Part[LiteRed`Private`jgraph, All, 1, 2], 
              PatternTest[
               Blank[], Negative]]]; LiteRed`Private`vs = Complement[
            Apply[Union, 
             MapApply[List, 
              Part[LiteRed`Private`jgraph, All, 1]]], LiteRed`Private`left, 
            LiteRed`Private`right]; 
         LiteRed`Private`left = MapIndexed[# -> "i" <> ToString[
               First[#2]]& , LiteRed`Private`left]; 
         LiteRed`Private`right = MapIndexed[# -> "o" <> ToString[
               First[#2]]& , LiteRed`Private`right]; 
         LiteRed`Private`vs = MapIndexed[# -> "v" <> ToString[
               First[#2]]& , LiteRed`Private`vs]; {
          LiteRed`Private`left, LiteRed`Private`right, LiteRed`Private`vs}; 
         LiteRed`Private`jgraph = MapAt[ReplaceAll[
             Apply[List, #], 
             Join[
             LiteRed`Private`left, LiteRed`Private`right, 
              LiteRed`Private`vs]]& , LiteRed`Private`jgraph, {All, 1}]; {
           LiteRed`Private`part1, LiteRed`Private`part2} = 
          Reap["\\fmfleft{" <> StringRiffle[
              Map[Last, LiteRed`Private`left], ","] <> "}\n  " <> 
            "\\fmfright{" <> StringRiffle[
              Map[Last, LiteRed`Private`right], ","] <> "}\n  " <> 
            StringRiffle[
              MapApply[(LiteRed`Private`edge = "\\fmf{" <> ReplaceAll[
                   Part[#2, 1], 
                   OptionValue[EdgeStyle]] <> ",tag=" <> ToString[
                   PreIncrement[LiteRed`Private`t]] <> "}{" <> 
                 StringRiffle[#, ","] <> "}"; If[Part[#2, 2] > 0, 
                 Sow[
                 "\\fmfvsp[" <> ToString[LiteRed`Private`t] <> "]{" <> 
                  StringRiffle[#, ","] <> "}{" <> StringRiffle[
                    Table["d" <> ToString[
                    PreIncrement[LiteRed`Private`dn]], {
                    Part[#2, 2]}], ","] <> "}"]]; LiteRed`Private`edge)& , 
               LiteRed`Private`jgraph], "\n  "]]; 
         LiteRed`Private`multirules = Flatten[
            Map[
             Function[LiteRed`Private`edges, 
              MapIndexed[",tag=" <> ToString[
                  Part[#, 1]] <> "}" -> ",tag=" <> ToString[
                  Part[#, 1]] <> ",left=" <> ToString[If[
                    OrderedQ[
                    Part[#, 2]], 1, -1] ((First[#2] - 1)/(
                    Length[LiteRed`Private`edges] - 1) - 0.5)] <> "}"& , 
               LiteRed`Private`edges]], 
             Select[
              GatherBy[
               MapIndexed[{
                 First[#2], #}& , 
                Part[LiteRed`Private`jgraph, All, 1]], Union[
                Last[#]]& ], Length[#] > 1& ]]]; 
         LiteRed`Private`part1 = 
          StringReplace[LiteRed`Private`part1, LiteRed`Private`multirules]; 
         If[LiteRed`Private`part2 =!= {}, LiteRed`Private`part2 = StringRiffle[
              Flatten[LiteRed`Private`part2], "\n  "] <> "\n  ", 
           LiteRed`Private`part2 = ""]; 
         If[LiteRed`Private`vs =!= {}, LiteRed`Private`part3 = 
           "\\fmfdot{" <> StringRiffle[
              Map[Last, LiteRed`Private`vs], ","] <> "}"]; 
         If[LiteRed`Private`dn != 0, LiteRed`Private`part3 = 
           LiteRed`Private`part3 <> "\n  \\fmfdot{" <> StringRiffle[
              Array["d" <> ToString[#]& , LiteRed`Private`dn], ","] <> "}"]; 
         LiteRed`Private`begin = "\\begin{fmfgraph*}(" <> StringRiffle[
             Map[ToString, 
              OptionValue[ImageSize]], ","] <> ")\n  "; 
         LiteRed`Private`end = "\n\\end{fmfgraph*}"; If[
           MatchQ[LiteRed`Private`frame = OptionValue[Frame], {{
              Blank[], 
              Blank[]}, {
              Blank[], 
              Blank[]}}], 
           LiteRed`Private`begin = "\\fmfframe" <> StringReplace[
               Apply[StringJoin, 
                Map[ToString, LiteRed`Private`frame]], {
               "{" -> "(", "}" -> ")", " " -> ""}] <> "{\n" <> 
             LiteRed`Private`begin; 
           LiteRed`Private`end = LiteRed`Private`end <> "\n}"; Null]; 
         LiteRed`Private`title = Replace[
            OptionValue[PlotLabel], True -> StringReplace[
              ToString[LiteRed`Private`jj, InputForm], "," -> ",,"]]; 
         If[LiteRed`Private`title =!= False, 
           LiteRed`Private`begin = 
            LiteRed`Private`begin <> "\\fmfbottom{ttl}\n  \\fmfv{l.a=-90,l=$" <> 
             LiteRed`Private`title <> "$}{ttl}\n  "; Null]; 
         LiteRed`Private`begin <> LiteRed`Private`part1 <> 
          "\n  \\fmffreeze\n  " <> LiteRed`Private`part2 <> 
          LiteRed`Private`part3 <> LiteRed`Private`end]}], "SubValues" -> 
    None, "DefaultValues" -> None, "NValues" -> None, "FormatValues" -> None, 
    "Options" -> {
     Left -> Automatic, Right -> Automatic, EdgeStyle -> {Blank[] -> "plain"},
       EdgeLabeling -> False, ImageSize -> {120, 75}, Frame -> False, 
