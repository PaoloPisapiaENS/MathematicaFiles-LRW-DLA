Cell[CellGroupData[{

Cell[TextData[{
 "Finding rules with MASSIVE basis: {sp[q+k]+m^2, sp[l]+m^2, sp[l + k]+m^2, \
sp[p]+m^2, sp[p + k]+m^2, sp[q]+m^2, sp[p - q]+m^2, sp[l - q]+m^2}\n",
 StyleBox["IT NEEDS TO ADD:  l\[CenterDot]p",
  Background->RGBColor[1, 1, 0]]
}], "Subsection",
 CellChangeTimes->{{3.7854606187281713`*^9, 3.785460624428533*^9}, {
  3.971777307239265*^9, 3.971777367425865*^9}, {3.971777412911087*^9, 
  3.971777415239109*^9}, {3.9720113046636505`*^9, 
  3.972011366453045*^9}},ExpressionUUID->"6283c118-faa7-b044-ac1c-\
3739d20aeac9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "borsalino4", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Timing", "[", 
  RowBox[{"NewDsBasis", "[", 
   RowBox[{"borsalino4", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"sp", "[", 
        RowBox[{"q", "+", "k"}], "]"}], "+", 
       RowBox[{"m", "^", "2"}]}], ",", 
      RowBox[{
       RowBox[{"sp", "[", "l", "]"}], "+", 
       RowBox[{"m", "^", "2"}]}], ",", 
      RowBox[{
       RowBox[{"sp", "[", 
        RowBox[{"l", "+", "k"}], "]"}], "+", 
       RowBox[{"m", "^", "2"}]}], ",", 
      RowBox[{
       RowBox[{"sp", "[", "p", "]"}], "+", 
       RowBox[{"m", "^", "2"}]}], ",", 
      RowBox[{
       RowBox[{"sp", "[", 
        RowBox[{"p", "+", "k"}], "]"}], "+", 
       RowBox[{"m", "^", "2"}]}], ",", 
      RowBox[{
       RowBox[{"sp", "[", "q", "]"}], "+", 
       RowBox[{"m", "^", "2"}]}], ",", 
      RowBox[{
       RowBox[{"sp", "[", 
        RowBox[{"p", "-", "q"}], "]"}], "+", 
       RowBox[{"m", "^", "2"}]}], ",", 
      RowBox[{
       RowBox[{"sp", "[", 
        RowBox[{"l", "-", "q"}], "]"}], "+", 
       RowBox[{"m", "^", "2"}]}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"l", ",", "p", ",", "q"}], "}"}], ",", 
    RowBox[{"AnalyzeSectors", "->", 
     RowBox[{"{", 
      RowBox[{"0", ",", "__"}], "}"}]}], 
    RowBox[{"(*", 
     RowBox[{"This", " ", "means", " ", "that", " ", "the", " ", "first", " ", 
      RowBox[{"entry", ":", " ", 
       RowBox[{"q", "+", 
        RowBox[{
        "k", " ", "corresponds", " ", "to", " ", "a", " ", 
         "numerator"}]}]}]}], "*)"}], ",", 
    RowBox[{"Append", "->", "True"}], ",", 
    RowBox[{"Directory", "\[Rule]", "\"\<Bases/borsalino4\>\""}], ",", 
    RowBox[{"SolvejSector", "\[Rule]", "True"}]}], "]"}], "]"}]}], "Input",
 CellChangeTimes->{{3.782707214576947*^9, 3.782707257165472*^9}, {
   3.782707289214075*^9, 3.782707306701565*^9}, {3.78453074174669*^9, 
