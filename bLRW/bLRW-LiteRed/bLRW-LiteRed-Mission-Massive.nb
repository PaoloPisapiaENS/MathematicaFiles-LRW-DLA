 RowBox[{
  RowBox[{
   RowBox[{"Diagram\[Epsilon]Expansion", "[", "\"\<hat\>\"", "]"}], "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"2", " ", 
      SuperscriptBox["\[Epsilon]", "2"]}]], "+", 
    FractionBox["1", 
     RowBox[{"4", "\[Epsilon]"}]], "+", 
    RowBox[{
     FractionBox[
      RowBox[{"1", "-", 
