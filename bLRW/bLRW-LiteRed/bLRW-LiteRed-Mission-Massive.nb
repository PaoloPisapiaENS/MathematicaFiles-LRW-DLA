 RowBox[{
  RowBox[{"ClearAll", "[", "den", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"den", "[", "name_String", "]"}], ":=", 
  RowBox[{"Print", "[", 
   RowBox[{"Style", "[", 
    RowBox[{
