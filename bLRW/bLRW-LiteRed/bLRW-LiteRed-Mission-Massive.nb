     RowBox[{"HoldForm", "[", 
      SuperscriptBox["\[Epsilon]", "0"], "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Diagram\[Epsilon]Expansion", "[", "\"\<sunset\>\"", "]"}], "=", 
