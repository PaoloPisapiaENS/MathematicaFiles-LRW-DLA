Cell[BoxData[
 InterpretationBox[
  StyleBox[
   FrameBox[
    DynamicModuleBox[{System`InformationDump`open$$ = False, 
     System`InformationDump`mouseOver$$ = False}, 
     PaneSelectorBox[{True->
      TagBox[GridBox[{
         {
          ItemBox[
           PaneBox[
            StyleBox[
             TagBox[
              TooltipBox[
               StyleBox["\<\" Symbol\"\>", "InformationRowLabel",
                StripOnInput->False],
               "\"Symbol\"",
               TooltipStyle->"TextStyling"],
              Annotation[#, "Symbol", "Tooltip"]& ], "InformationTitleText",
             StripOnInput->False,
             BaseStyle -> None],
            FrameMargins->{{4, 0}, {-1, 1}}],
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False], 
          ItemBox["\<\"\"\>",
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False]},
         {
          ItemBox[
           PaneBox[
            
            StyleBox["\<\"NewDsBasis[\\!\\(\\*\\nStyleBox[\\\"basis\\\", \
\\\"TI\\\"]\\),\\*\\nStyleBox[\\(\\!\\(\\*\\nStyleBox[\\\"denominators\\\", \
\\\"TI\\\"]\\)_List\\)],\\!\\(\\*\\nStyleBox[\\\"loopmomenta\\\", \\\"TI\\\"]\
\\)_List] determines a basis.\\nFirst argument is a name of the \
basis.\\nSecond argument is a complete set of independent denominators. \
Shortcuts are allowed here: for the massless propagator sp[l,l] just put l in \
the list. sp[a,b] stands for the scalar product of two vectors, sp[a] is a \
shortcut for sp[a,a].\\nThird argument is the list of loop \
momenta.\\nOptions:\\n    GenerateIBP\[Rule]True|False \[LongDash] determines \
whether to generate IBPs afterward,\\n    \
AnalyzeSectors\[Rule]True|False|pattern:False \[LongDash] determines whether \
to find zero sectors.\\n    FindSymmetries\[Rule]True|False \[LongDash] \
determines whether to find symmetries.\\n    Append\[Rule]False|True \
\[LongDash] determines whether to append irreducible numerators if needed.\\n \
   CutDs\[Rule]None|{1,0,\[Ellipsis]}:None \[LongDash] declares which \
denominators are cut (each 1 in the list corresponds to a cut \
denominator).\\n    PowerShifts\[Rule]{\[Nu]1,\[Ellipsis]}|None:None \
\[LongDash] determines shifts in powers of denominators (experimental).\\n    \
Directory\[Rule]False|\\!\\(\\*\\nStyleBox[\\\"dirname\\\", \\\"TI\\\"]\\) \
\[LongDash] determines the directory in which the basis is saved.\"\>", 
             "InformationUsageText",
             StripOnInput->False,
             LineSpacing->{1.5, 1.5, 3.}],
            FrameMargins->{{10, 10}, {8, 10}}],
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False], 
          ItemBox["\<\"\"\>",
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False]},
         {
          PaneBox[
           TagBox[GridBox[{
              {
               StyleBox[
                TagBox[
                 TooltipBox[
                  StyleBox["\<\" Definitions\"\>", "InformationRowLabel",
                   StripOnInput->False],
                  "\"Definitions\"",
                  TooltipStyle->"TextStyling"],
                 Annotation[#, "Definitions", "Tooltip"]& ], "DialogStyle",
                StripOnInput->False]},
              {
               TemplateBox[{"\"\[ThinSpace]\"", 
                 GridBox[{{
                    RowBox[{
                    RowBox[{"NewDsBasis", "[", 
                    RowBox[{"LiteRed`Private`nm_Symbol", ",", 
                    RowBox[{"LiteRed`Private`ds", ":", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"_", "?", "VecQ"}], "|", 
                    RowBox[{"_", "?", "NumQ"}]}], ")"}], ".."}], "}"}]}], ",", 
                    RowBox[{"LiteRed`Private`lms", ":", 
                    RowBox[{"{", 
                    RowBox[{"__", "?", "VecVarQ"}], "}"}]}], ",", 
                    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
                    RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"LiteRed`Private`d", "=", 
                    RowBox[{"MetricTensor", "[", "]"}]}], ",", 
                    "LiteRed`Private`m", ",", "LiteRed`Private`dens", ",", 
                    "LiteRed`Private`ddens", ",", "LiteRed`Private`pars", ",",
                     "LiteRed`Private`dim", ",", "LiteRed`Private`ems", ",", 
                    "LiteRed`Private`sps", ",", "LiteRed`Private`toj", ",", 
                    "LiteRed`Private`ns", ",", "LiteRed`Private`l", ",", 
                    "LiteRed`Private`gi", ",", "LiteRed`Private`as", ",", 
                    "LiteRed`Private`fs", ",", "LiteRed`Private`fes", ",", 
                    "LiteRed`Private`ss", ",", "LiteRed`Private`save", ",", 
                    "LiteRed`Private`ps", ",", "LiteRed`Private`gr"}], "}"}], 
                    ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    
                    RowBox[{"LiteRed`Private`gi", ",", "LiteRed`Private`as", 
                    ",", "LiteRed`Private`fs", ",", "LiteRed`Private`fes", 
                    ",", "LiteRed`Private`ss", ",", "LiteRed`Private`save", 
                    ",", "LiteRed`Private`ps", ",", "LiteRed`Private`gr"}], 
                    "}"}], "=", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"OptionValue", "[", "GenerateIBP", "]"}], ",", 
                    RowBox[{"OptionValue", "[", "AnalyzeSectors", "]"}], ",", 
                    
                    RowBox[{"OptionValue", "[", "FindSymmetries", "]"}], ",", 
                    
                    RowBox[{"OptionValue", "[", "FindExtSymmetries", "]"}], 
                    ",", 
                    RowBox[{"OptionValue", "[", "SolvejSector", "]"}], ",", 
                    RowBox[{"OptionValue", "[", "Directory", "]"}], ",", 
                    RowBox[{"OptionValue", "[", "PowerShifts", "]"}], ",", 
                    RowBox[{"OptionValue", "[", "AttachGraph", "]"}]}], 
                    "}"}]}], ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", 
                    RowBox[{"UpValues", "[", "LiteRed`Private`nm", "]"}], 
                    "]"}], ">", "0"}], ",", 
                    RowBox[{
                    RowBox[{"Message", "[", 
                    RowBox[{
                    StyleBox[
                    RowBox[{"NewDsBasis", "::", "ovrw"}], "MessageName"], ",",
                     "LiteRed`Private`nm"}], "]"}], ";", 
                    RowBox[{"Clear", "[", "LiteRed`Private`nm", "]"}]}]}], 
                    "]"}], ";", 
                    RowBox[{
                    RowBox[{"CurrentState", "[", 
                    RowBox[{"LiteRed`Private`nm", ",", 
                    RowBox[{"{", 
                    
                    RowBox[{"SolvejSector", ",", "FindSymmetries", ",", 
                    "AnalyzeSectors", ",", "GenerateIBP", ",", "NewDsBasis"}],
                     "}"}]}], "]"}], "=", "False"}], ";", 
                    RowBox[{
                    
                    RowBox[{"SectorsPattern", "[", "LiteRed`Private`nm", 
                    "]"}], "^=", 
                    RowBox[{"Replace", "[", 
                    RowBox[{"LiteRed`Private`as", ",", 
                    RowBox[{
                    RowBox[{"True", "|", "False"}], "\[Rule]", 
                    RowBox[{"OptionValue", "[", "SectorsPattern", "]"}]}]}], 
                    "]"}]}], ";", 
                    RowBox[{"LiteRed`Private`as", "=", 
                    RowBox[{"!", 
                    RowBox[{"TrueQ", "[", 
                    RowBox[{"!", "LiteRed`Private`as"}], "]"}]}]}], ";", 
                    RowBox[{"LiteRed`Private`dens", "=", 
                    RowBox[{"Replace", "[", 
                    RowBox[{"LiteRed`Private`ds", ",", 
                    RowBox[{
                    RowBox[{"LiteRed`Private`x_", "?", "VecQ"}], 
                    "\[RuleDelayed]", 
                    RowBox[{"sp", "[", 
                    RowBox[{"LiteRed`Private`x", ",", "LiteRed`Private`x"}], 
                    "]"}]}], ",", 
                    RowBox[{"{", "1", "}"}]}], "]"}]}], ";", 
                    RowBox[{"LiteRed`Private`ems", "=", 
                    RowBox[{"Replace", "[", 
                    RowBox[{
                    RowBox[{"OptionValue", "[", "EMs", "]"}], ",", 
                    RowBox[{"Automatic", "\[RuleDelayed]", 
                    RowBox[{"Complement", "[", 
                    RowBox[{
                    RowBox[{"Union", "[", 
                    RowBox[{"Cases", "[", 
                    RowBox[{"LiteRed`Private`dens", ",", 
                    RowBox[{"_", "?", "VecVarQ"}], ",", "\[Infinity]"}], 
                    "]"}], "]"}], ",", "LiteRed`Private`lms"}], "]"}]}]}], 
                    "]"}]}], ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Factor", "[", 
                    RowBox[{"GramDeterminant", "[", "]"}], "]"}], "===", 
                    "0"}], ",", 
                    RowBox[{"Message", "[", 
                    RowBox[{
                    StyleBox[
                    RowBox[{"NewDsBasis", "::", "ems"}], "MessageName"], ",", 
                    "LiteRed`Private`ems"}], "]"}]}], "]"}], ";", 
                    RowBox[{"LiteRed`Private`sps", "=", 
                    RowBox[{"Union", "@@", 
                    RowBox[{"Outer", "[", 
