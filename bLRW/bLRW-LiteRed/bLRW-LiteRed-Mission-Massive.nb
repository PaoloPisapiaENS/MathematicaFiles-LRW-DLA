           LiteRed`Private`ddens = 
            Join[LiteRed`Private`ddens, LiteRed`Private`ns]; 
           LiteRed`Private`dim = Length[LiteRed`Private`sps]; 
           LiteRed`Private`LiteRedPrint["Irreducible numerator(s) appended: ", 
