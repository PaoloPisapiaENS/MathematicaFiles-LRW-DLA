         LiteRed`Private`ddens = Expand[
            LinearFunctions`LFDistribute[LiteRed`Private`dens, Vectors`sp]]; 
         LiteRed`Private`dim = Length[LiteRed`Private`dens]; 
         LiteRed`Private`m = 
          Outer[Coefficient, LiteRed`Private`ddens, LiteRed`Private`sps]; 
         LiteRed`Private`ns = MatrixRank[LiteRed`Private`m]; 
         If[LiteRed`Private`ns < LiteRed`Private`dim, Message[
             MessageName[LiteRed`NewDsBasis, "notb"]]; Abort[]]; 
         LiteRed`Private`ns = 
          Length[LiteRed`Private`sps] - LiteRed`Private`ns; 
         If[LiteRed`Private`ns > 0, LiteRed`Private`ns = Dot[
