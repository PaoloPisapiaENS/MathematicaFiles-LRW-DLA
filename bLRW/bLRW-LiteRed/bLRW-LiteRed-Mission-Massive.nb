            LiteRed`Private`ps, {
             None -> ConstantArray[0, LiteRed`Private`dim]}], 
            LiteRed`Private`dim]; LiteRed`Private`pars = Join[
            Complement[
             Variables[{
               Cases[
                Variables[LiteRed`Private`ddens], 
                PatternTest[
                 Blank[], FreeQ[#, 
                  Apply[Alternatives, LiteRed`Private`lms]]& ]], 
               Outer[Vectors`sp, LiteRed`Private`ems, LiteRed`Private`ems], 
               LiteRed`Private`ps}], 
             Variables[{LiteRed`Private`d}]], 
            Variables[{LiteRed`Private`d}]]; UpSet[
           LiteRed`SectorsPattern[LiteRed`Private`nm], 
           Replace[
            LiteRed`SectorsPattern[LiteRed`Private`nm], Automatic -> {
              BlankNullSequence[], 
              Apply[Sequence, 
               ConstantArray[0, 
                Length[LiteRed`Private`ns]]]}]]; {LiteRed`Private`toj} = Solve[
            MapIndexed[# == Apply[LiteRed`j[LiteRed`Private`nm, 
                SlotSequence[1]]& , -
               IntegerDigits[
                2^(LiteRed`Private`dim - First[#2]), 2, 
                 LiteRed`Private`dim]]& , LiteRed`Private`ddens], 
            LiteRed`Private`sps]; TagSet[LiteRed`Private`nm, 
           LiteRed`Ds[LiteRed`Private`nm], LiteRed`Private`dens]; 
         TagSet[LiteRed`Private`nm, 
           LiteRed`NDs[LiteRed`Private`nm], LiteRed`Private`dim]; 
         TagSet[LiteRed`Private`nm, 
           LiteRed`SPs[LiteRed`Private`nm], LiteRed`Private`sps]; 
         TagSet[LiteRed`Private`nm, 
           LiteRed`LMs[LiteRed`Private`nm], LiteRed`Private`lms]; 
         TagSet[LiteRed`Private`nm, 
           LiteRed`EMs[LiteRed`Private`nm], LiteRed`Private`ems]; 
         TagSet[LiteRed`Private`nm, 
           LiteRed`Toj[LiteRed`Private`nm], LiteRed`Private`toj]; 
         TagSet[LiteRed`Private`nm, 
           LiteRed`Parameters[LiteRed`Private`nm], LiteRed`Private`pars]; 
         TagSet[LiteRed`Private`nm, 
           LiteRed`jsOrder[LiteRed`Private`nm], 
           OptionValue[LiteRed`jsOrder]]; 
         LiteRed`jSector[LiteRed`Private`nm] = Apply[LiteRed`js, 
            Prepend[
             ConstantArray[1, LiteRed`Private`dim], LiteRed`Private`nm]]; 
         UpSet[
           LiteRed`MIs[LiteRed`Private`nm], {}]; Quiet[
           TagUnset[LiteRed`Private`nm, 
            LiteRed`ToMyMIs[LiteRed`Private`nm]]]; UpSet[
           LiteRed`SR[LiteRed`Private`nm], 
           Module[{LiteRed`Private`jsc = LiteRed`jSector[
               LiteRed`j[LiteRed`Private`nm, 
                SlotSequence[1]]]}, 
            If[
             MemberQ[
              LiteRed`UniqueSectors[LiteRed`Private`nm], LiteRed`Private`jsc], 
             DeleteCases[
              DeleteDuplicates[
               LiteRed`Collectj[LiteRed`j[LiteRed`Private`nm, 
                  SlotSequence[1]] - ReplaceAll[
                 LiteRed`j[LiteRed`Private`nm, 
                  SlotSequence[1]], 
                 Apply[LiteRed`jSymmetries, LiteRed`Private`jsc]]]], 
              0], {}]]& ]; LiteRed`Private`l = DeleteCases[
            MapApply[{
              Sort[{
                SlotSequence[1]}], 
              Replace[
               Vectors`sp[
                SlotSequence[1]], Vectors`sp -> List, {1}, Heads -> True]}& , 
             
             Replace[
              Subsets[LiteRed`Private`ems, {1, 2}], {
                Pattern[LiteRed`Private`x, 
                 Blank[]]} :> {LiteRed`Private`x, LiteRed`Private`x}, {1}]], {
            
             Pattern[LiteRed`Private`l, 
              Blank[]], 
             Pattern[LiteRed`Private`l, 
              Blank[]]}]; UpSet[
           LiteRed`Definitions[LiteRed`Private`nm], 
           Flatten[{
             If[
              AtomQ[
               Vectors`MetricTensor[]], 
              (Hold[Vectors`MetricTensor[] === #, 
               Vectors`SetDim[#]]& )[
               Vectors`MetricTensor[]], 
              Unevaluated[
               Sequence[]]], 
             Map[Hold[
               Vectors`VecQ[#], 
               Types`Declare[#, Vectors`Vector]]& , 
              Join[LiteRed`Private`lms, LiteRed`Private`ems]], 
             MapApply[Hold[LiteRed`Private`ExpresionType[#] === #2, 
               Types`Declare[#, #2]]& , 
              Map[{#, 
                LiteRed`Private`ExpresionType[#]}& , 
               Select[
                Variables[LiteRed`Private`l], AtomQ]]], 
             Replace[LiteRed`Private`l, {{
                 Pattern[LiteRed`Private`x, 
                  Blank[]], 
                 Pattern[LiteRed`Private`y, 
                  Blank[]]}, 
                Pattern[LiteRed`Private`z, 
                 Blank[]]} :> 
              Hold[Vectors`sp[LiteRed`Private`x, LiteRed`Private`y] === 
                LiteRed`Private`z, 
                Vectors`sp[LiteRed`Private`x, LiteRed`Private`y] = 
                LiteRed`Private`z], {1}]}]]; UpSet[
           LiteRed`PowerShifts[LiteRed`Private`nm], LiteRed`Private`ps]; UpSet[
           LiteRed`CutDs[LiteRed`Private`nm], 
           Replace[
            OptionValue[LiteRed`CutDs], {
            None -> ConstantArray[0, LiteRed`Private`dim], Automatic :> 
             LiteRed`Private`cutds[
               LiteRed`SectorsPattern[LiteRed`Private`nm], 
               LiteRed`Private`dim], Pattern[LiteRed`Private`l, {
                RepeatedNull[
                 Alternatives[0, 1]]}] :> 
             PadRight[LiteRed`Private`l, LiteRed`Private`dim], 
             Pattern[LiteRed`Private`l, {
                PatternTest[
                 Blank[Integer], Positive]}] :> ReplacePart[
               ConstantArray[0, LiteRed`Private`dim], 
               Thread[Map[List, LiteRed`Private`l] -> 1]]}]]; UpSet[
           LiteRed`SectorsPattern[LiteRed`Private`nm], 
           ReplaceAll[
            LiteRed`SectorsPattern[LiteRed`Private`nm], 1 -> Blank[]]]; 
         MessageName[LiteRed`Private`nm, "usage"] = ToString[
             Length[LiteRed`Private`lms]] <> "-loop basis with " <> ToString[
             Length[LiteRed`Private`ems]] <> 
           " external momenta.\nUse Information[" <> 
           ToString[LiteRed`Private`nm] <> 
           "] to get basis summary.\nThis string can be redefined by setting \
" <> ToString[LiteRed`Private`nm] <> "::usage=\"\[Ellipsis]\""; 
         TagSetDelayed[LiteRed`Private`nm, 
           Information[LiteRed`Private`nm], If[
             ValueQ[
              MessageName[LiteRed`Private`nm, "usage"]], 
             Information[LiteRed`Private`nm, LongForm -> False]]; Print[
             Grid[
              Partition[
               Union[
                Replace[
                 Replace[
                  ReplaceAll[
                   Map[First, 
                    UpValues[LiteRed`Private`nm]], HoldPattern -> HoldForm], {
                  HoldPattern[
                    HoldForm[
                    Pattern[LiteRed`Private`f, 
                    Blank[]][LiteRed`Private`nm, 
                    BlankSequence[]]]] :> HoldForm[
                    LiteRed`Private`f[LiteRed`Private`nm, "\[Ellipsis]"]]}, {
                  1}], {HoldPattern[
                    Pattern[LiteRed`Private`x, 
                    HoldForm[
                    Pattern[LiteRed`Private`f, 
                    Blank[]][LiteRed`Private`nm, 
                    BlankNullSequence[]]]]] :> 
                  Button[LiteRed`Private`x, (SelectionMove[
                    ButtonNotebook[], All, GeneratedCell]; NotebookDelete[]; 
                    Information[
                    Evaluate[
                    Part[LiteRed`Private`x, 1, 0]], LongForm -> False]; 
                    Print[
                    TableForm[
                    ReplaceAll[
                    Cases[
                    UpValues[LiteRed`Private`nm], 
                    Condition[
                    HoldPattern[Pattern[LiteRed`Private`a, 
                    Blank[]] :> Pattern[LiteRed`Private`b, 
                    Blank[]]], 
                    MatchQ[
                    Part[LiteRed`Private`a, 1, 0], 
                    Part[LiteRed`Private`x, 1, 0]]]], HoldPattern -> 
                    HoldForm]]])& , Appearance -> "Frameless", BaseStyle -> 
                    "InformationLink"]}, {1}]], 5], DefaultBaseStyle -> 
              "InfoGrid"]]]; LiteRed`Private`nm[LiteRed`j, 
            Pattern[LiteRed`Private`inds, 
             BlankSequence[]]] := 
          LiteRed`j[LiteRed`Private`nm, LiteRed`Private`inds]; 
         LiteRed`Private`nm[LiteRed`js, 
            Pattern[LiteRed`Private`inds, 
             BlankSequence[]]] := 
          LiteRed`js[LiteRed`Private`nm, LiteRed`Private`inds]; 
         SyntaxInformation[LiteRed`Private`nm] = {
           "ArgumentsPattern" -> ConstantArray[
              Blank[], Length[LiteRed`Private`dens] + 1]}; UpSet[
           LiteRed`DsBasisQ[LiteRed`Private`nm], True]; UpSet[
           LiteRed`MappedSectors[LiteRed`Private`nm], {}]; UpSet[
           LiteRed`SectorsMappings[LiteRed`Private`nm], {}]; UpSet[
           LiteRed`ExtMappedSectors[LiteRed`Private`nm], {}]; UpSet[
           LiteRed`ExtSectorsMappings[LiteRed`Private`nm], {}]; (
          LiteRed`Private`LiteRedPrint[# <> " is valid basis." <> 
           If[LiteRed`Private`save =!= False, 
             " The definitions of the basis will be saved in \"" <> 
             LiteRed`Private`save <> "\" directory.", ""] <> "\n    Ds[" <> # <> 
           "] \[LongDash] denominators,\n    SPs[" <> # <> 
           "] \[LongDash] scalar products involving loop momenta,\n    LMs[" <> \
# <> "] \[LongDash] loop momenta,\n    EMs[" <> # <> 
           "] \[LongDash] external momenta,\n    Parameters[" <> # <> 
           "] \[LongDash] parameters (invariants, masses, dimension),\n    \
Toj[" <> # <> 
           "] \[LongDash] rules to transform scalar products to denominators,\
\n    CutDs[" <> # <> "] \[LongDash] flag vector of cut denominators."]& )[
           ToString[LiteRed`Private`nm]]; 
         LiteRed`CurrentState[LiteRed`Private`nm, LiteRed`NewDsBasis] = True; 
         If[LiteRed`Private`save =!= False, 
           LiteRed`BasisDirectory[LiteRed`Private`nm] = LiteRed`Private`save; 
           LiteRed`DiskSave[LiteRed`Private`nm, Save -> "Basis"]]; If[
           MatchQ[LiteRed`Private`gr, 
            Alternatives[
             HoldPattern[LiteRed`js[LiteRed`Private`nm, 
                BlankNullSequence[]] -> Blank[]], 
             HoldPattern[{
               Repeated[LiteRed`js[LiteRed`Private`nm, 
                  BlankNullSequence[]] -> Blank[]]}]]], 
           MapApply[LiteRed`AttachGraph[#, #2]& , 
            Flatten[{LiteRed`Private`gr}]]]; If[
           TrueQ[
            Or[
            LiteRed`Private`ss, LiteRed`Private`fs, LiteRed`Private`as, 
             LiteRed`Private`gi]], LiteRed`Private`LiteRedPrint[
             Style["Generating IBP\[Ellipsis]", Bold]]; 
           LiteRed`GenerateIBP[LiteRed`Private`nm]]; If[
           TrueQ[
            Or[LiteRed`Private`ss, LiteRed`Private`fs, LiteRed`Private`as]], 
           LiteRed`Private`LiteRedPrint[
             Style["Analyzing sectors\[Ellipsis]", Bold]]; 
           LiteRed`AnalyzeSectors[LiteRed`Private`nm]]; If[
           TrueQ[
            Or[LiteRed`Private`ss, LiteRed`Private`fs]], If[
             Not[
              TrueQ[
               Not[LiteRed`Private`fes]]], LiteRed`Private`LiteRedPrint[
               Style["Finding external symmetries\[Ellipsis]", Bold]]; 
             Apply[LiteRed`FindExtSymmetries[LiteRed`Private`nm, 
                SlotSequence[1]]& , 
               Replace[LiteRed`Private`fes, True -> LiteRed`$ActiveBases]]; 
             Null]; LiteRed`Private`LiteRedPrint[
             Style["Finding symmetries\[Ellipsis]", Bold]]; 
           LiteRed`FindSymmetries[LiteRed`Private`nm]]; If[
           TrueQ[LiteRed`Private`ss], LiteRed`Private`LiteRedPrint[
             Style["Solving sectors\[Ellipsis]", Bold]]; 
           LiteRed`SolvejSector[LiteRed`Private`nm]]; 
         If[LiteRed`Private`save =!= False, 
           LiteRed`BasisDirectory[LiteRed`Private`nm] = LiteRed`Private`save; 
           LiteRed`DiskSave[LiteRed`Private`nm]]; LiteRed`Private`nm]}], 
    "SubValues" -> None, "DefaultValues" -> None, "NValues" -> None, 
    "FormatValues" -> None, 
    "Options" -> {
     LiteRed`GenerateIBP -> False, LiteRed`SectorsPattern -> Automatic, 
