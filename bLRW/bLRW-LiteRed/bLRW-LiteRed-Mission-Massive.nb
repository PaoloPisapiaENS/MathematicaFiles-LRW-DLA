     RowBox[{"sp", "[", "k", "]"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", 
         RowBox[{"8", "\[Epsilon]"}]]}], "-", 
       RowBox[{
        FractionBox["5", 
         RowBox[{"8", "*", "4"}]], 
        RowBox[{"HoldForm", "[", 
         SuperscriptBox["\[Epsilon]", "0"], "]"}]}]}], ")"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Diagram\[Epsilon]Expansion", "[", "expr_", "]"}], ":=", 
    RowBox[{"ReleaseHold", "[", 
     RowBox[{"Diagram\[Epsilon]Expansion", "/@", "expr"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
