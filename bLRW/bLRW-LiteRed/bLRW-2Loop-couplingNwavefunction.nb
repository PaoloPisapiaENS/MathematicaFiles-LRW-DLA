 CellLabel->
  "During evaluation of \
In[21]:=",ExpressionUUID->"6df94a2e-4fd8-7942-91ec-30ee71249ab3"],

Cell[BoxData["\<\"Found 14(2) zero(nonzero) sectors out of 16.\\n    \
ZeroSectors[hatGradient] \[LongDash] zero sectors,\\n    \
NonZeroSectors[hatGradient] \[LongDash] nonzero sectors,\\n    \
SimpleSectors[hatGradient] \[LongDash] simple sectors (no nonzero \
subsectors),\\n    BasisSectors[hatGradient] \[LongDash] basis sectors (at \
least one immediate subsector is zero),\\n    ZerojRule[hatGradient] \
\[LongDash] a rule to nullify all zero j[hatGradient\[Ellipsis]],\\n    \
CutDs[hatGradient] \[LongDash] a flag list of cut denominators \
(1=cut).\"\>"], "Print",
 CellChangeTimes->{3.9726224525581045`*^9},
 CellLabel->
  "During evaluation of \
In[21]:=",ExpressionUUID->"742585de-b376-594d-ba8f-a6f0b883c260"],

Cell[BoxData[
 StyleBox["\<\"Finding symmetries\[Ellipsis]\"\>",
  StripOnInput->False,
  FontWeight->Bold]], "Print",
 CellChangeTimes->{3.9726224533238955`*^9},
 CellLabel->
  "During evaluation of \
In[21]:=",ExpressionUUID->"099056e0-5ebd-7947-a34a-4c6362d416da"],

Cell[BoxData["\<\"Found 0 mapped sectors and 2 unique sectors.\\n    \
UniqueSectors[hatGradient] \[LongDash] unique sectors.\\n    \
MappedSectors[hatGradient] \[LongDash] mapped sectors.\\n    SR[hatGradient][\
\[Ellipsis]] \[LongDash] symmetry relations for j[hatGradient,\[Ellipsis]] \
from UniqueSectors[hatGradient].\\n    jSymmetries[hatGradient,\[Ellipsis]] \
\[LongDash] symmetry rules for the sector js[hatGradient,\[Ellipsis]] in \
UniqueSectors[hatGradient].\\n    jRules[hatGradient,\[Ellipsis]] \[LongDash] \
reduction rules for j[hatGradient,\[Ellipsis]] from \
MappedSectors[hatGradient].\\n    SectorsMappings[hatGradient] gives the list \
of mappings of all sectors from MappedSectors[hatGradient] to \
UniqueSectors[hatGradient].\"\>"], "Print",
 CellChangeTimes->{3.9726224633862066`*^9},
 CellLabel->
  "During evaluation of \
In[21]:=",ExpressionUUID->"884adf87-4b04-494d-9887-3845cf5e77c2"],

