Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "hatGradient", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Timing", "[", 
  RowBox[{"NewDsBasis", "[", 
   RowBox[{"hatGradient", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"sp", "[", 
       RowBox[{"p", ",", "k"}], "]"}], ",", "l", ",", 
      RowBox[{"l", "+", "k"}], ",", "p", ",", 
      RowBox[{"p", "+", "l"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"l", ",", "p"}], "}"}], ",", 
    RowBox[{"AnalyzeSectors", "->", 
     RowBox[{"{", 
      RowBox[{"0", ",", "__"}], "}"}]}], 
    RowBox[{"(*", 
     RowBox[{"This", " ", "means", " ", "that", " ", "the", " ", "first", " ", 
      RowBox[{"entry", ":", " ", 
       RowBox[{
        RowBox[{"sp", "[", 
         RowBox[{
          RowBox[{"p", "+", "k"}], ",", 
          RowBox[{"p", "-", "q"}]}], "]"}], " ", "corresponds", " ", "to", 
        " ", "a", " ", "numerator"}]}]}], "*)"}], ",", 
    RowBox[{"Append", "->", "True"}], ",", 
    RowBox[{"Directory", "\[Rule]", "\"\<Bases/hatGradient\>\""}], ",", 
    RowBox[{"SolvejSector", "\[Rule]", "True"}]}], "]"}], "]"}]}], "Input",
 CellChangeTimes->{{3.782707214576947*^9, 3.782707257165472*^9}, {
   3.782707289214075*^9, 3.782707306701565*^9}, {3.78453074174669*^9, 
