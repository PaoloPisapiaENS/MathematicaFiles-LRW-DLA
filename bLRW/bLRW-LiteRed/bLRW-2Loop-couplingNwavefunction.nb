Cell[BoxData["\<\"Identities are generated.\\n    IBP[hatGradient] \
\[LongDash] integration-by-part identities,\\n    LI[hatGradient] \[LongDash] \
Lorentz invariance identities.\"\>"], "Print",
 CellChangeTimes->{3.9726224494242887`*^9},
 CellLabel->
  "During evaluation of \
In[21]:=",ExpressionUUID->"cc23f639-89ab-6144-a3e4-68617bbca480"],

Cell[BoxData[
 StyleBox["\<\"Analyzing sectors\[Ellipsis]\"\>",
  StripOnInput->False,
  FontWeight->Bold]], "Print",
