Cell[CellGroupData[{

Cell[BoxData["\<\"hatGradient is valid basis. The definitions of the basis \
will be saved in \\\"Bases/hatGradient\\\" directory.\\n    Ds[hatGradient] \
\[LongDash] denominators,\\n    SPs[hatGradient] \[LongDash] scalar products \
involving loop momenta,\\n    LMs[hatGradient] \[LongDash] loop momenta,\\n   \
 EMs[hatGradient] \[LongDash] external momenta,\\n    Parameters[hatGradient] \
\[LongDash] parameters (invariants, masses, dimension),\\n    \
Toj[hatGradient] \[LongDash] rules to transform scalar products to \
denominators,\\n    CutDs[hatGradient] \[LongDash] flag vector of cut \
denominators.\"\>"], "Print",
 CellChangeTimes->{3.97262244661301*^9},
 CellLabel->
  "During evaluation of \
In[21]:=",ExpressionUUID->"a5bbedb4-7818-634f-a97a-2c8178bad161"],

