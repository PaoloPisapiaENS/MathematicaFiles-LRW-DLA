 "I  know I will have to use two ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "29f7bcca-fb18-9546-8cca-ab24cf203f5d"],
 " at 1-loop order. So, let\[CloseCurlyQuote]s set it up with two ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ba21d889-b0a5-b644-be1d-527f76c02954"],
 " at different times and space."
}], "Text",
 CellChangeTimes->{{3.962964247990719*^9, 
  3.9629643430792217`*^9}},ExpressionUUID->"0c334a0d-304b-4f4e-949f-\
b884ae43e0a3"],

