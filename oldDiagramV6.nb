              RowBox[{"[", 
               RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "->", 
            RowBox[{"path", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "3"}], "]"}], "]"}]}], "}"}]}], "]"}], 
        ";"}]}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
