Cell[TextData[{
 "I get some absurd result. ",
 StyleBox["Check that I can contract multiple g interactions at the same time",
  Background->RGBColor[1, 1, 0]]
}], "Text",
 CellChangeTimes->{{3.9610575097234974`*^9, 
  3.9610575692296867`*^9}},ExpressionUUID->"30d8579e-c894-6a4c-998c-\
5e64291e21f7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Z", "=", 
   RowBox[{"Product", "[", 
    RowBox[{
     RowBox[{"Product", "[", 
      RowBox[{
       RowBox[{"InteractingAction", "[", 
        RowBox[{
         SubscriptBox["x", "spaceIndex"], ",", "timeIndex"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"timeIndex", ",", "1", ",", "3"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"spaceIndex", ",", "0", ",", "2"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9610519003639812`*^9, 3.9610519722316*^9}, {
   3.9610521896360188`*^9, 3.9610522138020363`*^9}, {3.9610523391509*^9, 
   3.9610523531284027`*^9}, 3.961054124154028*^9, {3.9610541602868423`*^9, 
   3.9610541617367554`*^9}},
 CellLabel->
  "In[185]:=",ExpressionUUID->"19484b29-09c4-b349-9323-c7a82c65270c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TwoLoop", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"WickContractionSpaceVerticesMOD", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"V", "[", 
          RowBox[{"\[Phi]s", "[", 
           RowBox[{
            SubscriptBox["x", "0"], ",", 
            SubscriptBox["t", "1"]}], "]"}], "]"}], "*", "Z"}], ",", 
        RowBox[{"\"\<fields\>\"", "->", 
         RowBox[{"FieldsNamesGenerator", "[", 
          RowBox[{"{", 
           RowBox[{"\[Phi]", ",", "\[Chi]", ",", "\[Psi]"}], "}"}], "]"}]}], 
