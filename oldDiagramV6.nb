Cell[BoxData[
 RowBox[{"WickContractionSpaceVerticesMOD", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Phi]s", "[", 
     RowBox[{
      SubscriptBox["x", "0"], ",", 
      SubscriptBox["t", "1"]}], "]"}], 
    RowBox[{"V\[Gamma]1", "[", 
     RowBox[{
      SubscriptBox["x", "1"], ",", "1"}], "]"}], 
    RowBox[{"V\[Gamma]1", "[", 
     RowBox[{
      SubscriptBox["x", "2"], ",", "2"}], "]"}], 
    RowBox[{"V\[Psi]\[Chi]", "[", 
     RowBox[{
      SubscriptBox["x", "101"], ",", "t"}], "]"}]}], ",", 
   RowBox[{"\"\<fields\>\"", "->", 
    RowBox[{"FieldsNamesGenerator", "[", 
     RowBox[{"{", 
      RowBox[{"\[Phi]", ",", "\[Chi]", ",", "\[Psi]"}], "}"}], "]"}]}], ",", 
   " ", 
   RowBox[{"\"\<endTime\>\"", "->", "2"}], ",", 
   RowBox[{"\"\<print\>\"", "->", "False"}], ",", 
   RowBox[{"\"\<\[Delta]rule\>\"", "->", "True"}], ",", 
   RowBox[{"\"\<\[Delta]ruleExternal\>\"", "->", "True"}], ",", 
   RowBox[{"\"\<\!\(\*SubscriptBox[\(n\), \(\[Chi]\)]\)\>\"", "->", 
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}]}], ",", 
   RowBox[{"\"\<\!\(\*SubscriptBox[\(n\), \(\[Alpha]\)]\)\>\"", "->", 
    RowBox[{"(", "0", ")"}]}], ",", 
   RowBox[{"\"\<#vertices\>\"", "->", "1"}], ",", 
   RowBox[{"\"\<kill\[Psi]\>\"", "->", "True"}], ",", 
   RowBox[{"\"\<maxContractions\>\"", "->", "3"}]}], "]"}]], "Input",
