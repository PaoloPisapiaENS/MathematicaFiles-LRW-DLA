 RowBox[{
  RowBox[{"nInteractionVertices", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"AbsoluteTiming", "[", 
  RowBox[{
   RowBox[{"ThreeLoop3", "=", 
    RowBox[{"WickContractionSpaceVerticesMOD", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Phi]s", "[", 
        RowBox[{
         SubscriptBox["x", "0"], ",", 
         SubscriptBox["t", "1"]}], "]"}], 
       RowBox[{"V\[Gamma]1", "[", 
        RowBox[{
         SubscriptBox["x", "1"], ",", "1"}], "]"}], 
       RowBox[{"Product", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"V\[Gamma]1", "[", 
           RowBox[{
            SubscriptBox["x", "ll"], ",", "ll"}], "]"}], 
          RowBox[{"V\[Psi]\[Chi]", "[", 
           RowBox[{
            SubscriptBox["x", 
             RowBox[{"100", "+", "ll"}]], ",", "t"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"ll", ",", "2", ",", 
           RowBox[{"nInteractionVertices", "+", "1"}]}], "}"}]}], "]"}]}], 
      ",", 
      RowBox[{"\"\<fields\>\"", "->", 
       RowBox[{"FieldsNamesGenerator", "[", 
        RowBox[{"{", 
         RowBox[{"\[Phi]", ",", "\[Chi]", ",", "\[Psi]"}], "}"}], "]"}]}], 
      ",", " ", 
      RowBox[{"\"\<endTime\>\"", "->", 
       RowBox[{"(", 
        RowBox[{"nInteractionVertices", "+", "1"}], ")"}]}], ",", 
      RowBox[{"\"\<print\>\"", "->", "False"}], ",", 
      RowBox[{"\"\<\[Delta]rule\>\"", "->", "True"}], ",", 
      RowBox[{"\"\<\[Delta]ruleExternal\>\"", "->", "True"}], ",", 
      RowBox[{"\"\<\!\(\*SubscriptBox[\(n\), \(\[Chi]\)]\)\>\"", "->", 
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}]}], ",", 
      RowBox[{"\"\<\!\(\*SubscriptBox[\(n\), \(\[Alpha]\)]\)\>\"", "->", 
       RowBox[{"(", "0", ")"}]}], ",", 
      RowBox[{"\"\<kill\[Psi]\>\"", "->", "True"}]}], "]"}]}], ";"}], 
  "]"}]}], "Input",
