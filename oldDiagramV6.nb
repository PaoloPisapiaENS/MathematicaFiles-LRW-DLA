Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "CombinatorialFactor", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"CombinatorialFactor", "[", 
     RowBox[{
      RowBox[{"A_", "+", "B___"}], ",", "max_", ",", "time_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"CombinatorialFactor", "[", 
      RowBox[{"A", ",", "max", ",", "time"}], "]"}], "+", 
     RowBox[{"CombinatorialFactor", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Plus", "@@", 
         RowBox[{"{", "B", "}"}]}], ")"}], ",", "max", ",", "time"}], 
      "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"CombinatorialFactor", "[", 
     RowBox[{"expr_", ",", "max_", ",", "time_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"factors", ",", "chis", ",", "others", ",", "n"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Head", "[", "expr", "]"}], "===", "Times"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", " ", "TRUE", " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"factors", "=", 
           RowBox[{"List", "@@", "expr"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"chis", "=", 
           RowBox[{"Select", "[", 
            RowBox[{"factors", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"!", 
                RowBox[{"FreeQ", "[", 
                 RowBox[{"#", ",", 
                  OverscriptBox["g", "~"]}], "]"}]}], "&&", 
               RowBox[{"!", 
                RowBox[{"FreeQ", "[", 
                 RowBox[{"#", ",", 
                  SubscriptBox["t", "time"]}], "]"}]}]}], "&"}]}], "]"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"others", "=", 
           RowBox[{"Complement", "[", 
            RowBox[{"factors", ",", "chis"}], "]"}]}], ";", 
          RowBox[{"(*", 
           RowBox[{"conservatively", ":", 
            RowBox[{"remove", " ", "\[Chi]s", " ", "only"}]}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"n", "=", 
           RowBox[{"Length", "[", "chis", "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"n", ">", "0"}], "&&", 
             RowBox[{"n", "<=", "max"}]}], ",", "\[IndentingNewLine]", 
            RowBox[{"Return", "[", 
             RowBox[{
              RowBox[{"Factorial", "[", "n", "]"}], "*", 
              RowBox[{"Times", "@@", "chis"}], "*", 
              RowBox[{"Times", "@@", "others"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Return", "[", "expr", "]"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", "ELSE", " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"Return", "[", "expr", "]"}]}], "\[IndentingNewLine]", "]"}],
        ";"}]}], " ", 
     RowBox[{"(*", " ", 
      RowBox[{"END", " ", "OF", " ", "FIRST", " ", "IF"}], "*)"}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{"END", " ", "OF", " ", "MODULE"}], "*)"}]}], "\n"}], "Input",
