      RowBox[{"\"\<gauss\[Psi]\>\"", "->", "True"}], ",", 
      RowBox[{"\"\<gauss\[Xi]\>\"", "->", "False"}], ",", 
      RowBox[{"\"\<additionalSub\>\"", "->", 
       RowBox[{"{", "}"}]}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ToContinuum", "[", 
