           RowBox[{"F", "[", 
            RowBox[{
             RowBox[{"x", "-", "\[Delta]x"}], ",", 
             RowBox[{"t", "+", "\[Delta]t"}], ",", "c"}], "]"}], "*", 
           RowBox[{
            RowBox[{"G", "[", 
             RowBox[{
              RowBox[{"x", "-", "\[Delta]x"}], ",", "t", ",", "d"}], "]"}], 
            "/", "2"}]}]}]}]}], "//", "Expand"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[CapitalMu]Action", "=", 
      RowBox[{
       RowBox[{"\[CapitalMu]Action", "//.", 
        RowBox[{
