Cell[TextData[{
 "One should expand the result of the sum up to O[\[Lambda]]^b so that the \
divergence is compensated. The generating functionals are\n\t\t\t\t\t\t\t\t\t\
\t\t1:     ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        RowBox[{"(", 
          FractionBox[
           RowBox[{
             SuperscriptBox[
              StyleBox["e", "TI"], "\[Lambda]"], "\[Lambda]"}], 
           RowBox[{
             SuperscriptBox[
              StyleBox["e", "TI"], "\[Lambda]"], "-", "1"}]], ")"}], 
        StyleBox["b", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "$\\left(\\frac{e^{\\lambda } \\lambda }{e^{\\lambda }-1}\\right)^b$", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "594789fc-07ac-3b45-abec-936539d1b421"],
 "\n\t\t\t\t\t\t\t\t\t\t\t",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[Chi]", "~"], TraditionalForm]],ExpressionUUID->
  "61a838a4-d67d-4346-84b7-f3e2004d0062"],
 ": ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          StyleBox["b", "TI"], 
          RowBox[{
            SuperscriptBox[
             StyleBox["e", "TI"], "\[Lambda]"], "-", "1"}]], 
         SuperscriptBox[
          RowBox[{"(", 
            FractionBox[
             RowBox[{
               SuperscriptBox[
                StyleBox["e", "TI"], "\[Lambda]"], "\[Lambda]"}], 
             RowBox[{
               SuperscriptBox[
                StyleBox["e", "TI"], "\[Lambda]"], "-", "1"}]], ")"}], 
          StyleBox["b", "TI"]], "-", 
         FractionBox[
          StyleBox["b", "TI"], "\[Lambda]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\frac{b }{e^{\\lambda }-1}\\left(\\frac{e^{\\lambda } \\lambda \
}{e^{\\lambda }-1}\\right)^b-\\frac{b}{\\lambda}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d7ee86a6-a515-4b4f-b4e2-189456658a4e"],
 "\n",
 StyleBox["If one wants to factorize the first, then the \
\[OpenCurlyDoubleQuote]weight\[CloseCurlyDoubleQuote] is just given by ",
  FontSize->8],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       FractionBox[
        StyleBox["b", "TI"], 
        RowBox[{
          SuperscriptBox[
           StyleBox["e", "TI"], "\[Lambda]"], "-", "1"}]], TraditionalForm], 
     "errors" -> {}, "input" -> "$\\frac{b }{e^{\\lambda }-1}$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSize->8,ExpressionUUID->"b634ef10-e334-9844-ab12-639ff5e07fbf"],
 StyleBox[". NOT TRUE!!!\n",
  FontSize->8],
 StyleBox["The problem is that now there is no closed form for the dependence \
on ",
  FontSize->16],
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "dd283460-6d8c-0445-af8c-59872e2b6dc5"],
 "!"
}], "Text",
 CellChangeTimes->{{3.983011172211241*^9, 3.9830112403138676`*^9}, {
  3.983011420428289*^9, 3.983011443419443*^9}, {3.983011492727272*^9, 
  3.98301149484935*^9}, {3.9830115510246153`*^9, 3.983011552507145*^9}, {
  3.9830122767488117`*^9, 3.983012317097403*^9}, {3.983012832226483*^9, 
  3.9830128341316395`*^9}, {3.9830132249969406`*^9, 3.9830132734990005`*^9}, {
  3.9830139233985977`*^9, 3.9830139261939945`*^9}, {3.983014261406361*^9, 
  3.9830143105896854`*^9}},ExpressionUUID->"f05c767e-747e-ed47-988d-\
06194d3924d5"],

