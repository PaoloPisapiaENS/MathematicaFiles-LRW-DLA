Cell["\<\
I NEED TO USE \[Beta] EVERYWHERE, AND NOT \[Beta]hat!!!!
Also, if \[OpenCurlyDoubleQuote]justSmallestOrder\[CloseCurlyDoubleQuote] -> \
True, then there are some extra term in \[Gamma]g, but we don\
\[CloseCurlyQuote]t really care about \[Gamma]g\
\>", "Text",
 CellChangeTimes->{{3.956917081038988*^9, 3.956917100687214*^9}, {
   3.956995275060177*^9, 3.956995311278618*^9}, 
   3.9592395105230904`*^9},ExpressionUUID->"eb486b7b-c501-5e41-b96b-\
0ca62ae04d19"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "ToContinuum", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "ToContinuum", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<print\>\"", "->", "False"}], ",", 
      RowBox[{"\"\<justSmallestOrder\>\"", "->", "False"}], ",", 
      RowBox[{"\"\<\[Gamma]gterms\>\"", "->", "True"}], ",", 
      RowBox[{"\"\<CollectLaplacian\>\"", "->", "True"}], ",", 
      RowBox[{"\"\<\[Delta]\[Psi]\>\"", "->", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{"\"\<\[Delta]\[Chi]\>\"", "->", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{"\"\<\[Kappa]Order\>\"", "->", "6"}], ",", " ", 
      RowBox[{"\"\<rx\>\"", "->", 
       RowBox[{"{", 
        RowBox[{
         SubscriptBox["r", "a_"], ":>", "\[CapitalSigma]\[Beta]"}], "}"}]}], 
      ",", 
      RowBox[{"\"\<gauss\[Psi]\>\"", "->", "True"}], ",", 
      RowBox[{"\"\<additionalSub\>\"", "->", 
       RowBox[{"{", "}"}]}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ToContinuum", "[", 
   RowBox[{"\[Mu]Action_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[CapitalMu]Action", ",", "\[Kappa]order", ",", "purificationRule", ",",
       "purifiedAction", ",", "freeAction", ",", "gAction", ",", 
      "\[Gamma]Action", ",", "\[Gamma]gAction"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Clear", "[", 
      RowBox[{"g", ",", "\[Kappa]"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[CapitalMu]Action", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"V", "[", 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{
               RowBox[{
                RowBox[{"-", 
                 RowBox[{"\[Phi]", "[", 
                  RowBox[{"1", ",", 
                   SubscriptBox["t", "1"], ",", 
                   SubscriptBox["k", "1"]}], "]"}]}], " ", 
                RowBox[{"\[Phi]s", "[", 
                 RowBox[{"1", ",", 
                  SubscriptBox["t", "1"], ",", 
                  SubscriptBox["k", "1"]}], "]"}]}], "-", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"OptionValue", "[", "\"\<gauss\[Psi]\>\"", "]"}], 
                 ",", 
                 RowBox[{
                  RowBox[{"\[Psi]", "[", 
                   RowBox[{"1", ",", 
                    SubscriptBox["t", "1"], ",", 
                    SubscriptBox["ll", "1"]}], "]"}], 
                  RowBox[{"\[Psi]s", "[", 
                   RowBox[{"1", ",", 
                    SubscriptBox["t", "1"], ",", 
                    SubscriptBox["ll", "1"]}], "]"}]}], ",", "0"}], "]"}], 
               "-", " ", 
               RowBox[{
                SubscriptBox["r", "x"], " ", 
                RowBox[{"\[Chi]", "[", 
                 RowBox[{"1", ",", 
                  SubscriptBox["t", "1"], ",", 
                  SubscriptBox["i", "1"], ",", 
                  SubscriptBox["\[Alpha]", "1"]}], "]"}], " ", 
                RowBox[{"\[Chi]s", "[", 
                 RowBox[{"1", ",", 
                  SubscriptBox["t", "1"], ",", 
                  SubscriptBox["i", "1"], ",", 
                  SubscriptBox["\[Alpha]", "1"]}], "]"}]}]}]], "]"}], "*", 
            " ", "\[Mu]Action"}], "/.", 
           RowBox[{"OptionValue", "[", "\"\<additionalSub\>\"", "]"}]}], 
          "\[IndentingNewLine]", "/.", 
          RowBox[{"{", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"V", "[", "a_", "]"}], "/;", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"FreeQ", "[", 
                  RowBox[{"a", ",", 
                   RowBox[{"\[Phi]", "[", 
                    RowBox[{"1", ",", "___"}], "]"}]}], "]"}], "&&", 
                 RowBox[{"FreeQ", "[", 
                  RowBox[{"a", ",", 
                   RowBox[{"\[Xi]", "[", 
                    RowBox[{"1", ",", "___"}], "]"}]}], "]"}]}], ")"}]}], ":>",
               "1"}], ","}], "*)"}], 
           RowBox[{
            RowBox[{
             RowBox[{"R", "[", "___", "]"}], ":>", "1"}], ",", 
            RowBox[{
             RowBox[{"\[Phi]", "[", 
              RowBox[{"a__", ",", "b_"}], "]"}], "->", 
             RowBox[{"\[Phi]", "[", "a", "]"}]}], ",", 
            RowBox[{
             RowBox[{"\[Phi]s", "[", 
              RowBox[{"a__", ",", "b_"}], "]"}], "->", 
             RowBox[{"\[Phi]s", "[", "a", "]"}]}], ",", 
            RowBox[{
             RowBox[{"\[Psi]", "[", 
              RowBox[{"a__", ",", "b_"}], "]"}], "->", 
             RowBox[{"\[Psi]", "[", "a", "]"}]}], ",", 
            RowBox[{
             RowBox[{"\[Psi]s", "[", 
              RowBox[{"a__", ",", "b_"}], "]"}], "->", 
             RowBox[{"\[Psi]s", "[", "a", "]"}]}], ",", 
            RowBox[{
             RowBox[{"\[Xi]", "[", 
              RowBox[{"a__", ",", "b_"}], "]"}], "->", 
             RowBox[{"\[Xi]", "[", "a", "]"}]}], ",", 
            RowBox[{
             RowBox[{"\[Xi]s", "[", 
              RowBox[{"a__", ",", "b_"}], "]"}], "->", 
             RowBox[{"\[Xi]s", "[", "a", "]"}]}]}], "}"}]}], 
         "\[IndentingNewLine]", "/.", 
         RowBox[{
          RowBox[{"V", "[", "a_", "]"}], ":>", "a"}]}], "\[IndentingNewLine]",
         "/.", " ", 
        RowBox[{
         RowBox[{"Exp", "[", "arg_", "]"}], ":>", 
         RowBox[{"Exp", "[", 
          RowBox[{"Expand", "[", "arg", "]"}], "]"}]}]}], "//", "Expand"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"OptionValue", "[", "\"\<print\>\"", "]"}], ",", 
       RowBox[{"Print", "[", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
          "\"\<\\t Extracting terms for point \!\(\*SubscriptBox[\(x\), \
\(1\)]\):\\n \>\"", ",", 
           RowBox[{"{", "Blue", "}"}]}], "]"}], ",", " ", 
         "\[CapitalMu]Action", ",", "\"\<\\n\>\""}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"\[CapitalMu]Action", "=", 
      RowBox[{
       RowBox[{"\[CapitalMu]Action", "//.", 
        RowBox[{
         RowBox[{"F_", "[", 
          RowBox[{"1", ",", 
           SubscriptBox["t", "1"], ",", "c___"}], "]"}], ":>", 
         RowBox[{"\[Kappa]", " ", 
          RowBox[{"F", "[", 
           RowBox[{"x", ",", "t", ",", "c"}], "]"}]}]}]}], "//", "Expand"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"\[CapitalMu]Action", "=", 
        RowBox[{
         RowBox[{"\[CapitalMu]Action", "//.", 
          RowBox[{
           RowBox[{"G_", "/", 
            RowBox[{"F_", "[", 
             RowBox[{"1", ",", 
              SubscriptBox["t", "1"], ",", "c___"}], "]"}]}], ":>", 
           RowBox[{"G", "/", 
            RowBox[{"(", 
             RowBox[{"\[Kappa]", " ", 
              RowBox[{"F", "[", 
               RowBox[{"x", ",", "t", ",", "c"}], "]"}]}], ")"}]}]}]}], "//", 
         "Expand"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[CapitalMu]Action", "=", 
      RowBox[{
       RowBox[{"\[CapitalMu]Action", "//.", 
        RowBox[{
         RowBox[{"F_", "[", 
          RowBox[{"1", ",", 
           SubscriptBox["t", "2"], ",", "c___"}], "]"}], ":>", 
         RowBox[{"\[Kappa]", " ", 
          RowBox[{"F", "[", 
           RowBox[{"x", ",", 
            RowBox[{"t", "+", "\[Delta]t"}], ",", "c"}], "]"}]}]}]}], "//", 
       "Expand"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[CapitalMu]Action", "=", 
      RowBox[{
       RowBox[{"\[CapitalMu]Action", "//.", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"F_", "[", 
            RowBox[{"a_", ",", 
             SubscriptBox["t", "2"], ",", "c___"}], "]"}], "*", 
           RowBox[{"G_", "[", 
            RowBox[{"a_", ",", 
             SubscriptBox["t", "1"], ",", "d___"}], "]"}]}], "/;", 
          RowBox[{"(", " ", 
           RowBox[{"FreeQ", "[", 
            RowBox[{"a", ",", "x"}], "]"}], ")"}]}], ":>", 
         RowBox[{
          RowBox[{
           SuperscriptBox["\[Kappa]", "2"], " ", 
           RowBox[{"F", "[", 
            RowBox[{
             RowBox[{"x", "+", "\[Delta]x"}], ",", 
