  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "LRWaction\[Psi]overallIn\[Gamma]s", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<sourceBC\>\"", "->", "1"}], ",", 
      RowBox[{"\"\<excludedVertices\>\"", "->", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{"\"\<graph\>\"", "->", "g"}], ",", 
      RowBox[{"\"\<startingTime\>\"", "->", "1"}], ",", 
      RowBox[{"\"\<endTime\>\"", "->", "10"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LRWaction\[Psi]overallIn\[Gamma]s", "[", 
   RowBox[{"OptionsPattern", "[", "]"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "locGraph", ",", "locStartingTime", ",", "locEndTime", ",", "locSource", 
      ",", "locRoot", ",", "locWeights", ",", "totWeights", ",", 
      "locVertices", ",", "actionTimeSlice", ",", "action"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Clear", "[", 
      RowBox[{"i", ",", "k", ",", "j", ",", "\[Gamma]"}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"locGraph", "=", 
      RowBox[{"OptionValue", "[", "\"\<graph\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"locStartingTime", " ", "=", 
      RowBox[{"OptionValue", "[", "\"\<startingTime\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"locEndTime", " ", "=", 
      RowBox[{"OptionValue", "[", "\"\<endTime\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"locWeights", "=", 
      RowBox[{
       RowBox[{"WeightedAdjacencyMatrix", "[", "locGraph", "]"}], "//", 
       "Normal"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"totWeights", " ", "=", 
      RowBox[{"Total", "[", 
       RowBox[{"locWeights", ",", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"locVertices", "=", 
      RowBox[{"VertexList", "@", "locGraph"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"locRoot", " ", "=", " ", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"locGraph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<ROOT\>\""}]}], "]"}], "&"}]}], "]"}], 
        "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"locSource", " ", "=", " ", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"locGraph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<SOURCE\>\""}]}], "]"}], "&"}]}], "]"}],
         "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"actionTimeSlice", " ", "[", "T_", "]"}], ":=", " ", 
      RowBox[{
       RowBox[{"Product", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"totWeights", "[", 
              RowBox[{"[", "x", "]"}], "]"}], "===", "0"}], "  ", "||", " ", 
            RowBox[{"MemberQ", "[", 
             RowBox[{
              RowBox[{"OptionValue", "[", "\"\<excludedVertices\>\"", "]"}], 
              ",", "x"}], "]"}]}], ",", "1", ",", "\[IndentingNewLine]", 
           RowBox[{"(*", "FALSE", "*)"}], 
