                    RowBox[{"T", "+", "1"}]], ",", 
                   SubscriptBox["ll", "x"]}], "]"}], "*", 
                 RowBox[{"\[Psi]", "[", 
                  RowBox[{"x", ",", 
                   SubscriptBox["t", "T"], ",", 
                   SubscriptBox["ll", "x"]}], "]"}]}], 
                RowBox[{"(*", 
