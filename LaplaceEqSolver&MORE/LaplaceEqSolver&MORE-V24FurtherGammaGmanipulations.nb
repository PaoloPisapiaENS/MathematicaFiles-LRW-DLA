   RowBox[{
    RowBox[{"Options", "[", "LRWactionExp\[Psi]", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<sourceBC\>\"", "->", "1"}], ",", 
