                    RowBox[{"\[Chi]s", "[", 
                    RowBox[{"x", ",", 
                    SubscriptBox["t", "T"], ",", "1"}], "]"}]}], ")"}]}]}], 
                    ")"}]}], ",", 
                  RowBox[{"{", 
                   RowBox[{"y", ",", 
                    RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], 
