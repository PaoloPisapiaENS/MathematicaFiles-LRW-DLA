                    SubscriptBox["ll", "x"]}], "]"}], "*)"}],
                    Background->RGBColor[1, 0.5, 0.5]], 
                    StyleBox["\[IndentingNewLine]",
                    Background->RGBColor[1, 0.5, 0.5]], "-", 
                    RowBox[{
                    RowBox[{"\[Phi]s", "[", 
                    RowBox[{"x", ",", 
