Cell[TextData[{
 "I want to get rid of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["\[Psi]", "4"], "&"}], "\[Gamma]\[Psi]"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dfa8ea11-b541-0b43-aaee-cc0b1b001828"],
 " interactions. I do not like them. I think that the theoretical-sound way \
to do this is by replacing 1+\[Psi]\[Psi] with ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", "\[Psi]\[Psi]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "92fc217e-8763-874f-909e-237e1be7d05c"],
 ". First I want to make sure that my wickContraction routine can handle \
this. "
}], "Text",
 CellChangeTimes->{{3.951972396780592*^9, 3.951972414306528*^9}, {
  3.9519726467851925`*^9, 3.951972661560749*^9}, {3.9520736155219975`*^9, 
  3.95207367732251*^9}, {3.953806359839178*^9, 3.953806387974497*^9}, {
  3.953863109336878*^9, 
  3.9538631572768536`*^9}},ExpressionUUID->"95b74a20-6f0f-e546-80df-\
8dc57dd532e1"],

