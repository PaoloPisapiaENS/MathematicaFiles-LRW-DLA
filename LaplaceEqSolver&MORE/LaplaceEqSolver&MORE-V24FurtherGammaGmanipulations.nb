Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
  "To", " ", "extract", " ", "the", " ", "paths", " ", "and", " ", "their", 
   " ", "weights", " ", "from", " ", "the", " ", "expression", " ", "of", " ",
    "an", " ", "expectation", " ", "value"}], "*)"}]], "Input",
 CellChangeTimes->{{3.947588583707459*^9, 
