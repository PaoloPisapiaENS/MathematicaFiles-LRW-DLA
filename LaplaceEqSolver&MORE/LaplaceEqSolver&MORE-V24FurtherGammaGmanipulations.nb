Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "LRWactionREALinteraction", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "LRWactionREALinteraction", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<sourceBC\>\"", "->", "1"}], ",", 
      RowBox[{"\"\<excludedVertices\>\"", "->", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{"\"\<graph\>\"", "->", "g"}], ",", 
      RowBox[{"\"\<startingTime\>\"", "->", "1"}], ",", 
      RowBox[{"\"\<endTime\>\"", "->", "10"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LRWactionREALinteraction", "[", 
   RowBox[{"OptionsPattern", "[", "]"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "locGraph", ",", "locStartingTime", ",", "locEndTime", ",", "locSource", 
      ",", "locRoot", ",", "locWeights", ",", "totWeights", ",", 
      "locVertices", ",", "actionTimeSlice", ",", "action"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Clear", "[", 
      RowBox[{"i", ",", "k", ",", "j", ",", "\[Gamma]"}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"locGraph", "=", 
      RowBox[{"OptionValue", "[", "\"\<graph\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"locStartingTime", " ", "=", 
      RowBox[{"OptionValue", "[", "\"\<startingTime\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"locEndTime", " ", "=", 
      RowBox[{"OptionValue", "[", "\"\<endTime\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"locWeights", "=", 
      RowBox[{
       RowBox[{"WeightedAdjacencyMatrix", "[", "locGraph", "]"}], "//", 
       "Normal"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"totWeights", " ", "=", 
      RowBox[{"Total", "[", 
       RowBox[{"locWeights", ",", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"locVertices", "=", 
      RowBox[{"VertexList", "@", "locGraph"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"locRoot", " ", "=", " ", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"locGraph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<ROOT\>\""}]}], "]"}], "&"}]}], "]"}], 
        "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"locSource", " ", "=", " ", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"locGraph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<SOURCE\>\""}]}], "]"}], "&"}]}], "]"}],
         "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"actionTimeSlice", " ", "[", "T_", "]"}], ":=", " ", 
      RowBox[{
       RowBox[{"Product", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"totWeights", "[", 
              RowBox[{"[", "x", "]"}], "]"}], "===", "0"}], "  ", "||", " ", 
            RowBox[{"MemberQ", "[", 
             RowBox[{
              RowBox[{"OptionValue", "[", "\"\<excludedVertices\>\"", "]"}], 
              ",", "x"}], "]"}]}], ",", "1", ",", "\[IndentingNewLine]", 
           RowBox[{"(*", "FALSE", "*)"}], 
           RowBox[{
            RowBox[{"V", "[", 
             RowBox[{"(", 
              RowBox[{"1", "+", 
               RowBox[{"\[Gamma]", " ", 
                RowBox[{"Sum", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"locWeights", "[", 
                    RowBox[{"[", 
                    RowBox[{"x", ",", "y"}], "]"}], "]"}], 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"R", "[", 
                    RowBox[{"x", ",", "y", ",", "Red"}], "]"}], 
                    RowBox[{"\[Phi]s", "[", 
                    RowBox[{"y", ",", 
                    SubscriptBox["t", 
                    RowBox[{"T", "+", "1"}]], ",", 
                    SubscriptBox["k", "y"]}], "]"}], 
                    RowBox[{"\[Chi]s", "[", 
                    RowBox[{"y", ",", 
                    SubscriptBox["t", "T"], ",", "1"}], "]"}]}], "-", 
                    RowBox[{
                    RowBox[{"\[Phi]s", "[", 
                    RowBox[{"x", ",", 
                    SubscriptBox["t", 
                    RowBox[{"T", "+", "1"}]], ",", 
                    SubscriptBox["k", "x"]}], "]"}], 
                    RowBox[{"\[Chi]s", "[", 
                    RowBox[{"x", ",", 
                    SubscriptBox["t", "T"], ",", "1"}], "]"}]}]}], ")"}], 
                    RowBox[{"\[Psi]s", "[", 
                    RowBox[{"x", ",", 
                    SubscriptBox["t", 
                    RowBox[{"T", "+", "1"}]], ",", 
                    SubscriptBox["ll", "x"]}], "]"}]}], "-", 
                    RowBox[{
                    RowBox[{"\[Phi]s", "[", 
                    RowBox[{"x", ",", 
                    SubscriptBox["t", 
                    RowBox[{"T", "+", "1"}]], ",", 
                    SubscriptBox["k", "x"]}], "]"}], 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"\[Chi]s", "[", 
                    RowBox[{"y", ",", 
                    SubscriptBox["t", "T"], ",", "1"}], "]"}], "-", 
                    RowBox[{"\[Chi]s", "[", 
                    RowBox[{"x", ",", 
                    SubscriptBox["t", "T"], ",", "1"}], "]"}]}], ")"}]}]}], 
                    ")"}]}], ",", 
                  RowBox[{"{", 
                   RowBox[{"y", ",", 
                    RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], 
                 "]"}], "*", 
                RowBox[{"\[Phi]", "[", 
                 RowBox[{"x", ",", 
                  SubscriptBox["t", "T"], ",", 
                  SubscriptBox["k", "x"]}], "]"}]}], "\[IndentingNewLine]", 
               "+", 
               RowBox[{
                RowBox[{"Sum", "[", 
                 RowBox[{
                  RowBox[{
                   FractionBox[
                    RowBox[{"locWeights", "[", 
                    RowBox[{"[", 
                    RowBox[{"x", ",", "y"}], "]"}], "]"}], 
                    RowBox[{"totWeights", "[", 
                    RowBox[{"[", "x", "]"}], "]"}]], 
                   RowBox[{"R", "[", 
                    RowBox[{"x", ",", "y", ",", "Blue"}], "]"}], 
                   RowBox[{"\[Chi]s", "[", 
                    RowBox[{"y", ",", 
                    SubscriptBox["t", "T"], ",", 
                    SubscriptBox["i", "x"]}], "]"}]}], ",", 
                  RowBox[{"{", 
                   RowBox[{"y", ",", 
                    RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], 
                 "]"}], "*", 
                RowBox[{"\[Chi]", "[", 
                 RowBox[{"x", ",", 
                  SubscriptBox["t", "T"], ",", 
                  SubscriptBox["i", "x"]}], "]"}]}], "\[IndentingNewLine]", 
               "+", 
               RowBox[{"(*", 
                RowBox[{"COPY", " ", "\[Psi]"}], "*)"}], " ", 
               RowBox[{
                RowBox[{"\[Psi]s", "[", 
                 RowBox[{"x", ",", 
                  SubscriptBox["t", 
                   RowBox[{"T", "+", "1"}]], ",", 
                  SubscriptBox["ll", "x"]}], "]"}], "*", 
                RowBox[{"\[Psi]", "[", 
                 RowBox[{"x", ",", 
                  SubscriptBox["t", "T"], ",", 
                  SubscriptBox["ll", "x"]}], "]"}]}]}], ")"}], " ", "]"}], 
            "\[IndentingNewLine]", 
            RowBox[{"V", "[", 
             RowBox[{"(", 
              RowBox[{"1", "+", 
               RowBox[{"(*", 
                RowBox[{"COPY", " ", "\[Phi]"}], "*)"}], " ", 
               RowBox[{
                RowBox[{"\[Phi]s", "[", 
                 RowBox[{"x", ",", 
                  SubscriptBox["t", 
                   RowBox[{"T", "+", "1"}]], ",", 
                  SubscriptBox["k", "x"]}], "]"}], "*", 
                RowBox[{"\[Phi]", "[", 
                 RowBox[{"x", ",", 
                  SubscriptBox["t", "T"], ",", 
                  SubscriptBox["k", "x"]}], "]"}]}]}], ")"}], "]"}]}]}], 
          RowBox[{"(*", 
           RowBox[{
           "I", " ", "AM", " ", "SEPARATING", " ", "\[Phi]", " ", "and", " ", 
            RowBox[{"\[Psi]", "!"}]}], "*)"}], "\[IndentingNewLine]", "]"}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], "]"}], 
       "\[IndentingNewLine]", 
       RowBox[{"V", "[", 
        RowBox[{"(", 
         RowBox[{"1", "+", " ", 
          RowBox[{
           RowBox[{"\[Phi]s", "[", 
            RowBox[{"locSource", ",", 
             SubscriptBox["t", 
              RowBox[{"T", "+", "1"}]], ",", 
             SubscriptBox["k", "locSource"]}], "]"}], 
           RowBox[{"\[Phi]", "[", 
            RowBox[{"locSource", ",", 
             SubscriptBox["t", "T"], ",", 
             SubscriptBox["k", "locSource"]}], "]"}]}], "+", 
          RowBox[{"\[Chi]", "[", 
           RowBox[{"locSource", ",", 
            SubscriptBox["t", "T"], ",", "1"}], "]"}]}], ")"}], "]"}]}]}], 
     ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"action", "=", 
      RowBox[{"Product", "[", 
       RowBox[{
        RowBox[{"actionTimeSlice", "[", "T", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"T", ",", "locEndTime"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
