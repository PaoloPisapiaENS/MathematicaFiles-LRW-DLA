Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "ConvergenceLRW\[Psi]overallIn\[Gamma]", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "ConvergenceLRW\[Psi]overallIn\[Gamma]", "]"}], 
    "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<graph\>\"", "->", "g"}], ",", 
