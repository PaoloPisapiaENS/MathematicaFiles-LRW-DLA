                    SubscriptBox["k", "x"]}], "]"}], 
                  RowBox[{"\[Psi]s", "[", 
                   RowBox[{"x", ",", 
                    SubscriptBox["t", 
                    RowBox[{"T", "+", "1"}]], ",", 
                    SubscriptBox["ll", "x"]}], "]"}], "*", 
                  RowBox[{"\[Psi]", "[", 
                   RowBox[{"x", ",", 
                    SubscriptBox["t", "T"], ",", 
                    SubscriptBox["ll", "x"]}], "]"}]}],
                 Background->RGBColor[1, 1, 0]], 
                RowBox[{"(*", 
                 RowBox[{
                  RowBox[{"+", 
                   RowBox[{"(*", 
                    RowBox[{"COPY", " ", "\[Phi]"}], " ", "*)"}], " ", 
                   RowBox[{"\[Phi]s", "[", 
                    RowBox[{"x", ",", 
                    SubscriptBox["t", 
                    RowBox[{"T", "+", "1"}]], ",", 
