          SubscriptBox["t", "a_"], "->", 
          SubscriptBox["t", 
           RowBox[{"a", "-", "1"}]]}]}], "/.", 
        RowBox[{"\[Gamma]", "->", "loc\[Gamma]"}]}], 
       StyleBox["/.",
        Background->RGBColor[1, 1, 0]], 
       StyleBox[
        RowBox[{
         RowBox[{
          RowBox[{"\[Psi]s", "[", "a__", "]"}], "^", "n_"}], "->", 
         RowBox[{"\[Psi]s", "[", "a", "]"}]}],
        Background->RGBColor[1, 1, 0]]}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", "LOOP", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "2"}], ",", 
       RowBox[{
        RowBox[{"i", "<=", 
         RowBox[{"OptionValue", "[", "\"\<steps\>\"", "]"}]}], " ", "&&", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Coefficient", "[", 
            RowBox[{"exp", ",", " ", 
             RowBox[{
              RowBox[{"\[Phi]s", "[", 
               RowBox[{"1", ",", 
                SubscriptBox["t", "1"], ",", 
                SubscriptBox["k", "1"]}], "]"}], 
              StyleBox[
               RowBox[{"\[Psi]s", "[", 
                RowBox[{"1", ",", 
                 SubscriptBox["t", "1"], ",", 
                 SubscriptBox["ll", "1"]}], "]"}],
               Background->RGBColor[1, 1, 0]]}]}], "]"}], "/.", 
           RowBox[{
            RowBox[{"R", "[", "__", "]"}], "->", "0"}]}], ")"}], ">=", 
         "locPrecision"}]}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"exp", "=", 
         RowBox[{"Replace", "[", 
          RowBox[{"exp", ",", 
           RowBox[{
            RowBox[{"a_", "/;", 
             RowBox[{"(", 
              RowBox[{"!", 
               RowBox[{"NumericQ", "[", "a", "]"}]}], ")"}]}], ":>", 
            RowBox[{"a", "/", 
             RowBox[{"(", 
              RowBox[{"Znorm", "[", 
               RowBox[{"a", ",", 
                RowBox[{"\"\<graph\>\"", "->", 
                 RowBox[{"OptionValue", "[", "\"\<graph\>\"", "]"}]}], ",", 
                RowBox[{"\"\<fieldsToExclude\>\"", "->", 
