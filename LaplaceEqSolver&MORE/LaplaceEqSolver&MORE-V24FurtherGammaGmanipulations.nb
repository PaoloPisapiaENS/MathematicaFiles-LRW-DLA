   "e^{-S_t} =\n    \\prod_x   e^{-\\sum_i \
\\chi^*_i(x,t)\\chi_i(x,t)-\\phi^*(x,t)\\phi(x,t)} \\times \\prod_{x \\in \
\\mc G \\setminus \\{s\\}}\n    \\Bigg\\{1 +\\sum_y \\frac{\\beta_{xy}}{r_x}  \
\\sum_i ^{N=-1} \\chi^*_i(y,t)\\chi_i(x,t)+ \\phi^*(x,t+1)\\phi(x,t)+\\\\+ \
\\gamma \\sum_y \\beta_{xy} \\Big(\\phi^*(y,t+1)\\phi^*(x,t+1) \
-\\phi^*(x,t+1) \\Big)\\phi(x,t)\\chi^*_1(y,t) \\chi_1(s,t) \\Bigg\\}.", 
   "state" -> "Boxes"|>,
  "TeXAssistantTemplate"]], "Input",
 CellChangeTimes->{3.9470465192505913`*^9},
 EmphasizeSyntaxErrors->True,
 CellLabel->
  "In[1076]:=",ExpressionUUID->"2745bce7-12fb-4a4a-9b10-82423589884a"],

Cell[TextData[{
 "For fields that do not have a color index, we default to set it to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["j", 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "748a687c-f4c9-164b-b062-8aa1c95a968a"],
 ", because in the WickContraction[] it automated with color indices.\n\
Instead, the source is set with index 1, so that it can contract with an \
external \[OpenCurlyDoubleQuote]probe\[CloseCurlyDoubleQuote]."
}], "Text",
 CellChangeTimes->{{3.947131579459246*^9, 3.947131634737303*^9}, {
   3.947131688714962*^9, 3.947131719382986*^9}, {3.947234352715584*^9, 
   3.94723435879998*^9}, 
   3.947304529435337*^9},ExpressionUUID->"1ce7645c-312a-3a4b-b727-\
ab21720ba042"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "FinalDynamicDLAaction", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "FinalDynamicDLAaction", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<sourceBC\>\"", "->", "1"}], ",", 
      RowBox[{"\"\<excludedVertices\>\"", "->", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{"\"\<graph\>\"", "->", "g"}], ",", 
      RowBox[{"\"\<endTime\>\"", "->", "10"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FinalDynamicDLAaction", "[", 
   RowBox[{"OptionsPattern", "[", "]"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "locGraph", ",", "locEndTime", ",", "locSource", ",", "locRoot", ",", 
      "locWeights", ",", "totWeights", ",", "locVertices", ",", 
      "actionTimeSlice", ",", "action"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Clear", "[", 
      RowBox[{"i", ",", "k", ",", "j", ",", "\[Gamma]"}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"locGraph", "=", 
      RowBox[{"OptionValue", "[", "\"\<graph\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"locEndTime", " ", "=", 
      RowBox[{"OptionValue", "[", "\"\<endTime\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"locWeights", "=", 
      RowBox[{
       RowBox[{"WeightedAdjacencyMatrix", "[", "locGraph", "]"}], "//", 
       "Normal"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"totWeights", " ", "=", 
      RowBox[{"Total", "[", 
       RowBox[{"locWeights", ",", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"locVertices", "=", 
      RowBox[{"VertexList", "@", "locGraph"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"locRoot", " ", "=", " ", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"locGraph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<ROOT\>\""}]}], "]"}], "&"}]}], "]"}], 
        "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"locSource", " ", "=", " ", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"locGraph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<SOURCE\>\""}]}], "]"}], "&"}]}], "]"}],
         "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"actionTimeSlice", " ", "[", "T_", "]"}], ":=", " ", 
      RowBox[{
       RowBox[{"Product", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"totWeights", "[", 
              RowBox[{"[", "x", "]"}], "]"}], "===", "0"}], "  ", "||", " ", 
            RowBox[{"MemberQ", "[", 
             RowBox[{
              RowBox[{"OptionValue", "[", "\"\<excludedVertices\>\"", "]"}], 
              ",", "x"}], "]"}]}], ",", "1", ",", "\[IndentingNewLine]", 
           RowBox[{"(*", "FALSE", "*)"}], 
           RowBox[{"V", "[", 
            RowBox[{"(", 
             RowBox[{"1", "+", 
              RowBox[{"\[Gamma]", " ", 
               RowBox[{"Sum", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"locWeights", "[", 
                   RowBox[{"[", 
                    RowBox[{"x", ",", "y"}], "]"}], "]"}], 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"R", "[", 
                    RowBox[{"x", ",", "y", ",", "Red"}], "]"}], 
                    RowBox[{"\[Phi]s", "[", 
                    RowBox[{"y", ",", 
                    SubscriptBox["t", 
                    RowBox[{"T", "+", "1"}]], ",", 
                    SubscriptBox["k", "y"]}], "]"}]}], "-", "1"}], ")"}], 
                  RowBox[{"\[Phi]s", "[", 
                   RowBox[{"x", ",", 
                    SubscriptBox["t", 
                    RowBox[{"T", "+", "1"}]], ",", 
                    SubscriptBox["k", "x"]}], "]"}], 
                  RowBox[{"\[Phi]", "[", 
                   RowBox[{"x", ",", 
                    SubscriptBox["t", "T"], ",", 
                    SubscriptBox["k", "x"]}], "]"}], 
                  RowBox[{"\[Chi]s", "[", 
                   RowBox[{"y", ",", 
                    SubscriptBox["t", "T"], ",", "1"}], "]"}]}], ",", 
                 RowBox[{"{", 
                  RowBox[{"y", ",", 
                   RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], 
                "]"}]}], "+", "\[IndentingNewLine]", 
              RowBox[{"Sum", "[", 
               RowBox[{
                RowBox[{
                 FractionBox[
                  RowBox[{"locWeights", "[", 
                   RowBox[{"[", 
                    RowBox[{"x", ",", "y"}], "]"}], "]"}], 
                  RowBox[{"totWeights", "[", 
                   RowBox[{"[", "x", "]"}], "]"}]], 
                 RowBox[{"R", "[", 
                  RowBox[{"x", ",", "y", ",", "Blue"}], "]"}], 
                 RowBox[{"\[Chi]s", "[", 
                  RowBox[{"y", ",", 
                   SubscriptBox["t", "T"], ",", 
                   SubscriptBox["i", "x"]}], "]"}], 
                 RowBox[{"\[Chi]", "[", 
                  RowBox[{"x", ",", 
                   SubscriptBox["t", "T"], ",", 
                   SubscriptBox["i", "x"]}], "]"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"y", ",", 
                  RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], 
               "]"}], "+", " ", 
              RowBox[{
               RowBox[{"\[Phi]s", "[", 
                RowBox[{"x", ",", 
                 SubscriptBox["t", 
                  RowBox[{"T", "+", "1"}]], ",", 
                 SubscriptBox["k", "x"]}], "]"}], 
               RowBox[{"\[Phi]", "[", 
                RowBox[{"x", ",", 
                 SubscriptBox["t", "T"], ",", 
                 SubscriptBox["k", "x"]}], "]"}]}]}], ")"}], " ", "]"}]}], 
          "\[IndentingNewLine]", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], "]"}], 
       "\[IndentingNewLine]", 
       RowBox[{"V", "[", 
        RowBox[{"(", 
         RowBox[{"1", "+", " ", 
          RowBox[{
           RowBox[{"\[Phi]s", "[", 
            RowBox[{"locSource", ",", 
             SubscriptBox["t", 
              RowBox[{"T", "+", "1"}]], ",", 
             SubscriptBox["k", "locSource"]}], "]"}], 
           RowBox[{"\[Phi]", "[", 
            RowBox[{"locSource", ",", 
             SubscriptBox["t", "T"], ",", 
             SubscriptBox["k", "locSource"]}], "]"}]}], "+", " ", 
          RowBox[{"\[Chi]", "[", 
           RowBox[{"locSource", ",", 
            SubscriptBox["t", "T"], ",", "1"}], "]"}]}], ")"}], "]"}]}]}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"V", "[", 
       RowBox[{"(", 
        RowBox[{"1", "+", " ", 
         RowBox[{
          RowBox[{"OptionValue", "[", "\"\<sourceBC\>\"", "]"}], " ", 
          RowBox[{"\[Chi]", "[", 
           RowBox[{"locSource", ",", 
            SubscriptBox["t", "T"], ",", "1"}], "]"}]}]}], ")"}], "]"}], 
      "*)"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"action", "=", 
      RowBox[{"Product", "[", 
       RowBox[{
        RowBox[{"actionTimeSlice", "[", "T", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"T", ",", "locEndTime"}], "}"}]}], "]"}]}], 
     RowBox[{"(*", 
      RowBox[{"Product", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"V", "[", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"\[Phi]", "[", 
             RowBox[{"x", ",", 
              SubscriptBox["t", 
               RowBox[{"locEndTime", "+", "1"}]], ",", 
              SubscriptBox["k", "x"]}], "]"}]}], ")"}], 
          RowBox[{"(*", 
           RowBox[{
           "This", " ", "allows", " ", "the", " ", "path", " ", "tracker", 
            " ", "to", " ", "be", " ", "absorbed", " ", "at", " ", "the", " ",
             "end"}], "*)"}], " ", "]"}], 
         RowBox[{"V", "[", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"\[Phi]", "[", 
             RowBox[{"x", ",", 
              SubscriptBox["t", 
               RowBox[{"locEndTime", "+", "1"}]], ",", "0"}], "]"}]}], ")"}], 
          RowBox[{"(*", 
           RowBox[{
           "This", " ", "allows", " ", "the", " ", "path", " ", "to", " ", 
            "end", " ", "after", " ", "\"\<endTime\>\"", " ", "steps"}], 
           "*)"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], "]"}], 
      "*)"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "action", "]"}]}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
