                  RowBox[{
                   StyleBox["\[Phi]s",
                    Background->RGBColor[1, 1, 0]], 
                   StyleBox[",",
                    Background->RGBColor[1, 1, 0]], "\[Psi]s"}], "}"}]}]}], 
               "]"}], ")"}]}]}], ",", "1"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"exp", "=", 
         RowBox[{"ExpectationValueBlock", "[", 
          RowBox[{
           RowBox[{"Z", " ", "exp"}], ",", 
           RowBox[{"\"\<endTime\>\"", "->", "1"}], ",", 
           RowBox[{"\"\<fields\>\"", "->", 
            RowBox[{"OptionValue", "[", "\"\<fields\>\"", "]"}]}], ",", 
           RowBox[{"\"\<Rrule\>\"", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"R", "[", 
               RowBox[{"__", ",", "Blue"}], "]"}], "->", "1."}], "}"}]}], ",", 
           RowBox[{"\"\<graph\>\"", "->", 
            RowBox[{"OptionValue", "[", " ", "\"\<graph\>\"", "]"}]}], ",", 
           RowBox[{"\"\<n\[Chi]\>\"", "->", 
            RowBox[{"-", "1"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"exp", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"exp", "/.", 
            RowBox[{
             SubscriptBox["t", "a_"], "->", 
             SubscriptBox["t", 
              RowBox[{"a", "-", "1"}]]}]}], "/.", 
           RowBox[{"\[Gamma]", "->", "loc\[Gamma]"}]}], 
          StyleBox["/.",
           Background->RGBColor[1, 1, 0]], 
          StyleBox[
