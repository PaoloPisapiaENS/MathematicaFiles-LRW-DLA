                    RowBox[{"\[Chi]s", "[", 
                    RowBox[{"x", ",", 
                    SubscriptBox["t", "T"], ",", "1"}], "]"}]}]}], ")"}], 
                    StyleBox[
                    RowBox[{"(*", 
