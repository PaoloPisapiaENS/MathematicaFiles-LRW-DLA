      RowBox[{"\"\<precision\>\"", "->", 
       SuperscriptBox["10", 
        RowBox[{"-", "9"}]]}], ",", 
      RowBox[{"\"\<theory\>\"", "->", "\"\<DLA\>\""}], ",", 
      RowBox[{"\"\<gammaValue\>\"", "->", "0.1"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ConvergenceLRW\[Psi]overallIn\[Gamma]", "[", 
   RowBox[{"operator_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "Z", ",", "Z0", ",", "locOperator", ",", "locPrecision", ",", 
      "loc\[Gamma]", ",", "exp", ",", 
      RowBox[{"i", "=", "1"}], ",", "temp"}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Z", "=", 
      RowBox[{
       RowBox[{"LRWaction\[Psi]overallIn\[Gamma]s", "[", 
        RowBox[{
         RowBox[{"\"\<graph\>\"", "->", 
          RowBox[{"OptionValue", "[", " ", "\"\<graph\>\"", "]"}]}], ",", 
         RowBox[{"\"\<endTime\>\"", "->", "1"}]}], "]"}], "/.", 
       RowBox[{
        RowBox[{"\[Beta]", "[", "__", "]"}], "->", "1."}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"locOperator", "=", " ", 
      RowBox[{"operator", "/", 
       RowBox[{"Znorm", "[", 
        RowBox[{"operator", ",", 
         RowBox[{"\"\<graph\>\"", "->", 
          RowBox[{"OptionValue", "[", "\"\<graph\>\"", "]"}]}], ",", 
         RowBox[{"\"\<fieldsToExclude\>\"", "->", 
          RowBox[{"{", 
           RowBox[{
            StyleBox["\[Phi]s",
             Background->RGBColor[1, 1, 0]], 
            StyleBox[",",
             Background->RGBColor[1, 1, 0]], "\[Psi]s"}], "}"}]}]}], 
        "]"}]}]}], ";", " ", 
     RowBox[{"(*", 
      RowBox[{"Normalized", " ", "immediately"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"locPrecision", "=", 
      RowBox[{"OptionValue", "[", "\"\<precision\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"loc\[Gamma]", "=", 
      RowBox[{"OptionValue", "[", "\"\<gammaValue\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"exp", "=", 
