Cell[BoxData[
 StyleBox[
  RowBox[{" ", 
   RowBox[{"\[Gamma]", " ", 
    RowBox[{"\[Beta]", "[", 
     RowBox[{"x", ",", "y"}], "]"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Phi]s", "[", 
           RowBox[{"y", ",", 
            RowBox[{"t", "+", "1"}]}], "]"}], 
          RowBox[{"\[Chi]s", "[", 
           RowBox[{"y", ",", "t"}], "]"}]}], " ", 
         RowBox[{"(*", 
          RowBox[{
          "Diffusion", " ", "solving", " ", "the", " ", "laplace", " ", 
           "equation"}], " ", "*)"}], "\[IndentingNewLine]", "-", 
         RowBox[{
          RowBox[{"\[Phi]s", "[", 
           RowBox[{"x", ",", 
            RowBox[{"t", "+", "1"}]}], "]"}], 
          RowBox[{"\[Chi]s", "[", 
           RowBox[{"x", ",", "t"}], "]"}]}]}], ")"}], 
       RowBox[{"\[Psi]s", "[", 
        RowBox[{"x", ",", 
         RowBox[{"t", "+", "1"}]}], "]"}]}], 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "This", " ", "is", " ", "THE", " ", "PROBABILITY", " ", "TO", " ", 
         "STAY", " ", "PUT"}], ",", " ", 
        RowBox[{"DO", " ", "NOT", " ", "DIFFUSE"}]}], "*)"}], 
      "\[IndentingNewLine]", "-", 
      RowBox[{
       RowBox[{"\[Phi]s", "[", 
        RowBox[{"x", ",", 
         RowBox[{"t", "+", "1"}]}], "]"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Chi]s", "[", 
          RowBox[{"y", ",", "t"}], "]"}], " ", "-", 
         RowBox[{"\[Chi]s", "[", 
          RowBox[{"x", ",", "t"}], "]"}]}], ")"}]}]}], 
     RowBox[{"(*", 
      RowBox[{"This", " ", "keeps", " ", "probability", " ", "conserved"}], 
      "*)"}], "\[IndentingNewLine]", " ", ")"}], 
    RowBox[{"\[Phi]", "[", 
     RowBox[{"x", ",", "t"}], "]"}]}]}],
