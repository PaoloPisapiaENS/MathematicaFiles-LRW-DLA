Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "Znorm", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "Znorm", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<graph\>\"", "->", "g"}], ",", 
      RowBox[{"\"\<fieldsToExclude\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"\[Phi]s", ",", "\[Psi]s"}], "}"}]}], ",", 
      RowBox[{"\"\<theory\>\"", "->", "\"\<LERW\>\""}], ",", 
      RowBox[{"\"\<\[Beta]rule\>\"", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Beta]", "[", "__", "]"}], "->", "1."}], "}"}]}]}], 
     "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Znorm", "[", 
   RowBox[{"expression_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "locZnorm", ",", "excludedVertices", ",", "token", ",", "index"}], "}"}],
     ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"excludedVertices", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"expression", " ", "*", " ", "2"}], ")"}], "/.", 
         RowBox[{
          RowBox[{"R", "[", "__", "]"}], "->", "1"}]}], "/.", 
        RowBox[{"\[Gamma]", "->", "1"}]}], "//", "Expand"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"excludedVertices", "=", 
      RowBox[{"List", " ", "@@", "excludedVertices"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"excludedVertices", "=", 
      RowBox[{"excludedVertices", "[", 
       RowBox[{"[", 
        RowBox[{"2", ";;"}], "]"}], "]"}]}], ";", " ", 
     RowBox[{"(*", 
      RowBox[{
      "Gets", " ", "rid", " ", "of", " ", "the", " ", "numerical", " ", 
       "coefficient"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"index", "=", "1"}], ",", 
       RowBox[{"index", "<=", 
        RowBox[{"Length", "[", 
         RowBox[{"OptionValue", "[", "\"\<fieldsToExclude\>\"", "]"}], 
         "]"}]}], ",", 
       RowBox[{"index", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"excludedVertices", "=", 
         RowBox[{"excludedVertices", "/.", 
          RowBox[{
