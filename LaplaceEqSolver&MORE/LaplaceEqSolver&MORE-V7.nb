Cell[CellGroupData[{

Cell["LERWtransitionProb[]", "Section",
 CellChangeTimes->{{3.94698824346854*^9, 3.946988245627989*^9}, {
  3.947042960974579*^9, 
  3.94704296672044*^9}},ExpressionUUID->"32aea97d-bfc5-1744-973a-\
3eebe72759d8"],

Cell["This function computes the transition probability as", "Text",
 CellChangeTimes->{{3.9470431190788527`*^9, 
  3.947043134135778*^9}},ExpressionUUID->"19207e4f-6a46-494d-b27f-\
6e491f7ec4ef"],

Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       SubsuperscriptBox[
        StyleBox["P", "TI"], 
        RowBox[{
          StyleBox["L", "TI"], 
          StyleBox["E", "TI"], 
          StyleBox["R", "TI"], 
          StyleBox["W", "TI"]}], 
        StyleBox["s", "TI"]], 
       RowBox[{"(", 
         RowBox[{"\[Gamma]", "\[Rule]", "\[Gamma]", "+", 
           StyleBox["x", "TI"]}], ")"}], "\[LongEqual]", 
       FractionBox[
        RowBox[{"\[Beta]", 
          RowBox[{
            StyleBox["v", "TI"], 
            StyleBox["x", "TI"]}]}], 
        SubscriptBox[
         StyleBox["r", "TI"], 
         StyleBox["v", "TI"]]], 
       FractionBox[
        RowBox[{"\[Integral]", 
          SuperscriptBox[
           StyleBox["e", "TI"], 
           RowBox[{"-", 
             SubscriptBox[
              StyleBox["S", "TI"], 
              RowBox[{
                StyleBox["G", "TI"], "|", "\[Gamma]", "\[Union]", 
                RowBox[{"{", 
                  StyleBox["s", "TI"], "}"}]}]]}]], 
          SubsuperscriptBox["\[Chi]", "1", "*"], 
          RowBox[{"(", 
            StyleBox["x", "TI"], ")"}], 
          SubscriptBox["\[Chi]", "1"], 
          RowBox[{"(", 
            StyleBox["s", "TI"], ")"}]}], 
        RowBox[{"\[Integral]", 
          SuperscriptBox[
           StyleBox["e", "TI"], 
           RowBox[{"-", 
             SubscriptBox[
              StyleBox["S", "TI"], 
              RowBox[{
                StyleBox["G", "TI"], "|", "\[Gamma]", "\[Union]", 
                RowBox[{"{", 
                  StyleBox["s", "TI"], "}"}], "\\", 
                RowBox[{"{", 
                  StyleBox["v", "TI"], "}"}]}]]}]], 
          SubsuperscriptBox["\[Chi]", "1", "*"], 
          RowBox[{"(", 
            StyleBox["v", "TI"], ")"}], 
          SubscriptBox["\[Chi]", "1"], 
          RowBox[{"(", 
            StyleBox["s", "TI"], ")"}]}]]}], TraditionalForm], "errors" -> {},
    "input" -> 
   "\\mathcal{ P}_{LERW}^s(\\gamma \\to \\gamma+x) = \
\\frac{\\beta{vx}}{r_{v}} \\frac{\\int e^{-{\\mathcal{ S}_{\\mathcal {G} | \
\\gamma \\cup \\{s\\}}}\n    }\\chi^*_1(x)\\chi_1(s) }{\\int e^{-{\\mathcal \
{S}_{\\mathcal{ G} | \\gamma \\cup \\{s\\} \\setminus  \\{v\\}}}\n    \
}\\chi^*_1(v)\\chi_1(s) }", "state" -> "Boxes"|>,
  "TeXAssistantTemplate"]], "DisplayFormula",
 CellChangeTimes->{3.947046100917994*^9},
 EmphasizeSyntaxErrors->True,
 CellLabel->
  "In[576]:=",ExpressionUUID->"1a9c7098-d038-964e-9055-d4e4c896ba3b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "LERWtransitionProb", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "LERWtransitionProb", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<draw\>\"", "->", "False"}], ",", 
      RowBox[{"\"\<print\>\"", "->", "False"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LERWtransitionProb", "[", 
   RowBox[{"graph_", ",", "path__", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "locSource", ",", "locRoot", ",", "locWeights", ",", "totWeights", ",", 
      "locVertices", ",", "denominator", ",", 
      RowBox[{"prob", "=", "1"}], ",", " ", "Z", ",", "numerator"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"locWeights", "=", 
      RowBox[{
       RowBox[{"WeightedAdjacencyMatrix", "[", "graph", "]"}], "//", 
       "Normal"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"totWeights", " ", "=", 
      RowBox[{"Total", "[", 
       RowBox[{"locWeights", ",", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"locVertices", "=", 
      RowBox[{"VertexList", "@", "graph"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"locRoot", " ", "=", " ", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"graph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<ROOT\>\""}]}], "]"}], "&"}]}], "]"}], 
        "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"locSource", " ", "=", " ", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"graph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<SOURCE\>\""}]}], "]"}], "&"}]}], "]"}],
         "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"locRoot", " ", "=!=", " ", 
        RowBox[{"path", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<####  WRONG ROOT  ####\>\"", "]"}], ";", 
        " ", 
        RowBox[{"Return", "[", "NULL", "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"locSource", " ", "=!=", " ", 
        RowBox[{"path", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "2"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<####  WRONG SOURCE  ####\>\"", "]"}], ";", 
        RowBox[{"Return", "[", "NULL", "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"locBC", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", "}"}], ",", 
            RowBox[{"{", "}"}]}], "}"}]}], ",", "\[Phi]", ",", 
         RowBox[{"i", "=", "1"}], ",", "j"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"locBC", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[Phi]", "[", "locSource", "]"}], "==", "1"}], "}"}], 
           ",", 
           RowBox[{"{", "locSource", "}"}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", "1"}], ",", 
          RowBox[{"i", "<=", 
           RowBox[{"Length", "[", "path", "]"}]}], ",", 
          RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"Z", "=", 
             RowBox[{"VertexAssignment", "[", 
              RowBox[{"graph", ",", " ", 
               RowBox[{"\"\<excludedVertices\>\"", "->", 
                RowBox[{"locBC", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"Z", "=", 
             RowBox[{"ExpectationValue", "[", 
              RowBox[{"Z", "*", 
               RowBox[{"\[Chi]s", "[", 
                RowBox[{
                 RowBox[{"path", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", "1"}], "]"}]}],
               "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"OptionValue", "[", "\"\<print\>\"", "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
               "Print", "[", 
                "\"\<#####  Previous Partition Function  #####\>\"", "]"}], 
               ";", "\[IndentingNewLine]", 
               RowBox[{"Print", "[", "Z", "]"}]}]}], "\[IndentingNewLine]", 
             "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"denominator", "=", 
             RowBox[{"Z", "//", "FullSimplify"}]}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
             "Then", " ", "we", " ", "need", " ", "to", " ", "solve", " ", 
              "it", " ", "again", " ", "with", " ", "updated", " ", "BC", " ",
               "at", " ", "the", " ", "current", " ", "step"}], "*)"}], 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{
              RowBox[{"locBC", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{"\[Phi]", "[", 
                RowBox[{"path", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "==", "0"}]}],
              "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{
              RowBox[{"locBC", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", 
              RowBox[{"path", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "1"}], "]"}], "]"}]}], "]"}], ";"}], 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"Print", "[", "locBC", "]"}], "*)"}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"Z", "=", 
            RowBox[{"VertexAssignment", "[", 
             RowBox[{"graph", ",", " ", 
              RowBox[{"\"\<excludedVertices\>\"", "->", 
               RowBox[{"locBC", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], ",", 
              RowBox[{"\"\<sourceBC\>\"", "->", 
               SuperscriptBox["denominator", 
                RowBox[{"-", "1"}]]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"Z", "=", 
            RowBox[{"ExpectationValue", "[", 
             RowBox[{"Z", "*", 
              RowBox[{"\[Chi]s", "[", 
               RowBox[{
                RowBox[{"path", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", "1"}], "]"}]}], 
             " ", "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"OptionValue", "[", "\"\<print\>\"", "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
              "Print", "[", 
               "\"\<#####  Current Partition Function  #####\>\"", "]"}], ";",
               "\[IndentingNewLine]", 
              RowBox[{"Print", "[", "Z", "]"}]}]}], "\[IndentingNewLine]", 
            "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"numerator", "=", 
            RowBox[{
             RowBox[{
              FractionBox[
               RowBox[{"locWeights", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"path", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
                  RowBox[{"path", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}], 
               RowBox[{"totWeights", "[", 
                RowBox[{"[", 
                 RowBox[{"path", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "]"}]], "*", 
              "Z"}], "//", "FullSimplify"}]}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<#####  Transition probability \>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"path", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "<>", 
             "\"\< to \>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"path", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "2"}], "]"}], "]"}], "]"}], "<>", 
             "\"\<  #####\>\""}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{
             RowBox[{"numerator", "/.", 
              RowBox[{
               RowBox[{"\[Beta]", "[", 
                RowBox[{"_", ",", "_"}], "]"}], "->", "1"}]}], "//", 
             "FullSimplify"}], "]"}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"prob", "*=", "numerator"}], "//", "FullSimplify"}], 
           ";"}]}], "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"OptionValue", "[", "\"\<draw\>\"", "]"}], ",", 
       RowBox[{"Print", "[", 
        RowBox[{"DrawOnGraph", "[", 
         RowBox[{"graph", ",", "path"}], "]"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "prob", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.946957123289613*^9, 3.946957125790329*^9}, {
   3.9469574223943024`*^9, 3.946957542179091*^9}, {3.946957574886076*^9, 
   3.946957642467764*^9}, {3.946957683153883*^9, 3.946957717311455*^9}, {
   3.946957872291024*^9, 3.946957894147585*^9}, {3.946957968709587*^9, 
   3.946957970997284*^9}, {3.946958072860735*^9, 3.946958158819021*^9}, {
   3.946958621553276*^9, 3.946958626118513*^9}, {3.946958661127107*^9, 
   3.946958861230053*^9}, {3.946959054720075*^9, 3.946959060505043*^9}, {
   3.94695928540217*^9, 3.946959290797489*^9}, {3.946960535391119*^9, 
   3.94696054348859*^9}, {3.946984021412091*^9, 3.9469840260369606`*^9}, {
   3.946984098556278*^9, 3.9469841880042267`*^9}, {3.946984219545618*^9, 
   3.9469842377405796`*^9}, {3.946984506003359*^9, 3.946984574653496*^9}, {
   3.946985172302428*^9, 3.946985193879123*^9}, {3.946985260562937*^9, 
   3.946985390985346*^9}, {3.94698547363096*^9, 3.9469854811467533`*^9}, {
   3.946985608820848*^9, 3.946985639280615*^9}, {3.946985686978163*^9, 
   3.9469856876604214`*^9}, {3.94698572933925*^9, 3.946985731008896*^9}, {
   3.9469858048689785`*^9, 3.946985819567713*^9}, {3.9469858614411793`*^9, 
   3.946985885521733*^9}, {3.946986016415917*^9, 3.946986018157924*^9}, {
   3.9469860712988033`*^9, 3.946986098933809*^9}, {3.9469861482308617`*^9, 
   3.9469861566440372`*^9}, {3.946986209347742*^9, 3.9469862111550255`*^9}, {
   3.946986429824531*^9, 3.946986451863417*^9}, {3.946986490339582*^9, 
   3.946986510731653*^9}, 3.9469865604052505`*^9, {3.9469866619958477`*^9, 
   3.9469867264422417`*^9}, {3.946987083701443*^9, 3.946987129609234*^9}, {
   3.946987374035248*^9, 3.946987750032591*^9}, 3.946987797541025*^9, {
   3.947041016357744*^9, 3.9470410194554996`*^9}, {3.947042539408333*^9, 
   3.9470426024265804`*^9}, {3.9470426400564785`*^9, 3.9470426855155334`*^9}},
 CellLabel->"In[74]:=",ExpressionUUID->"ecdcfd6a-3175-f94e-be48-267ceadc4b0d"],

