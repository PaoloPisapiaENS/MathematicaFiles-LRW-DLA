  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"FieldsNamesGenerator", "[", "fields", "]"}], "=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"locFields", "=", 
        RowBox[{"{", "}"}]}], ",", 
