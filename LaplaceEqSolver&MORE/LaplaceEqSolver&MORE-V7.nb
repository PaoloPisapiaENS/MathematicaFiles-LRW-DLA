          RowBox[{"Times", "->", "List"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"terms", "=", 
         RowBox[{"monoFlatten", "@@@", "terms"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"terms", "=", 
         RowBox[{"terms", "//.", 
          RowBox[{
           RowBox[{"R", "[", 
            RowBox[{"a_", ",", "b_", ",", "c_"}], "]"}], "->", 
           RowBox[{"{", 
            RowBox[{"a", ",", "b", ",", "c"}], "}"}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"i", "=", "1"}], ",", 
            RowBox[{"i", "<=", 
             RowBox[{"Length", "[", "terms", "]"}]}], ",", 
            RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"terms", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "=", 
              RowBox[{"DeleteElements", "[", 
               RowBox[{
                RowBox[{"terms", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"a_", "?", "NumericQ"}], "}"}]}], "]"}]}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"Print", "[", "terms", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"z", "=", 
         RowBox[{"z", "/.", 
          RowBox[{
           RowBox[{"R", "[", "___", "]"}], "->", "1"}]}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", "1"}], ",", 
          RowBox[{"i", "<=", 
           RowBox[{"Length", "[", "terms", "]"}]}], ",", 
          RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
          RowBox[{
