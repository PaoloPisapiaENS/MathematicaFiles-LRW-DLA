Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "Final2DynamicDLAaction", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "Final2DynamicDLAaction", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<sourceBC\>\"", "->", "1"}], ",", 
      RowBox[{"\"\<excludedVertices\>\"", "->", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{"\"\<graph\>\"", "->", "g"}], ",", 
      RowBox[{"\"\<endTime\>\"", "->", "10"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Final2DynamicDLAaction", "[", 
   RowBox[{"OptionsPattern", "[", "]"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "locGraph", ",", "locEndTime", ",", "locSource", ",", "locRoot", ",", 
      "locWeights", ",", "totWeights", ",", "locVertices", ",", 
      "actionTimeSlice", ",", "action"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Clear", "[", 
      RowBox[{"i", ",", "k", ",", "j", ",", "\[Gamma]"}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"locGraph", "=", 
      RowBox[{"OptionValue", "[", "\"\<graph\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"locEndTime", " ", "=", 
      RowBox[{"OptionValue", "[", "\"\<endTime\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"locWeights", "=", 
      RowBox[{
       RowBox[{"WeightedAdjacencyMatrix", "[", "locGraph", "]"}], "//", 
       "Normal"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"totWeights", " ", "=", 
      RowBox[{"Total", "[", 
       RowBox[{"locWeights", ",", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"locVertices", "=", 
      RowBox[{"VertexList", "@", "locGraph"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"locRoot", " ", "=", " ", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"locGraph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<ROOT\>\""}]}], "]"}], "&"}]}], "]"}], 
        "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"locSource", " ", "=", " ", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"locGraph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<SOURCE\>\""}]}], "]"}], "&"}]}], "]"}],
         "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"actionTimeSlice", " ", "[", "T_", "]"}], ":=", " ", 
      RowBox[{"Product", "[", " ", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"V", "[", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"\[Gamma]", " ", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"locWeights", "[", 
                RowBox[{"[", 
                 RowBox[{"x", ",", "y"}], "]"}], "]"}], 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"R", "[", 
                   RowBox[{"x", ",", "y", ",", "Red"}], "]"}], 
                  RowBox[{"\[Phi]s", "[", 
                   RowBox[{"y", ",", 
                    SubscriptBox["t", 
                    RowBox[{"T", "+", "1"}]], ",", 
                    SubscriptBox["k", "x"]}], "]"}]}], "-", "1"}], ")"}], 
               RowBox[{"\[Phi]s", "[", 
                RowBox[{"x", ",", 
                 SubscriptBox["t", 
                  RowBox[{"T", "+", "1"}]], ",", 
                 SubscriptBox["k", "x"]}], "]"}], 
               RowBox[{"\[Phi]", "[", 
                RowBox[{"x", ",", 
                 SubscriptBox["t", "T"], ",", 
                 SubscriptBox["k", "x"]}], "]"}], 
               RowBox[{"\[Chi]s", "[", 
                RowBox[{"y", ",", 
                 SubscriptBox["t", "T"], ",", "1"}], "]"}], 
               RowBox[{"OptionValue", "[", "\"\<sourceBC\>\"", "]"}], " ", 
               RowBox[{"\[Chi]", "[", 
                RowBox[{"locSource", ",", 
                 SubscriptBox["t", "T"], ",", "1"}], "]"}], 
               RowBox[{"Product", "[", 
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"z", "!=", "x"}], ",", 
                   RowBox[{"\[Xi]s", "[", 
                    RowBox[{"z", ",", 
                    SubscriptBox["t", "T"], ",", 
                    SubscriptBox["j", "z"]}], "]"}], ",", "1"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"z", ",", 
                   RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], 
                "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"y", ",", 
                RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], 
             "]"}]}], "+", 
           RowBox[{
            RowBox[{"\[Xi]", "[", 
             RowBox[{"x", ",", 
              SubscriptBox["t", "T"], ",", 
              SubscriptBox["j", "x"]}], "]"}], 
            RowBox[{"(", 
             RowBox[{"1", "+", 
              RowBox[{"Sum", "[", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"totWeights", "[", 
                    RowBox[{"[", "x", "]"}], "]"}], "===", "0"}], "  ", "||", 
                   " ", 
                   RowBox[{"MemberQ", "[", 
                    RowBox[{
                    RowBox[{
                    "OptionValue", "[", "\"\<excludedVertices\>\"", "]"}], 
                    ",", "x"}], "]"}]}], ",", "0", ",", 
                  RowBox[{"(*", "FALSE", "*)"}], 
                  RowBox[{
                   FractionBox[
                    RowBox[{"locWeights", "[", 
                    RowBox[{"[", 
                    RowBox[{"x", ",", "y"}], "]"}], "]"}], 
                    RowBox[{"totWeights", "[", 
                    RowBox[{"[", "x", "]"}], "]"}]], 
                   RowBox[{"R", "[", 
                    RowBox[{"x", ",", "y", ",", "Blue"}], "]"}], 
                   RowBox[{"\[Chi]s", "[", 
                    RowBox[{"y", ",", 
                    SubscriptBox["t", "T"], ",", 
                    SubscriptBox["i", "x"]}], "]"}], 
                   RowBox[{"\[Chi]", "[", 
                    RowBox[{"x", ",", 
                    SubscriptBox["t", "T"], ",", 
                    SubscriptBox["i", "x"]}], "]"}]}]}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"y", ",", 
                  RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], 
               "]"}]}], ")"}]}], "+", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "+", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"totWeights", "[", 
                   RowBox[{"[", "x", "]"}], "]"}], "===", "0"}], "  ", "||", 
                 " ", 
                 RowBox[{"MemberQ", "[", 
                  RowBox[{
                   RowBox[{
                   "OptionValue", "[", "\"\<excludedVertices\>\"", "]"}], ",",
                    "x"}], "]"}]}], ",", "0", ",", 
                RowBox[{"\[Xi]", "[", 
                 RowBox[{"x", ",", 
                  SubscriptBox["t", "T"], ",", 
                  SubscriptBox["j", "x"]}], "]"}]}], "]"}]}], ")"}], 
            RowBox[{"\[Phi]s", "[", 
             RowBox[{"x", ",", 
              SubscriptBox["t", 
               RowBox[{"T", "+", "1"}]], ",", 
              SubscriptBox["k", "x"]}], "]"}], 
            RowBox[{"\[Phi]", "[", 
             RowBox[{"x", ",", 
              SubscriptBox["t", "T"], ",", 
              SubscriptBox["k", "x"]}], "]"}]}]}], ")"}], " ", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], "]"}]}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"V", "[", 
       RowBox[{"(", 
        RowBox[{"1", "+", " ", 
         RowBox[{
          RowBox[{"OptionValue", "[", "\"\<sourceBC\>\"", "]"}], " ", 
          RowBox[{"\[Chi]", "[", 
           RowBox[{"locSource", ",", 
            SubscriptBox["t", "T"], ",", "1"}], "]"}]}]}], ")"}], "]"}], 
      "*)"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"action", "=", 
      RowBox[{"Product", "[", 
