     RowBox[{"(*", 
      RowBox[{"Product", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"V", "[", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"\[Phi]", "[", 
             RowBox[{"x", ",", 
              SubscriptBox["t", 
               RowBox[{"locEndTime", "+", "1"}]], ",", 
              SubscriptBox["k", "x"]}], "]"}]}], ")"}], 
          RowBox[{"(*", 
           RowBox[{
           "This", " ", "allows", " ", "the", " ", "path", " ", "tracker", 
            " ", "to", " ", "be", " ", "absorbed", " ", "at", " ", "the", " ",
             "end"}], "*)"}], " ", "]"}], 
         RowBox[{"V", "[", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"\[Phi]", "[", 
             RowBox[{"x", ",", 
              SubscriptBox["t", 
               RowBox[{"locEndTime", "+", "1"}]], ",", "0"}], "]"}]}], ")"}], 
          RowBox[{"(*", 
