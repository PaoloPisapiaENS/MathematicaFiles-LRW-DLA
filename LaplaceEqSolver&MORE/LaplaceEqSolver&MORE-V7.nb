           RowBox[{"\[Chi]", "[", 
            RowBox[{"locSource", ",", 
             SubscriptBox["t", "T"], ",", "1"}], "]"}]}]}], ")"}], "]"}]}]}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"V", "[", 
       RowBox[{"(", 
        RowBox[{"1", "+", " ", 
         RowBox[{
