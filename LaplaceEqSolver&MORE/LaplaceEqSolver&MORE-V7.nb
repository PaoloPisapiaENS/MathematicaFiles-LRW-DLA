Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "ExpectationValueBlock", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "ExpectationValueBlock", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<operator\>\"", "->", "1"}], ",", 
      RowBox[{"\"\<print\>\"", "->", "False"}], ",", " ", 
      RowBox[{"\"\<fields\>\"", "->", 
       RowBox[{"{", "\[Chi]", "}"}]}], ",", 
      RowBox[{"\"\<endTime\>\"", "->", "1"}], ",", 
      RowBox[{"\"\<draw\>\"", "->", "False"}], ",", 
      RowBox[{"\"\<graph\>\"", "->", "g"}], ",", " ", 
      RowBox[{"\"\<Rrule\>\"", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"R", "[", "__", "]"}], "->", "1"}], "}"}]}], ",", 
      RowBox[{"\"\<external\[Delta]\>\"", "->", "True"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ExpectationValueBlock", "[", 
   RowBox[{"Z_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"Nvertices", ",", "z", ",", "terms", ",", 
      RowBox[{"graphs", "=", 
       RowBox[{"{", "}"}]}], ",", "i"}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Nvertices", "=", 
      RowBox[{"Length", "[", 
       RowBox[{"VertexList", "@", 
        RowBox[{"OptionValue", "[", "\"\<graph\>\"", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<operator\>\"", "]"}], "===", "1"}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{"(*", "True", "*)"}], 
       RowBox[{"z", "=", 
        RowBox[{"WickContractionBlock", "[", 
         RowBox[{"Z", ",", "\[IndentingNewLine]", 
          RowBox[{"\"\<print\>\"", "->", 
           RowBox[{"OptionValue", "[", "\"\<print\>\"", "]"}]}], ",", " ", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<fields\>\"", "->", 
           RowBox[{"OptionValue", "[", "\"\<fields\>\"", "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<endTime\>\"", "->", 
           RowBox[{"OptionValue", "[", "\"\<endTime\>\"", "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<#vertices\>\"", "->", "Nvertices"}]}], 
         "\[IndentingNewLine]", "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", "False", "*)"}], 
       RowBox[{"z", "=", 
        RowBox[{
         RowBox[{"WickContractionBlock", "[", 
          RowBox[{
           RowBox[{"Z", "*", 
            RowBox[{"Op", "[", 
             RowBox[{"OptionValue", "[", "\"\<operator\>\"", "]"}], "]"}]}], 
           ",", "\[IndentingNewLine]", 
           RowBox[{"\"\<print\>\"", "->", 
            RowBox[{"OptionValue", "[", "\"\<print\>\"", "]"}]}], ",", " ", 
           "\[IndentingNewLine]", 
           RowBox[{"\"\<fields\>\"", "->", 
            RowBox[{"OptionValue", "[", "\"\<fields\>\"", "]"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"\"\<endTime\>\"", "->", 
            RowBox[{"OptionValue", "[", "\"\<endTime\>\"", "]"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"\"\<#vertices\>\"", "->", "Nvertices"}]}], 
          "\[IndentingNewLine]", "]"}], "/", 
         RowBox[{"WickContractionBlock", "[", 
          RowBox[{"Z", ",", " ", 
           RowBox[{"\"\<fields\>\"", "->", 
            RowBox[{"OptionValue", "[", "\"\<fields\>\"", "]"}]}], ",", 
           RowBox[{"\"\<endTime\>\"", "->", 
            RowBox[{"OptionValue", "[", "\"\<endTime\>\"", "]"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"\"\<#vertices\>\"", "->", "Nvertices"}]}], "]"}]}]}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"OptionValue", "[", "\"\<external\[Delta]\>\"", "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"z", "=", 
        RowBox[{"z", "//.", "\[Delta]ruleExternal"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"z", "=", 
      RowBox[{"z", "/.", 
       RowBox[{"n", "->", 
        RowBox[{"-", "1"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"z", "=", 
      RowBox[{"z", "/.", 
       RowBox[{"m", "->", "0"}]}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
