                  SubscriptBox["k", "x"]}], "]"}]}]}], ")"}], " ", "]"}]}]}], 
          "\[IndentingNewLine]", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], "]"}], 
       "\[IndentingNewLine]", 
       RowBox[{"V", "[", 
        RowBox[{"(", 
         RowBox[{"1", "+", " ", 
          RowBox[{
           RowBox[{"\[Phi]s", "[", 
            RowBox[{"locSource", ",", 
