Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"-", 
          SubscriptBox[
           StyleBox["S", "TI"], 
           StyleBox["t", "TI"]]}]], "\[LongEqual]", 
       UnderscriptBox["\[Product]", 
        StyleBox["x", "TI"], LimitsPositioning -> True], 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"-", 
          UnderscriptBox["\[Sum]", 
           StyleBox["i", "TI"], LimitsPositioning -> True], 
          SubsuperscriptBox["\[Chi]", 
           StyleBox["i", "TI"], "*"], 
          RowBox[{"(", 
            RowBox[{
              StyleBox["x", "TI"], ",", 
              StyleBox["t", "TI"]}], ")"}], 
          SubscriptBox["\[Chi]", 
           StyleBox["i", "TI"]], 
          RowBox[{"(", 
            RowBox[{
              StyleBox["x", "TI"], ",", 
              StyleBox["t", "TI"]}], ")"}], "-", 
          SuperscriptBox["\[Psi]", "*"], 
          RowBox[{"(", 
            RowBox[{
              StyleBox["x", "TI"], ",", 
              StyleBox["t", "TI"]}], ")"}], "\[Psi]", 
          RowBox[{"(", 
            RowBox[{
              StyleBox["x", "TI"], ",", 
              StyleBox["t", "TI"]}], ")"}], "-", 
          SuperscriptBox["\[Phi]", "*"], 
          RowBox[{"(", 
            RowBox[{
              StyleBox["x", "TI"], ",", 
              StyleBox["t", "TI"]}], ")"}], "\[Phi]", 
          RowBox[{"(", 
            RowBox[{
              StyleBox["x", "TI"], ",", 
              StyleBox["t", "TI"]}], ")"}]}]], 
       UnderscriptBox["\[Product]", 
        RowBox[{
          StyleBox["x", "TI"], "\[Element]", 
          StyleBox["G", "TI"], "\\", 
          RowBox[{"{", 
            StyleBox["s", "TI"], "}"}]}], LimitsPositioning -> True], 
       RowBox[{"{", 
         RowBox[{"1", "+", 
           UnderscriptBox["\[Sum]", 
            StyleBox["y", "TI"], LimitsPositioning -> True], 
           FractionBox[
            SubscriptBox["\[Beta]", 
             RowBox[{
               StyleBox["x", "TI"], 
               StyleBox["y", "TI"]}]], 
            SubscriptBox[
             StyleBox["r", "TI"], 
             StyleBox["x", "TI"]]], 
           SuperscriptBox["\[Phi]", "*"], 
           RowBox[{"(", 
             RowBox[{
               StyleBox["y", "TI"], ",", 
               StyleBox["t", "TI"], "+", "1"}], ")"}], "\[Phi]", 
           RowBox[{"(", 
             RowBox[{
               StyleBox["x", "TI"], ",", 
               StyleBox["t", "TI"]}], ")"}], 
           SuperscriptBox["\[Psi]", "*"], 
           RowBox[{"(", 
             RowBox[{
               StyleBox["x", "TI"], ",", 
               StyleBox["t", "TI"], "+", "1"}], ")"}], 
           SubsuperscriptBox["\[Chi]", "1", "*"], 
           RowBox[{"(", 
             RowBox[{
               StyleBox["y", "TI"], ",", 
               StyleBox["t", "TI"]}], ")"}], "+", 
           UnderscriptBox["\[Sum]", 
            StyleBox["y", "TI"], LimitsPositioning -> True], 
           FractionBox[
            SubscriptBox["\[Beta]", 
             RowBox[{
               StyleBox["x", "TI"], 
               StyleBox["y", "TI"]}]], 
            SubscriptBox[
             StyleBox["r", "TI"], 
             StyleBox["x", "TI"]]], 
           UnderoverscriptBox["\[Sum]", 
            StyleBox["i", "TI"], 
            RowBox[{
              StyleBox["N", "TI"], "\[LongEqual]", "-1"}], LimitsPositioning -> 
            True], 
           SubsuperscriptBox["\[Chi]", 
            StyleBox["i", "TI"], "*"], 
           RowBox[{"(", 
             RowBox[{
               StyleBox["y", "TI"], ",", 
               StyleBox["t", "TI"]}], ")"}], 
           SubscriptBox["\[Chi]", 
            StyleBox["i", "TI"]], 
           RowBox[{"(", 
             RowBox[{
               StyleBox["x", "TI"], ",", 
               StyleBox["t", "TI"]}], ")"}], "+", 
           SuperscriptBox["\[Psi]", "*"], 
           RowBox[{"(", 
             RowBox[{
               StyleBox["x", "TI"], ",", 
               StyleBox["t", "TI"], "+", "1"}], ")"}], "\[Psi]", 
           RowBox[{"(", 
             RowBox[{
               StyleBox["x", "TI"], ",", 
               StyleBox["t", "TI"]}], ")"}]}], "}"}], "\[Cross]", 
       RowBox[{"[", 
         RowBox[{"1", "+", "\[Psi]", 
           RowBox[{"(", 
             RowBox[{
               StyleBox["x", "TI"], ",", 
               StyleBox["T", "TI"], "+", "1"}], ")"}]}], "]"}], 
       RowBox[{"[", 
         RowBox[{"1", "+", 
           SubscriptBox[
            StyleBox["a", "TI"], 
            StyleBox["s", "TI"]], 
           RowBox[{"(", 
             StyleBox["t", "TI"], ")"}], 
           SubscriptBox["\[Chi]", "1"], 
           RowBox[{"(", 
             RowBox[{
               StyleBox["s", "TI"], ",", 
               StyleBox["t", "TI"]}], ")"}]}], "]"}]}], TraditionalForm], 
   "errors" -> {}, "input" -> 
   "e^{-S_t} =    \\prod_x  e^{-\\sum_i \
\\chi^*_i(x,t)\\chi_i(x,t)-\\psi^*(x,t)\\psi(x,t)-\\phi^*(x,t)\\phi(x,t)}  \
\\prod_{x \\in \\mathcal{ G} \\setminus \\{s\\}}\\left\\{1 +\\sum_y \
\\frac{\\beta_{xy}}{r_x}\\phi^*(y,t+1)\\phi(x,t) \\psi^*(x,t+1) \
\\chi^*_1(y,t) + \\sum_y \\frac{\\beta_{xy}}{r_x}  \\sum_i ^{N=-1} \
\\chi^*_i(y,t)\\chi_i(x,t)+ \\psi^*(x,t+1)\\psi(x,t) \\right\\} \
\\times\\Bigg[1+\\psi(x,T+1)\\Bigg] \\Bigg[ 1+a_s(t) \\chi_1(s,t)\\Bigg]", 
   "state" -> "Boxes"|>,
  "TeXAssistantTemplate"]], "Input",
 CellChangeTimes->{3.9470465192505913`*^9},
 EmphasizeSyntaxErrors->True,
 CellLabel->
  "In[623]:=",ExpressionUUID->"e04d3c3d-ba93-8049-a521-0c5779224662"],

Cell[TextData[{
 "For fields that do not have a color index, we default to set it to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["j", 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "6a10e7fd-d2da-b048-8cc0-399833ba1f8b"],
 ", because in the WickContraction[] it automated with color indices.\n\
Instead, the source is set with index 1, so that it can contract with an \
external \[OpenCurlyDoubleQuote]probe\[CloseCurlyDoubleQuote]"
}], "Text",
 CellChangeTimes->{{3.947131579459246*^9, 3.947131634737303*^9}, {
