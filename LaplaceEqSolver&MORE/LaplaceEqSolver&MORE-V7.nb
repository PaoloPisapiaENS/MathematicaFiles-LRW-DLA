        RowBox[{"locWeights", "=", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"locRoot", "=", "root"}], ",", 
        RowBox[{"locSource", "=", "source"}], ",", "p"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Clear", "[", "\[Beta]", "]"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", "1"}], ",", " ", 
          RowBox[{"i", "<=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"Dimensions", "@", "edges"}], ")"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", 
          RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"OptionValue", "[", "\"\<undirected\>\"", "]"}], " ", "&&",
               " ", 
              RowBox[{
               RowBox[{"edges", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "2"}], "]"}], "]"}], " ", "=!=", 
               "locSource"}], " ", "&&", " ", 
              RowBox[{
               RowBox[{"edges", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "2"}], "]"}], "]"}], " ", "=!=", 
               RowBox[{"edges", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "1"}], "]"}], "]"}]}]}], " ", ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"locEdges", ",", 
                RowBox[{
                 RowBox[{"edges", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "2"}], "]"}], "]"}], "->", 
                 RowBox[{"edges", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "1"}], "]"}], "]"}]}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"AppendTo", "[", 
               RowBox[{"locWeights", ",", 
                RowBox[{"\[Beta]", "[", 
                 RowBox[{
                  RowBox[{"edges", "[", 
