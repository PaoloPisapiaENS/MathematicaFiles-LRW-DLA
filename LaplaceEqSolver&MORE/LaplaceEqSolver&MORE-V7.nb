       "\[IndentingNewLine]", 
       RowBox[{"(*", "True", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"z", "=", 
         RowBox[{"z", "//.", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"R", "[", 
             RowBox[{"a_", ",", "b_", ",", "c_"}], "]"}], "n_"], "->", 
           RowBox[{"R", "[", 
            RowBox[{"a", ",", "b", ",", "c"}], "]"}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"terms", "=", 
         RowBox[{"List", " ", "@@", " ", 
          RowBox[{"(", 
           RowBox[{"z", "+", 
            RowBox[{"Zeta", "[", "3", "]"}]}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"terms", "=", 
         RowBox[{"terms", "//.", 
          RowBox[{
           RowBox[{"\[Beta]", "[", "__", "]"}], "->", "1"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"terms", "=", 
         RowBox[{"DeleteElements", "[", 
          RowBox[{"terms", ",", 
           RowBox[{"{", 
            RowBox[{"Zeta", "[", "3", "]"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"terms", "=", 
