                  RowBox[{"2", ";;"}]}], "]"}], "]"}], ",", 
               RowBox[{"\"\<drawOthers\>\"", "->", "False"}]}], "]"}]}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"graphs", "[", 
