Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"-", 
          SubscriptBox[
           StyleBox["S", "TI"], 
           StyleBox["t", "TI"]]}]], "\[LongEqual]", 
       UnderscriptBox["\[Product]", 
        StyleBox["x", "TI"], LimitsPositioning -> True], 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"-", 
          UnderscriptBox["\[Sum]", 
           StyleBox["i", "TI"], LimitsPositioning -> True], 
          SubsuperscriptBox["\[Chi]", 
           StyleBox["i", "TI"], "*"], 
          RowBox[{"(", 
            RowBox[{
              StyleBox["x", "TI"], ",", 
              StyleBox["t", "TI"]}], ")"}], 
          SubscriptBox["\[Chi]", 
           StyleBox["i", "TI"]], 
          RowBox[{"(", 
            RowBox[{
              StyleBox["x", "TI"], ",", 
              StyleBox["t", "TI"]}], ")"}], "-", 
          SuperscriptBox["\[Phi]", "*"], 
          RowBox[{"(", 
            RowBox[{
              StyleBox["x", "TI"], ",", 
              StyleBox["t", "TI"]}], ")"}], "\[Phi]", 
          RowBox[{"(", 
            RowBox[{
              StyleBox["x", "TI"], ",", 
              StyleBox["t", "TI"]}], ")"}]}]], "\[Cross]", 
       UnderscriptBox["\[Product]", 
        RowBox[{
          StyleBox["x", "TI"], "\[Element]", 
          StyleBox["G", "TI"], "\\", 
          RowBox[{"{", 
            StyleBox["s", "TI"], "}"}]}], LimitsPositioning -> True], 
       RowBox[{"{", 
         RowBox[{"1", "+", 
           UnderscriptBox["\[Sum]", 
            StyleBox["y", "TI"], LimitsPositioning -> True], 
           FractionBox[
            SubscriptBox["\[Beta]", 
             RowBox[{
               StyleBox["x", "TI"], 
               StyleBox["y", "TI"]}]], 
            SubscriptBox[
             StyleBox["r", "TI"], 
             StyleBox["x", "TI"]]], 
           UnderoverscriptBox["\[Sum]", 
            StyleBox["i", "TI"], 
            RowBox[{
              StyleBox["N", "TI"], "\[LongEqual]", "-1"}], LimitsPositioning -> 
            True], 
           SubsuperscriptBox["\[Chi]", 
            StyleBox["i", "TI"], "*"], 
           RowBox[{"(", 
             RowBox[{
               StyleBox["y", "TI"], ",", 
               StyleBox["t", "TI"]}], ")"}], 
           SubscriptBox["\[Chi]", 
            StyleBox["i", "TI"]], 
           RowBox[{"(", 
             RowBox[{
               StyleBox["x", "TI"], ",", 
               StyleBox["t", "TI"]}], ")"}], "+", 
           SuperscriptBox["\[Phi]", "*"], 
           RowBox[{"(", 
             RowBox[{
               StyleBox["x", "TI"], ",", 
               StyleBox["t", "TI"], "+", "1"}], ")"}], "\[Phi]", 
           RowBox[{"(", 
             RowBox[{
               StyleBox["x", "TI"], ",", 
               StyleBox["t", "TI"]}], ")"}], "+", "\n", "+", "\[Gamma]", 
           UnderscriptBox["\[Sum]", 
            StyleBox["y", "TI"], LimitsPositioning -> True], 
           SubscriptBox["\[Beta]", 
            RowBox[{
              StyleBox["x", "TI"], 
              StyleBox["y", "TI"]}]], 
           RowBox[{"(", 
             RowBox[{
               SuperscriptBox["\[Phi]", "*"], 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["y", "TI"], ",", 
                   StyleBox["t", "TI"], "+", "1"}], ")"}], 
               SuperscriptBox["\[Phi]", "*"], 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["x", "TI"], ",", 
                   StyleBox["t", "TI"], "+", "1"}], ")"}], "-", 
               SuperscriptBox["\[Phi]", "*"], 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["x", "TI"], ",", 
                   StyleBox["t", "TI"], "+", "1"}], ")"}]}], ")"}], "\[Phi]", 
           RowBox[{"(", 
             RowBox[{
               StyleBox["x", "TI"], ",", 
               StyleBox["t", "TI"]}], ")"}], 
           SubsuperscriptBox["\[Chi]", "1", "*"], 
           RowBox[{"(", 
             RowBox[{
               StyleBox["y", "TI"], ",", 
               StyleBox["t", "TI"]}], ")"}], 
           SubscriptBox["\[Chi]", "1"], 
           RowBox[{"(", 
             RowBox[{
               StyleBox["s", "TI"], ",", 
               StyleBox["t", "TI"]}], ")"}]}], "}"}], "."}], TraditionalForm],
    "errors" -> {}, "input" -> 
   "e^{-S_t} =\n    \\prod_x   e^{-\\sum_i \
\\chi^*_i(x,t)\\chi_i(x,t)-\\phi^*(x,t)\\phi(x,t)} \\times \\prod_{x \\in \
\\mc G \\setminus \\{s\\}}\n    \\Bigg\\{1 +\\sum_y \\frac{\\beta_{xy}}{r_x}  \
\\sum_i ^{N=-1} \\chi^*_i(y,t)\\chi_i(x,t)+ \\phi^*(x,t+1)\\phi(x,t)+\\\\+ \
\\gamma \\sum_y \\beta_{xy} \\Big(\\phi^*(y,t+1)\\phi^*(x,t+1) \
-\\phi^*(x,t+1) \\Big)\\phi(x,t)\\chi^*_1(y,t) \\chi_1(s,t) \\Bigg\\}.", 
   "state" -> "Boxes"|>,
  "TeXAssistantTemplate"]], "Input",
 CellChangeTimes->{3.9470465192505913`*^9},
 EmphasizeSyntaxErrors->True,
 CellLabel->
  "In[1076]:=",ExpressionUUID->"29e16154-de93-0d46-befc-eaa03e371933"],

Cell[TextData[{
 "For fields that do not have a color index, we default to set it to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["j", 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "c3c55837-f86a-8c4a-ae2b-4489c81bcdb4"],
 ", because in the WickContraction[] it automated with color indices.\n\
Instead, the source is set with index 1, so that it can contract with an \
external \[OpenCurlyDoubleQuote]probe\[CloseCurlyDoubleQuote]."
}], "Text",
 CellChangeTimes->{{3.947131579459246*^9, 3.947131634737303*^9}, {
