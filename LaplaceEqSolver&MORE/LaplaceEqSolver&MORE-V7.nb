Cell[BoxData[{
 RowBox[{
  RowBox[{"g", "=", 
   RowBox[{"AugmentedGraph", "[", "myFavoriteGraph", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"endTime", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fields", "=", 
   RowBox[{"{", 
    RowBox[{"\[Phi]", ",", "\[Chi]"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Z", "=", 
   RowBox[{"DynamicDLAaction", "[", 
    RowBox[{"g", ",", "endTime", ",", 
     RowBox[{"\"\<excludedVertices\>\"", "->", 
      RowBox[{"{", "1", "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"DLAnorm", "=", 
  RowBox[{"Limit", "[", 
   RowBox[{
    RowBox[{"\[Sigma]", 
