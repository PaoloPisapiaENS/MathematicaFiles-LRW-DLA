        RowBox[{"{", "}"}]}], ",", "l"}], "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"locFields", "=", "fields"}], ";", "\[IndentingNewLine]", 
