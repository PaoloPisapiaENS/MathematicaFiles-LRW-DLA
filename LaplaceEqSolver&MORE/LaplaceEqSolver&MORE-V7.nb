6325f4bdfbed"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "FinalDynamicDLAaction", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "FinalDynamicDLAaction", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<sourceBC\>\"", "->", "1"}], ",", 
