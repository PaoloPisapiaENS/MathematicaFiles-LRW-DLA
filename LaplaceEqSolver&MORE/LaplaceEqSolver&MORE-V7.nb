Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"-", 
          SubscriptBox[
           StyleBox["S", "TI"], 
           StyleBox["t", "TI"]]}]], "\[LongEqual]", 
       UnderscriptBox["\[Product]", 
        StyleBox["x", "TI"], LimitsPositioning -> True], 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"-", 
          UnderscriptBox["\[Sum]", 
           StyleBox["i", "TI"], LimitsPositioning -> True], 
          SubsuperscriptBox["\[Chi]", 
           StyleBox["i", "TI"], "*"], 
          RowBox[{"(", 
            RowBox[{
              StyleBox["x", "TI"], ",", 
              StyleBox["t", "TI"]}], ")"}], 
          SubscriptBox["\[Chi]", 
           StyleBox["i", "TI"]], 
          RowBox[{"(", 
            RowBox[{
              StyleBox["x", "TI"], ",", 
              StyleBox["t", "TI"]}], ")"}], "-", 
          SuperscriptBox["\[Psi]", "*"], 
          RowBox[{"(", 
            RowBox[{
              StyleBox["x", "TI"], ",", 
              StyleBox["t", "TI"]}], ")"}], "\[Psi]", 
          RowBox[{"(", 
            RowBox[{
              StyleBox["x", "TI"], ",", 
              StyleBox["t", "TI"]}], ")"}], "-", 
          SuperscriptBox["\[Phi]", "*"], 
          RowBox[{"(", 
            RowBox[{
              StyleBox["x", "TI"], ",", 
              StyleBox["t", "TI"]}], ")"}], "\[Phi]", 
          RowBox[{"(", 
            RowBox[{
              StyleBox["x", "TI"], ",", 
              StyleBox["t", "TI"]}], ")"}]}]], 
       UnderscriptBox["\[Product]", 
        RowBox[{
          StyleBox["x", "TI"], "\[Element]", 
          StyleBox["G", "TI"], "\\", 
          RowBox[{"{", 
            StyleBox["s", "TI"], "}"}]}], LimitsPositioning -> True], 
       RowBox[{"{", 
         RowBox[{"1", "+", 
           UnderscriptBox["\[Sum]", 
            StyleBox["y", "TI"], LimitsPositioning -> True], 
           FractionBox[
            SubscriptBox["\[Beta]", 
             RowBox[{
               StyleBox["x", "TI"], 
               StyleBox["y", "TI"]}]], 
            SubscriptBox[
             StyleBox["r", "TI"], 
             StyleBox["x", "TI"]]], 
           SuperscriptBox["\[Phi]", "*"], 
           RowBox[{"(", 
             RowBox[{
               StyleBox["y", "TI"], ",", 
               StyleBox["t", "TI"], "+", "1"}], ")"}], "\[Phi]", 
           RowBox[{"(", 
             RowBox[{
               StyleBox["x", "TI"], ",", 
               StyleBox["t", "TI"]}], ")"}], 
           SuperscriptBox["\[Psi]", "*"], 
           RowBox[{"(", 
             RowBox[{
               StyleBox["x", "TI"], ",", 
               StyleBox["t", "TI"], "+", "1"}], ")"}], 
           SubsuperscriptBox["\[Chi]", "1", "*"], 
           RowBox[{"(", 
             RowBox[{
               StyleBox["y", "TI"], ",", 
               StyleBox["t", "TI"]}], ")"}], "+", 
           UnderscriptBox["\[Sum]", 
            StyleBox["y", "TI"], LimitsPositioning -> True], 
           FractionBox[
            SubscriptBox["\[Beta]", 
             RowBox[{
               StyleBox["x", "TI"], 
               StyleBox["y", "TI"]}]], 
            SubscriptBox[
             StyleBox["r", "TI"], 
             StyleBox["x", "TI"]]], 
           UnderoverscriptBox["\[Sum]", 
            StyleBox["i", "TI"], 
            RowBox[{
              StyleBox["N", "TI"], "\[LongEqual]", "-1"}], LimitsPositioning -> 
            True], 
           SubsuperscriptBox["\[Chi]", 
            StyleBox["i", "TI"], "*"], 
           RowBox[{"(", 
             RowBox[{
               StyleBox["y", "TI"], ",", 
               StyleBox["t", "TI"]}], ")"}], 
           SubscriptBox["\[Chi]", 
            StyleBox["i", "TI"]], 
           RowBox[{"(", 
             RowBox[{
               StyleBox["x", "TI"], ",", 
               StyleBox["t", "TI"]}], ")"}], "+", 
           SuperscriptBox["\[Psi]", "*"], 
           RowBox[{"(", 
             RowBox[{
               StyleBox["x", "TI"], ",", 
               StyleBox["t", "TI"], "+", "1"}], ")"}], "\[Psi]", 
           RowBox[{"(", 
             RowBox[{
               StyleBox["x", "TI"], ",", 
               StyleBox["t", "TI"]}], ")"}]}], "}"}], "\[Cross]", 
       RowBox[{"[", 
         RowBox[{"1", "+", "\[Psi]", 
           RowBox[{"(", 
             RowBox[{
               StyleBox["x", "TI"], ",", 
               StyleBox["T", "TI"], "+", "1"}], ")"}]}], "]"}], 
       RowBox[{"[", 
         RowBox[{"1", "+", 
           SubscriptBox[
            StyleBox["a", "TI"], 
            StyleBox["s", "TI"]], 
           RowBox[{"(", 
             StyleBox["t", "TI"], ")"}], 
           SubscriptBox["\[Chi]", "1"], 
           RowBox[{"(", 
             RowBox[{
               StyleBox["s", "TI"], ",", 
               StyleBox["t", "TI"]}], ")"}]}], "]"}]}], TraditionalForm], 
   "errors" -> {}, "input" -> 
   "e^{-S_t} =    \\prod_x  e^{-\\sum_i \
\\chi^*_i(x,t)\\chi_i(x,t)-\\psi^*(x,t)\\psi(x,t)-\\phi^*(x,t)\\phi(x,t)}  \
\\prod_{x \\in \\mathcal{ G} \\setminus \\{s\\}}\\left\\{1 +\\sum_y \
\\frac{\\beta_{xy}}{r_x}\\phi^*(y,t+1)\\phi(x,t) \\psi^*(x,t+1) \
\\chi^*_1(y,t) + \\sum_y \\frac{\\beta_{xy}}{r_x}  \\sum_i ^{N=-1} \
\\chi^*_i(y,t)\\chi_i(x,t)+ \\psi^*(x,t+1)\\psi(x,t) \\right\\} \
\\times\\Bigg[1+\\psi(x,T+1)\\Bigg] \\Bigg[ 1+a_s(t) \\chi_1(s,t)\\Bigg]", 
   "state" -> "Boxes"|>,
  "TeXAssistantTemplate"]], "Input",
 CellChangeTimes->{3.9470465192505913`*^9},
 EmphasizeSyntaxErrors->True,
 CellLabel->
  "In[623]:=",ExpressionUUID->"b9ec30f0-2118-6f4d-9c8c-c9f95ed1eb0f"],

Cell[TextData[{
 "For fields that do not have a color index, we default to set it to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["j", 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "0ff625f8-0822-9446-8edf-aafb7dd81421"],
 ", because in the WickContraction[] it automated with color indices.\n\
Instead, the source is set with index 1, so that it can contract with an \
external \[OpenCurlyDoubleQuote]probe\[CloseCurlyDoubleQuote]"
}], "Text",
 CellChangeTimes->{{3.947131579459246*^9, 3.947131634737303*^9}, {
  3.947131688714962*^9, 3.947131719382986*^9}, {3.947234352715584*^9, 
  3.94723435879998*^9}},ExpressionUUID->"693ceba7-bd3a-e04a-ac2c-\
33329fcd238c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "DynamicLERWaction", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "DynamicLERWaction", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{"\"\<sourceBC\>\"", "->", "1"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DynamicLERWaction", "[", 
   RowBox[{"graph_", ",", "endTime_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "locSource", ",", "locRoot", ",", "locWeights", ",", "totWeights", ",", 
      "locVertices", ",", "actionTimeSlice", ",", "action"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Clear", "[", 
      RowBox[{"i", ",", "k", ",", "j"}], "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"locWeights", "=", 
      RowBox[{
       RowBox[{"WeightedAdjacencyMatrix", "[", "graph", "]"}], "//", 
       "Normal"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"totWeights", " ", "=", 
      RowBox[{"Total", "[", 
       RowBox[{"locWeights", ",", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"locVertices", "=", 
      RowBox[{"VertexList", "@", "graph"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"locRoot", " ", "=", " ", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"graph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<ROOT\>\""}]}], "]"}], "&"}]}], "]"}], 
        "[", 
        RowBox[{"[", 
