Cell[CellGroupData[{

Cell["\<\
DynamicLERWactionDerivatives[]\t!!!!!!!!!!!!!! IT WORKS !!!!!!!!!!!!!!\
\>", "Section",
 CellChangeTimes->{{3.947046438393255*^9, 3.947046448986958*^9}, 
   3.947128965444277*^9, {3.947907696295887*^9, 3.947907696894024*^9}, {
   3.951447684867695*^9, 3.951447690218338*^9}, {3.951559403933454*^9, 
   3.951559406758001*^9}, {3.951811505347435*^9, 
   3.951811530159549*^9}},ExpressionUUID->"0195cc10-c5e2-6b4e-bbb9-\
ded8e4895bc8"],

Cell[TextData[{
 "I want to answer the question: can I turn t+1 into time derivatives and y \
into Laplacians? I implement this by subtracting, e.g.,  f(t). If the \
modified action doesn\[CloseCurlyQuote]t change the result, then I can! \nI \
simply rewrite the action with ",
 Cell[BoxData[
  RowBox[{"\<\"\\\"\\!\\(\\*SubscriptBox[\\(S\\), \\(LRW, \
\[Gamma]\\)]\\)=\\\"\"\>", "\[InvisibleSpace]", "-", 
   RowBox[{"\[Gamma]", " ", 
    SubscriptBox["\[Phi]", 
     RowBox[{"x", ",", "t"}]], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        TemplateBox[{
          SubscriptBox[
           OverscriptBox["\[Chi]", "~"], 
           RowBox[{"x", ",", "t"}]], "2"},
         "Grad"]}], " ", 
       SubscriptBox[
        OverscriptBox["\[Delta]\[Phi]", "~"], 
        RowBox[{"x", ",", "t"}]]}], "+", 
      RowBox[{
       TemplateBox[{
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              OverscriptBox["\[Delta]\[Phi]", "~"], 
              RowBox[{"x", ",", "t"}]], " ", 
             SubscriptBox[
              OverscriptBox["\[Chi]", "~"], 
              RowBox[{"x", ",", "t"}]]}], ")"}], "2"},
        "Grad"], " ", 
       SubscriptBox[
        OverscriptBox["\[Delta]\[Psi]", "~"], 
        RowBox[{"x", ",", "t"}]]}]}], ")"}]}]}]], "Print",
  GeneratedCell->False,
  CellAutoOverwrite->False,
  CellChangeTimes->{{3.948865337048701*^9, 3.948865345905358*^9}, 
    3.948865458525028*^9, 3.950936752475893*^9, 3.950937271368866*^9, 
    3.9512797083943214`*^9, 3.951280631266508*^9, 3.9513840844736557`*^9, 
    3.951384274519554*^9, 3.9513859329835777`*^9, 3.951386304439604*^9, 
    3.951387368224079*^9, 3.95138744077775*^9, 3.951387588381033*^9, 
    3.95138763006126*^9, 3.951388160033422*^9},ExpressionUUID->
  "6074010a-bba7-fb4f-ae58-2bf1e5da56dd"],
 " and check whether this yield the same result.\nNB: I need to use the \
messenger field \[Xi], otherwise I make a mess. \n\nOf course I can do this \
to any degree of simplification. That is, I can do this just to set \
\[Chi](x)=0.\n\n\nI think I can still move the ex-gamma term at exponential! \
Let\[CloseCurlyQuote]s try WRONG!!!!"
}], "Text",
 CellChangeTimes->{{3.9470465063508663`*^9, 3.947046515093057*^9}, {
  3.947131571501259*^9, 3.947131572569847*^9}, {3.951447705083858*^9, 
  3.951447721828516*^9}, {3.951559426686567*^9, 3.951559442513262*^9}, {
  3.951559553968033*^9, 3.951559601145744*^9}, {3.951559651390234*^9, 
  3.951559664509409*^9}, {3.951560351700281*^9, 3.951560421195728*^9}, {
  3.951818128177044*^9, 3.951818150234112*^9}, {3.9518182228332195`*^9, 
  3.9518182480901356`*^9}, {3.951818575992897*^9, 3.9518185790583973`*^9}, {
  3.9518189692087383`*^9, 
  3.9518190055738125`*^9}},ExpressionUUID->"4fb39357-795e-d444-99fa-\
d129f3f11c3a"],

