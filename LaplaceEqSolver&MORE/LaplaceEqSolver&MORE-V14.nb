        RowBox[{"z", "=", 
         RowBox[{"z", "//.", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"R", "[", 
             RowBox[{"a_", ",", "b_", ",", "c_"}], "]"}], "n_"], "->", 
           RowBox[{"R", "[", 
            RowBox[{"a", ",", "b", ",", "c"}], "]"}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"terms", "=", 
         RowBox[{"List", " ", "@@", " ", 
          RowBox[{"(", 
           RowBox[{"z", "+", 
            RowBox[{"Zeta", "[", "3", "]"}]}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"terms", "=", 
