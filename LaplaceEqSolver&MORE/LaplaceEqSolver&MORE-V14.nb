Cell[CellGroupData[{

Cell["DrawOnGraph[]", "Section",
 CellChangeTimes->{{3.946454068917313*^9, 3.946454074666565*^9}, 
   3.946632327201769*^9, 
   3.946632384780033*^9},ExpressionUUID->"cfa364ec-a69c-e34f-bdfc-\
ad17e7674f6e"],

Cell["\<\
\[OpenCurlyDoubleQuote]Path\[CloseCurlyDoubleQuote] should be made of \
triplets whose first two elements are the initial and final vertices \
respectively, while the last is the color of this edge\
\>", "Text",
 CellChangeTimes->{{3.9471586654636097`*^9, 3.947158676283375*^9}, {
  3.947158739898224*^9, 
  3.947158794128586*^9}},ExpressionUUID->"9ac3d895-8239-c74c-9c0d-\
408b8f8cd563"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "DrawOnGraph", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "DrawOnGraph", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"\"\<drawOthers\>\"", "->", " ", "True"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DrawOnGraph", "[", 
   RowBox[{"graph_", ",", "path__", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"locEdges", ",", 
      RowBox[{"locPathStyle", "=", 
       RowBox[{"{", "}"}]}], ",", "locRoot", ",", "locSource", ",", "i"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"locEdges", " ", "=", " ", 
      RowBox[{"EdgeList", "@", "graph"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"locRoot", " ", "=", " ", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"graph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<ROOT\>\""}]}], "]"}], "&"}]}], "]"}], 
        "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"locSource", " ", "=", " ", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"graph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<SOURCE\>\""}]}], "]"}], "&"}]}], "]"}],
         "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", " ", 
       RowBox[{"i", "<=", 
        RowBox[{"Length", "[", "path", "]"}]}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"locPathStyle", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"path", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "1"}], "]"}], "]"}], "\[DirectedEdge]", 
             RowBox[{"path", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "->", 
            RowBox[{"path", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "3"}], "]"}], "]"}]}], "}"}]}], "]"}], 
        ";"}]}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Print", "[", "locPathStyle", "]"}], "*)"}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"OptionValue", "[", "\"\<drawOthers\>\"", "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", "True", "*)"}], 
       RowBox[{"Graph", "[", 
        RowBox[{"locEdges", ",", 
         RowBox[{"EdgeStyle", "->", 
          RowBox[{"Flatten", "@", 
           RowBox[{"{", 
            RowBox[{"locPathStyle", ",", "Blue"}], "}"}]}]}], ",", " ", 
         RowBox[{"VertexLabels", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"locRoot", "->", 
             RowBox[{
              RowBox[{"ToString", "[", "locRoot", "]"}], "\"\<,ROOT\>\""}]}], 
            ",", 
            RowBox[{"locSource", "->", 
             RowBox[{
              RowBox[{"ToString", "[", "locSource", "]"}], 
              "\"\<,SOURCE\>\""}]}], ",", "\"\<Name\>\""}], "}"}]}], ",", " ", 
         RowBox[{"VertexStyle", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"locRoot", "->", "Red"}], ",", 
            RowBox[{"locSource", "->", "Green"}], ",", "Blue"}], "}"}]}], ",", 
         RowBox[{"EdgeShapeFunction", "->", "\"\<FilledArrow\>\""}]}], "]"}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{"(*", "False", "*)"}], 
       RowBox[{"Graph", "[", 
        RowBox[{"locEdges", ",", 
         RowBox[{"EdgeStyle", "->", 
          RowBox[{"Flatten", "@", 
           RowBox[{"{", 
            RowBox[{"locPathStyle", ",", "White"}], "}"}]}]}], ",", " ", 
         RowBox[{"VertexLabels", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"locRoot", "->", 
             RowBox[{
              RowBox[{"ToString", "[", "locRoot", "]"}], "\"\<,ROOT\>\""}]}], 
            ",", 
            RowBox[{"locSource", "->", 
             RowBox[{
              RowBox[{"ToString", "[", "locSource", "]"}], 
              "\"\<,SOURCE\>\""}]}], ",", "\"\<Name\>\""}], "}"}]}], ",", " ", 
         RowBox[{"VertexStyle", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"locRoot", "->", "Red"}], ",", 
            RowBox[{"locSource", "->", "Green"}], ",", "Blue"}], "}"}]}], ",", 
         RowBox[{"EdgeShapeFunction", "->", "\"\<FilledArrow\>\""}]}], 
        "]"}]}], "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9464540779760075`*^9, 3.9464541185540104`*^9}, {
   3.946454148875323*^9, 3.9464542801191463`*^9}, {3.9464544402849865`*^9, 
