         RowBox[{"terms", "//.", 
          RowBox[{"Times", "->", "List"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"terms", "=", 
         RowBox[{"monoFlatten", "@@@", "terms"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"terms", "=", 
         RowBox[{"terms", "//.", 
          RowBox[{
           RowBox[{"R", "[", 
            RowBox[{"a_", ",", "b_", ",", "c_"}], "]"}], "->", 
           RowBox[{"{", 
            RowBox[{"a", ",", "b", ",", "c"}], "}"}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
