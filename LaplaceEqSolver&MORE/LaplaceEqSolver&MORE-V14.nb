Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "ConvergenceLERWrealInteraction", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "ConvergenceLERWrealInteraction", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<graph\>\"", "->", "g"}], ",", 
      RowBox[{"\"\<fields\>\"", "->", 
       RowBox[{"FieldsNamesGenerator", "[", 
        RowBox[{"{", 
         RowBox[{"\[Phi]", ",", "\[Psi]", ",", "\[Chi]"}], "}"}], "]"}]}], 
      ",", 
      RowBox[{"\"\<steps\>\"", "->", "10"}], ",", 
      RowBox[{"\"\<precision\>\"", "->", 
       SuperscriptBox["10", 
        RowBox[{"-", "9"}]]}], ",", 
      RowBox[{"\"\<theory\>\"", "->", "\"\<DLA\>\""}], ",", 
      RowBox[{"\"\<gammaValue\>\"", "->", "0.1"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ConvergenceLERWrealInteraction", "[", 
   RowBox[{"operator_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "Z", ",", "Z0", ",", "locOperator", ",", "locPrecision", ",", 
      "loc\[Gamma]", ",", "exp", ",", 
      RowBox[{"i", "=", "1"}], ",", "temp"}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Z", "=", 
      RowBox[{
       RowBox[{"LRWactionREALinteraction", "[", 
        RowBox[{
         RowBox[{"\"\<graph\>\"", "->", 
          RowBox[{"OptionValue", "[", " ", "\"\<graph\>\"", "]"}]}], ",", 
         RowBox[{"\"\<endTime\>\"", "->", "1"}]}], "]"}], "/.", 
       RowBox[{
        RowBox[{"\[Beta]", "[", "__", "]"}], "->", "1."}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"locOperator", "=", " ", 
      RowBox[{"operator", "/", 
       RowBox[{"Znorm", "[", 
        RowBox[{"operator", ",", 
         RowBox[{"\"\<graph\>\"", "->", 
          RowBox[{"OptionValue", "[", "\"\<graph\>\"", "]"}]}], ",", 
         RowBox[{"\"\<fieldsToExclude\>\"", "->", 
          RowBox[{"{", "\[Psi]s", "}"}]}]}], "]"}]}]}], ";", " ", 
     RowBox[{"(*", 
      RowBox[{"Normalized", " ", "immediately"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"locPrecision", "=", 
      RowBox[{"OptionValue", "[", "\"\<precision\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"loc\[Gamma]", "=", 
      RowBox[{"OptionValue", "[", "\"\<gammaValue\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"exp", "=", 
      RowBox[{"ExpectationValueBlock", "[", 
       RowBox[{
        RowBox[{"Z", " ", "locOperator"}], ",", 
        RowBox[{"\"\<endTime\>\"", "->", "1"}], ",", 
        RowBox[{"\"\<fields\>\"", "->", 
         RowBox[{"OptionValue", "[", "\"\<fields\>\"", "]"}]}], ",", 
        RowBox[{"\"\<Rrule\>\"", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"R", "[", 
            RowBox[{"__", ",", "Blue"}], "]"}], "->", "1."}], "}"}]}], ",", 
        RowBox[{"\"\<graph\>\"", "->", 
         RowBox[{"OptionValue", "[", " ", "\"\<graph\>\"", "]"}]}], ",", 
        RowBox[{"\"\<n\[Chi]\>\"", "->", 
         RowBox[{"-", "1"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"exp", "=", 
      RowBox[{
       RowBox[{"exp", "/.", 
        RowBox[{
         SubscriptBox["t", "a_"], "->", 
         SubscriptBox["t", 
          RowBox[{"a", "-", "1"}]]}]}], "/.", 
       RowBox[{"\[Gamma]", "->", "loc\[Gamma]"}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", "LOOP", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "2"}], ",", 
       RowBox[{
        RowBox[{"i", "<=", 
         RowBox[{"OptionValue", "[", "\"\<steps\>\"", "]"}]}], " ", "&&", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Coefficient", "[", 
            RowBox[{"exp", ",", " ", 
             RowBox[{"\[Phi]s", "[", 
              RowBox[{"1", ",", 
               SubscriptBox["t", "1"], ",", 
               SubscriptBox["k", "1"]}], "]"}]}], "]"}], "/.", 
           RowBox[{
            RowBox[{"R", "[", "__", "]"}], "->", "0"}]}], ")"}], ">=", 
         "locPrecision"}]}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"exp", "=", 
         RowBox[{"Replace", "[", 
          RowBox[{"exp", ",", 
           RowBox[{
            RowBox[{"a_", "/;", 
             RowBox[{"(", 
              RowBox[{"!", 
               RowBox[{"NumericQ", "[", "a", "]"}]}], ")"}]}], ":>", 
            RowBox[{"a", "/", 
             RowBox[{"(", 
              RowBox[{"Znorm", "[", 
               RowBox[{"a", ",", 
                RowBox[{"\"\<graph\>\"", "->", 
                 RowBox[{"OptionValue", "[", "\"\<graph\>\"", "]"}]}], ",", 
                RowBox[{"\"\<fieldsToExclude\>\"", "->", 
                 RowBox[{"{", "\[Psi]s", "}"}]}]}], "]"}], ")"}]}]}], ",", 
           "1"}], "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"exp", "=", 
         RowBox[{"ExpectationValueBlock", "[", 
          RowBox[{
           RowBox[{"Z", " ", "exp"}], ",", 
           RowBox[{"\"\<endTime\>\"", "->", "1"}], ",", 
           RowBox[{"\"\<fields\>\"", "->", 
            RowBox[{"OptionValue", "[", "\"\<fields\>\"", "]"}]}], ",", 
           RowBox[{"\"\<Rrule\>\"", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"R", "[", 
               RowBox[{"__", ",", "Blue"}], "]"}], "->", "1."}], "}"}]}], ",", 
           RowBox[{"\"\<graph\>\"", "->", 
            RowBox[{"OptionValue", "[", " ", "\"\<graph\>\"", "]"}]}], ",", 
           RowBox[{"\"\<n\[Chi]\>\"", "->", 
            RowBox[{"-", "1"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"exp", "=", 
         RowBox[{
          RowBox[{"exp", "/.", 
           RowBox[{
            SubscriptBox["t", "a_"], "->", 
            SubscriptBox["t", 
             RowBox[{"a", "-", "1"}]]}]}], "/.", 
          RowBox[{"\[Gamma]", "->", "loc\[Gamma]"}]}]}], ";"}]}], 
      "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], ";", 
