    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Nvertices", "=", 
      RowBox[{"Length", "[", 
       RowBox[{"VertexList", "@", 
        RowBox[{"OptionValue", "[", "\"\<graph\>\"", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<operator\>\"", "]"}], "===", "1"}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{"(*", "True", "*)"}], 
       RowBox[{"z", "=", 
        RowBox[{"WickContractionBlock", "[", 
         RowBox[{"Z", ",", "\[IndentingNewLine]", 
          RowBox[{"\"\<print\>\"", "->", 
           RowBox[{"OptionValue", "[", "\"\<print\>\"", "]"}]}], ",", " ", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<fields\>\"", "->", 
           RowBox[{"OptionValue", "[", "\"\<fields\>\"", "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<endTime\>\"", "->", 
           RowBox[{"OptionValue", "[", "\"\<endTime\>\"", "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"\"\<#vertices\>\"", "->", "Nvertices"}]}], 
