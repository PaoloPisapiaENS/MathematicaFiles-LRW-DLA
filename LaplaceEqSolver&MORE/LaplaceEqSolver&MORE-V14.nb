Cell[TextData[{
 "In this version I copy a double field and then annihilate it in the next \
step. So, I am effectively copying a single field. However, I do this so that \
I can simplify the \[Gamma] vertex. The goal is to have ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Gamma]", 
    RowBox[{"\[Del]", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[Chi]", "*"], 
       RowBox[{"\[Del]", 
        SuperscriptBox["\[Phi]", 
         RowBox[{"*", "2"}]]}]}], ")"}]}], "\[Phi]"}], TraditionalForm]],
  FormatType->TraditionalForm,
  Background->RGBColor[1, 0.9, 0.8],ExpressionUUID->
  "50106533-1d3b-4c44-bcaa-39cd8159b002"],
 ", i.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Gamma]", "(", 
     RowBox[{
      RowBox[{
       SuperscriptBox["\[Phi]", "*"], "[", 
       RowBox[{"y", ",", 
        RowBox[{"t", "+", "1"}]}], "]"}], "-", 
      RowBox[{
       SuperscriptBox["\[Phi]", "*"], "[", 
       RowBox[{"x", ",", 
        RowBox[{"t", "+", "1"}]}], "]"}]}], ")"}], 
    RowBox[{
     SuperscriptBox["\[Phi]", "*"], "[", 
     RowBox[{"x", ",", "t"}], "]"}], 
    RowBox[{
     SuperscriptBox["\[Chi]", "*"], "[", 
     RowBox[{"y", ",", "t"}], "]"}], "\[Phi]"}], TraditionalForm]],
  FormatType->TraditionalForm,
  Background->RGBColor[1, 0.9, 0.8],ExpressionUUID->
  "6b00d43d-d816-d648-a524-2db4e1567fad"],
 ". \nTo do this I need a \[OpenCurlyDoubleQuote]purification\
\[CloseCurlyDoubleQuote] layer in which the fields are reset to order 1. \n\
WARNING: we are using a \[Psi] just for technical reasons."
}], "Text",
 CellChangeTimes->{{3.9493748750632153`*^9, 3.9493749468896656`*^9}, {
  3.9493749895650425`*^9, 3.949375051521914*^9}, {3.949375382639179*^9, 
