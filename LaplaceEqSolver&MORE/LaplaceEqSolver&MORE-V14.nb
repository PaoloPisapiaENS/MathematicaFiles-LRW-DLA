Cell[CellGroupData[{

Cell["DrawFromExpression[]", "Section",
 CellChangeTimes->{{3.947587433704223*^9, 
  3.947587453022045*^9}},ExpressionUUID->"1a7cca1d-126b-9f47-b8f8-\
62549253891d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "DrawFromExpression", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "DrawFromExpression", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<graph\>\"", "->", "g"}], ",", 
      RowBox[{"\"\<drawOthers\>\"", "->", "False"}]}], "}"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DrawFromExpression", "[", 
   RowBox[{"exp_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"terms", ",", 
      RowBox[{"graphs", "=", 
       RowBox[{"{", "}"}]}], ",", "i"}], "}"}], ",", "\n", 
    RowBox[{
     RowBox[{"terms", "=", 
      RowBox[{
       RowBox[{"exp", "//.", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"R", "[", 
           RowBox[{"a_", ",", "b_", ",", "c_"}], "]"}], "n_"], "->", 
         RowBox[{"R", "[", 
          RowBox[{"a", ",", "b", ",", "c"}], "]"}]}]}], "//", "Expand"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"terms", "=", 
      RowBox[{"List", " ", "@@", " ", 
       RowBox[{"(", 
        RowBox[{"terms", "+", 
         RowBox[{"Zeta", "[", "3", "]"}]}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"terms", "=", 
      RowBox[{"terms", "//.", 
       RowBox[{
        RowBox[{"\[Beta]", "[", "__", "]"}], "->", "1"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"terms", "=", 
      RowBox[{"DeleteElements", "[", 
       RowBox[{"terms", ",", 
        RowBox[{"{", 
         RowBox[{"Zeta", "[", "3", "]"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"terms", "=", 
      RowBox[{"Outer", "[", 
       RowBox[{"List", ",", "terms"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"terms", "=", 
      RowBox[{"terms", "//.", 
       RowBox[{"Times", "->", "List"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"terms", "=", 
      RowBox[{"monoFlatten", "@@@", "terms"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"terms", "=", 
      RowBox[{"terms", "//.", 
       RowBox[{
        RowBox[{"R", "[", 
         RowBox[{"a_", ",", "b_", ",", "c_"}], "]"}], "->", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b", ",", "c"}], "}"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", 
         RowBox[{"i", "<=", 
          RowBox[{"Length", "[", "terms", "]"}]}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"terms", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "=", 
           RowBox[{"DeleteElements", "[", 
            RowBox[{
             RowBox[{"terms", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"a_", "?", "NumericQ"}], "}"}]}], "]"}]}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "terms", "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<=", 
        RowBox[{"Length", "[", "terms", "]"}]}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"graphs", ",", 
          RowBox[{"DrawOnGraph", "[", 
           RowBox[{
            RowBox[{"OptionValue", "[", "\"\<graph\>\"", "]"}], ",", 
            RowBox[{"terms", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", 
               RowBox[{"2", ";;"}]}], "]"}], "]"}], ",", 
            RowBox[{"\"\<drawOthers\>\"", "->", 
             RowBox[{"OptionValue", "[", "\"\<drawOthers\>\"", "]"}]}]}], 
           "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"graphs", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"Weight", " ", "==", 
          RowBox[{"terms", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "1"}], "]"}], "]"}]}], "]"}], ";"}]}], "\n", 
      "]"}], ";"}]}], "\n", "]"}]}]}], "Code",
 CellChangeTimes->{{3.947587457138987*^9, 3.94758752866209*^9}, {
   3.947587560612142*^9, 3.947587597856365*^9}, 3.947587771967296*^9, {
