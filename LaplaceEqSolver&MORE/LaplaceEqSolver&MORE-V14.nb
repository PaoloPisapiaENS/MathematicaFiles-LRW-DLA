      RowBox[{"\"\<Rrule\>\"", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"R", "[", "__", "]"}], "->", "1"}], "}"}]}], ",", 
      RowBox[{"\"\<external\[Delta]\>\"", "->", "True"}], ",", 
      RowBox[{"\"\<n\[Chi]\>\"", "->", 
       RowBox[{"-", "1"}]}], ",", 
      RowBox[{"\"\<n\[Alpha]\>\"", "->", "0"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ExpectationValueBlock", "[", 
   RowBox[{"Z_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
