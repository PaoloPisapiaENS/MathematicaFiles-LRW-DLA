Cell[CellGroupData[{

Cell["ConvergenceLERW[] NO NORMALIZATION BY HAND", "Subsection",
 CellChangeTimes->{{3.947932509994894*^9, 3.947932549332403*^9}, {
  3.948186005136362*^9, 3.948186008749977*^9}, {3.951390731830309*^9, 
  3.951390733676489*^9}, {3.9514476583080997`*^9, 
  3.951447669352167*^9}},ExpressionUUID->"a671ba1f-a7a3-5444-a96b-\
1d41bb151088"],

Cell["\<\
I want to check whether I really get the wrong result if I do not normalize \
at each step\
\>", "Text",
 CellChangeTimes->{{3.9513907625274143`*^9, 
  3.9513907884283543`*^9}},ExpressionUUID->"f23eb773-06d0-0749-bc69-\
71cfeab1cb81"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "ConvergenceLERW", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "ConvergenceLERW", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<graph\>\"", "->", "g"}], ",", 
      RowBox[{"\"\<fields\>\"", "->", 
