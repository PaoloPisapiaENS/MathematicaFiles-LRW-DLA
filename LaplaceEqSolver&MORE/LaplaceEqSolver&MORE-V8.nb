          RowBox[{"(", 
            RowBox[{
              StyleBox["x", "TI"], ",", 
              StyleBox["t", "TI"]}], ")"}], "-", 
          SuperscriptBox["\[Psi]", "*"], 
          RowBox[{"(", 
