              RowBox[{"OptionValue", "[", "\"\<excludedVertices\>\"", "]"}], 
              ",", "x"}], "]"}]}], ",", "1", ",", "\[IndentingNewLine]", 
           RowBox[{"(*", "FALSE", "*)"}], 
           RowBox[{"V", "[", 
            RowBox[{"(", 
             RowBox[{"1", "+", 
              RowBox[{"\[Gamma]", " ", 
               RowBox[{"Sum", "[", 
                RowBox[{
                 RowBox[{
