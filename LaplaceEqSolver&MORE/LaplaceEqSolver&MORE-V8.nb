Cell[TextData[{
 "For fields that do not have a color index, we default to set it to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["j", 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "aeff0efc-c075-c240-ae51-0530a985d785"],
 ", because in the WickContraction[] it automated with color indices.\n\
Instead, the source is set with index 1, so that it can contract with an \
external \[OpenCurlyDoubleQuote]probe\[CloseCurlyDoubleQuote]."
}], "Text",
 CellChangeTimes->{{3.947131579459246*^9, 3.947131634737303*^9}, {
   3.947131688714962*^9, 3.947131719382986*^9}, {3.947234352715584*^9, 
   3.94723435879998*^9}, 
   3.947304529435337*^9},ExpressionUUID->"b17627ca-ec49-df4c-87e0-\
579ed4b3a610"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "DynamicDLAaction", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "DynamicDLAaction", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<sourceBC\>\"", "->", "1"}], ",", 
      RowBox[{"\"\<excludedVertices\>\"", "->", 
       RowBox[{"{", "}"}]}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DynamicDLAaction", "[", 
   RowBox[{"graph_", ",", "endTime_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "locSource", ",", "locRoot", ",", "locWeights", ",", "totWeights", ",", 
      "locVertices", ",", "actionTimeSlice", ",", "action"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Clear", "[", 
      RowBox[{"i", ",", "k", ",", "j"}], "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"locWeights", "=", 
      RowBox[{
       RowBox[{"WeightedAdjacencyMatrix", "[", "graph", "]"}], "//", 
       "Normal"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"totWeights", " ", "=", 
      RowBox[{"Total", "[", 
       RowBox[{"locWeights", ",", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"locVertices", "=", 
      RowBox[{"VertexList", "@", "graph"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"locRoot", " ", "=", " ", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"graph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<ROOT\>\""}]}], "]"}], "&"}]}], "]"}], 
        "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"locSource", " ", "=", " ", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"graph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<SOURCE\>\""}]}], "]"}], "&"}]}], "]"}],
         "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"actionTimeSlice", " ", "[", "T_", "]"}], ":=", " ", 
      RowBox[{
       RowBox[{"Product", "[", " ", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"totWeights", "[", 
              RowBox[{"[", "x", "]"}], "]"}], "===", "0"}], "  ", "||", " ", 
            RowBox[{"MemberQ", "[", 
             RowBox[{
              RowBox[{"OptionValue", "[", "\"\<excludedVertices\>\"", "]"}], 
              ",", "x"}], "]"}]}], ",", "1", ",", 
           RowBox[{"(*", "FALSE", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"V", "[", 
            RowBox[{"(", 
             RowBox[{"1", "+", " ", 
              RowBox[{"Sum", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"locWeights", "[", 
                  RowBox[{"[", 
                   RowBox[{"x", ",", "y"}], "]"}], "]"}], 
                 RowBox[{"R", "[", 
                  RowBox[{"x", ",", "y", ",", "Red"}], "]"}], 
                 RowBox[{"\[Phi]s", "[", 
                  RowBox[{"y", ",", 
                   SubscriptBox["t", 
                    RowBox[{"T", "+", "1"}]], ",", 
                   SubscriptBox["k", "x"]}], "]"}], 
                 RowBox[{"\[Phi]", "[", 
                  RowBox[{"x", ",", 
                   SubscriptBox["t", "T"], ",", 
                   SubscriptBox["k", "x"]}], "]"}], 
                 RowBox[{"\[Phi]s", "[", 
                  RowBox[{"x", ",", 
                   SubscriptBox["t", 
                    RowBox[{"T", "+", "1"}]], ",", 
                   SubscriptBox["k", "x"]}], "]"}], 
                 RowBox[{"\[Chi]s", "[", 
                  RowBox[{"y", ",", 
                   SubscriptBox["t", "T"], ",", "1"}], "]"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"y", ",", 
                  RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], 
               "]"}], "+", 
              RowBox[{"Sum", "[", 
               RowBox[{
                RowBox[{
                 FractionBox[
                  RowBox[{"locWeights", "[", 
                   RowBox[{"[", 
                    RowBox[{"x", ",", "y"}], "]"}], "]"}], 
                  RowBox[{"totWeights", "[", 
                   RowBox[{"[", "x", "]"}], "]"}]], 
                 RowBox[{"R", "[", 
                  RowBox[{"x", ",", "y", ",", "Blue"}], "]"}], 
                 RowBox[{"\[Chi]s", "[", 
                  RowBox[{"y", ",", 
                   SubscriptBox["t", "T"], ",", 
                   SubscriptBox["i", "x"]}], "]"}], 
                 RowBox[{"\[Chi]", "[", 
                  RowBox[{"x", ",", 
                   SubscriptBox["t", "T"], ",", 
                   SubscriptBox["i", "x"]}], "]"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"y", ",", 
                  RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], 
               "]"}], "+", " ", 
              RowBox[{
               RowBox[{"\[Phi]s", "[", 
                RowBox[{"x", ",", 
                 SubscriptBox["t", 
                  RowBox[{"T", "+", "1"}]], ",", 
                 SubscriptBox["k", "x"]}], "]"}], 
               RowBox[{"\[Phi]", "[", 
                RowBox[{"x", ",", 
                 SubscriptBox["t", "T"], ",", 
                 SubscriptBox["k", "x"]}], "]"}]}]}], ")"}], " ", "]"}]}], 
          "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], "]"}], 
       "\[IndentingNewLine]", 
       RowBox[{"V", "[", 
        RowBox[{"(", 
         RowBox[{"1", "+", " ", 
          RowBox[{
           RowBox[{"OptionValue", "[", "\"\<sourceBC\>\"", "]"}], " ", 
           RowBox[{"\[Chi]", "[", 
            RowBox[{"locSource", ",", 
             SubscriptBox["t", "T"], ",", "1"}], "]"}]}]}], ")"}], "]"}]}]}], 
     ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"action", "=", 
      RowBox[{
       RowBox[{"Product", "[", 
        RowBox[{
         RowBox[{"actionTimeSlice", "[", "T", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"T", ",", "endTime"}], "}"}]}], "]"}], 
       RowBox[{"Product", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"V", "[", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"\[Phi]", "[", 
              RowBox[{"x", ",", 
               SubscriptBox["t", 
                RowBox[{"endTime", "+", "1"}]], ",", 
               SubscriptBox["k", "x"]}], "]"}]}], ")"}], 
           RowBox[{"(*", 
            RowBox[{
            "This", " ", "allows", " ", "the", " ", "path", " ", "tracker", 
             " ", "to", " ", "be", " ", "absorbed", " ", "at", " ", "the", 
             " ", "end"}], "*)"}], " ", "]"}], 
          RowBox[{"V", "[", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"\[Phi]", "[", 
              RowBox[{"x", ",", 
               SubscriptBox["t", 
                RowBox[{"endTime", "+", "1"}]], ",", "0"}], "]"}]}], ")"}], 
           RowBox[{"(*", 
            RowBox[{
            "This", " ", "allows", " ", "the", " ", "path", " ", "to", " ", 
             "end", " ", "after", " ", "\"\<endTime\>\"", " ", "steps"}], 
            "*)"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], "]"}]}]}], 
     ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "action", "]"}]}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
 InitializationCell->True,
