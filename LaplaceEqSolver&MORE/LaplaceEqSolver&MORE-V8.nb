              SubscriptBox["t", 
               RowBox[{"locEndTime", "+", "1"}]], ",", "0"}], "]"}]}], ")"}], 
          RowBox[{"(*", 
           RowBox[{
           "This", " ", "allows", " ", "the", " ", "path", " ", "to", " ", 
