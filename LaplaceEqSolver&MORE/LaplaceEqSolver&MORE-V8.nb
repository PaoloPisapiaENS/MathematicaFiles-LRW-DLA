                    SubscriptBox["k", "x"]}], "]"}], 
                    RowBox[{"\[Psi]s", "[", 
                    RowBox[{"x", ",", 
                    SubscriptBox["t", 
                    RowBox[{"T", "+", "1"}]], ",", 
                    SubscriptBox["j", 
                    RowBox[{"-", "1"}]]}], "]"}]}], "-", " ", 
                    RowBox[{"\[Phi]s", "[", 
                    RowBox[{"x", ",", 
                    SubscriptBox["t", 
                    RowBox[{"T", "+", "1"}]], ",", 
                    SubscriptBox["k", "x"]}], "]"}]}], ")"}], 
                  RowBox[{"\[Phi]", "[", 
                   RowBox[{"x", ",", 
                    SubscriptBox["t", "T"], ",", 
                    SubscriptBox["k", "x"]}], "]"}], 
                  RowBox[{"\[Chi]s", "[", 
                   RowBox[{"y", ",", 
                    SubscriptBox["t", "T"], ",", "1"}], "]"}]}]}], "]"}], " ",
                ",", 
               RowBox[{"{", 
                RowBox[{"y", ",", 
                 RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], 
              "]"}]}], "+", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"totWeights", "[", 
                  RowBox[{"[", "x", "]"}], "]"}], "===", "0"}], " ", ",", "0",
                 ",", 
                RowBox[{"(*", "FALSE", "*)"}], 
                RowBox[{
