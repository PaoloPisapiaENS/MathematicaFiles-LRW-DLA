Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       SubsuperscriptBox[
        StyleBox["P", "TI"], 
        RowBox[{
          StyleBox["L", "TI"], 
          StyleBox["E", "TI"], 
          StyleBox["R", "TI"], 
          StyleBox["W", "TI"]}], 
        StyleBox["s", "TI"]], 
       RowBox[{"(", 
         RowBox[{"\[Gamma]", "\[Rule]", "\[Gamma]", "+", 
           StyleBox["x", "TI"]}], ")"}], "\[LongEqual]", 
       FractionBox[
        RowBox[{"\[Beta]", 
          RowBox[{
            StyleBox["v", "TI"], 
            StyleBox["x", "TI"]}]}], 
        SubscriptBox[
         StyleBox["r", "TI"], 
         StyleBox["v", "TI"]]], 
       FractionBox[
        RowBox[{"\[Integral]", 
          SuperscriptBox[
           StyleBox["e", "TI"], 
           RowBox[{"-", 
             SubscriptBox[
              StyleBox["S", "TI"], 
              RowBox[{
                StyleBox["G", "TI"], "|", "\[Gamma]", "\[Union]", 
                RowBox[{"{", 
                  StyleBox["s", "TI"], "}"}]}]]}]], 
          SubsuperscriptBox["\[Chi]", "1", "*"], 
          RowBox[{"(", 
            StyleBox["x", "TI"], ")"}], 
          SubscriptBox["\[Chi]", "1"], 
          RowBox[{"(", 
            StyleBox["s", "TI"], ")"}]}], 
        RowBox[{"\[Integral]", 
          SuperscriptBox[
           StyleBox["e", "TI"], 
           RowBox[{"-", 
             SubscriptBox[
              StyleBox["S", "TI"], 
              RowBox[{
                StyleBox["G", "TI"], "|", "\[Gamma]", "\[Union]", 
                RowBox[{"{", 
                  StyleBox["s", "TI"], "}"}], "\\", 
                RowBox[{"{", 
                  StyleBox["v", "TI"], "}"}]}]]}]], 
          SubsuperscriptBox["\[Chi]", "1", "*"], 
          RowBox[{"(", 
            StyleBox["v", "TI"], ")"}], 
          SubscriptBox["\[Chi]", "1"], 
          RowBox[{"(", 
            StyleBox["s", "TI"], ")"}]}]]}], TraditionalForm], "errors" -> {},
    "input" -> 
   "\\mathcal{ P}_{LERW}^s(\\gamma \\to \\gamma+x) = \
\\frac{\\beta{vx}}{r_{v}} \\frac{\\int e^{-{\\mathcal{ S}_{\\mathcal {G} | \
\\gamma \\cup \\{s\\}}}\n    }\\chi^*_1(x)\\chi_1(s) }{\\int e^{-{\\mathcal \
{S}_{\\mathcal{ G} | \\gamma \\cup \\{s\\} \\setminus  \\{v\\}}}\n    \
}\\chi^*_1(v)\\chi_1(s) }", "state" -> "Boxes"|>,
  "TeXAssistantTemplate"]], "DisplayFormula",
 CellChangeTimes->{3.947046100917994*^9},
 EmphasizeSyntaxErrors->True,
 CellLabel->
  "In[576]:=",ExpressionUUID->"1a9c7098-d038-964e-9055-d4e4c896ba3b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "LERWtransitionProb", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "LERWtransitionProb", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<draw\>\"", "->", "False"}], ",", 
      RowBox[{"\"\<print\>\"", "->", "False"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LERWtransitionProb", "[", 
   RowBox[{"graph_", ",", "path__", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "locSource", ",", "locRoot", ",", "locWeights", ",", "totWeights", ",", 
      "locVertices", ",", "denominator", ",", 
      RowBox[{"prob", "=", "1"}], ",", " ", "Z", ",", "numerator"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"locWeights", "=", 
      RowBox[{
       RowBox[{"WeightedAdjacencyMatrix", "[", "graph", "]"}], "//", 
       "Normal"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"totWeights", " ", "=", 
      RowBox[{"Total", "[", 
       RowBox[{"locWeights", ",", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"locVertices", "=", 
      RowBox[{"VertexList", "@", "graph"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"locRoot", " ", "=", " ", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"graph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<ROOT\>\""}]}], "]"}], "&"}]}], "]"}], 
        "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"locSource", " ", "=", " ", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"graph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<SOURCE\>\""}]}], "]"}], "&"}]}], "]"}],
         "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"locRoot", " ", "=!=", " ", 
        RowBox[{"path", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<####  WRONG ROOT  ####\>\"", "]"}], ";", 
        " ", 
        RowBox[{"Return", "[", "NULL", "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"locSource", " ", "=!=", " ", 
        RowBox[{"path", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "2"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<####  WRONG SOURCE  ####\>\"", "]"}], ";", 
        RowBox[{"Return", "[", "NULL", "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"locBC", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", "}"}], ",", 
            RowBox[{"{", "}"}]}], "}"}]}], ",", "\[Phi]", ",", 
         RowBox[{"i", "=", "1"}], ",", "j"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"locBC", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[Phi]", "[", "locSource", "]"}], "==", "1"}], "}"}], 
           ",", 
           RowBox[{"{", "locSource", "}"}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", "1"}], ",", 
          RowBox[{"i", "<=", 
           RowBox[{"Length", "[", "path", "]"}]}], ",", 
          RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"Z", "=", 
             RowBox[{"VertexAssignment", "[", 
              RowBox[{"graph", ",", " ", 
               RowBox[{"\"\<excludedVertices\>\"", "->", 
                RowBox[{"locBC", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"Z", "=", 
             RowBox[{"ExpectationValue", "[", 
              RowBox[{"Z", "*", 
               RowBox[{"\[Chi]s", "[", 
                RowBox[{
                 RowBox[{"path", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", "1"}], "]"}]}],
               "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"OptionValue", "[", "\"\<print\>\"", "]"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
               "Print", "[", 
                "\"\<#####  Previous Partition Function  #####\>\"", "]"}], 
               ";", "\[IndentingNewLine]", 
               RowBox[{"Print", "[", "Z", "]"}]}]}], "\[IndentingNewLine]", 
             "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"denominator", "=", 
             RowBox[{"Z", "//", "FullSimplify"}]}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
             "Then", " ", "we", " ", "need", " ", "to", " ", "solve", " ", 
              "it", " ", "again", " ", "with", " ", "updated", " ", "BC", " ",
               "at", " ", "the", " ", "current", " ", "step"}], "*)"}], 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{
              RowBox[{"locBC", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{"\[Phi]", "[", 
                RowBox[{"path", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "==", "0"}]}],
              "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{
              RowBox[{"locBC", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", 
              RowBox[{"path", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "1"}], "]"}], "]"}]}], "]"}], ";"}], 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"Print", "[", "locBC", "]"}], "*)"}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"Z", "=", 
            RowBox[{"VertexAssignment", "[", 
             RowBox[{"graph", ",", " ", 
              RowBox[{"\"\<excludedVertices\>\"", "->", 
               RowBox[{"locBC", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], ",", 
              RowBox[{"\"\<sourceBC\>\"", "->", 
               SuperscriptBox["denominator", 
                RowBox[{"-", "1"}]]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"Z", "=", 
            RowBox[{"ExpectationValue", "[", 
             RowBox[{"Z", "*", 
              RowBox[{"\[Chi]s", "[", 
               RowBox[{
                RowBox[{"path", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", "1"}], "]"}]}], 
             " ", "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"OptionValue", "[", "\"\<print\>\"", "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
              "Print", "[", 
               "\"\<#####  Current Partition Function  #####\>\"", "]"}], ";",
               "\[IndentingNewLine]", 
              RowBox[{"Print", "[", "Z", "]"}]}]}], "\[IndentingNewLine]", 
            "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"numerator", "=", 
            RowBox[{
             RowBox[{
              FractionBox[
               RowBox[{"locWeights", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"path", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
                  RowBox[{"path", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}], 
               RowBox[{"totWeights", "[", 
                RowBox[{"[", 
                 RowBox[{"path", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "]"}]], "*", 
              "Z"}], "//", "FullSimplify"}]}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<#####  Transition probability \>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"path", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "<>", 
             "\"\< to \>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"path", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "2"}], "]"}], "]"}], "]"}], "<>", 
             "\"\<  #####\>\""}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{
             RowBox[{"numerator", "/.", 
              RowBox[{
               RowBox[{"\[Beta]", "[", 
                RowBox[{"_", ",", "_"}], "]"}], "->", "1"}]}], "//", 
             "FullSimplify"}], "]"}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"prob", "*=", "numerator"}], "//", "FullSimplify"}], 
           ";"}]}], "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
