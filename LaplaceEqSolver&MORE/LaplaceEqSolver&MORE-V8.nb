Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "ExtractPaths", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ExtractPaths", "[", "exp_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"terms", ",", 
      RowBox[{"paths", "=", 
       RowBox[{"{", "}"}]}], ",", "i"}], "}"}], ",", "\n", "\n", 
    RowBox[{
     RowBox[{"terms", "=", 
      RowBox[{"exp", "//", "Expand"}]}], ";", "\n", 
     RowBox[{"terms", "=", 
      RowBox[{"List", " ", "@@", 
       RowBox[{"Collect", "[", 
        RowBox[{"terms", ",", 
         RowBox[{"R", "[", 
          RowBox[{"__", ",", "Red"}], "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"terms", "=", 
      RowBox[{"Outer", "[", 
       RowBox[{"List", ",", "terms"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<=", 
        RowBox[{"Length", "[", "terms", "]"}]}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"MatchQ", "[", 
          RowBox[{
           RowBox[{"terms", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"R", "[", 
             RowBox[{"__", ",", "Red"}], "]"}], "*", "A_"}]}], "]"}], ",", 
         "\n", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"paths", ",", 
           RowBox[{"terms", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
        "]"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"terms", "=", 
      RowBox[{
       RowBox[{"paths", "//.", 
        RowBox[{
         RowBox[{"R", "[", 
          RowBox[{"__", ",", "Blue"}], "]"}], "->", "1"}]}], "//", 
       "FullSimplify"}]}], ";", "\n", "\n", 
     RowBox[{"Return", "[", "terms", "]"}]}]}], "\n", "]"}]}]}], "Code",
