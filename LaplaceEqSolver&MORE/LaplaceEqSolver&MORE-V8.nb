     RowBox[{"(*", 
      RowBox[{"Product", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"V", "[", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"\[Phi]", "[", 
             RowBox[{"x", ",", 
