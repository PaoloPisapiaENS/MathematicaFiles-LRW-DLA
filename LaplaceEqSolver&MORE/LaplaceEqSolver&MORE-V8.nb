           RowBox[{"\[Chi]", "[", 
            RowBox[{"locSource", ",", 
             SubscriptBox["t", "T"], ",", "1"}], "]"}]}]}], ")"}], "]"}]}]}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"V", "[", 
       RowBox[{"(", 
        RowBox[{"1", "+", " ", 
         RowBox[{
          RowBox[{"OptionValue", "[", "\"\<sourceBC\>\"", "]"}], " ", 
          RowBox[{"\[Chi]", "[", 
           RowBox[{"locSource", ",", 
            SubscriptBox["t", "T"], ",", "1"}], "]"}]}]}], ")"}], "]"}], 
      "*)"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"action", "=", 
      RowBox[{"Product", "[", 
       RowBox[{
        RowBox[{"actionTimeSlice", "[", "T", "]"}], ",", 
