        RowBox[{
         RowBox[{"V", "[", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"\[Gamma]", " ", 
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"totWeights", "[", 
                   RowBox[{"[", "x", "]"}], "]"}], "===", "0"}], " ", ",", 
