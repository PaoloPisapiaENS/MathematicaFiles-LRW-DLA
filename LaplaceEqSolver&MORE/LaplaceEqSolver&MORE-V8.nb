             SubscriptBox["t", "T"], ",", "1"}], "]"}]}]}], ")"}], "]"}]}]}], 
     ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"action", "=", 
      RowBox[{
       RowBox[{"Product", "[", 
        RowBox[{
         RowBox[{"actionTimeSlice", "[", "T", "]"}], ",", 
         RowBox[{"{", 
