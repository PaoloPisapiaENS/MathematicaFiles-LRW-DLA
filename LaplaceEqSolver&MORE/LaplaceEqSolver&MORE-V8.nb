             RowBox[{"\[Phi]", "[", 
              RowBox[{"x", ",", 
               SubscriptBox["t", 
                RowBox[{"locEndTime", "+", "1"}]], ",", 
               SubscriptBox["k", "x"]}], "]"}]}], ")"}], 
           RowBox[{"(*", 
