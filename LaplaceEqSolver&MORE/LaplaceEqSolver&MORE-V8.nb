             RowBox[{"\[Psi]", "[", 
              RowBox[{"x", ",", 
               SubscriptBox["t", 
                RowBox[{"endTime", "+", "1"}]], ",", 
               SubscriptBox["j", 
                RowBox[{"-", "1"}]]}], "]"}]}], ")"}], 
           RowBox[{"(*", 
            RowBox[{
            "This", " ", "allows", " ", "the", " ", "path", " ", "tracker", 
             " ", "to", " ", "be", " ", "absorbed", " ", "at", " ", "the", 
             " ", "end"}], "*)"}], " ", "]"}], 
          RowBox[{"V", "[", 
