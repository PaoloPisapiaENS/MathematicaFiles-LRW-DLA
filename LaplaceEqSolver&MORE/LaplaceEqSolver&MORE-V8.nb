             RowBox[{"\[Phi]", "[", 
              RowBox[{"x", ",", 
               SubscriptBox["t", "T"], ",", 
               SubscriptBox["k", "x"]}], "]"}]}]}], ")"}], " ", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], "]"}], 
       "\[IndentingNewLine]", 
       RowBox[{"V", "[", 
        RowBox[{"(", 
         RowBox[{"1", "+", " ", 
          RowBox[{
           RowBox[{"OptionValue", "[", "\"\<sourceBC\>\"", "]"}], " ", 
           RowBox[{"\[Chi]", "[", 
            RowBox[{"locSource", ",", 
             SubscriptBox["t", "T"], ",", "1"}], "]"}]}]}], ")"}], "]"}]}]}], 
     ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"action", "=", 
      RowBox[{
       RowBox[{"Product", "[", 
