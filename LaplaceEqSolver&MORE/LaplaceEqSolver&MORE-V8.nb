     "\[IndentingNewLine]", 
     RowBox[{"locEndTime", " ", "=", 
      RowBox[{"OptionValue", "[", "\"\<endTime\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"locWeights", "=", 
      RowBox[{
       RowBox[{"WeightedAdjacencyMatrix", "[", "locGraph", "]"}], "//", 
       "Normal"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"totWeights", " ", "=", 
      RowBox[{"Total", "[", 
       RowBox[{"locWeights", ",", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"locVertices", "=", 
      RowBox[{"VertexList", "@", "locGraph"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"locRoot", " ", "=", " ", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"locGraph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<ROOT\>\""}]}], "]"}], "&"}]}], "]"}], 
        "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
