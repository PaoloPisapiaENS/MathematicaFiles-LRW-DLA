         RowBox[{"actionTimeSlice", "[", "T", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"T", ",", "locStartingTime", ",", "locEndTime"}], "}"}]}], 
        "]"}], 
       RowBox[{"Product", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"V", "[", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"\[Psi]", "[", 
              RowBox[{"x", ",", 
               SubscriptBox["t", 
                RowBox[{"locEndTime", "+", "1"}]], ",", 
               SubscriptBox["j", 
                RowBox[{"-", "1"}]]}], "]"}]}], ")"}], 
           RowBox[{"(*", 
