            StyleBox["i", "TI"]], 
           RowBox[{"(", 
             RowBox[{
               StyleBox["x", "TI"], ",", 
               StyleBox["t", "TI"]}], ")"}], "+", 
           SuperscriptBox["\[Psi]", "*"], 
           RowBox[{"(", 
             RowBox[{
               StyleBox["x", "TI"], ",", 
               StyleBox["t", "TI"], "+", "1"}], ")"}], "\[Psi]", 
           RowBox[{"(", 
             RowBox[{
               StyleBox["x", "TI"], ",", 
               StyleBox["t", "TI"]}], ")"}]}], "}"}], "\[Cross]", 
       RowBox[{"[", 
         RowBox[{"1", "+", "\[Psi]", 
           RowBox[{"(", 
             RowBox[{
               StyleBox["x", "TI"], ",", 
               StyleBox["T", "TI"], "+", "1"}], ")"}]}], "]"}], 
       RowBox[{"[", 
         RowBox[{"1", "+", 
           SubscriptBox[
            StyleBox["a", "TI"], 
            StyleBox["s", "TI"]], 
           RowBox[{"(", 
             StyleBox["t", "TI"], ")"}], 
           SubscriptBox["\[Chi]", "1"], 
           RowBox[{"(", 
             RowBox[{
               StyleBox["s", "TI"], ",", 
               StyleBox["t", "TI"]}], ")"}]}], "]"}]}], TraditionalForm], 
   "errors" -> {}, "input" -> 
   "e^{-S_t} =    \\prod_x  e^{-\\sum_i \
\\chi^*_i(x,t)\\chi_i(x,t)-\\psi^*(x,t)\\psi(x,t)-\\phi^*(x,t)\\phi(x,t)}  \
\\prod_{x \\in \\mathcal{ G} \\setminus \\{s\\}}\\left\\{1 +\\sum_y \
\\frac{\\beta_{xy}}{r_x}\\phi^*(y,t+1)\\phi(x,t) \\psi^*(x,t+1) \
\\chi^*_1(y,t) + \\sum_y \\frac{\\beta_{xy}}{r_x}  \\sum_i ^{N=-1} \
\\chi^*_i(y,t)\\chi_i(x,t)+ \\psi^*(x,t+1)\\psi(x,t) \\right\\} \
\\times\\Bigg[1+\\psi(x,T+1)\\Bigg] \\Bigg[ 1+a_s(t) \\chi_1(s,t)\\Bigg]", 
   "state" -> "Boxes"|>,
  "TeXAssistantTemplate"]], "Input",
