  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DynamicLERWaction", "[", 
   RowBox[{"graph_", ",", "endTime_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "locSource", ",", "locRoot", ",", "locWeights", ",", "totWeights", ",", 
      "locVertices", ",", "actionTimeSlice", ",", "action"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Clear", "[", 
      RowBox[{"i", ",", "k", ",", "j"}], "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"locWeights", "=", 
      RowBox[{
       RowBox[{"WeightedAdjacencyMatrix", "[", "graph", "]"}], "//", 
       "Normal"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"totWeights", " ", "=", 
      RowBox[{"Total", "[", 
       RowBox[{"locWeights", ",", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"locVertices", "=", 
      RowBox[{"VertexList", "@", "graph"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"locRoot", " ", "=", " ", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"graph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<ROOT\>\""}]}], "]"}], "&"}]}], "]"}], 
        "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"locSource", " ", "=", " ", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"graph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<SOURCE\>\""}]}], "]"}], "&"}]}], "]"}],
         "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"actionTimeSlice", " ", "[", "T_", "]"}], ":=", " ", 
      RowBox[{
       RowBox[{"Product", "[", " ", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"totWeights", "[", 
             RowBox[{"[", "x", "]"}], "]"}], "===", "0"}], " ", ",", "1", ",", 
           RowBox[{"(*", "FALSE", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"V", "[", 
            RowBox[{"(", 
             RowBox[{"1", "+", " ", 
              RowBox[{"Sum", "[", 
               RowBox[{
                RowBox[{
                 FractionBox[
                  RowBox[{"locWeights", "[", 
                   RowBox[{"[", 
                    RowBox[{"x", ",", "y"}], "]"}], "]"}], 
                  RowBox[{"totWeights", "[", 
                   RowBox[{"[", "x", "]"}], "]"}]], 
                 RowBox[{"R", "[", 
                  RowBox[{"x", ",", "y", ",", "Red"}], "]"}], 
                 RowBox[{"\[Phi]s", "[", 
                  RowBox[{"y", ",", 
                   SubscriptBox["t", 
                    RowBox[{"T", "+", "1"}]], ",", 
                   SubscriptBox["k", "x"]}], "]"}], 
                 RowBox[{"\[Phi]", "[", 
                  RowBox[{"x", ",", 
                   SubscriptBox["t", "T"], ",", 
                   SubscriptBox["k", "x"]}], "]"}], 
                 RowBox[{"\[Psi]s", "[", 
                  RowBox[{"x", ",", 
                   SubscriptBox["t", 
                    RowBox[{"T", "+", "1"}]], ",", 
                   SubscriptBox["j", 
                    RowBox[{"-", "1"}]]}], "]"}], 
                 RowBox[{"\[Chi]s", "[", 
                  RowBox[{"y", ",", 
                   SubscriptBox["t", "T"], ",", "1"}], "]"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"y", ",", 
                  RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], 
               "]"}], "+", 
              RowBox[{"Sum", "[", 
               RowBox[{
                RowBox[{
                 FractionBox[
                  RowBox[{"locWeights", "[", 
                   RowBox[{"[", 
                    RowBox[{"x", ",", "y"}], "]"}], "]"}], 
                  RowBox[{"totWeights", "[", 
                   RowBox[{"[", "x", "]"}], "]"}]], 
                 RowBox[{"R", "[", 
                  RowBox[{"x", ",", "y", ",", "Blue"}], "]"}], 
                 RowBox[{"\[Chi]s", "[", 
                  RowBox[{"y", ",", 
                   SubscriptBox["t", "T"], ",", 
                   SubscriptBox["i", "x"]}], "]"}], 
                 RowBox[{"\[Chi]", "[", 
                  RowBox[{"x", ",", 
                   SubscriptBox["t", "T"], ",", 
                   SubscriptBox["i", "x"]}], "]"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"y", ",", 
                  RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], 
               "]"}], "+", " ", 
              RowBox[{
               RowBox[{"\[Psi]s", "[", 
                RowBox[{"x", ",", 
                 SubscriptBox["t", 
                  RowBox[{"T", "+", "1"}]], ",", 
                 SubscriptBox["j", 
                  RowBox[{"-", "1"}]]}], "]"}], 
               RowBox[{"\[Psi]", "[", 
                RowBox[{"x", ",", 
                 SubscriptBox["t", "T"], ",", 
                 SubscriptBox["j", 
                  RowBox[{"-", "1"}]]}], "]"}]}]}], ")"}], " ", "]"}]}], 
          "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], "]"}], 
       "\[IndentingNewLine]", 
       RowBox[{"V", "[", 
        RowBox[{"(", 
         RowBox[{"1", "+", " ", 
          RowBox[{
           RowBox[{"OptionValue", "[", "\"\<sourceBC\>\"", "]"}], " ", 
           RowBox[{"\[Chi]", "[", 
