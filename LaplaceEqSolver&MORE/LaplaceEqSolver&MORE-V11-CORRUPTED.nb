   3.9493759103874*^9, 3.949375940912094*^9}, {3.9494615922697945`*^9, 
   3.949461766492867*^9}, {3.949462503929502*^9, 3.949462530068489*^9}, {
   3.94946327863249*^9, 3.9494632787612348`*^9}, {3.950176699439604*^9, 
