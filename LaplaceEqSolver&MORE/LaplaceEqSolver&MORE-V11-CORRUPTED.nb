                  RowBox[{"totWeights", "[", 
                   RowBox[{"[", "x", "]"}], "]"}]], 
                 RowBox[{"R", "[", 
                  RowBox[{"x", ",", "y", ",", "Blue"}], "]"}], 
                 RowBox[{"\[Chi]s", "[", 
