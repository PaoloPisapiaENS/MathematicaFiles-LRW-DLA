Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "ConvergenceSARW\[Beta]", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "ConvergenceSARW\[Beta]", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<graph\>\"", "->", "g"}], ",", 
      RowBox[{"\"\<fields\>\"", "->", 
       RowBox[{"FieldsNamesGenerator", "[", 
        RowBox[{"{", 
         RowBox[{"\[Phi]", ",", "\[Psi]", ",", "\[Chi]"}], "}"}], "]"}]}], 
      ",", 
      RowBox[{"\"\<steps\>\"", "->", "10"}], ",", 
      RowBox[{"\"\<precision\>\"", "->", 
       SuperscriptBox["10", 
        RowBox[{"-", "9"}]]}], ",", 
      RowBox[{"\"\<gammaValue\>\"", "->", "0.1"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ConvergenceSARW\[Beta]", "[", 
   RowBox[{"operator_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "Z", ",", "locOperator", ",", "locPrecision", ",", "loc\[Gamma]", ",", 
      "exp", ",", 
      RowBox[{"ii", "=", "1"}], ",", "temp"}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Z", "=", 
      RowBox[{
       RowBox[{"DynamicSARWaction\[Beta]", "[", 
        RowBox[{
         RowBox[{"\"\<graph\>\"", "->", 
          RowBox[{"OptionValue", "[", " ", "\"\<graph\>\"", "]"}]}], ",", 
         RowBox[{"\"\<endTime\>\"", "->", "1"}]}], "]"}], "/.", 
       RowBox[{
        RowBox[{"\[Beta]", "[", "__", "]"}], "->", "1."}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"locOperator", "=", " ", "operator"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"locPrecision", "=", 
      RowBox[{"OptionValue", "[", "\"\<precision\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"loc\[Gamma]", "=", 
      RowBox[{"OptionValue", "[", "\"\<gammaValue\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"exp", "=", 
      RowBox[{"ExpectationValueBlock", "[", 
       RowBox[{
        RowBox[{"Z", "*", "locOperator"}], ",", 
        RowBox[{"\"\<endTime\>\"", "->", "1"}], ",", 
        RowBox[{"\"\<fields\>\"", "->", 
         RowBox[{"OptionValue", "[", "\"\<fields\>\"", "]"}]}], ",", 
        RowBox[{"\"\<Rrule\>\"", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"R", "[", 
            RowBox[{"__", ",", "Blue"}], "]"}], "->", "1."}], "}"}]}], ",", 
        RowBox[{"\"\<graph\>\"", "->", 
         RowBox[{"OptionValue", "[", " ", "\"\<graph\>\"", "]"}]}], ",", 
        RowBox[{"\"\<nFields\>\"", "->", "0"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"exp", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"exp", "/.", 
         RowBox[{
          SubscriptBox["t", "a_"], "->", 
          SubscriptBox["t", 
           RowBox[{"a", "-", "1"}]]}]}], "/.", 
        RowBox[{"\[Gamma]", "->", "loc\[Gamma]"}]}], "//", "Expand"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<########## i=\>\"", ",", "ii", ",", "\"\<, \>\"", ",", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Coefficient", "[", 
          RowBox[{"exp", ",", " ", 
           RowBox[{"\[Phi]s", "[", 
            RowBox[{"1", ",", 
             SubscriptBox["t", "1"], ",", 
             SubscriptBox["k", "1"]}], "]"}]}], "]"}], "/.", 
         RowBox[{
          RowBox[{"R", "[", "__", "]"}], "->", "0"}]}], ")"}], ",", 
       "\"\< ############\>\""}], "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"ii", "=", "2"}], ",", 
       RowBox[{
        RowBox[{"ii", "<=", 
         RowBox[{"OptionValue", "[", "\"\<steps\>\"", "]"}]}], " ", "&&", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Coefficient", "[", 
            RowBox[{"exp", ",", " ", 
             RowBox[{"\[Phi]s", "[", 
              RowBox[{"1", ",", 
               SubscriptBox["t", "1"], ",", 
               SubscriptBox["k", "1"]}], "]"}]}], "]"}], "/.", 
           RowBox[{
            RowBox[{"R", "[", "__", "]"}], "->", "0"}]}], ")"}], ">=", 
         "locPrecision"}]}], ",", 
       RowBox[{"ii", "++"}], ",", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"exp", "=", 
         RowBox[{"ExpectationValueBlock", "[", 
          RowBox[{
           RowBox[{"Z", "*", "exp"}], ",", 
           RowBox[{"\"\<endTime\>\"", "->", "1"}], ",", 
           RowBox[{"\"\<fields\>\"", "->", 
            RowBox[{"OptionValue", "[", "\"\<fields\>\"", "]"}]}], ",", 
           RowBox[{"\"\<Rrule\>\"", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"R", "[", 
               RowBox[{"__", ",", "Blue"}], "]"}], "->", "1."}], "}"}]}], ",", 
           RowBox[{"\"\<graph\>\"", "->", 
            RowBox[{"OptionValue", "[", " ", "\"\<graph\>\"", "]"}]}], ",", 
           RowBox[{"\"\<nFields\>\"", "->", "0"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"exp", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"exp", "/.", 
            RowBox[{
             SubscriptBox["t", "a_"], "->", 
             SubscriptBox["t", 
              RowBox[{"a", "-", "1"}]]}]}], "/.", 
           RowBox[{"\[Gamma]", "->", "loc\[Gamma]"}]}], "//", "Expand"}]}], 
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<########## i=\>\"", ",", "ii", ",", "\"\<, \>\"", ",", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Coefficient", "[", 
             RowBox[{"exp", ",", " ", 
              RowBox[{"\[Phi]s", "[", 
               RowBox[{"1", ",", 
                SubscriptBox["t", "1"], ",", 
                SubscriptBox["k", "1"]}], "]"}]}], "]"}], "/.", 
            RowBox[{
             RowBox[{"R", "[", "__", "]"}], "->", "0"}]}], ")"}], ",", 
          "\"\< ############\>\""}], "]"}], ";"}]}], "\[IndentingNewLine]", 
      "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "exp", "]"}], ";"}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
