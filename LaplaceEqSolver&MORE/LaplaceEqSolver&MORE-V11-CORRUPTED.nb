Cell["DynamicTSARWaction[]", "Section",
 CellChangeTimes->{{3.947046438393255*^9, 3.947046448986958*^9}, 
   3.947128965444277*^9, {3.947304429295563*^9, 3.947304429526634*^9}, {
   3.9479039518886013`*^9, 3.947903953617817*^9}, {3.949461440278736*^9, 
   3.94946144740184*^9}, {3.95118886762574*^9, 3.951188883637684*^9}, 
   3.9511924974827137`*^9},ExpressionUUID->"8db5d854-6bc7-ca49-8150-\
4ddf5de3c70d"],

Cell["\<\
This is the same as the LRW action with the difference that \[Chi] is \
identically 1.
I NEED A PURIFYING STEP & I need something to prevent from coming back on \
itself. I\[CloseCurlyQuote]m implementing this by using a \
\[OpenCurlyDoubleQuote]tracer\[CloseCurlyDoubleQuote] particle that just gets \
absorbed. I call it \[Chi] for simplicity of implementation\
\>", "Text",
 CellChangeTimes->{{3.947131579459246*^9, 3.947131634737303*^9}, {
   3.947131688714962*^9, 3.947131719382986*^9}, {3.947234352715584*^9, 
   3.94723435879998*^9}, 3.947304529435337*^9, {3.95118891601857*^9, 
   3.9511889456181183`*^9}, {3.951192416466921*^9, 3.95119253918009*^9}, {
   3.9511928849739857`*^9, 3.9511928903996506`*^9}, {3.9512052593997345`*^9, 
   3.951205315547367*^9}},ExpressionUUID->"a04761af-1818-9747-834c-\
f37fe28b5c49"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "DynamicTSARWaction", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "DynamicTSARWaction", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<sourceBC\>\"", "->", "1"}], ",", 
      RowBox[{"\"\<excludedVertices\>\"", "->", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{"\"\<graph\>\"", "->", "g"}], ",", 
      RowBox[{"\"\<endTime\>\"", "->", "10"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DynamicTSARWaction", "[", 
   RowBox[{"OptionsPattern", "[", "]"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "locGraph", ",", "locEndTime", ",", "locSource", ",", "locRoot", ",", 
      "locWeights", ",", "totWeights", ",", "locVertices", ",", 
      "actionTimeSlice", ",", "action"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Clear", "[", 
      RowBox[{"i", ",", "k", ",", "j", ",", "\[Gamma]"}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"locGraph", "=", 
      RowBox[{"OptionValue", "[", "\"\<graph\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"locEndTime", " ", "=", 
      RowBox[{"OptionValue", "[", "\"\<endTime\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"locWeights", "=", 
      RowBox[{
       RowBox[{"WeightedAdjacencyMatrix", "[", "locGraph", "]"}], "//", 
       "Normal"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"totWeights", " ", "=", 
      RowBox[{"Total", "[", 
       RowBox[{"locWeights", ",", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"locVertices", "=", 
      RowBox[{"VertexList", "@", "locGraph"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"locRoot", " ", "=", " ", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"locGraph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<ROOT\>\""}]}], "]"}], "&"}]}], "]"}], 
        "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"locSource", " ", "=", " ", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"locGraph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<SOURCE\>\""}]}], "]"}], "&"}]}], "]"}],
         "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"actionTimeSlice", " ", "[", "T_", "]"}], ":=", " ", 
      RowBox[{
       RowBox[{"Product", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"totWeights", "[", 
              RowBox[{"[", "x", "]"}], "]"}], "===", "0"}], "  ", "||", " ", 
            RowBox[{"MemberQ", "[", 
             RowBox[{
              RowBox[{"OptionValue", "[", "\"\<excludedVertices\>\"", "]"}], 
              ",", "x"}], "]"}]}], ",", "1", ",", "\[IndentingNewLine]", 
           RowBox[{"(*", "FALSE", "*)"}], 
           RowBox[{
            RowBox[{"V", "[", 
             RowBox[{"(", 
              RowBox[{"1", "+", 
               RowBox[{"\[Gamma]", " ", 
                RowBox[{"Sum", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"locWeights", "[", 
                    RowBox[{"[", 
                    RowBox[{"x", ",", "y"}], "]"}], "]"}], 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"R", "[", 
                    RowBox[{"x", ",", "y", ",", "Red"}], "]"}], 
                    RowBox[{"\[Phi]s", "[", 
                    RowBox[{"y", ",", 
