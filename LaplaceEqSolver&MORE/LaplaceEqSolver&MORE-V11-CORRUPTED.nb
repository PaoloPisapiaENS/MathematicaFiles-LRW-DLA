              RowBox[{"\[Phi]s", "[", 
               RowBox[{"1", ",", 
                SubscriptBox["t", "1"], ",", 
                SubscriptBox["k", "1"]}], "]"}]}], "]"}], "/.", 
            RowBox[{
             RowBox[{"R", "[", "__", "]"}], "->", "0"}]}], ")"}], ",", 
          "\"\< ############\>\""}], "]"}], ";"}]}], "\[IndentingNewLine]", 
      "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "exp", "]"}], ";"}]}], "\[IndentingNewLine]", 
