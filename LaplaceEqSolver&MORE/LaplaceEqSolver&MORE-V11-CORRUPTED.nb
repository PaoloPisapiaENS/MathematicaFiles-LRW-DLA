Cell[TextData[{
 "In this version I use the initial vertex with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["\[Phi]", "*"], "-", "1"}], ")"}], TraditionalForm]],
  Background->RGBColor[1, 1, 0],ExpressionUUID->
  "578219fb-b4d7-f849-826c-3dbd179d8a61"],
 " but I use an auxiliary field in the \[Gamma] term. This is arguably \
better(?)"
}], "Text",
 CellChangeTimes->{{3.9493748750632153`*^9, 3.9493749468896656`*^9}, {
  3.9493749895650425`*^9, 3.949375051521914*^9}, {3.949375382639179*^9, 
