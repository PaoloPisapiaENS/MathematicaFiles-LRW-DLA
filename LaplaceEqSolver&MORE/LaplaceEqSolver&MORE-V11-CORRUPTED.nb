                  RowBox[{"y", ",", 
                   RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], 
                "]"}]}], "+", "\[IndentingNewLine]", 
              RowBox[{"Sum", "[", 
               RowBox[{
                RowBox[{
