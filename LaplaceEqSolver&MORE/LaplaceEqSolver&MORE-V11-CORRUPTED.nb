                  RowBox[{"\[Phi]", "[", 
                   RowBox[{"x", ",", 
                    SubscriptBox["t", "T"], ",", 
                    SubscriptBox["k", "x"]}], "]"}], 
                  RowBox[{"\[Chi]s", "[", 
                   RowBox[{"y", ",", 
                    SubscriptBox["t", "T"], ",", "1"}], "]"}]}], ",", 
