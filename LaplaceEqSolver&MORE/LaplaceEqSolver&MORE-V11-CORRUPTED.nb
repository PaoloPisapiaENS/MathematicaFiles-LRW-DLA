      RowBox[{"\"\<precision\>\"", "->", 
       SuperscriptBox["10", 
        RowBox[{"-", "9"}]]}], ",", 
      RowBox[{"\"\<gammaValue\>\"", "->", "0.1"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ConvergenceSARW\[Beta]", "[", 
   RowBox[{"operator_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "Z", ",", "locOperator", ",", "locPrecision", ",", "loc\[Gamma]", ",", 
      "exp", ",", 
      RowBox[{"ii", "=", "1"}], ",", "temp"}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Z", "=", 
      RowBox[{
       RowBox[{"DynamicSARWaction\[Beta]", "[", 
        RowBox[{
         RowBox[{"\"\<graph\>\"", "->", 
          RowBox[{"OptionValue", "[", " ", "\"\<graph\>\"", "]"}]}], ",", 
         RowBox[{"\"\<endTime\>\"", "->", "1"}]}], "]"}], "/.", 
       RowBox[{
        RowBox[{"\[Beta]", "[", "__", "]"}], "->", "1."}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"locOperator", "=", " ", "operator"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"locPrecision", "=", 
      RowBox[{"OptionValue", "[", "\"\<precision\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"loc\[Gamma]", "=", 
      RowBox[{"OptionValue", "[", "\"\<gammaValue\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"exp", "=", 
      RowBox[{"ExpectationValueBlock", "[", 
       RowBox[{
        RowBox[{"Z", "*", "locOperator"}], ",", 
        RowBox[{"\"\<endTime\>\"", "->", "1"}], ",", 
        RowBox[{"\"\<fields\>\"", "->", 
         RowBox[{"OptionValue", "[", "\"\<fields\>\"", "]"}]}], ",", 
        RowBox[{"\"\<Rrule\>\"", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"R", "[", 
            RowBox[{"__", ",", "Blue"}], "]"}], "->", "1."}], "}"}]}], ",", 
        RowBox[{"\"\<graph\>\"", "->", 
         RowBox[{"OptionValue", "[", " ", "\"\<graph\>\"", "]"}]}], ",", 
        RowBox[{"\"\<nFields\>\"", "->", "0"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"exp", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"exp", "/.", 
