Cell[CellGroupData[{

Cell["DrawFromExpression[]", "Section",
 CellChangeTimes->{{3.947587433704223*^9, 
  3.947587453022045*^9}},ExpressionUUID->"1a7cca1d-126b-9f47-b8f8-\
62549253891d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "DrawFromExpression", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "DrawFromExpression", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<graph\>\"", "->", "g"}], ",", 
      RowBox[{"\"\<drawOthers\>\"", "->", "False"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"DrawFromExpression", "[", 
   RowBox[{"exp_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"terms", ",", 
      RowBox[{"graphs", "=", 
       RowBox[{"{", "}"}]}], ",", "i"}], "}"}], ",", "\n", 
    RowBox[{
     RowBox[{"terms", "=", 
      RowBox[{
       RowBox[{"exp", "//.", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"R", "[", 
           RowBox[{"a_", ",", "b_", ",", "c_"}], "]"}], "n_"], "->", 
         RowBox[{"R", "[", 
          RowBox[{"a", ",", "b", ",", "c"}], "]"}]}]}], "//", "Expand"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"terms", "=", 
      RowBox[{"List", " ", "@@", " ", 
       RowBox[{"(", 
        RowBox[{"terms", "+", 
         RowBox[{"Zeta", "[", "3", "]"}]}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"terms", "=", 
      RowBox[{"terms", "//.", 
       RowBox[{
        RowBox[{"\[Beta]", "[", "__", "]"}], "->", "1"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"terms", "=", 
      RowBox[{"DeleteElements", "[", 
       RowBox[{"terms", ",", 
        RowBox[{"{", 
         RowBox[{"Zeta", "[", "3", "]"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"terms", "=", 
      RowBox[{"Outer", "[", 
       RowBox[{"List", ",", "terms"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"terms", "=", 
      RowBox[{"terms", "//.", 
       RowBox[{"Times", "->", "List"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"terms", "=", 
      RowBox[{"monoFlatten", "@@@", "terms"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"terms", "=", 
      RowBox[{"terms", "//.", 
       RowBox[{
        RowBox[{"R", "[", 
         RowBox[{"a_", ",", "b_", ",", "c_"}], "]"}], "->", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b", ",", "c"}], "}"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", 
         RowBox[{"i", "<=", 
          RowBox[{"Length", "[", "terms", "]"}]}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"terms", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "=", 
           RowBox[{"DeleteElements", "[", 
            RowBox[{
             RowBox[{"terms", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"a_", "?", "NumericQ"}], "}"}]}], "]"}]}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "terms", "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<=", 
        RowBox[{"Length", "[", "terms", "]"}]}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"graphs", ",", 
          RowBox[{"DrawOnGraph", "[", 
           RowBox[{
            RowBox[{"OptionValue", "[", "\"\<graph\>\"", "]"}], ",", 
            RowBox[{"terms", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", 
               RowBox[{"2", ";;"}]}], "]"}], "]"}], ",", 
            RowBox[{"\"\<drawOthers\>\"", "->", 
             RowBox[{"OptionValue", "[", "\"\<drawOthers\>\"", "]"}]}]}], 
           "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"graphs", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"Weight", " ", "==", 
          RowBox[{"terms", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "1"}], "]"}], "]"}]}], "]"}], ";"}]}], "\n", 
      "]"}], ";"}]}], "\n", "]"}]}]}], "Code",
 CellChangeTimes->{{3.947587457138987*^9, 3.94758752866209*^9}, {
   3.947587560612142*^9, 3.947587597856365*^9}, 3.947587771967296*^9, {
   3.947587931703184*^9, 3.94758800527005*^9}, {3.947588064625824*^9, 
   3.947588071160824*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"ba9435de-b2ce-794f-91f3-b57f33369645"]
}, Open  ]],

Cell[CellGroupData[{

Cell["AugmentedGraph[]", "Section",
 CellChangeTimes->{{3.9473097483762274`*^9, 
  3.947309752462919*^9}},ExpressionUUID->"1bc7d842-1ac6-be4b-bde1-\
739dba010962"],

Cell["\<\
This is useful to compute the total incoming current from the source towards \
the DLA cluster/Tree. WE MUST ADD THE EDGE FROM THE OLD SOURCE TO THE NEW \
SOURCE, AS WELL AS ALLOW THE EDGES FROM THE OLD SOURCE TO THE NEIGHBORS\
\>", "Text",
 CellChangeTimes->{{3.947309774970585*^9, 3.9473097965891857`*^9}, {
  3.9473163434281826`*^9, 
  3.947316423106577*^9}},ExpressionUUID->"dd7df4ef-a43e-3f4d-b0a1-\
ab9de8b5c786"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "AugmentedGraph", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AugmentedGraph", "[", "graph_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"locVertices", ",", "locEdges", ",", 
      RowBox[{"locPathStyle", "=", 
       RowBox[{"{", "}"}]}], ",", "locRoot", ",", "locSource", ",", 
      "newSource", ",", "oldSourceNeighbors", ",", "graphPlus", ",", "i"}], 
     "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"locVertices", " ", "=", " ", 
      RowBox[{"VertexList", "@", "graph"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"locEdges", " ", "=", " ", 
      RowBox[{
       RowBox[{"EdgeList", "@", "graph"}], "/.", 
       RowBox[{"DirectedEdge", "->", "List"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"locRoot", " ", "=", " ", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"graph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<ROOT\>\""}]}], "]"}], "&"}]}], "]"}], 
        "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"locSource", " ", "=", " ", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"graph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<SOURCE\>\""}]}], "]"}], "&"}]}], "]"}],
         "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"newSource", "=", 
      RowBox[{
       RowBox[{"locVertices", "[", 
        RowBox[{"[", 
         RowBox[{"-", "1"}], "]"}], "]"}], "+", "1"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Add", " ", "the", " ", "edge", " ", "from", " ", "the", " ", 
       "oldSource", " ", "to", " ", "the", " ", "newSource"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"locEdges", ",", 
       RowBox[{"{", 
        RowBox[{"locSource", ",", "newSource"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Add", " ", "all", " ", "the", " ", "edges", " ", "from", " ", "the", 
       " ", "oldSource", " ", "to", " ", "its", " ", "neighbors"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"oldSourceNeighbors", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"locEdges", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "==", "locSource"}], " ", "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<=", 
        RowBox[{"Length", "[", "oldSourceNeighbors", "]"}]}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"locEdges", ",", 
         RowBox[{"{", 
          RowBox[{"locSource", ",", 
           RowBox[{"oldSourceNeighbors", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "1"}], "]"}], "]"}]}], "}"}]}], "]"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"graphPlus", " ", "=", 
      RowBox[{
       RowBox[{"MyGraph", "[", 
        RowBox[{"locEdges", ",", "locRoot", ",", "newSource", ",", 
         RowBox[{"\"\<undirected\>\"", "->", "False"}]}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{"{", 
       RowBox[{"graphPlus", ",", "locSource", ",", "newSource"}], "}"}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}]}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.947309755844429*^9, 3.94730976689428*^9}, {
  3.947309800591593*^9, 3.9473098396476955`*^9}, {3.9473099063504295`*^9, 
  3.947309928729601*^9}, {3.947310023977883*^9, 3.947310042171185*^9}, {
  3.9473101684275*^9, 3.947310227394001*^9}, {3.947310258023266*^9, 
