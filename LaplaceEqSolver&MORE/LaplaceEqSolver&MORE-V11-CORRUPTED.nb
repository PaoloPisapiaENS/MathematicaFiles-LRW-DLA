                   SubscriptBox["t", "T"], ",", 
                   SubscriptBox["i", "x"]}], "]"}], 
                 RowBox[{"\[Chi]", "[", 
                  RowBox[{"x", ",", 
                   SubscriptBox["t", "T"], ",", 
                   SubscriptBox["i", "x"]}], "]"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"y", ",", 
                  RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], 
               "]"}], "+", " ", 
              RowBox[{
               RowBox[{"\[Phi]s", "[", 
                RowBox[{"x", ",", 
                 SubscriptBox["t", 
                  RowBox[{"T", "+", "1"}]], ",", 
                 SubscriptBox["k", "x"]}], "]"}], 
               RowBox[{"\[Phi]", "[", 
