Cell["This action should be:", "Text",
 CellChangeTimes->{{3.9470465063508663`*^9, 3.947046515093057*^9}, {
  3.947131571501259*^9, 
  3.947131572569847*^9}},ExpressionUUID->"d07af7ea-3abe-7749-9a40-\
1d4c6009e0b1"],

Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"-", 
          SubscriptBox[
           StyleBox["S", "TI"], 
           StyleBox["t", "TI"]]}]], "\[LongEqual]", 
       UnderscriptBox["\[Product]", 
        StyleBox["x", "TI"], LimitsPositioning -> True], 
       SuperscriptBox[
        StyleBox["e", "TI"], 
        RowBox[{"-", 
          UnderscriptBox["\[Sum]", 
           StyleBox["i", "TI"], LimitsPositioning -> True], 
          SubsuperscriptBox["\[Chi]", 
           StyleBox["i", "TI"], "*"], 
          RowBox[{"(", 
            RowBox[{
              StyleBox["x", "TI"], ",", 
              StyleBox["t", "TI"]}], ")"}], 
          SubscriptBox["\[Chi]", 
           StyleBox["i", "TI"]], 
          RowBox[{"(", 
            RowBox[{
              StyleBox["x", "TI"], ",", 
              StyleBox["t", "TI"]}], ")"}], "-", 
          SuperscriptBox["\[Psi]", "*"], 
          RowBox[{"(", 
            RowBox[{
              StyleBox["x", "TI"], ",", 
              StyleBox["t", "TI"]}], ")"}], "\[Psi]", 
          RowBox[{"(", 
            RowBox[{
              StyleBox["x", "TI"], ",", 
              StyleBox["t", "TI"]}], ")"}], "-", 
          SuperscriptBox["\[Phi]", "*"], 
          RowBox[{"(", 
            RowBox[{
              StyleBox["x", "TI"], ",", 
              StyleBox["t", "TI"]}], ")"}], "\[Phi]", 
          RowBox[{"(", 
            RowBox[{
              StyleBox["x", "TI"], ",", 
              StyleBox["t", "TI"]}], ")"}]}]], 
       UnderscriptBox["\[Product]", 
        RowBox[{
          StyleBox["x", "TI"], "\[Element]", 
          StyleBox["G", "TI"], "\\", 
          RowBox[{"{", 
            StyleBox["s", "TI"], "}"}]}], LimitsPositioning -> True], 
       RowBox[{"{", 
         RowBox[{"1", "+", 
           UnderscriptBox["\[Sum]", 
            StyleBox["y", "TI"], LimitsPositioning -> True], 
           FractionBox[
            SubscriptBox["\[Beta]", 
             RowBox[{
               StyleBox["x", "TI"], 
               StyleBox["y", "TI"]}]], 
            SubscriptBox[
             StyleBox["r", "TI"], 
             StyleBox["x", "TI"]]], 
           SuperscriptBox["\[Phi]", "*"], 
           RowBox[{"(", 
             RowBox[{
               StyleBox["y", "TI"], ",", 
               StyleBox["t", "TI"], "+", "1"}], ")"}], "\[Phi]", 
           RowBox[{"(", 
             RowBox[{
               StyleBox["x", "TI"], ",", 
               StyleBox["t", "TI"]}], ")"}], 
           SuperscriptBox["\[Psi]", "*"], 
           RowBox[{"(", 
             RowBox[{
               StyleBox["x", "TI"], ",", 
               StyleBox["t", "TI"], "+", "1"}], ")"}], 
           SubsuperscriptBox["\[Chi]", "1", "*"], 
           RowBox[{"(", 
             RowBox[{
               StyleBox["y", "TI"], ",", 
               StyleBox["t", "TI"]}], ")"}], "+", 
           UnderscriptBox["\[Sum]", 
            StyleBox["y", "TI"], LimitsPositioning -> True], 
           FractionBox[
            SubscriptBox["\[Beta]", 
             RowBox[{
               StyleBox["x", "TI"], 
               StyleBox["y", "TI"]}]], 
            SubscriptBox[
             StyleBox["r", "TI"], 
             StyleBox["x", "TI"]]], 
           UnderoverscriptBox["\[Sum]", 
            StyleBox["i", "TI"], 
            RowBox[{
              StyleBox["N", "TI"], "\[LongEqual]", "-1"}], LimitsPositioning -> 
            True], 
           SubsuperscriptBox["\[Chi]", 
            StyleBox["i", "TI"], "*"], 
           RowBox[{"(", 
             RowBox[{
               StyleBox["y", "TI"], ",", 
               StyleBox["t", "TI"]}], ")"}], 
           SubscriptBox["\[Chi]", 
            StyleBox["i", "TI"]], 
           RowBox[{"(", 
             RowBox[{
               StyleBox["x", "TI"], ",", 
               StyleBox["t", "TI"]}], ")"}], "+", 
           SuperscriptBox["\[Psi]", "*"], 
           RowBox[{"(", 
             RowBox[{
               StyleBox["x", "TI"], ",", 
               StyleBox["t", "TI"], "+", "1"}], ")"}], "\[Psi]", 
           RowBox[{"(", 
             RowBox[{
               StyleBox["x", "TI"], ",", 
               StyleBox["t", "TI"]}], ")"}]}], "}"}], "\[Cross]", 
       RowBox[{"[", 
         RowBox[{"1", "+", "\[Psi]", 
           RowBox[{"(", 
             RowBox[{
               StyleBox["x", "TI"], ",", 
               StyleBox["T", "TI"], "+", "1"}], ")"}]}], "]"}], 
       RowBox[{"[", 
         RowBox[{"1", "+", 
           SubscriptBox[
            StyleBox["a", "TI"], 
            StyleBox["s", "TI"]], 
           RowBox[{"(", 
             StyleBox["t", "TI"], ")"}], 
           SubscriptBox["\[Chi]", "1"], 
           RowBox[{"(", 
             RowBox[{
               StyleBox["s", "TI"], ",", 
               StyleBox["t", "TI"]}], ")"}]}], "]"}]}], TraditionalForm], 
   "errors" -> {}, "input" -> 
   "e^{-S_t} =    \\prod_x  e^{-\\sum_i \
\\chi^*_i(x,t)\\chi_i(x,t)-\\psi^*(x,t)\\psi(x,t)-\\phi^*(x,t)\\phi(x,t)}  \
\\prod_{x \\in \\mathcal{ G} \\setminus \\{s\\}}\\left\\{1 +\\sum_y \
\\frac{\\beta_{xy}}{r_x}\\phi^*(y,t+1)\\phi(x,t) \\psi^*(x,t+1) \
\\chi^*_1(y,t) + \\sum_y \\frac{\\beta_{xy}}{r_x}  \\sum_i ^{N=-1} \
\\chi^*_i(y,t)\\chi_i(x,t)+ \\psi^*(x,t+1)\\psi(x,t) \\right\\} \
\\times\\Bigg[1+\\psi(x,T+1)\\Bigg] \\Bigg[ 1+a_s(t) \\chi_1(s,t)\\Bigg]", 
   "state" -> "Boxes"|>,
  "TeXAssistantTemplate"]], "Input",
 CellChangeTimes->{3.9470465192505913`*^9},
 EmphasizeSyntaxErrors->True,
 CellLabel->
  "In[623]:=",ExpressionUUID->"e04d3c3d-ba93-8049-a521-0c5779224662"],

Cell[TextData[{
 "For fields that do not have a color index, we default to set it to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["j", 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "6a10e7fd-d2da-b048-8cc0-399833ba1f8b"],
 ", because in the WickContraction[] it automated with color indices.\n\
Instead, the source is set with index 1, so that it can contract with an \
external \[OpenCurlyDoubleQuote]probe\[CloseCurlyDoubleQuote]"
}], "Text",
 CellChangeTimes->{{3.947131579459246*^9, 3.947131634737303*^9}, {
  3.947131688714962*^9, 3.947131719382986*^9}, {3.947234352715584*^9, 
  3.94723435879998*^9}},ExpressionUUID->"d8d0b1ca-b108-9343-bbe9-\
52b285897e24"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "FinalDynamicLERWaction", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "FinalDynamicLERWaction", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<sourceBC\>\"", "->", "1"}], ",", 
      RowBox[{"\"\<excludedVertices\>\"", "->", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{"\"\<graph\>\"", "->", "g"}], ",", 
      RowBox[{"\"\<startingTime\>\"", "->", "1"}], ",", 
      RowBox[{"\"\<endTime\>\"", "->", "10"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FinalDynamicLERWaction", "[", 
   RowBox[{"OptionsPattern", "[", "]"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "locGraph", ",", "locStartingTime", ",", "locEndTime", ",", "locSource", 
      ",", "locRoot", ",", "locWeights", ",", "totWeights", ",", 
      "locVertices", ",", "actionTimeSlice", ",", "action"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Clear", "[", 
      RowBox[{"i", ",", "k", ",", "j", ",", "\[Gamma]"}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"locGraph", "=", 
      RowBox[{"OptionValue", "[", "\"\<graph\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"locStartingTime", " ", "=", 
      RowBox[{"OptionValue", "[", "\"\<startingTime\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"locEndTime", " ", "=", 
      RowBox[{"OptionValue", "[", "\"\<endTime\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"locWeights", "=", 
      RowBox[{
       RowBox[{"WeightedAdjacencyMatrix", "[", "locGraph", "]"}], "//", 
       "Normal"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"totWeights", " ", "=", 
      RowBox[{"Total", "[", 
       RowBox[{"locWeights", ",", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"locVertices", "=", 
      RowBox[{"VertexList", "@", "locGraph"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"locRoot", " ", "=", " ", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"locGraph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<ROOT\>\""}]}], "]"}], "&"}]}], "]"}], 
        "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"locSource", " ", "=", " ", "\[IndentingNewLine]", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"locGraph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<SOURCE\>\""}]}], "]"}], "&"}]}], "]"}],
         "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"actionTimeSlice", " ", "[", "T_", "]"}], ":=", " ", 
      RowBox[{
       RowBox[{"Product", "[", " ", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"V", "[", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"\[Gamma]", " ", 
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"totWeights", "[", 
                   RowBox[{"[", "x", "]"}], "]"}], "===", "0"}], " ", ",", 
                 "0", ",", 
                 RowBox[{"(*", "FALSE", "*)"}], 
                 RowBox[{
                  FractionBox[
                   RowBox[{"locWeights", "[", 
                    RowBox[{"[", 
                    RowBox[{"x", ",", "y"}], "]"}], "]"}], 
                   RowBox[{"totWeights", "[", 
                    RowBox[{"[", "x", "]"}], "]"}]], 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"R", "[", 
                    RowBox[{"x", ",", "y", ",", "Red"}], "]"}], 
                    RowBox[{"\[Phi]s", "[", 
                    RowBox[{"y", ",", 
                    SubscriptBox["t", 
                    RowBox[{"T", "+", "1"}]], ",", 
                    SubscriptBox["k", "x"]}], "]"}], 
                    RowBox[{"\[Psi]s", "[", 
                    RowBox[{"x", ",", 
                    SubscriptBox["t", 
                    RowBox[{"T", "+", "1"}]], ",", 
                    SubscriptBox["j", 
                    RowBox[{"-", "1"}]]}], "]"}]}], "-", " ", 
                    RowBox[{"\[Phi]s", "[", 
                    RowBox[{"x", ",", 
                    SubscriptBox["t", 
                    RowBox[{"T", "+", "1"}]], ",", 
                    SubscriptBox["k", "x"]}], "]"}]}], ")"}], 
                  RowBox[{"\[Phi]", "[", 
                   RowBox[{"x", ",", 
                    SubscriptBox["t", "T"], ",", 
                    SubscriptBox["k", "x"]}], "]"}], 
                  RowBox[{"\[Chi]s", "[", 
                   RowBox[{"y", ",", 
                    SubscriptBox["t", "T"], ",", "1"}], "]"}]}]}], "]"}], " ",
                ",", 
               RowBox[{"{", 
                RowBox[{"y", ",", 
                 RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], 
              "]"}]}], "+", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"totWeights", "[", 
                  RowBox[{"[", "x", "]"}], "]"}], "===", "0"}], " ", ",", "0",
                 ",", 
                RowBox[{"(*", "FALSE", "*)"}], 
                RowBox[{
                 FractionBox[
                  RowBox[{"locWeights", "[", 
                   RowBox[{"[", 
                    RowBox[{"x", ",", "y"}], "]"}], "]"}], 
                  RowBox[{"totWeights", "[", 
                   RowBox[{"[", "x", "]"}], "]"}]], 
                 RowBox[{"R", "[", 
                  RowBox[{"x", ",", "y", ",", "Blue"}], "]"}], 
                 RowBox[{"\[Chi]s", "[", 
                  RowBox[{"y", ",", 
                   SubscriptBox["t", "T"], ",", 
                   SubscriptBox["i", "x"]}], "]"}], 
                 RowBox[{"\[Chi]", "[", 
                  RowBox[{"x", ",", 
                   SubscriptBox["t", "T"], ",", 
                   SubscriptBox["i", "x"]}], "]"}]}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"y", ",", 
                RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], "]"}],
             "+", " ", 
            RowBox[{
             RowBox[{"\[Psi]s", "[", 
              RowBox[{"x", ",", 
               SubscriptBox["t", 
                RowBox[{"T", "+", "1"}]], ",", 
               SubscriptBox["j", 
                RowBox[{"-", "1"}]]}], "]"}], 
             RowBox[{"\[Psi]", "[", 
              RowBox[{"x", ",", 
               SubscriptBox["t", "T"], ",", 
               SubscriptBox["j", 
                RowBox[{"-", "1"}]]}], "]"}]}], "+", 
            RowBox[{
             RowBox[{"\[Phi]s", "[", 
              RowBox[{"x", ",", 
               SubscriptBox["t", 
                RowBox[{"T", "+", "1"}]], ",", 
               SubscriptBox["k", "x"]}], "]"}], 
             RowBox[{"\[Phi]", "[", 
              RowBox[{"x", ",", 
               SubscriptBox["t", "T"], ",", 
               SubscriptBox["k", "x"]}], "]"}]}]}], ")"}], " ", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], "]"}], 
       "\[IndentingNewLine]", 
       RowBox[{"V", "[", 
        RowBox[{"(", 
         RowBox[{"1", "+", " ", 
          RowBox[{
           RowBox[{"OptionValue", "[", "\"\<sourceBC\>\"", "]"}], " ", 
           RowBox[{"\[Chi]", "[", 
            RowBox[{"locSource", ",", 
             SubscriptBox["t", "T"], ",", "1"}], "]"}]}]}], ")"}], "]"}]}]}], 
     ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"action", "=", 
      RowBox[{
       RowBox[{"Product", "[", 
        RowBox[{
         RowBox[{"actionTimeSlice", "[", "T", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"T", ",", "locStartingTime", ",", "locEndTime"}], "}"}]}], 
        "]"}], 
       RowBox[{"Product", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"V", "[", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"\[Psi]", "[", 
              RowBox[{"x", ",", 
               SubscriptBox["t", 
                RowBox[{"locEndTime", "+", "1"}]], ",", 
               SubscriptBox["j", 
                RowBox[{"-", "1"}]]}], "]"}]}], ")"}], 
           RowBox[{"(*", 
            RowBox[{
            "This", " ", "allows", " ", "the", " ", "PASSIVE", " ", "path", 
             " ", "tracker", " ", "to", " ", "be", " ", "absorbed", " ", "at",
              " ", "the", " ", "end"}], "*)"}], " ", "]"}], 
          RowBox[{"V", "[", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"\[Phi]", "[", 
              RowBox[{"x", ",", 
               SubscriptBox["t", 
                RowBox[{"locEndTime", "+", "1"}]], ",", 
               SubscriptBox["k", "x"]}], "]"}]}], ")"}], 
           RowBox[{"(*", 
            RowBox[{
            "This", " ", "allows", " ", "the", " ", "ACTIVE", " ", "path", 
             " ", "tracker", " ", "to", " ", "be", " ", "absorbed", " ", "at",
              " ", "the", " ", "end"}], "*)"}], " ", "]"}], 
          RowBox[{"V", "[", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"\[Phi]", "[", 
              RowBox[{"x", ",", 
               SubscriptBox["t", 
                RowBox[{"locEndTime", "+", "1"}]], ",", "0"}], "]"}]}], ")"}], 
           RowBox[{"(*", 
            RowBox[{
            "This", " ", "allows", " ", "the", " ", "path", " ", "to", " ", 
             "end", " ", "after", " ", "\"\<endTime\>\"", " ", "steps"}], 
            "*)"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], "]"}]}]}], 
     ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "action", "]"}]}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
 CellChangeTimes->{{3.947046452063454*^9, 3.947046477762972*^9}, {
   3.9470468701890545`*^9, 3.947046880280176*^9}, {3.947046918125824*^9, 
