            RowBox[{"exp", ",", " ", 
             RowBox[{"\[Phi]s", "[", 
              RowBox[{"1", ",", 
               SubscriptBox["t", "1"], ",", 
               SubscriptBox["k", "1"]}], "]"}]}], "]"}], "/.", 
           RowBox[{
            RowBox[{"R", "[", "__", "]"}], "->", "0"}]}], ")"}], ">=", 
         "locPrecision"}]}], ",", 
       RowBox[{"ii", "++"}], ",", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"exp", "=", 
         RowBox[{"ExpectationValueBlock", "[", 
          RowBox[{
           RowBox[{"Z", "*", "exp"}], ",", 
           RowBox[{"\"\<endTime\>\"", "->", "1"}], ",", 
           RowBox[{"\"\<fields\>\"", "->", 
            RowBox[{"OptionValue", "[", "\"\<fields\>\"", "]"}]}], ",", 
           RowBox[{"\"\<Rrule\>\"", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"R", "[", 
               RowBox[{"__", ",", "Blue"}], "]"}], "->", "1."}], "}"}]}], ",", 
           RowBox[{"\"\<graph\>\"", "->", 
            RowBox[{"OptionValue", "[", " ", "\"\<graph\>\"", "]"}]}], ",", 
           RowBox[{"\"\<nFields\>\"", "->", "0"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"exp", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"exp", "/.", 
            RowBox[{
             SubscriptBox["t", "a_"], "->", 
             SubscriptBox["t", 
              RowBox[{"a", "-", "1"}]]}]}], "/.", 
           RowBox[{"\[Gamma]", "->", "loc\[Gamma]"}]}], "//", "Expand"}]}], 
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<########## i=\>\"", ",", "ii", ",", "\"\<, \>\"", ",", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Coefficient", "[", 
