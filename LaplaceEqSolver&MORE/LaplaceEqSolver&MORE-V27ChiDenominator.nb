Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "ConvergenceLERW", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "ConvergenceLERW", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<graph\>\"", "->", "g"}], ",", 
      RowBox[{"\"\<fields\>\"", "->", 
       RowBox[{"FieldsNamesGenerator", "[", 
        RowBox[{"{", 
         RowBox[{"\[Phi]", ",", "\[Psi]", ",", "\[Chi]"}], "}"}], "]"}]}], 
      ",", 
      RowBox[{"\"\<steps\>\"", "->", "10"}], ",", 
      RowBox[{"\"\<precision\>\"", "->", 
       SuperscriptBox["10", 
        RowBox[{"-", "9"}]]}], ",", 
      RowBox[{"\"\<gammaValue\>\"", "->", "0.1"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ConvergenceLERW", "[", 
   RowBox[{"operator_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "Z", ",", "locOperator", ",", "locPrecision", ",", "loc\[Gamma]", ",", 
      "exp", ",", "i", ",", "temp", ",", "token"}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"i", "=", "1"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"Z", "=", 
      RowBox[{
       RowBox[{"FinalDynamicLERWaction", "[", 
        RowBox[{
         RowBox[{"\"\<graph\>\"", "->", 
          RowBox[{"OptionValue", "[", " ", "\"\<graph\>\"", "]"}]}], ",", 
         RowBox[{"\"\<endTime\>\"", "->", "1"}]}], "]"}], "/.", 
       RowBox[{
        RowBox[{"\[Beta]", "[", "__", "]"}], "->", "1."}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"locOperator", "=", " ", "operator"}], " ", ";", 
     "\[IndentingNewLine]", 
     RowBox[{"locPrecision", "=", 
      RowBox[{"OptionValue", "[", "\"\<precision\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"loc\[Gamma]", "=", 
      RowBox[{"OptionValue", "[", "\"\<gammaValue\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"exp", "=", 
      RowBox[{"ExpectationValueBlock", "[", 
       RowBox[{
        RowBox[{"Z", " ", "locOperator"}], ",", 
        RowBox[{"\"\<endTime\>\"", "->", "1"}], ",", 
        RowBox[{"\"\<fields\>\"", "->", 
         RowBox[{"OptionValue", "[", "\"\<fields\>\"", "]"}]}], ",", 
        RowBox[{"\"\<Rrule\>\"", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"R", "[", 
            RowBox[{"__", ",", "Blue"}], "]"}], "->", "1"}], "}"}]}], ",", 
        RowBox[{"\"\<graph\>\"", "->", 
         RowBox[{"OptionValue", "[", " ", "\"\<graph\>\"", "]"}]}], ",", 
        RowBox[{"\"\<n\[Chi]\>\"", "->", 
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"exp", "=", 
      RowBox[{"exp", "/.", 
       RowBox[{
        SubscriptBox["t", "a_"], "->", 
        SubscriptBox["t", 
         RowBox[{"a", "-", "1"}]]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"exp", "=", 
      RowBox[{"exp", "/.", 
       RowBox[{"\[Gamma]", "->", "loc\[Gamma]"}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<########## i=\>\"", "<>", 
         RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<, \>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Coefficient", "[", 
             RowBox[{"exp", ",", " ", 
              RowBox[{"\[Phi]s", "[", 
               RowBox[{"1", ",", 
                SubscriptBox["t", "1"], ",", 
                SubscriptBox["k", "1"]}], "]"}]}], "]"}], "/.", 
            RowBox[{
             RowBox[{"R", "[", "__", "]"}], "->", "0"}]}], ")"}], "]"}], 
         "<>", "\"\< ############\>\""}], "]"}], ";"}], "*)"}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "2"}], ",", 
       RowBox[{
        RowBox[{"i", "<=", 
         RowBox[{"OptionValue", "[", "\"\<steps\>\"", "]"}]}], " ", "&&", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Coefficient", "[", 
             RowBox[{"exp", ",", "  ", 
              RowBox[{"\[Phi]s", "[", 
               RowBox[{"1", ",", 
                SubscriptBox["t", "1"], ",", 
                SubscriptBox["k", "1"]}], "]"}]}], "]"}], "/.", 
            RowBox[{
             RowBox[{"R", "[", "__", "]"}], "->", "0"}]}], "/.", 
           RowBox[{"\[Gamma]", "->", "loc\[Gamma]"}]}], ")"}], ">=", 
         "locPrecision"}]}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"exp", "=", 
         RowBox[{"ExpectationValueBlock", "[", 
          RowBox[{
           RowBox[{"Z", " ", "exp"}], ",", 
           RowBox[{"\"\<endTime\>\"", "->", "1"}], ",", 
           RowBox[{"\"\<fields\>\"", "->", 
            RowBox[{"OptionValue", "[", "\"\<fields\>\"", "]"}]}], ",", 
           RowBox[{"\"\<Rrule\>\"", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"R", "[", 
               RowBox[{"__", ",", "Blue"}], "]"}], "->", "1"}], "}"}]}], ",", 
           RowBox[{"\"\<graph\>\"", "->", 
            RowBox[{"OptionValue", "[", " ", "\"\<graph\>\"", "]"}]}], ",", 
           RowBox[{"\"\<n\[Chi]\>\"", "->", 
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"exp", "=", 
         RowBox[{"exp", "/.", 
          RowBox[{
           SubscriptBox["t", "a_"], "->", 
           SubscriptBox["t", 
            RowBox[{"a", "-", "1"}]]}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"exp", "=", 
         RowBox[{"exp", "/.", 
          RowBox[{"\[Gamma]", "->", "loc\[Gamma]"}]}]}], ";"}]}], 
      "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<########## i=\>\"", ",", "i", ",", "\"\<, \>\"", ",", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Coefficient", "[", 
          RowBox[{"exp", ",", " ", 
           RowBox[{"\[Phi]s", "[", 
            RowBox[{"1", ",", 
             SubscriptBox["t", "1"], ",", 
             SubscriptBox["k", "1"]}], "]"}]}], "]"}], "/.", 
         RowBox[{
          RowBox[{"R", "[", "__", "]"}], "->", "0"}]}], ")"}], ",", 
       "\"\< ############\>\""}], "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "exp", "]"}], ";"}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
