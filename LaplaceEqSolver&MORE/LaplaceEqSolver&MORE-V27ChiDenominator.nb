 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "LRWaction\[Chi]DivisionWithTruncation", "]"}], 
    "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<sourceBC\>\"", "->", "1"}], ",", 
      RowBox[{"\"\<excludedVertices\>\"", "->", 
       RowBox[{"{", "}"}]}], ",", 
