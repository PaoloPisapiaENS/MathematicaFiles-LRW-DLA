                    RowBox[{"[", "l", "]"}], "]"}], "[", 
                   RowBox[{"jj", ",", "a_"}], "]"}], "->", "0"}]}]}], ";", 
               "\n", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"zTemp1", "-", "z"}], "=!=", "0"}], ",", "\n", 
                 RowBox[{
