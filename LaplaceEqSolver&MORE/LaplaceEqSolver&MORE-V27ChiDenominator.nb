                    SubscriptBox["k", "x"]}], "]"}]}], ")"}], 
                   RowBox[{"\[Chi]s", "[", 
                    RowBox[{"y", ",", 
                    SubscriptBox["t", "T"], ",", "1"}], "]"}], "*", 
                   RowBox[{"\[Phi]", "[", 
                    RowBox[{"x", ",", 
                    SubscriptBox["t", "T"], ",", 
                    SubscriptBox["k", "x"]}], "]"}]}], ",", 
                  RowBox[{"{", 
                   RowBox[{"y", ",", 
                    RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], 
                 "]"}]}], "\[IndentingNewLine]", "+", 
               RowBox[{"(*", " ", 
                RowBox[{"COPY", " ", "\[Psi]"}], " ", "*)"}], " ", 
               RowBox[{
                RowBox[{"\[Psi]s", "[", 
