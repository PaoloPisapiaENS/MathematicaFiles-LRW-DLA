Cell[CellGroupData[{

Cell[TextData[{
 "LRWaction\[Chi]DivisionWithTruncation[] \t\t",
 StyleBox["NOT WORKING: IS IT BECAUSE I SHOULD USE ANOTHER REPLICA FOR THE \
DENOMINATOR?",
  Background->RGBColor[1, 0.5, 0.5]]
}], "Section",
 CellChangeTimes->{{3.947046438393255*^9, 3.947046448986958*^9}, 
   3.947128965444277*^9, {3.947907696295887*^9, 3.947907696894024*^9}, {
   3.9519719900375195`*^9, 3.951972018332321*^9}, {3.982926650331925*^9, 
   3.982926665189028*^9}, {3.9851667865894794`*^9, 3.985166788409498*^9}, {
   3.9851712348154964`*^9, 3.985171247116976*^9}, {3.9852263975730286`*^9, 
   3.985226437812315*^9}},ExpressionUUID->"9bc128a7-cd72-4b42-8f92-\
26f785f1fa7d"],

Cell[TextData[{
 "The  idea  is  that  since  I  cannot  actually  contract  1/\[Chi], I  \
instead  contract  (1 - \[Delta]\[Chi]), which  is exact since we only have \
one target. This actually means that this new term is useless: I cannot \
contract it, ever.",
 StyleBox[" Let me use two targets, with different fixed index.",
  Background->RGBColor[1, 1, 0]],
 "\n\nAlso, since I cannot use \[Chi](x), i use \[Sum] \[Chi](y) which should \
evaluate to the same number."
}], "Text",
 CellChangeTimes->{{3.985166795282236*^9, 3.985166813532709*^9}, {
  3.9851682586127815`*^9, 3.9851682950090847`*^9}, {3.9851692738120956`*^9, 
  3.9851693365720215`*^9}, {3.9852248709329205`*^9, 
  3.9852248836934166`*^9}},ExpressionUUID->"2bf1af85-57f9-7c43-ae2c-\
bc240130ba20"],

Cell[CellGroupData[{

Cell["Check that WickContraction handles \[Delta]\[Chi]", "Subsection",
 CellChangeTimes->{{3.9851668704740887`*^9, 
  3.985166881702387*^9}},ExpressionUUID->"50aca1d4-ef2a-b041-bc82-\
b91073aeb92b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "WickContractionBlock", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "WickContractionBlock", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<print\>\"", "->", "False"}], ",", 
      RowBox[{"\"\<fields\>\"", "->", 
       RowBox[{"FieldsNamesGenerator", "[", 
        RowBox[{"{", "\[Chi]", "}"}], "]"}]}], ",", " ", 
      RowBox[{"\"\<endTime\>\"", "->", "1"}], ",", 
      RowBox[{"\"\<#vertices\>\"", "->", "10"}], ",", 
      RowBox[{"\"\<MAXnumberOfDer\>\"", "->", "3"}]}], "}"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"WickContractionBlock", "[", 
     RowBox[{
      RowBox[{"A_", " ", "+", "B_"}], ",", 
      RowBox[{"opts", ":", 
       RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{"WickContractionBlock", "[", 
      RowBox[{"A", ",", "opts"}], "]"}], "+", 
     RowBox[{"WickContractionBlock", "[", 
      RowBox[{"B", ",", "opts"}], "]"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"WickContractionBlock", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Op", "[", 
        RowBox[{"A_", " ", "+", "B_"}], "]"}], "*", "C_"}], ",", 
      RowBox[{"opts", ":", 
       RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{"WickContractionBlock", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Op", "[", "A", "]"}], "C"}], ",", "opts"}], "]"}], "+", 
     RowBox[{"WickContractionBlock", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Op", "[", "B", "]"}], "C"}], ",", "opts"}], "]"}]}]}], ";"}],
   "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"WickContractionBlock", "[", 
     RowBox[{
      RowBox[{"A_", "?", "NumericQ"}], ",", 
      RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", "A"}], ";"}], "\n",
   "\n", 
  RowBox[{"(*", 
   RowBox[{
   "##", "##", "##", "##", "##", "##", "##", "##", "##", "##", "##", "##", 
    "##", "##", "##", "##", "##", "##", "##", "##", "##", "##", "##", "##", 
