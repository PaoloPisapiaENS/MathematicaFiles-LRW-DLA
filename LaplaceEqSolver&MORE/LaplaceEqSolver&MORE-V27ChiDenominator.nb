       RowBox[{
        RowBox[{"Product", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"totWeights", "[", 
               RowBox[{"[", "x", "]"}], "]"}], "===", "0"}], "  ", "||", " ", 
             RowBox[{"MemberQ", "[", 
              RowBox[{
               RowBox[{"OptionValue", "[", "\"\<excludedVertices\>\"", "]"}], 
