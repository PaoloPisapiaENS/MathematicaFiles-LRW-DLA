       "numberOfDer"}], "}"}], ",", "\n", "\n", 
     RowBox[{
      RowBox[{"z", "=", 
       RowBox[{
        RowBox[{"V", "[", "A", "]"}], "B"}]}], ";", "\n", "\n", 
      RowBox[{"locFields", "=", 
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<fields\>\"", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", 
      RowBox[{"starFields", "=", 
       RowBox[{
