            RowBox[{"Length", "[", "locFields", "]"}]}], ",", 
           RowBox[{"l", "++"}], ",", "\n", "\n", 
           RowBox[{"(*", 
            RowBox[{
            "Start", " ", "of", " ", "loop", " ", "over", " ", "space"}], 
            "*)"}], "\n", 
           RowBox[{
            RowBox[{"For", "[", 
             RowBox[{
              RowBox[{"jj", "=", "1"}], ",", 
              RowBox[{"jj", "<=", 
               RowBox[{"OptionValue", "[", "\"\<#vertices\>\"", "]"}]}], ",", 
              RowBox[{"jj", "++"}], ",", "\n", "\n", 
              RowBox[{"(*", 
