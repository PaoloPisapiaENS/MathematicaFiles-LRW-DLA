Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Clear", "[", "LRWaction\[Chi]DivisionWithRegulatorMultipleReplicas", "]"}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
    "Options", "[", "LRWaction\[Chi]DivisionWithRegulatorMultipleReplicas", 
     "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<sourceBC\>\"", "->", "1"}], ",", 
      RowBox[{"\"\<excludedVertices\>\"", "->", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{"\"\<graph\>\"", "->", "g"}], ",", 
      RowBox[{"\"\<startingTime\>\"", "->", "1"}], ",", 
      RowBox[{"\"\<endTime\>\"", "->", "10"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"LRWaction\[Chi]DivisionWithRegulatorMultipleReplicas", "[", 
    RowBox[{"OptionsPattern", "[", "]"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "locGraph", ",", "locStartingTime", ",", "locEndTime", ",", "locSource",
        ",", "locRoot", ",", "locWeights", ",", "totWeights", ",", 
       "locVertices", ",", "actionTimeSlice", ",", "action"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Clear", "[", 
       RowBox[{"i", ",", "k", ",", "j", ",", "\[Gamma]"}], "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"locGraph", "=", 
       RowBox[{"OptionValue", "[", "\"\<graph\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"locStartingTime", " ", "=", 
       RowBox[{"OptionValue", "[", "\"\<startingTime\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"locEndTime", " ", "=", 
       RowBox[{"OptionValue", "[", "\"\<endTime\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"locWeights", "=", 
       RowBox[{
        RowBox[{"WeightedAdjacencyMatrix", "[", "locGraph", "]"}], "//", 
        "Normal"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"totWeights", " ", "=", 
       RowBox[{"Total", "[", 
        RowBox[{"locWeights", ",", 
         RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"locVertices", "=", 
       RowBox[{"VertexList", "@", "locGraph"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"locRoot", " ", "=", " ", "\[IndentingNewLine]", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"List", "@@@", 
              RowBox[{"PropertyValue", "[", 
               RowBox[{"locGraph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
            RowBox[{"[", 
             RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"StringMatchQ", "[", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", 
              RowBox[{"___", "~~", "\"\<ROOT\>\""}]}], "]"}], "&"}]}], "]"}], 
         "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"locSource", " ", "=", " ", "\[IndentingNewLine]", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"List", "@@@", 
              RowBox[{"PropertyValue", "[", 
               RowBox[{"locGraph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
            RowBox[{"[", 
             RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"StringMatchQ", "[", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", 
              RowBox[{"___", "~~", "\"\<SOURCE\>\""}]}], "]"}], "&"}]}], 
          "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"actionTimeSlice", " ", "[", "T_", "]"}], ":=", " ", 
       RowBox[{
        RowBox[{"Product", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"totWeights", "[", 
               RowBox[{"[", "x", "]"}], "]"}], "===", "0"}], "  ", "||", " ", 
             RowBox[{"MemberQ", "[", 
              RowBox[{
               RowBox[{"OptionValue", "[", "\"\<excludedVertices\>\"", "]"}], 
               ",", "x"}], "]"}]}], ",", "1", ",", "\[IndentingNewLine]", 
            RowBox[{"(*", "FALSE", "*)"}], 
            RowBox[{"V", "[", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  StyleBox["1",
                   Background->RGBColor[1, 1, 0]], 
                  StyleBox["+",
                   Background->RGBColor[1, 1, 0]], 
                  RowBox[{"Sum", "[", 
                   RowBox[{
                    RowBox[{
                    FractionBox[
                    RowBox[{"locWeights", "[", 
                    RowBox[{"[", 
                    RowBox[{"x", ",", "y"}], "]"}], "]"}], 
                    RowBox[{"totWeights", "[", 
                    RowBox[{"[", "x", "]"}], "]"}]], 
                    RowBox[{"R", "[", 
                    RowBox[{"x", ",", "y", ",", "Blue"}], "]"}], 
                    RowBox[{"\[Chi]s", "[", 
                    RowBox[{"y", ",", 
                    SubscriptBox["t", "T"], ",", 
                    SubscriptBox["i", "x"]}], "]"}], 
                    RowBox[{"\[Chi]", "[", 
                    RowBox[{"x", ",", 
                    SubscriptBox["t", "T"], ",", 
                    SubscriptBox["i", "x"]}], "]"}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"y", ",", 
                    RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], 
                   "]"}]}], ")"}], "*", 
                RowBox[{"(", 
                 RowBox[{
                  StyleBox["1",
                   Background->RGBColor[1, 1, 0]], 
                  StyleBox["+",
                   Background->RGBColor[1, 1, 0]], 
                  RowBox[{"Sum", "[", 
                   RowBox[{
                    RowBox[{
                    FractionBox[
                    RowBox[{"locWeights", "[", 
                    RowBox[{"[", 
                    RowBox[{"x", ",", "y"}], "]"}], "]"}], 
                    RowBox[{"totWeights", "[", 
                    RowBox[{"[", "x", "]"}], "]"}]], 
                    RowBox[{"R", "[", 
                    RowBox[{"x", ",", "y", ",", "Blue"}], "]"}], 
                    RowBox[{
                    StyleBox["\[Xi]s",
                    Background->RGBColor[1, 1, 0]], 
                    StyleBox["[",
                    Background->RGBColor[1, 1, 0]], 
                    RowBox[{
                    StyleBox["y",
                    Background->RGBColor[1, 1, 0]], 
                    StyleBox[",",
                    Background->RGBColor[1, 1, 0]], 
                    StyleBox[
                    SubscriptBox["t", "T"],
                    Background->RGBColor[1, 1, 0]], 
                    StyleBox[",",
                    Background->RGBColor[1, 1, 0]], 
                    SubscriptBox[
                    StyleBox["j",
                    Background->RGBColor[1, 1, 0]], "x"]}], 
                    StyleBox["]",
                    Background->RGBColor[1, 1, 0]]}], 
                    RowBox[{
                    StyleBox["\[Xi]",
                    Background->RGBColor[1, 1, 0]], 
                    StyleBox["[",
                    Background->RGBColor[1, 1, 0]], 
                    RowBox[{
                    StyleBox["x",
                    Background->RGBColor[1, 1, 0]], 
                    StyleBox[",",
                    Background->RGBColor[1, 1, 0]], 
                    StyleBox[
                    SubscriptBox["t", "T"],
                    Background->RGBColor[1, 1, 0]], 
                    StyleBox[",",
                    Background->RGBColor[1, 1, 0]], 
                    SubscriptBox[
                    StyleBox["j",
                    Background->RGBColor[1, 1, 0]], "x"]}], 
                    StyleBox["]",
                    Background->RGBColor[1, 1, 0]]}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"y", ",", 
                    RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], 
                   "]"}]}], ")"}]}], "\[IndentingNewLine]", "+", 
               RowBox[{"\[Gamma]", 
                RowBox[{"(", " ", 
                 RowBox[{"1", "/", 
                  StyleBox[
                   RowBox[{"(", 
                    RowBox[{"\[Lambda]", "+", 
                    RowBox[{"Sum", "[", " ", 
                    RowBox[{
                    RowBox[{
                    FractionBox[
                    RowBox[{"locWeights", "[", 
                    RowBox[{"[", 
                    RowBox[{"x", ",", "y"}], "]"}], "]"}], 
                    RowBox[{"totWeights", "[", 
                    RowBox[{"[", "x", "]"}], "]"}]], 
                    RowBox[{"\[Delta]\[Xi]s", "[", 
                    RowBox[{"y", ",", 
                    SubscriptBox["t", "T"], ",", "1"}], "]"}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"y", ",", 
                    RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], 
                    "]"}]}], ")"}],
                   Background->RGBColor[1, 1, 0]]}], ")"}], "*", 
                RowBox[{"Sum", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"locWeights", "[", 
                    RowBox[{"[", 
                    RowBox[{"x", ",", "y"}], "]"}], "]"}], 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"R", "[", 
                    RowBox[{"x", ",", "y", ",", "Red"}], "]"}], 
                    RowBox[{"\[Phi]s", "[", 
                    RowBox[{"y", ",", 
                    SubscriptBox["t", 
                    RowBox[{"T", "+", "1"}]], ",", 
                    SubscriptBox["k", "y"]}], "]"}], 
                    RowBox[{"\[Psi]s", "[", 
                    RowBox[{"x", ",", 
                    SubscriptBox["t", 
                    RowBox[{"T", "+", "1"}]], ",", 
