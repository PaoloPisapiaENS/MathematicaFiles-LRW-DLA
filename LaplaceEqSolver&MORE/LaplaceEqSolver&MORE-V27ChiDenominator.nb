Cell[CellGroupData[{

Cell["\<\
Test for modified (faster) WickContraction: I want to set the fields to zero \
as early as possible\
\>", "Item",
 CellChangeTimes->{{3.9833362281525927`*^9, 
  3.9833362690588512`*^9}},ExpressionUUID->"71c468ff-c9cb-7441-9f2f-\
