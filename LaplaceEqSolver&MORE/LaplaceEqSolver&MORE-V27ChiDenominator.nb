Cell[CellGroupData[{

Cell["LRWaction\[Chi]Denominator[]\t\t", "Section",
 CellChangeTimes->{{3.947046438393255*^9, 3.947046448986958*^9}, 
   3.947128965444277*^9, {3.947907696295887*^9, 3.947907696894024*^9}, {
   3.9519719900375195`*^9, 3.951972018332321*^9}, {3.982926650331925*^9, 
   3.982926665189028*^9}},ExpressionUUID->"e51edc69-835d-3840-ae06-\
14505b105225"],

Cell[TextData[{
 "I am using the formalism in which \[Phi] -> ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Phi]", "/", 
    OverscriptBox["\[Chi]", "~"]}], TraditionalForm]],ExpressionUUID->
  "85979aa4-7f48-824b-9050-7ae76a8ad7ee"],
 " \nThe ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    OverscriptBox["\[Chi]", "~"]}], TraditionalForm]],ExpressionUUID->
  "561a757d-6391-b74a-814d-d3268242e9bd"],
 " must always be understood in terms of its expansion. Since I only have ONE \
TARGET, I should be able to truncate its expansion just to first order. \n\
However, we cannot expand around ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[Chi]", "~"], TraditionalForm]],ExpressionUUID->
  "db5d138e-40a1-8842-9ba4-a09f333fa395"],
 "=0 directly. I use the expansion around ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[Chi]", "~"], TraditionalForm]],ExpressionUUID->
  "cfec91ec-f751-9940-8ae6-8905a2cace10"],
 "=1 and then keep the first order in ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[Chi]", "~"], TraditionalForm]],ExpressionUUID->
  "156a3fe7-0227-d343-85d2-e0094b6bc00a"],
 ".\n\t\t\t\t\t\t\t\t\t",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox["1", 
          OverscriptBox["\[Chi]", "~"]], "\[LongEqual]", "1", "+", 
         RowBox[{"(", 
           RowBox[{"1", "-", 
             OverscriptBox["\[Chi]", "~"]}], ")"}], "+", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{"1", "-", 
              OverscriptBox["\[Chi]", "~"]}], ")"}], "2"], "+", "...", 
         "\[LongEqual]", 
         UnderscriptBox["\[Sum]", 
          StyleBox["n", "TI"], LimitsPositioning -> True], "1", "-", 
         UnderscriptBox["\[Sum]", 
          StyleBox["n", "TI"], LimitsPositioning -> True], 
         StyleBox["n", "TI"], 
         OverscriptBox["\[Chi]", "~"], "+", "...", "\[LongEqual]", "const", 
         "+", 
         FractionBox["1", "12"], 
         OverscriptBox["\[Chi]", "~"], "+", "..."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$\\frac{1}{\\tilde\\chi} = 1 + (1-\\tilde\\chi) + \
(1-\\tilde\\chi)^2+... = \\sum_n 1 - \\sum_n n \\tilde\\chi+... \
=\\text{const} + \\frac{1}{12} \\tilde\\chi + ...$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontFamily->"Latin Modern Math",ExpressionUUID->
  "e25a5a84-1691-5d4b-9ffd-3096fb71e123"],
 "\nTo reach the final result I\[CloseCurlyQuote]ll go slowly and check how \
the action behave by adding contributions one by one"
}], "Text",
