                  SubscriptBox["ll", "x"]}], "]"}]}], "\[IndentingNewLine]", 
               " ", "+", 
               RowBox[{"(*", " ", 
                RowBox[{"COPY", " ", "\[Phi]"}], " ", "*)"}], 
               RowBox[{
