            RowBox[{"\[Phi]", "[", 
             RowBox[{"locSource", ",", 
              SubscriptBox["t", "T"], ",", 
              SubscriptBox["k", "locSource"]}], "]"}]}], "+", 
           StyleBox[
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "+", 
               RowBox[{"\[Chi]", "[", 
                RowBox[{"locSource", ",", 
                 SubscriptBox["t", "T"], ",", "1"}], "]"}]}], ")"}], "*", 
             RowBox[{"(", 
              RowBox[{"1", "+", 
               RowBox[{"\[Xi]", "[", 
                RowBox[{"locSource", ",", 
                 SubscriptBox["t", "T"], ",", "1"}], "]"}]}], ")"}]}],
            Background->RGBColor[1, 1, 0]]}], ")"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"action", "=", 
       RowBox[{"Product", "[", 
        RowBox[{
         RowBox[{"actionTimeSlice", "[", "T", "]"}], ",", 
