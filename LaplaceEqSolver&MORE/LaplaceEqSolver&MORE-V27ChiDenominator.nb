Cell[TextData[{
 "This function is divergent for all b \[Element] Reals. We want to \
regularize it with ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", "\[Lambda]"], TraditionalForm]],
  ExpressionUUID->"24bf5af5-56e3-1949-a817-941ea68adb95"],
 ".\nOne should expand the result of the sum up to O[\[Lambda]]^b so that the \
divergence is compensated. The generating functionals are\n\t\t\t\t\t\t\t\t\t\
\t\t1:     ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        RowBox[{"(", 
          FractionBox[
           RowBox[{
             SuperscriptBox[
              StyleBox["e", "TI"], "\[Lambda]"], "\[Lambda]"}], 
           RowBox[{
             SuperscriptBox[
              StyleBox["e", "TI"], "\[Lambda]"], "-", "1"}]], ")"}], 
        StyleBox["b", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "$\\left(\\frac{e^{\\lambda } \\lambda }{e^{\\lambda }-1}\\right)^b$", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1047c2b4-52f2-204f-abd7-062e35762679"],
 "\n\t\t\t\t\t\t\t\t\t\t\t",
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[Chi]", "~"], TraditionalForm]],ExpressionUUID->
  "c8fbbc82-b172-5b42-b3aa-2c4d136cc081"],
 ": ",
 Cell[BoxData[
