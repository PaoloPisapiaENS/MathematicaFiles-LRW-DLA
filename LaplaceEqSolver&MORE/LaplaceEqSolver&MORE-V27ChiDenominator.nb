Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "WickContractionBlock", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "WickContractionBlock", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<print\>\"", "->", "False"}], ",", 
      RowBox[{"\"\<fields\>\"", "->", 
       RowBox[{"FieldsNamesGenerator", "[", 
        RowBox[{"{", "\[Chi]", "}"}], "]"}]}], ",", " ", 
      RowBox[{"\"\<endTime\>\"", "->", "1"}], ",", 
      RowBox[{"\"\<#vertices\>\"", "->", "10"}], ",", 
      RowBox[{"\"\<MAXnumberOfDer\>\"", "->", "3"}]}], "}"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"WickContractionBlock", "[", 
     RowBox[{
      RowBox[{"A_", " ", "+", "B_"}], ",", 
      RowBox[{"opts", ":", 
       RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{"WickContractionBlock", "[", 
      RowBox[{"A", ",", "opts"}], "]"}], "+", 
     RowBox[{"WickContractionBlock", "[", 
      RowBox[{"B", ",", "opts"}], "]"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"WickContractionBlock", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Op", "[", 
        RowBox[{"A_", " ", "+", "B_"}], "]"}], "*", "C_"}], ",", 
      RowBox[{"opts", ":", 
       RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{"WickContractionBlock", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Op", "[", "A", "]"}], "C"}], ",", "opts"}], "]"}], "+", 
     RowBox[{"WickContractionBlock", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Op", "[", "B", "]"}], "C"}], ",", "opts"}], "]"}]}]}], ";"}],
   "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"WickContractionBlock", "[", 
     RowBox[{
      RowBox[{"A_", "?", "NumericQ"}], ",", 
      RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", "A"}], ";"}], "\n",
   "\n", 
  RowBox[{"(*", 
   RowBox[{
   "##", "##", "##", "##", "##", "##", "##", "##", "##", "##", "##", "##", 
    "##", "##", "##", "##", "##", "##", "##", "##", "##", "##", "##", "##", 
    "##", "##", "##", "##", "##", "##", "##", "##", "##", "##", "##", "##", 
    "##", "##", "##", "##", "\n", "\t\t\t\t\t\t\t\t\t", "Partition", " ", 
    "Function", "                             ", "\n", "##", "##", "##", "##",
     "##", "##", "##", "##", "##", "##", "##", "##", "##", "##", "##", "##", 
    "##", "##", "##", "##", "##", "##", "##", "##", "##", "##", "##", "##", 
    "##", "##", "##", "##", "##", "##", "##", "##", "##", "##", "##"}], 
   "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
         "There", " ", "are", " ", "two", " ", "possible", " ", 
          "contributions", " ", "for", " ", "each", " ", 
          RowBox[{"field", ":", " ", "1"}]}], ")"}], " ", "it", " ", "is", 
        " ", "not", " ", 
        RowBox[{"contracted", ":", " ", "\[Chi]"}]}], "->", "0"}], ";", " ", 
      "2"}], ")"}], " ", "it", " ", "is", " ", "contracted"}], "*)"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"WickContractionBlock", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"V", "[", "A_", "]"}], " ", "*", "B_."}], ",", " ", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"locFields", "=", 
        RowBox[{"{", "}"}]}], ",", " ", 
       RowBox[{"starFields", "=", 
        RowBox[{"{", "}"}]}], ",", " ", 
       RowBox[{"deltaFields", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"deltaStarFields", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"contributions", "=", "0"}], ",", "z", ",", "zTemp1", ",", 
       "zTemp2", ",", "\[Kappa]", ",", "jj", ",", "l", ",", "timeIndex", ",", 
       "numberOfDer"}], "}"}], ",", "\n", "\n", 
     RowBox[{
      RowBox[{"z", "=", 
       RowBox[{
        RowBox[{"V", "[", "A", "]"}], "B"}]}], ";", "\n", "\n", 
      RowBox[{"locFields", "=", 
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<fields\>\"", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", 
      RowBox[{"starFields", "=", 
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<fields\>\"", "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", 
      RowBox[{"deltaFields", "=", 
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<fields\>\"", "]"}], "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], ";", "\n", 
      RowBox[{"deltaStarFields", "=", 
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<fields\>\"", "]"}], "[", 
        RowBox[{"[", "4", "]"}], "]"}]}], ";", "\n", "\n", "\n", 
      RowBox[{"(*", 
       RowBox[{"Start", " ", "a", " ", "loop", " ", "over", " ", "time"}], 
       "*)"}], "\n", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"timeIndex", "=", "0"}], ",", 
        RowBox[{"timeIndex", "<=", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"OptionValue", "[", "\"\<endTime\>\"", "]"}], "-", "1"}], 
          ")"}]}], ",", 
        RowBox[{"timeIndex", "++"}], ",", "\n", "\n", 
        RowBox[{
         RowBox[{"z", "=", 
          RowBox[{"z", "//.", 
           RowBox[{
            RowBox[{"f_", "[", 
             RowBox[{"x_", ",", 
              RowBox[{"Subscript", "[", 
               RowBox[{"t", ",", " ", 
                RowBox[{"(", 
                 RowBox[{"timeIndex", "+", "1"}], ")"}]}], "]"}], ",", "a_"}],
              "]"}], "->", 
            RowBox[{"f", "[", 
             RowBox[{"x", ",", "a"}], "]"}]}]}]}], ";", "\n", "\n", 
         RowBox[{"(*", 
          RowBox[{
          "Start", " ", "of", " ", "loop", " ", "over", " ", "fields"}], 
          "*)"}], "\n", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"l", "=", "1"}], ",", 
           RowBox[{"l", "<=", 
            RowBox[{"Length", "[", "locFields", "]"}]}], ",", 
           RowBox[{"l", "++"}], ",", "\n", "\n", 
           RowBox[{"(*", 
            RowBox[{
            "Start", " ", "of", " ", "loop", " ", "over", " ", "space"}], 
            "*)"}], "\n", 
           RowBox[{
            RowBox[{"For", "[", 
             RowBox[{
              RowBox[{"jj", "=", "1"}], ",", 
              RowBox[{"jj", "<=", 
               RowBox[{"OptionValue", "[", "\"\<#vertices\>\"", "]"}]}], ",", 
              RowBox[{"jj", "++"}], ",", "\n", "\n", 
              RowBox[{"(*", 
               RowBox[{
                StyleBox["First",
                 Background->GrayLevel[1]], " ", "contribution"}], "*)"}], 
              "\n", 
              RowBox[{
               RowBox[{"zTemp1", "=", 
                RowBox[{
                 RowBox[{"z", "//.", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"locFields", "[", 
                    RowBox[{"[", "l", "]"}], "]"}], "[", 
                    RowBox[{"jj", ",", "a_"}], "]"}], "->", "0"}]}], "//.", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"starFields", "[", 
                    RowBox[{"[", "l", "]"}], "]"}], "[", 
                   RowBox[{"jj", ",", "a_"}], "]"}], "->", "0"}]}]}], ";", 
               "\n", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"zTemp1", "-", "z"}], "=!=", "0"}], ",", "\n", 
                 RowBox[{
                  RowBox[{"contributions", "=", "zTemp1"}], ";"}]}], "\n", 
                RowBox[{"(*", 
                 RowBox[{
                  RowBox[{"Print", "[", 
                   RowBox[{"\"\<First contribution: \>\"", ",", "zTemp1"}], 
                   "]"}], ";"}], "*)"}], "\n", "]"}], ";", "\n", 
               "\[IndentingNewLine]", 
               RowBox[{"(*", " ", 
                RowBox[{
                "N", " ", "E", " ", "W", "  ", "P", " ", "A", " ", "R", " ", 
                 "T", "  ", "O", " ", "N", "  ", "M", " ", "U", " ", "L", " ",
                  "T", " ", "I", " ", "P", " ", "L", " ", "E", "  ", "C", " ",
                  "O", " ", "N", " ", "T", " ", "R", " ", "A", " ", "C", " ", 
                 "T", " ", "I", " ", "O", " ", "N", " ", "S"}], "*)"}], 
               "\[IndentingNewLine]", 
               RowBox[{"For", "[", 
                RowBox[{
                 RowBox[{"numberOfDer", "=", "1"}], ",", 
                 RowBox[{"numberOfDer", "<=", 
                  RowBox[{
                  "OptionValue", "[", "\"\<MAXnumberOfDer\>\"", "]"}]}], ",", 
                 RowBox[{"numberOfDer", "++"}], ",", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"zTemp1", "=", 
                   RowBox[{"z", "/.", " ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"locFields", "[", 
                    RowBox[{"[", "l", "]"}], "]"}], "[", 
                    RowBox[{"jj", ",", "a_"}], "]"}], "->", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"locFields", "[", 
                    RowBox[{"[", "l", "]"}], "]"}], "[", 
                    RowBox[{"jj", ",", "a"}], "]"}], "+", 
                    RowBox[{"\[Kappa]", " ", "*", 
                    RowBox[{
                    RowBox[{"deltaFields", "[", 
                    RowBox[{"[", "l", "]"}], "]"}], "[", 
                    RowBox[{"jj", ",", "a"}], "]"}]}]}]}]}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"zTemp1", "-", "z"}], "=!=", "0"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"zTemp1", "=", " ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"D", "[", 
                    RowBox[{"zTemp1", ",", 
                    RowBox[{"{", 
                    RowBox[{"\[Kappa]", ",", "numberOfDer"}], "}"}]}], "]"}], 
                    "/", 
                    RowBox[{"(", 
                    RowBox[{"numberOfDer", "!"}], ")"}]}], "/.", 
                    RowBox[{"\[Kappa]", "->", "0"}]}]}], 
                    RowBox[{"(*", 
                    RowBox[{",", "\[IndentingNewLine]", 
                    RowBox[{"Continue", "[", "]"}]}], "*)"}], ";"}]}], 
                   "\[IndentingNewLine]", "]"}], ";", "\n", "\n", 
                  RowBox[{"zTemp2", "=", 
                   RowBox[{"zTemp1", "/.", " ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"starFields", "[", 
                    RowBox[{"[", "l", "]"}], "]"}], "[", 
                    RowBox[{"jj", ",", "a_"}], "]"}], "->", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"starFields", "[", 
                    RowBox[{"[", "l", "]"}], "]"}], "[", 
                    RowBox[{"jj", ",", "a"}], "]"}], "+", 
                    RowBox[{"\[Kappa]", " ", "*", 
                    RowBox[{
                    RowBox[{"deltaStarFields", "[", 
                    RowBox[{"[", "l", "]"}], "]"}], "[", 
                    RowBox[{"jj", ",", "a"}], "]"}]}]}]}]}]}], ";", "\n", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"zTemp2", "-", "zTemp1"}], "=!=", "0"}], ",", 
                    "\n", 
                    RowBox[{
                    RowBox[{"zTemp1", "=", 
                    RowBox[{
                    RowBox[{"D", "[", 
                    RowBox[{"zTemp2", ",", 
                    RowBox[{"{", 
                    RowBox[{"\[Kappa]", ",", "numberOfDer"}], "}"}]}], "]"}], 
                    "/.", 
                    RowBox[{"\[Kappa]", "->", "0"}]}]}], 
                    RowBox[{"(*", 
                    RowBox[{",", "\[IndentingNewLine]", 
                    RowBox[{"Continue", "[", "]"}]}], "*)"}], ";"}]}], "\n", 
                   "]"}], ";", "\n", "\n", 
                  RowBox[{"zTemp1", "=", 
                   RowBox[{"Expand", "[", "zTemp1", "]"}]}], ";", "\n", 
                  RowBox[{"zTemp2", "=", 
                   RowBox[{"zTemp1", "//.", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"deltaFields", "[", 
                    RowBox[{"[", "l", "]"}], "]"}], "[", 
                    RowBox[{"jj", ",", "a_"}], "]"}], "^", "n_."}], "*", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"deltaStarFields", "[", 
                    RowBox[{"[", "l", "]"}], "]"}], "[", 
                    RowBox[{"jj", ",", "b_"}], "]"}], "^", "n_."}]}], 
                    RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"/;", 
                    RowBox[{"(", 
                    RowBox[{"!", 
                    RowBox[{"NumericQ", "[", 
                    RowBox[{"a", "*", "b"}], "]"}]}], ")"}]}], ":>"}], "*)"}],
                     "->", 
                    RowBox[{
                    RowBox[{"\[Delta]", "[", 
                    RowBox[{"a", ",", "b"}], "]"}], "^", "n"}]}]}]}], ";", 
                  "\n", 
                  RowBox[{"(*", 
                   RowBox[{
                    RowBox[{"zTemp2", "=", 
                    RowBox[{"zTemp1", "//.", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"deltaFields", "[", 
                    RowBox[{"[", "l", "]"}], "]"}], "[", 
                    RowBox[{"jj", ",", "a_"}], "]"}], "*", 
                    RowBox[{
                    RowBox[{"deltaStarFields", "[", 
                    RowBox[{"[", "l", "]"}], "]"}], "[", 
                    RowBox[{"jj", ",", "b_"}], "]"}], "*", 
                    RowBox[{
                    RowBox[{"deltaFields", "[", 
                    RowBox[{"[", "l", "]"}], "]"}], "[", 
                    RowBox[{"jj", ",", "a_"}], "]"}], "*", 
                    RowBox[{
                    RowBox[{"deltaStarFields", "[", 
                    RowBox[{"[", "l", "]"}], "]"}], "[", 
                    RowBox[{"jj", ",", "b_"}], "]"}]}], 
                    RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"/;", 
                    RowBox[{"(", 
                    RowBox[{"!", 
                    RowBox[{"NumericQ", "[", 
                    RowBox[{"a", "*", "b"}], "]"}]}], ")"}]}], ":>"}], "*)"}],
                     "->", 
                    RowBox[{
                    RowBox[{"\[Delta]", "[", 
                    RowBox[{"a", ",", "b"}], "]"}], "*", 
                    RowBox[{"\[Delta]", "[", 
                    RowBox[{"a", ",", "b"}], "]"}]}]}]}]}], ";"}], "*)"}], 
                  "\n", "\n", 
                  RowBox[{"zTemp1", "=", 
                   RowBox[{
                    RowBox[{"zTemp2", "/.", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"deltaFields", "[", 
                    RowBox[{"[", "l", "]"}], "]"}], "[", 
                    RowBox[{"jj", ",", "a_"}], "]"}], "->", "0"}]}], "/.", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"deltaStarFields", "[", 
                    RowBox[{"[", "l", "]"}], "]"}], "[", 
                    RowBox[{"jj", ",", "b_"}], "]"}], "->", "0"}]}]}], ";", 
                  "\n", "\n", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"contributions", "-", "zTemp1"}], "=!=", "0"}], 
                    ",", "\n", 
                    RowBox[{
                    RowBox[{"contributions", "+=", "zTemp1"}], ";"}]}], "\n", 
                   RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<Third contribution: \>\"", ",", "zTemp1"}], 
                    "]"}], ";"}], "*)"}], "\n", "]"}], ";"}]}], 
                "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
               "\[IndentingNewLine]", 
               RowBox[{"(*", "  ", 
                RowBox[{
                "E", " ", "N", " ", "D", "  ", "O", " ", "F", "  ", "C", " ", 
                 "O", " ", "N", " ", "T", " ", "R", " ", "I", " ", "B", " ", 
                 "U", " ", "T", " ", "I", " ", "O", " ", "N", " ", "S"}], 
                "  ", "*)"}], "\n", 
               RowBox[{"z", "=", "contributions"}], ";", "\n", "\n", 
               RowBox[{"contributions", "=", "0"}], ";", "\n", 
               "\[IndentingNewLine]", 
               StyleBox[
                RowBox[{"(*", " ", 
                 RowBox[{
                 "N", " ", "E", " ", "W", "  ", "P", " ", "A", " ", "R", " ", 
                  RowBox[{"T", ":", 
                   StyleBox[
                    RowBox[{" ", " "}]], 
                   RowBox[{
                   "FIELDS", " ", "SET", " ", "TO", " ", "0", " ", 
                    "EARLIER"}]}]}], " ", "*)"}],
                Background->RGBColor[1, 1, 0]], "\[IndentingNewLine]", "\n", 
               RowBox[{"z", "=", 
                RowBox[{"z", "/.", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"locFields", "[", 
                    RowBox[{"[", "l", "]"}], "]"}], "[", 
                   RowBox[{"jj", ",", "a_"}], "]"}], "->", "0"}]}]}], ";", 
               "\n", 
               RowBox[{"z", "=", 
                RowBox[{"z", "/.", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"starFields", "[", 
                    RowBox[{"[", "l", "]"}], "]"}], "[", 
                   RowBox[{"jj", ",", "a_"}], "]"}], "->", "0"}]}]}], ";"}]}],
              "\n", "]"}], ";"}]}], 
          RowBox[{"(*", 
