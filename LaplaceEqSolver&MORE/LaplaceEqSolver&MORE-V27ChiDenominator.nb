Cell[TextData[{
 "LRWaction\[Chi]DivisionWithRegulatorMultipleReplicas[] \t\t\nSAME AS \
TRUNCATED IF \[Lambda]->1\nHOWEVER, BOTH ARE NOT REALLY 1/\[Chi]!! They are ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    RowBox[{"\[Chi]", "+", "1"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3e33b79f-bbc1-df40-98e4-093dd4711a5f"],
 "!!!!\t"
}], "Section",
 CellChangeTimes->{{3.947046438393255*^9, 3.947046448986958*^9}, 
   3.947128965444277*^9, {3.947907696295887*^9, 3.947907696894024*^9}, {
   3.9519719900375195`*^9, 3.951972018332321*^9}, {3.982926650331925*^9, 
   3.982926665189028*^9}, {3.98516678658948*^9, 3.985166788409498*^9}, {
   3.985171234815497*^9, 3.985171247116976*^9}, {3.985226397573028*^9, 
   3.985226437812315*^9}, {3.9852264814339905`*^9, 3.9852264951824055`*^9}, {
   3.985229105404545*^9, 3.9852291091819344`*^9}, 3.9853341134626713`*^9, {
   3.985336007523247*^9, 3.985336009287525*^9}, {3.985337156943842*^9, 
   3.9853372391619835`*^9}},ExpressionUUID->"58ce3c2d-62b9-a74d-960c-\
00fbde7895a3"],

Cell[TextData[{
 "The  idea  is  that  since  I  cannot  actually  contract  1/\[Chi], I  \
instead  contract ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    RowBox[{"\[Chi]", "+", "\[Lambda]"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "875145a9-0e24-1c40-b29e-5e556be986ef"],
 " which  is regulated by \[Lambda]. ",
 StyleBox[" Let me use two targets, with different fixed index & MULTIPLE \
REPLICAS TOO.",
  Background->RGBColor[1, 1, 0]],
 "\n\nAlso, since I cannot use \[Chi](x), i use \[Sum] \[Chi](y) which should \
evaluate to the same number.\n\t",
 StyleBox["\nSAME AS TRUNCATED IF \[Lambda]->1\nHOWEVER, BOTH ARE NOT REALLY \
1/\[Chi]!! They are ",
  FontSize->48],
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    RowBox[{"\[Chi]", "+", "1"}]], TraditionalForm]],
  FormatType->TraditionalForm,
  FontSize->48,ExpressionUUID->"c8604d21-1443-6b45-a52f-f5f718ebcf14"],
 StyleBox["!!!!",
  FontSize->48]
}], "Text",
 CellChangeTimes->{{3.985166795282236*^9, 3.985166813532709*^9}, {
  3.9851682586127815`*^9, 3.9851682950090847`*^9}, {3.9851692738120956`*^9, 
