Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["LRWaction\[Chi]DivisionWithTruncationMultipleReplicas[] \t\tTHIS \
WORKS!!",
  Background->RGBColor[1, 1, 0]],
 "\t\t\nHOWEVER, IT IS NOT REALLY 1/\[Chi]!! IT IS ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    RowBox[{"\[Chi]", "+", "1"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "38de2609-2bea-c941-9fa7-6098013130b8"],
 "!!!!\nI WOULD NEED INFINITE TARGETS TO EVALUATE IT CORRECTLY"
}], "Section",
 CellChangeTimes->{{3.947046438393255*^9, 3.947046448986958*^9}, 
   3.947128965444277*^9, {3.947907696295887*^9, 3.947907696894024*^9}, {
   3.9519719900375195`*^9, 3.951972018332321*^9}, {3.982926650331925*^9, 
   3.982926665189028*^9}, {3.98516678658948*^9, 3.985166788409498*^9}, {
   3.985171234815497*^9, 3.985171247116976*^9}, {3.985226397573028*^9, 
   3.985226437812315*^9}, {3.9852264814339905`*^9, 3.9852264951824055`*^9}, {
   3.985229105404545*^9, 3.9852291091819344`*^9}, {3.9853377484296284`*^9, 
   3.9853377863178864`*^9}},ExpressionUUID->"dfecbb50-cf05-3440-b566-\
17d7851657ef"],

Cell[TextData[{
 "The  idea  is  that  since  I  cannot  actually  contract  1/\[Chi], I  \
instead  contract  (1 - \[Delta]\[Chi]), which  is exact since we only have \
one target. This actually means that this new term is useless: I cannot \
contract it, ever.",
 StyleBox[" Let me use two targets, with different fixed index & MULTIPLE \
REPLICAS TOO.",
  Background->RGBColor[1, 1, 0]],
 "\n\nAlso, since I cannot use \[Chi](x), i use \[Sum] \[Chi](y) which should \
evaluate to the same number."
}], "Text",
 CellChangeTimes->{{3.985166795282236*^9, 3.985166813532709*^9}, {
  3.9851682586127815`*^9, 3.9851682950090847`*^9}, {3.9851692738120956`*^9, 
  3.9851693365720215`*^9}, {3.9852248709329205`*^9, 3.9852248836934166`*^9}, {
  3.985226502286581*^9, 
  3.985226509155157*^9}},ExpressionUUID->"daf5541c-a321-5646-8ea8-\
2f6f060a9320"],

