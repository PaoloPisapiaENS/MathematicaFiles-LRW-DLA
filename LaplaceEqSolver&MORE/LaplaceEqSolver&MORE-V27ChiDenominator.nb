Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{1, 2, 3, 4, 
      5}, {{{1, 2}, {2, 1}, {2, 3}, {3, 2}, {3, 4}, {1, 5}, {2, 5}, {5, 1}, {
       5, 2}, {5, 4}}, Null}, {
      EdgeShapeFunction -> {"FilledArrow"}, EdgeStyle -> {
         RGBColor[0, 0, 1]}, 
       VertexLabels -> {"Name", 4 -> "4, SOURCE", 1 -> "1, ROOT"}, 
       VertexStyle -> {
         RGBColor[0, 0, 1], 1 -> RGBColor[1, 0, 0], 4 -> RGBColor[0, 1, 0]}, 
       EdgeWeight -> {
         $CellContext`\[Beta][1, 2], 
         $CellContext`\[Beta][2, 1], 
         $CellContext`\[Beta][2, 3], 
         $CellContext`\[Beta][3, 2], 
         $CellContext`\[Beta][3, 4], 
