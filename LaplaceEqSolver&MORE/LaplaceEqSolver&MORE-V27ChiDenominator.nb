Cell[CellGroupData[{

Cell["LRWaction divided by \[Chi] by hand \t\tIT WORKS!!!!", "Section",
 CellChangeTimes->{{3.982927503203085*^9, 3.982927512357765*^9}, {
  3.9829893928025894`*^9, 3.982989407957217*^9}, {3.9847103539280434`*^9, 
