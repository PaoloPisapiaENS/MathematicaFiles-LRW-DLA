                   RowBox[{"T", "+", "1"}]], ",", 
                  SubscriptBox["k", "x"]}], "]"}], "*", 
                RowBox[{"\[Phi]", "[", 
                 RowBox[{"x", ",", 
                  SubscriptBox["t", "T"], ",", 
                  SubscriptBox["k", "x"]}], "]"}]}]}], ")"}], " ", "]"}]}], 
           "\[IndentingNewLine]", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", 
            RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], "]"}], 
        RowBox[{"(*", 
