Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "PathFinder", "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"PathFinder", "[", "graph_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pathList", "=", 
      RowBox[{"{", 
       RowBox[{"{", "}"}], "}"}]}], "}"}], ",", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"Step", "[", "subgraph_", "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "locEdges", ",", "locVertices", ",", "locWeights", ",", "locRoot", 
          ",", "locSource", ",", "locMoves", ",", "newEdges", ",", " ", 
          "newRoot", ",", "smallerGraph", ",", "i"}], "}"}], ",", "\n", 
        RowBox[{
         RowBox[{
          RowBox[{"locEdges", " ", "=", " ", 
           RowBox[{
            RowBox[{"EdgeList", "@", "subgraph"}], "/.", 
            RowBox[{"DirectedEdge", "->", "List"}]}]}], ";", "\n", 
          RowBox[{"locVertices", "=", 
           RowBox[{"VertexList", "@", "subgraph"}]}], ";", "\n", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "locVertices", "]"}], "==", "1"}], ",", 
            RowBox[{"Return", "[", "NULL", "]"}]}], "]"}], ";", "\n", 
          RowBox[{"locWeights", "=", 
           RowBox[{
            RowBox[{"WeightedAdjacencyMatrix", "[", "subgraph", "]"}], "//", 
            "Normal"}]}], ";", "\n", 
          RowBox[{"locRoot", " ", "=", " ", "\n", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"Select", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"List", "@@@", 
                  RowBox[{"PropertyValue", "[", 
                   RowBox[{"subgraph", ",", "VertexLabels"}], "]"}]}], ")"}], 
                "[", 
                RowBox[{"[", 
                 RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
               RowBox[{
                RowBox[{"StringMatchQ", "[", 
                 RowBox[{
                  RowBox[{"#", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], ",", 
                  RowBox[{"___", "~~", "\"\<ROOT\>\""}]}], "]"}], "&"}]}], 
              "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", 
          RowBox[{"locSource", " ", "=", " ", "\n", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"Select", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"List", "@@@", 
                  RowBox[{"PropertyValue", "[", 
                   RowBox[{"subgraph", ",", "VertexLabels"}], "]"}]}], ")"}], 
                "[", 
                RowBox[{"[", 
                 RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
               RowBox[{
                RowBox[{"StringMatchQ", "[", 
                 RowBox[{
                  RowBox[{"#", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], ",", 
                  RowBox[{"___", "~~", "\"\<SOURCE\>\""}]}], "]"}], "&"}]}], 
              "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", 
          RowBox[{"locMoves", "=", 
           RowBox[{
            RowBox[{"Select", "[", 
             RowBox[{"locEdges", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "==", "locRoot"}], " ", 
               "&"}]}], "]"}], "[", 
            RowBox[{"[", "All", "]"}], "]"}]}], ";"}], "\n", "\n", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Print", "[", "\"\<###  LocMoves  ####\>\"", "]"}], ";", 
           "\n", 
           RowBox[{"Print", "[", "locMoves", "]"}], ";"}], "*)"}], ";", "\n", 
         "\n", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"i", "=", "1"}], ",", " ", 
           RowBox[{"i", "<=", 
            RowBox[{"Length", "[", "locMoves", "]"}]}], ",", 
           RowBox[{"i", "++"}], ",", "\n", "\n", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"i", " ", "==", 
                 RowBox[{"Length", "[", "locMoves", "]"}]}], ",", "\n", 
                RowBox[{"(*", "True", "*)"}], 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"locMoves", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}], "==", 
                   "locSource"}], ",", "\n", " ", 
                  RowBox[{"(*", "Ture", "*)"}], 
                  RowBox[{
                   RowBox[{"pathList", "=", 
                    RowBox[{"Append", "[", 
                    RowBox[{
                    RowBox[{"pathList", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
                    RowBox[{"Append", "[", 
                    RowBox[{
                    RowBox[{"pathList", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"locMoves", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "]"}]}], ";", 
                   " ", 
                   RowBox[{"Continue", "[", "]"}]}], ",", "\n", " ", 
                  RowBox[{"(*", "False", "*)"}], 
                  RowBox[{"pathList", "=", 
                   RowBox[{"Prepend", "[", 
                    RowBox[{
                    RowBox[{"pathList", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
                    RowBox[{"Append", "[", 
                    RowBox[{
                    RowBox[{"pathList", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"locMoves", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "]"}]}]}], 
                 "\n", "]"}], ",", "\n", 
                RowBox[{"(*", "False", "*)"}], "\n", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"locMoves", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}], "==", 
                   "locSource"}], ",", "\n", " ", 
                  RowBox[{"(*", "True", "*)"}], 
                  RowBox[{
                   RowBox[{"pathList", "=", 
                    RowBox[{"Append", "[", 
                    RowBox[{"pathList", ",", 
                    RowBox[{"Append", "[", 
                    RowBox[{
                    RowBox[{"pathList", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"locMoves", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "]"}]}], ";", 
                   RowBox[{"Continue", "[", "]"}]}], ",", "\n", " ", 
                  RowBox[{"(*", "False", "*)"}], 
                  RowBox[{"pathList", "=", 
                   RowBox[{"Prepend", "[", 
                    RowBox[{"pathList", ",", 
                    RowBox[{"Append", "[", 
                    RowBox[{
                    RowBox[{"pathList", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"locMoves", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "]"}]}]}], 
                 "\n", "]"}]}], "]"}], ";"}], "\n", "\n", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{"Print", "[", "\"\<###  pathList  ####\>\"", "]"}], 
               ";", "\n", 
               RowBox[{"Print", "[", "pathList", "]"}], ";"}], "*)"}], ";", 
             "\n", "\n", 
             RowBox[{"newEdges", "=", 
              RowBox[{
               RowBox[{"Select", "[", 
                RowBox[{"locEdges", ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "=!=", "locRoot"}], " ", "&&",
                    " ", 
                   RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "=!=", "locRoot"}]}], " ",
                   "&"}]}], "]"}], "[", 
               RowBox[{"[", "All", "]"}], "]"}]}], ";", "\n", 
             RowBox[{"newRoot", " ", "=", " ", 
              RowBox[{"locMoves", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ";", "\n", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Length", "[", "newEdges", "]"}], " ", "<=", " ", 
                "0"}], ",", 
               RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\n", 
             RowBox[{"smallerGraph", "=", 
              RowBox[{
               RowBox[{"MyGraph", "[", 
                RowBox[{"newEdges", ",", "newRoot", ",", "locSource", ",", 
                 RowBox[{"\"\<undirected\>\"", "->", "False"}]}], "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", "\n", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"Print", "[", "smallerGraph", "]"}], ";"}], "*)"}], ";",
             "\n", "\n", 
            RowBox[{"Step", "[", "smallerGraph", "]"}]}]}], "\n", "]"}]}]}], 
       "\n", "]"}]}], ";", "\n", "\n", 
     RowBox[{"Step", "[", "graph", "]"}], ";", "\n", 
     RowBox[{"Return", "[", "pathList", "]"}]}]}], "\n", "]"}]}]}], "Code",
 CellLabel->"In[92]:=",ExpressionUUID->"2fb06a73-634a-b64e-9caa-776d48083bf4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "AllbLaplacianRWs", "]"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "AllbLaplacianRWs", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<draw\>\"", "->", "False"}], ",", 
      RowBox[{"\"\<print\>\"", "->", "False"}]}], "}"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"AllbLaplacianRWs", "[", 
   RowBox[{"graph_", ",", "b_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"possibleLRW", ",", "i", ",", 
      RowBox[{"probabilityLRW", "=", 
       RowBox[{"{", "}"}]}]}], "}"}], ",", "\n", 
    RowBox[{
     RowBox[{"possibleLRW", "=", 
      RowBox[{"PathFinder", "[", "graph", "]"}]}], ";", "\n", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", " ", 
       RowBox[{"i", "<=", " ", 
        RowBox[{"Length", "[", "possibleLRW", "]"}]}], ",", 
       RowBox[{"i", "++"}], ",", "\n", 
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"probabilityLRW", ",", 
          RowBox[{"bLaplacianRW", "[", 
           RowBox[{"graph", ",", 
            RowBox[{"possibleLRW", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", "b", ",", 
            RowBox[{"\"\<draw\>\"", "->", 
             RowBox[{"OptionValue", "[", "\"\<draw\>\"", "]"}]}]}], "]"}]}], 
         "]"}], ";", "\n", "\n", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"OptionValue", "[", "\"\<print\>\"", "]"}], ",", 
          RowBox[{"Print", "[", 
           RowBox[{"i", ",", "\"\<) Laplacian RW \>\"", ",", 
            RowBox[{"possibleLRW", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", 
            "\"\< with probability \>\"", " ", ",", 
            RowBox[{"probabilityLRW", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "\n", "]"}]}]}], "\n",
       "]"}], ";", "\n", "\[IndentingNewLine]", 
     RowBox[{"possibleLRW", "=", "\[IndentingNewLine]", 
      RowBox[{"Replace", "[", 
       RowBox[{"possibleLRW", ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"a_", "?", "NumberQ"}], ",", 
           RowBox[{"c_", "?", "NumberQ"}]}], "}"}], ":>", 
         RowBox[{"R", "[", 
          RowBox[{"a", ",", "c", ",", 
           TemplateBox[<|"color" -> RGBColor[1, 0, 0]|>,
            "RGBColorSwatchTemplate"]}], "]"}]}], ",", "3"}], "]"}]}], ";", 
     "\n", "\n", 
     RowBox[{"Return", "[", 
      RowBox[{"{", 
       RowBox[{"possibleLRW", ",", "probabilityLRW"}], "}"}], "]"}]}]}], "\n",
    "]"}]}]}], "Code",
