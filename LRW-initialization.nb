 RowBox[{
  RowBox[{"bLaplacianRW", "[", 
   RowBox[{"graph_", ",", "path__", ",", "b_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "locSource", ",", "locRoot", ",", "locWeights", ",", "locVertices", ",", 
      "denominator", ",", 
      RowBox[{"prob", "=", "1"}]}], "}"}], ",", "\n", 
    RowBox[{
     RowBox[{"locWeights", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"WeightedAdjacencyMatrix", "[", "graph", "]"}], "/.", 
        RowBox[{
         RowBox[{"\[Beta]", "[", "__", "]"}], "->", "1"}]}], "//", 
       "Normal"}]}], ";", "\n", 
     RowBox[{"locVertices", "=", 
      RowBox[{"VertexList", "@", "graph"}]}], ";", "\n", 
     RowBox[{"locRoot", " ", "=", " ", "\n", " ", 
      RowBox[{
