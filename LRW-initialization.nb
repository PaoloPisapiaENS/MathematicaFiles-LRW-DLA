         RowBox[{"Zeta", "[", "3", "]"}]}], ")"}]}]}], ";", "\n", 
     RowBox[{"terms", "=", 
      RowBox[{"terms", "//.", 
       RowBox[{
        RowBox[{"\[Beta]", "[", "__", "]"}], "->", "1"}]}]}], ";", "\n", 
     RowBox[{"terms", "=", 
