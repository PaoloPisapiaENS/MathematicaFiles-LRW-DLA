   RowBox[{"{", 
    RowBox[{"\"\<drawOthers\>\"", "->", " ", "True"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"DrawOnGraph", "[", 
   RowBox[{"graph_", ",", "path__", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"locEdges", ",", 
      RowBox[{"locPathStyle", "=", 
       RowBox[{"{", "}"}]}], ",", "locRoot", ",", "locSource", ",", "i"}], 
     "}"}], ",", "\n", 
    RowBox[{
     RowBox[{"locEdges", " ", "=", " ", 
      RowBox[{"EdgeList", "@", "graph"}]}], ";", "\n", 
     RowBox[{"locRoot", " ", "=", " ", "\n", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"graph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<ROOT\>\""}]}], "]"}], "&"}]}], "]"}], 
        "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", 
     RowBox[{"locSource", " ", "=", " ", "\n", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"graph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<SOURCE\>\""}]}], "]"}], "&"}]}], "]"}],
         "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "\n", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", " ", 
       RowBox[{"i", "<=", 
        RowBox[{"Length", "[", "path", "]"}]}], ",", 
       RowBox[{"i", "++"}], ",", "\n", 
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"locPathStyle", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"path", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "1"}], "]"}], "]"}], "\[DirectedEdge]", 
             RowBox[{"path", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "->", 
            RowBox[{"path", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "3"}], "]"}], "]"}]}], "}"}]}], "]"}], 
        ";"}]}], "\n", 
      RowBox[{"(*", 
       RowBox[{"Print", "[", "locPathStyle", "]"}], "*)"}], "\n", "]"}], ";", 
     "\n", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"OptionValue", "[", "\"\<drawOthers\>\"", "]"}], ",", "\n", 
       RowBox[{"(*", "True", "*)"}], 
       RowBox[{"Graph", "[", 
        RowBox[{"locEdges", ",", 
         RowBox[{"EdgeStyle", "->", 
          RowBox[{"Flatten", "@", 
           RowBox[{"{", 
            RowBox[{"locPathStyle", ",", "Blue"}], "}"}]}]}], ",", " ", 
         RowBox[{"VertexLabels", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"locRoot", "->", 
             RowBox[{
              RowBox[{"ToString", "[", "locRoot", "]"}], "\"\<,ROOT\>\""}]}], 
            ",", 
            RowBox[{"locSource", "->", 
             RowBox[{
              RowBox[{"ToString", "[", "locSource", "]"}], 
              "\"\<,SOURCE\>\""}]}], ",", "\"\<Name\>\""}], "}"}]}], ",", " ", 
         RowBox[{"VertexStyle", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"locRoot", "->", "Red"}], ",", 
            RowBox[{"locSource", "->", "Green"}], ",", "Blue"}], "}"}]}], ",", 
         RowBox[{"EdgeShapeFunction", "->", "\"\<FilledArrow\>\""}]}], "]"}], 
       ",", "\n", 
