Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "LaplaceEqSolver", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "LaplaceEqSolver", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<BC\>\"", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", "}"}], ",", 
         RowBox[{"{", "}"}]}], "}"}]}], " ", ",", " ", 
      RowBox[{"\"\<selectSolution\>\"", "->", "0"}]}], "}"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"LaplaceEqSolver", "[", 
   RowBox[{"graph_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "locVertices", ",", "locWeights", ",", "totWeights", ",", "locRoot", ",",
       "locSource", ",", "locBC", ",", "equations", ",", 
      RowBox[{"variables", "=", 
       RowBox[{"{", "}"}]}], ",", "x", ",", "solution"}], "}"}], ",", "\n", 
    RowBox[{
     RowBox[{"Clear", "[", "\[CapitalPhi]", "]"}], ";", "\n", "\n", 
     RowBox[{"locVertices", " ", "=", " ", 
      RowBox[{"VertexList", "@", "graph"}]}], ";", "\n", 
     RowBox[{"locWeights", "=", 
      RowBox[{
       RowBox[{"WeightedAdjacencyMatrix", "[", "graph", "]"}], "//", 
       "Normal"}]}], ";", "\n", 
     RowBox[{"totWeights", " ", "=", 
      RowBox[{"Total", "[", 
       RowBox[{"locWeights", ",", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\n", "\n", 
     RowBox[{"locRoot", " ", "=", " ", "\n", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"graph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<ROOT\>\""}]}], "]"}], "&"}]}], "]"}], 
        "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", 
     RowBox[{"locSource", " ", "=", " ", "\n", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"graph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<SOURCE\>\""}]}], "]"}], "&"}]}], "]"}],
         "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "\n", 
     RowBox[{"locBC", "=", 
      RowBox[{"OptionValue", "[", "\"\<BC\>\"", "]"}]}], ";", "\n", "\n", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"locBC", "=!=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", "}"}], ",", 
          RowBox[{"{", "}"}]}], "}"}]}], ",", "\n", "\n", 
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{
          RowBox[{"locBC", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"\[CapitalPhi]", "[", "locSource", "]"}], "==", " ", 
           "1"}]}], "]"}], ";", "\n", 
        RowBox[{"AppendTo", "[", 
         RowBox[{
          RowBox[{"locBC", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"\[CapitalPhi]", "[", "locRoot", "]"}], "==", "0"}]}], 
         "]"}], ";", "\n", "\n", 
        RowBox[{"AppendTo", "[", 
         RowBox[{
          RowBox[{"locBC", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", "locSource"}], "]"}], ";", 
        "\n", 
        RowBox[{"AppendTo", "[", 
         RowBox[{
          RowBox[{"locBC", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", "locRoot"}], "]"}], ";"}]}], 
      "\n", "]"}], ";", "\n", "\n", 
     RowBox[{"equations", " ", "=", 
      RowBox[{"locBC", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], " ", ";", "\n", "\n", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"x", "=", "1"}], ",", 
       RowBox[{"x", "<=", 
        RowBox[{"Length", "[", "locVertices", "]"}]}], ",", 
       RowBox[{"x", "++"}], ",", "\n", 
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"variables", ",", 
          RowBox[{"\[CapitalPhi]", "[", "x", "]"}]}], "]"}], ";", "\n", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"MemberQ", "[", 
           RowBox[{
            RowBox[{"locBC", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", "x"}], "]"}], ",", 
          RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\n", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"equations", ",", " ", 
          RowBox[{
           RowBox[{"\[CapitalPhi]", "[", "x", "]"}], "==", 
           RowBox[{"FullSimplify", "[", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"locWeights", "[", 
                 RowBox[{"[", 
                  RowBox[{"x", ",", "y"}], "]"}], "]"}], "/", 
                RowBox[{"totWeights", "[", 
                 RowBox[{"[", "x", "]"}], "]"}]}], " ", 
               RowBox[{"\[CapitalPhi]", "[", "y", "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"y", ",", 
                RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], "]"}],
             "]"}]}]}], "]"}]}]}], "]"}], ";", "\n", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Print", "[", "equations", "]"}], ";", "\n", 
       RowBox[{"Print", "[", "variables", "]"}], ";"}], "*)"}], "\n", 
     RowBox[{"solution", "=", 
      RowBox[{
       RowBox[{"Flatten", "@", 
        RowBox[{"Solve", "[", 
         RowBox[{"equations", ",", "variables"}], "]"}]}], "/.", " ", 
       RowBox[{"Rule", "->", "List"}]}]}], ";", "\n", "\n", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<selectSolution\>\"", "]"}], "!=", 
        "0"}], ",", 
       RowBox[{"(*", "True", "*)"}], "\n", 
       RowBox[{"solution", "=", 
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{"solution", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "==", 
             RowBox[{"\[CapitalPhi]", "[", 
              RowBox[{"OptionValue", "[", "\"\<selectSolution\>\"", "]"}], 
              "]"}]}], " ", "&"}]}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "2"}], "]"}], "]"}]}]}], "\n", "]"}], ";", "\n", 
     "\n", 
     RowBox[{"Return", "[", "solution", "]"}]}]}], "\n", "]"}]}]}], "Code",
 CellLabel->"In[86]:=",ExpressionUUID->"7dc99556-0c76-5946-a13c-2662155bb1c6"],

Cell[BoxData[{
