        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"graph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<ROOT\>\""}]}], "]"}], "&"}]}], "]"}], 
        "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", 
     RowBox[{"locSource", " ", "=", " ", "\n", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@@", 
             RowBox[{"PropertyValue", "[", 
              RowBox[{"graph", ",", "VertexLabels"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"StringMatchQ", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"___", "~~", "\"\<SOURCE\>\""}]}], "]"}], "&"}]}], "]"}],
         "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "\n", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"locRoot", " ", "=!=", " ", 
        RowBox[{"path", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<####  WRONG ROOT  ####\>\"", "]"}], ";", 
        " ", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\n", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"locSource", " ", "=!=", " ", 
        RowBox[{"path", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "2"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<####  WRONG SOURCE  ####\>\"", "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\n", "\n", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"locBC", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", "}"}], ",", 
            RowBox[{"{", "}"}]}], "}"}]}], ",", "\[Phi]", ",", "i", ",", 
         "\[Phi]sol"}], "}"}], ",", "\n", "\n", 
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{
          RowBox[{"locBC", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"\[CapitalPhi]", "[", "locSource", "]"}], "==", "1"}]}], 
         "]"}], ";", "\n", 
        RowBox[{"AppendTo", "[", 
         RowBox[{
          RowBox[{"locBC", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", "locSource"}], "]"}], ";", 
        "\n", "\n", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", "1"}], ",", 
          RowBox[{"i", "<=", 
           RowBox[{"Length", "[", "path", "]"}]}], ",", 
          RowBox[{"i", "++"}], ",", "\n", 
          RowBox[{
           RowBox[{
            RowBox[{"AppendTo", "[", 
             RowBox[{
              RowBox[{"locBC", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{"\[CapitalPhi]", "[", 
                RowBox[{"path", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "==", "0"}]}],
              "]"}], ";", "\n", 
            RowBox[{"AppendTo", "[", 
             RowBox[{
              RowBox[{"locBC", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", 
              RowBox[{"path", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "1"}], "]"}], "]"}]}], "]"}], ";", "\n", 
            "\n", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"Print", "[", "locBC", "]"}], ";"}], "*)"}], "\n", "\n", 
            RowBox[{"\[Phi]sol", "=", 
             RowBox[{
              RowBox[{"LaplaceEqSolver", "[", 
               RowBox[{"graph", ",", 
                RowBox[{"\"\<BC\>\"", "->", "locBC"}]}], "]"}], "/.", 
              RowBox[{
               RowBox[{"\[Beta]", "[", "__", "]"}], "->", "1"}]}]}], ";", 
            "\n", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"Print", "[", "\[Phi]sol", "]"}], ";"}], "*)"}], "\n", 
            "\n", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"Print", "[", "\"\< ##### OK SO FAR ##### \>\"", "]"}], 
              ";"}], "*)"}], "\n", "\n", 
            RowBox[{"denominator", "=", 
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"locWeights", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", "y"}], "]"}], 
                 "]"}], "*", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Select", "[", 
                    RowBox[{"\[Phi]sol", ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "==", 
                    RowBox[{"\[CapitalPhi]", "[", "y", "]"}]}], " ", "&"}]}], 
                    "]"}], "[", 
                   RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], ")"}], "^", 
                 "b"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"y", ",", 
                 RowBox[{"Length", "[", "locVertices", "]"}]}], "}"}]}], 
              "]"}]}], ";"}], "\n", 
           RowBox[{"(*", 
            RowBox[{"Print", "[", "denominator", "]"}], "*)"}], ";", "\n", 
           "\n", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"OptionValue", "[", "\"\<print\>\"", "]"}], ",", "\n", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{"\"\<#####  Transition probability \>\"", "<>", 
                RowBox[{"ToString", "[", 
                 RowBox[{"path", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "<>", 
                "\"\< to \>\"", "<>", 
                RowBox[{"ToString", "[", 
                 RowBox[{"path", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "2"}], "]"}], "]"}], "]"}], "<>", 
                "\"\<  #####\>\""}], "]"}], ";", "\n", "\n", 
              RowBox[{"Print", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"locWeights", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}], 
                    "*", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Select", "[", 
                    RowBox[{"\[Phi]sol", ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "==", 
                    RowBox[{"\[CapitalPhi]", "[", 
                    RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}], "]"}]}], " ", 
                    "&"}]}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], ")"}], "^", 
                    "b"}]}], ")"}], "/", "denominator"}], "/.", 
                 RowBox[{
                  RowBox[{"\[Beta]", "[", 
                   RowBox[{"_", ",", "_"}], "]"}], "->", "1"}]}], "//", 
                "FullSimplify"}], "]"}], ";"}]}], "\n", "]"}], ";", "\n", 
           "\n", 
           RowBox[{
            RowBox[{"prob", "*=", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"locWeights", "[", 
                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}], 
                 "*", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"Select", "[", 
                    RowBox[{"\[Phi]sol", ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "==", 
                    RowBox[{"\[CapitalPhi]", "[", 
                    RowBox[{"path", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}], "]"}]}], " ", 
                    "&"}]}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], ")"}], "^", 
                  "b"}]}], ")"}], "/", "denominator"}], "/.", 
              RowBox[{
               RowBox[{"\[Beta]", "[", "__", "]"}], "->", "1"}]}]}], "//", 
            "FullSimplify"}], ";", "\n", 
           RowBox[{"Clear", "[", "\[Phi]sol", "]"}], ";"}]}], "\n", "]"}], 
        ";"}]}], 
      RowBox[{"(*", 
       RowBox[{"END", " ", "OF", " ", "FOR"}], "*)"}], "\n", "]"}], ";", 
     RowBox[{"(*", 
      RowBox[{"END", " ", "OF", " ", "MODULE"}], "*)"}], "\n", "\n", 
     RowBox[{"If", "[", 
