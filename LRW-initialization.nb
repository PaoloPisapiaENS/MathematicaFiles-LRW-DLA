        RowBox[{"locRoot", "=", "root"}], ",", 
        RowBox[{"locSource", "=", "source"}], ",", "p"}], "}"}], ",", "\n", 
      RowBox[{
       RowBox[{
        RowBox[{"Clear", "[", "\[Beta]", "]"}], ";", "\n", "\n", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", "1"}], ",", " ", 
          RowBox[{"i", "<=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"Dimensions", "@", "edges"}], ")"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", 
          RowBox[{"i", "++"}], ",", "\n", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"OptionValue", "[", "\"\<undirected\>\"", "]"}], " ", "&&",
               " ", 
              RowBox[{
               RowBox[{"edges", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "2"}], "]"}], "]"}], " ", "=!=", 
               "locSource"}], " ", "&&", " ", 
              RowBox[{
               RowBox[{"edges", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "2"}], "]"}], "]"}], " ", "=!=", 
               RowBox[{"edges", "[", 
