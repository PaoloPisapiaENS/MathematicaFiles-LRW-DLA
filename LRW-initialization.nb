  "\n"}], "\n", 
 RowBox[{
  RowBox[{"ConvergencebLRW", "[", 
   RowBox[{"operator_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "ZZ", ",", "locOperator", ",", "locPrecision", ",", "loc\[Gamma]", ",", 
      "exp", ",", "i", ",", "temp", ",", "token"}], "}"}], ",", "\n", "\n", 
    RowBox[{
     RowBox[{"i", "=", "1"}], ";", "\n", "\n", 
     RowBox[{"ZZ", "=", 
      RowBox[{
       RowBox[{"bLRWaction", "[", 
        RowBox[{
         RowBox[{"\"\<graph\>\"", "->", 
          RowBox[{"OptionValue", "[", " ", "\"\<graph\>\"", "]"}]}], ",", 
         RowBox[{"\"\<endTime\>\"", "->", "1"}]}], "]"}], "/.", 
       RowBox[{
        RowBox[{"\[Beta]", "[", "__", "]"}], "->", "1"}]}]}], ";", "\n", "\n", 
     RowBox[{"locOperator", "=", " ", 
      RowBox[{"operator", " ", "/", 
       RowBox[{"bLRWnorm", "[", 
